;; physics_system.carp

(defmodule PhysicsSystem
  (use SpatialGrid)
  (use Collision)
  (use CollisionChecker)
  (use RigidBody)
  (use Solver)
  (use ECS)
  (use InputManager)
  (use RotationState)

  (def fixed-dt 0.00833)
  (def gravity (Vector3.init 0.0 -9.81 0.0))
  (def iterations 8)

  (defn apply-player-movement! [p-rb p-rot mgr dt]
    (let [move-speed 20.0
          yaw @(RotationState.yaw p-rot)
          pitch @(RotationState.pitch p-rot)
          dx (InputManager.action-analog mgr "LookX")
          dy (InputManager.action-analog mgr "LookY")
          new-yaw (+ yaw dx)
          new-pitch (clamp -1.5 1.5 (+ pitch dy))
          yaw-axis (Vector3.init 0.0 1.0 0.0)
          pitch-axis (Vector3.init 1.0 0.0 0.0)
          q-yaw (Quaternion.from-axis-angle yaw-axis new-yaw)
          q-pitch (Quaternion.from-axis-angle pitch-axis new-pitch)
          look-rot (Quaternion.mul &q-yaw &q-pitch)
          forward (Transform.forward-quat &look-rot)
          right (Transform.right-quat &look-rot)
          move-dir (Vector3.init 0.0 0.0 0.0)]
      (do
        (RotationState.set-yaw! p-rot new-yaw)
        (RotationState.set-pitch! p-rot new-pitch)
        (when (InputManager.action-digital? mgr "Forward") (set! move-dir (Vector3.add &move-dir &forward)))
        (when (InputManager.action-digital? mgr "Backward") (set! move-dir (Vector3.sub &move-dir &forward)))
        (when (InputManager.action-digital? mgr "Left") (set! move-dir (Vector3.sub &move-dir &right)))
        (when (InputManager.action-digital? mgr "Right") (set! move-dir (Vector3.add &move-dir &right)))
        (when (not (< (Vector3.mag-sq &move-dir) 0.001))
          (let [accel (Vector3.mul &(Vector3.normalize &move-dir) move-speed)]
            (RigidBody.apply-force! p-rb &accel)))
        (RigidBody.set-rotation! p-rb look-rot))))

  (defn sync-transforms! [world]
    ())

  (defn step-ecs! [world grid f-rb f-col coord]
    (let [collision-occurred false]
      (do
        (sync-transforms! world)
        
        ;; 1. Apply Gravity and Step Bodies
        (ECS.query world [ent (rb RigidBody)]
          (do
            (RigidBody.apply-force! rb &gravity)
            (RigidBody.step-custom! rb fixed-dt fixed-dt)))

        ;; 2. Rebuild Spatial Grid ONCE per frame
        (SpatialGrid.clear! grid)
        (ECS.query world [ent (rb RigidBody) (col Collidable)]
          (let [vol (Collidable.volume col)
                pos (RigidBody.position rb)]
            (do
              (match-ref vol (Volume.Ball s) (Sphere.set-center! s @pos) _ ())
              (let [vel (Body.velocity (RigidBody.body rb))
                    swept (Collision.get-swept-aabb vol vel fixed-dt)]
                (SpatialGrid.insert! grid &swept (ECS.Entity.id &ent))))))

        (for [iter-idx 0 iterations]
          (do
            ;; 3. Resolve vs Floor
            (ECS.query world [ent (rb RigidBody) (col Collidable)]
              (let [vel (Body.velocity (RigidBody.body rb))]
                (match (CollisionChecker.check-pair-swept col vel fixed-dt f-col)
                  (Maybe.Just (CollisionResult.Physical actual-col))
                    (Solver.solve! rb f-rb (Collision.contact-set &actual-col))
                  _ ())))

            ;; 4. Resolve vs Other Entities
            (ECS.query world [ent1 (rb1 RigidBody) (col1 Collidable)]
              (let [aabb (Collision.get-aabb (Collidable.volume col1))
                    candidates (SpatialGrid.query-unique grid &aabb)]
                (for [c 0 (Array.length &candidates)]
                  (let [id2 (Array.unsafe-nth &candidates c)
                        ent2 (ECS.Entity.init (Handle.init (Uint64.from-long (Uint32.to-long @id2)) (Uint32.from-long 1l)))]
                    (when (not (Uint32.= @id2 (ECS.Entity.id &ent1)))
                      (ECS.with-components world ent2 [e2 (rb2 RigidBody) (col2 Collidable)]
                        (let [vel1 (Body.velocity (RigidBody.body rb1))]
                          (match (CollisionChecker.check-pair-swept col1 vel1 fixed-dt col2)
                            (Maybe.Just (CollisionResult.Physical actual-col))
                              (do
                                (set! collision-occurred true)
                                (Solver.solve! rb1 rb2 (Collision.contact-set &actual-col)))
                            _ ()))))))))))
        
        collision-occurred)))
)
