;; physics_system.carp

(defmodule PhysicsSystem
  (use SpatialGrid)
  (use Collision)
  (use CollisionChecker)
  (use RigidBody)
  (use Solver)
  (use ECS)
  (use InputManager)
  (use BouncyTag)
  (def fixed-dt 0.00833)
  (def gravity (Vector3.init 0.0 -9.81 0.0))
  (def iterations 8)

  (defn clamp-vector3 [v max-val]
    (let [mag (Vector3.mag v)]
      (if (> mag max-val)
          (Vector3.mul &(Vector3.normalize v) max-val)
          @v)))

  (defn build-csg-tree-rec! [world parent-handle parent-sdf]
    (ECS.query world [child-ent (parent Parent) (node CsgNode)]
      (when (Handle.equal? (Parent.handle parent) parent-handle)
        (let [child-sdf (Box.peek (CsgNode.shape node))]
          (do
            (SDF.set-csg-nodes! child-sdf [])
            (build-csg-tree-rec! world (ECS.Entity.handle &child-ent) child-sdf)
            (let [boxed-shape (Box.init @child-sdf)
                  csg-node (CsgNode.init boxed-shape @(CsgNode.op node))]
              (SDF.add-csg-node! parent-sdf csg-node))))))))

  (defn get-static-world-handle [world]
    (let [h (Handle.init (Uint64.from-long 0l) (Uint32.from-long 1l))]
      (do
        (ECS.query world [ent (swt StaticWorldTag)]
          (set! h @(ECS.Entity.handle &ent)))
        h)))

  (defn sample-static-world [world-data p]
    (World.sample-voxel-grid-trilinear world-data p))

  (defn estimate-sdf-normal [world-data p]
    (let [eps 0.001
          p-x+ (Vector3.add p &(Vector3.init eps 0.0 0.0))
          p-x- (Vector3.sub p &(Vector3.init eps 0.0 0.0))
          p-y+ (Vector3.add p &(Vector3.init 0.0 eps 0.0))
          p-y- (Vector3.sub p &(Vector3.init 0.0 eps 0.0))
          p-z+ (Vector3.add p &(Vector3.init 0.0 0.0 eps))
          p-z- (Vector3.sub p &(Vector3.init 0.0 0.0 eps))
          dx (- (sample-static-world world-data &p-x+) (sample-static-world world-data &p-x-))
          dy (- (sample-static-world world-data &p-y+) (sample-static-world world-data &p-y-))
          dz (- (sample-static-world world-data &p-z+) (sample-static-world world-data &p-z-))
          len (Double.sqrt (+ (* dx dx) (+ (* dy dy) (* dz dz))))]
      (if (< len 0.0001)
          (Vector3.init 0.0 1.0 0.0)
          (Vector3.mul &(Vector3.init dx dy dz) (/ 1.0 len)))))

  (defn check-corner! [world-data contacts cx cy cz]
    (let [v (Vector3.init cx cy cz)
          d (sample-static-world world-data &v)]
      (if (< d 0.0)
          (let [depth (min 0.15 (neg d))
                normal (estimate-sdf-normal world-data &v)]
            (Array.push-back! contacts (Contact.init depth v normal)))
          (Vector3.delete v))))

  (defn check-offset-rad! [world-data contacts pos rot rad-val ox oy oz]
    (let [local-offset (Vector3.init ox oy oz)
          world-offset (Quaternion.rotate rot &local-offset)
          v (Vector3.add pos &world-offset)
          d (sample-static-world world-data &v)]
      (do
        (Vector3.delete local-offset)
        (Vector3.delete world-offset)
        (if (< d rad-val)
            (let [depth (min 0.15 (- rad-val d))
                  normal (estimate-sdf-normal world-data &v)]
              (if (= rad-val 0.0)
                  (Array.push-back! contacts (Contact.init depth v normal))
                  (let [contact-pt (Vector3.sub &v &(Vector3.mul &normal rad-val))]
                    (do
                      (Vector3.delete v)
                      (Array.push-back! contacts (Contact.init depth contact-pt normal))))))
            (Vector3.delete v)))))

  (defn sample-static-world-material [world p]
    (let [min-d 10000.0
          mat-id 0.0]
      (do
        (ECS.query world [ent (rb RigidBody) (col Collidable)]
          (when (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)
            (match-ref (Collidable.volume col)
              (Volume.Sdf sdf)
                (let [d (SDF.distance-world sdf p)]
                  (when (< d min-d)
                    (do
                      (set! min-d d)
                      (set! mat-id (Double.from-int (inc (the Int (Long.to-int (Uint32.to-long (ECS.Entity.id &ent))))))))))
              _ ())))
        (Vector2.init min-d mat-id))))

  (defn apply-atmospheric-forces! [e world db edb grid vel-field gravity-field]
    (let [coeff -30.0
          drag-coeff 0.15
          gravity (Settings.gravity (Engine.settings e))]
      (ECS.query world [ent (rb RigidBody)]
        (let [pos (RigidBody.position rb)
              vel (Body.velocity (RigidBody.body rb))
              grad (FieldDatabase.calculate-pressure-gradient-grid db edb pos (Pointer.address grid))
              p-force (let [f (Vector3.mul &grad coeff)]
                        (PhysicsSystem.clamp-vector3 &f 300.0))
              ind-vel (Field.sample vel-field pos)
              rel-vel (Vector3.sub &ind-vel vel)
              drag-force (Vector3.mul &rel-vel drag-coeff)
              g-scale (Field.sample gravity-field pos)
              local-gravity (Vector3.mul gravity g-scale)
              temp-sum (Vector3.add &local-gravity &p-force)
              total-force (let [tf (Vector3.add &temp-sum &drag-force)]
                            (PhysicsSystem.clamp-vector3 &tf 1000.0))]
          (RigidBody.apply-force! rb &total-force)))))

  (defn step-ecs! [e world grid]
    (let [world-data (Engine.world-data e)
          coord (Engine.coordinator e)
          diag (Engine.diagnostics e)
          collision-occurred false
          manifolds []
          fixed-dt @(Settings.fixed-dt (Engine.settings e))
          iterations @(Settings.physics-iterations (Engine.settings e))]
      (do
        
        ;; 1. Step Bodies (Integrate forces and advance state)
        (Diagnostics.start-zone! diag "Phys: Forces & Integrator")
        (ECS.query world [ent (rb RigidBody)]
          (RigidBody.step-custom! rb fixed-dt fixed-dt))
        (Diagnostics.end-zone! diag "Phys: Forces & Integrator")
 
        ;; 2. Rebuild Spatial Grid
        (Diagnostics.start-zone! diag "Phys: Spatial Grid Rebuild")
        (SpatialGrid.clear! grid)
        (ECS.query world [ent (rb RigidBody) (col Collidable)]
          (let [vol (Collidable.volume col)
                pos (RigidBody.position rb)
                rot (RigidBody.rotation rb)]
            (do
              (match-ref vol
                (Volume.Ball s) (Sphere.set-center! s @pos)
                (Volume.Box b)
                  (let [half-extents (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)]
                    (do
                      (AABB.set-min! b (Vector3.sub pos &half-extents))
                      (AABB.set-max! b (Vector3.add pos &half-extents))))
                (Volume.Sdf sdf)
                  (do
                    (SDF.set-position! sdf @pos)
                    (SDF.set-rotation! sdf @rot))
                _ ())
              (let [vel (Body.velocity (RigidBody.body rb))
                    swept (Collision.get-swept-aabb vol vel fixed-dt)
                    swept-expanded (if (ECS.has-component? world &ent BouncyTag)
                                       (let [pad 2.0
                                             pad-vec (Vector3.init pad pad pad)]
                                         (AABB.init (Vector3.sub (AABB.min &swept) &pad-vec)
                                                    (Vector3.add (AABB.max &swept) &pad-vec)))
                                       swept)]
                (when (not (ECS.has-component? world &ent StaticWorldTag))
                  (SpatialGrid.insert! grid &swept-expanded (ECS.Entity.id &ent)))))))
 
        (let [edb (World.entity-db (Engine.world-data e))
              active-arr (EntityDatabase.active edb)
              len (Array.length active-arr)]
          (for [id 0 len]
            (when @(Array.unsafe-nth active-arr id)
              (let [h (Array.unsafe-nth (EntityDatabase.handles edb) id)
                    pos (Array.unsafe-nth (EntityDatabase.positions edb) id)
                    scale (* @(Array.unsafe-nth (EntityDatabase.scales edb) id) 2.0)
                    pad-vec (Vector3.init scale scale scale)
                    aabb (AABB.init (Vector3.sub pos &pad-vec) (Vector3.add pos &pad-vec))
                    ent-id (the Uint32 (Uint32.from-long (Uint64.to-long (Handle.index h))))]
                (SpatialGrid.insert! grid &aabb ent-id)))))
        (Diagnostics.end-zone! diag "Phys: Spatial Grid Rebuild")
 
        ;; 3. Detect Collisions between Entities (including the static floor)
        (Diagnostics.start-zone! diag "Phys: Collision Detection")
        (ECS.query world [ent1 (rb1 RigidBody) (col1 Collidable)]
          (when (not (ECS.has-component? world &ent1 StaticWorldTag))
            (let [aabb (Collision.get-aabb (Collidable.volume col1))
                  candidates (SpatialGrid.query-unique grid &aabb)]
              (do
                (let [contacts []
                      pos (RigidBody.position rb1)
                      rot (RigidBody.rotation rb1)]
                  (do
                    (match-ref (Collidable.volume col1)
                      (Volume.Ball s)
                        (let [rad @(Sphere.radius s)
                              d (sample-static-world world-data pos)]
                          (when (< d rad)
                            (let [depth (min 0.15 (- rad d))
                                  normal (estimate-sdf-normal world-data pos)
                                  contact-pt (Vector3.sub pos &(Vector3.mul &normal rad))]
                              (Array.push-back! &contacts (Contact.init depth contact-pt normal)))))
                      (Volume.Box b)
                        (let [amin (AABB.min b)
                              amax (AABB.max b)
                              min-x @(Vector3.x amin)
                              min-y @(Vector3.y amin)
                              min-z @(Vector3.z amin)
                              max-x @(Vector3.x amax)
                              max-y @(Vector3.y amax)
                              max-z @(Vector3.z amax)]
                              (do
                            (check-corner! world-data &contacts min-x min-y min-z)
                            (check-corner! world-data &contacts min-x min-y max-z)
                            (check-corner! world-data &contacts min-x max-y min-z)
                            (check-corner! world-data &contacts min-x max-y max-z)
                            (check-corner! world-data &contacts max-x min-y min-z)
                            (check-corner! world-data &contacts max-x min-y max-z)
                            (check-corner! world-data &contacts max-x max-y min-z)
                            (check-corner! world-data &contacts max-x max-y max-z)
                            ()))
                      (Volume.Sdf sdf)
                        (match-ref (SDF.base sdf)
                          (BaseShape.Box half-extents)
                            (let [ex @(Vector3.x half-extents)
                                  ey @(Vector3.y half-extents)
                                  ez @(Vector3.z half-extents)]
                                  (do
                                (check-offset-rad! world-data &contacts pos rot 0.0 ex ey ez)
                                (check-offset-rad! world-data &contacts pos rot 0.0 ex ey (neg ez))
                                (check-offset-rad! world-data &contacts pos rot 0.0 ex (neg ey) ez)
                                (check-offset-rad! world-data &contacts pos rot 0.0 ex (neg ey) (neg ez))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg ex) ey ez)
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg ex) ey (neg ez))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg ex) (neg ey) ez)
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg ex) (neg ey) (neg ez))
                                ()))
                          (BaseShape.Cylinder rad hh)
                            (let [rad-val @rad
                                  hh-val @hh]
                                  (do
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 hh-val 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 (neg hh-val) 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 rad-val hh-val 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg rad-val) hh-val 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 hh-val rad-val)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 hh-val (neg rad-val))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val 0.7071) hh-val (* rad-val 0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val -0.7071) hh-val (* rad-val 0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val 0.7071) hh-val (* rad-val -0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val -0.7071) hh-val (* rad-val -0.7071))
                                
                                (check-offset-rad! world-data &contacts pos rot 0.0 rad-val (neg hh-val) 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg rad-val) (neg hh-val) 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 (neg hh-val) rad-val)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 (neg hh-val) (neg rad-val))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val 0.7071) (neg hh-val) (* rad-val 0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val -0.7071) (neg hh-val) (* rad-val 0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val 0.7071) (neg hh-val) (* rad-val -0.7071))
                                (check-offset-rad! world-data &contacts pos rot 0.0 (* rad-val -0.7071) (neg hh-val) (* rad-val -0.7071))
                                ()))
                          (BaseShape.Capsule rad hh)
                            (let [rad-val @rad
                                  hh-val @hh]
                                  (do
                                (check-offset-rad! world-data &contacts pos rot rad-val 0.0 hh-val 0.0)
                                (check-offset-rad! world-data &contacts pos rot rad-val 0.0 (neg hh-val) 0.0)
                                ()))
                          (BaseShape.Torus rad-maj rad-min)
                            (let [rmaj @rad-maj
                                  rmin @rad-min]
                                  (do
                                (check-offset-rad! world-data &contacts pos rot rmin rmaj 0.0 0.0)
                                (check-offset-rad! world-data &contacts pos rot rmin (neg rmaj) 0.0 0.0)
                                (check-offset-rad! world-data &contacts pos rot rmin 0.0 0.0 rmaj)
                                (check-offset-rad! world-data &contacts pos rot rmin 0.0 0.0 (neg rmaj))
                                (check-offset-rad! world-data &contacts pos rot rmin (* rmaj 0.7071) 0.0 (* rmaj 0.7071))
                                (check-offset-rad! world-data &contacts pos rot rmin (* rmaj -0.7071) 0.0 (* rmaj 0.7071))
                                (check-offset-rad! world-data &contacts pos rot rmin (* rmaj 0.7071) 0.0 (* rmaj -0.7071))
                                (check-offset-rad! world-data &contacts pos rot rmin (* rmaj -0.7071) 0.0 (* rmaj -0.7071))
                                ()))
                          (BaseShape.Octahedron s)
                            (let [size @s]
                                  (do
                                (check-offset-rad! world-data &contacts pos rot 0.0 size 0.0 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 (neg size) 0.0 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 size 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 (neg size) 0.0)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 0.0 size)
                                (check-offset-rad! world-data &contacts pos rot 0.0 0.0 0.0 (neg size))
                                ()))
                          _ (let [is-bouncy (ECS.has-component? world &ent1 BouncyTag)
                                  rad (if is-bouncy 0.2 0.4)
                                  d (sample-static-world world-data pos)]
                              (when (< d rad)
                                 (let [depth (min 0.15 (- rad d))
                                       normal (estimate-sdf-normal world-data pos)
                                       contact-pt (Vector3.sub pos &(Vector3.mul &normal rad))]
                                   (Array.push-back! &contacts (Contact.init depth contact-pt normal))))))
                      _ ())
                    (when (not (Array.empty? &contacts))
                      (let [m (ContactSet.init @(Collidable.handle col1) (get-static-world-handle world) @&contacts)
                            is-dig-bullet-1 (and (and (ECS.has-component? world &ent1 Lifetime)
                                                      (not (ECS.has-component? world &ent1 BouncyTag)))
                                                 (not (ECS.has-component? world &ent1 Explosion)))]
                        (if is-dig-bullet-1
                            (let [bullet-ent &ent1]
                              (do
                                (let [bp @(RigidBody.position rb1)
                                      crater-data (CraterSpawnData.init bp 0.45 0.0)
                                      event (EventKind.Game (GameEvent.SpawnCrater crater-data))]
                                  (Coordinator.dispatch! coord event))
                                (ECS.with-components world @bullet-ent [e (lt Lifetime)]
                                  (Lifetime.set-time! lt 0.0))))
                            (do
                               (set! collision-occurred true)
                               (Array.push-back! &manifolds m)))))))
 
                (for [c 0 (Array.length &candidates)]
                  (let [id2 (Array.unsafe-nth &candidates c)
                        ent2 (ECS.Entity.init (Handle.init (Uint64.from-long (Uint32.to-long @id2)) (Uint32.from-long 1l)))]
                    (do
                      (when (and (not (Uint32.= @id2 (ECS.Entity.id &ent1)))
                                 (Handle.less-than? (Collidable.handle col1) (ECS.Entity.handle &ent2)))
                        (let [edb (World.entity-db world-data)
                              h-idx (the Int (Long.to-int (Uint32.to-long @id2)))
                              is-field (if (< h-idx (Array.length (EntityDatabase.handle-to-index edb)))
                                           (>= @(Array.unsafe-nth (EntityDatabase.handle-to-index edb) h-idx) 0)
                                           false)]
                          (when (not is-field)
                            (ECS.with-components world @&ent2 [e2 (rb2 RigidBody) (col2 Collidable)]
                              (let [res (CollisionChecker.check-pair col1 col2)]
                          (match res
                            (Maybe.Just (CollisionResult.Physical actual-col))
                              (do
                                 (let [is-dig-bullet-1 (and (and (ECS.has-component? world &ent1 Lifetime)
                                                                 (not (ECS.has-component? world &ent1 BouncyTag)))
                                                            (not (ECS.has-component? world &ent1 Explosion)))
                                       is-dig-bullet-2 (and (and (ECS.has-component? world &ent2 Lifetime)
                                                                 (not (ECS.has-component? world &ent2 BouncyTag)))
                                                            (not (ECS.has-component? world &ent2 Explosion)))]
                                  (if (or is-dig-bullet-1 is-dig-bullet-2)
                                      (let [bullet-ent (if is-dig-bullet-1 &ent1 &ent2)
                                            other-ent (if is-dig-bullet-1 &ent2 &ent1)
                                            other-col (if is-dig-bullet-1 col2 col1)]
                                        (match-ref (Collidable.volume other-col)
                                          (Volume.Sdf sdf)
                                            (let [c-set (Collision.contact-set &actual-col)
                                                  contacts-arr (ContactSet.contacts c-set)]
                                              (when (> (Array.length contacts-arr) 0)
                                                (let [bp @(if is-dig-bullet-1 (RigidBody.position rb1) (RigidBody.position rb2))
                                                      crater-data (CraterSpawnData.init bp 0.45 0.0)
                                                      event (EventKind.Game (GameEvent.SpawnCrater crater-data))]
                                                  (do
                                                    (Coordinator.dispatch! coord event)
                                                    (ECS.with-components world @bullet-ent [e (lt Lifetime)]
                                                      (Lifetime.set-time! lt 0.0))))))
                                          _ (do
                                              (set! collision-occurred true)
                                              (Array.push-back! &manifolds @(Collision.contact-set &actual-col)))))
                                      (do
                                        (set! collision-occurred true)
                                        (Array.push-back! &manifolds @(Collision.contact-set &actual-col))))))
                            _ ())))))))))))))
        (Diagnostics.end-zone! diag "Phys: Collision Detection")
 
        ;; 4. Solve Constraints Iteratively over Cached Manifolds
        (Diagnostics.start-zone! diag "Phys: Constraint Solver")
        (let [resolved-manifolds []]
          (do
            (for [m-idx 0 (Array.length &manifolds)]
              (let [m (Array.unsafe-nth &manifolds m-idx)
                    h-a (ContactSet.a m)
                    h-b (ContactSet.b m)
                    ent-a (ECS.Entity.init @h-a)
                    ent-b (ECS.Entity.init @h-b)
                    ptr-a (ECS.get-component-ptr world &ent-a)
                    ptr-b (ECS.get-component-ptr world &ent-b)]
                (match ptr-a
                  (Maybe.Just p-a)
                    (match ptr-b
                      (Maybe.Just p-b)
                        (Array.push-back! &resolved-manifolds (Pair.init m-idx (Pair.init p-a p-b)))
                      _ ())
                  _ ())))
            (for [iter-idx 0 iterations]
              (for [rm-idx 0 (Array.length &resolved-manifolds)]
                (let [rm (Array.unsafe-nth &resolved-manifolds rm-idx)
                      m-idx @(Pair.a rm)
                      m (Array.unsafe-nth &manifolds m-idx)
                      ptrs (Pair.b rm)
                      ptr-a @(Pair.a ptrs)
                      ptr-b @(Pair.b ptrs)
                      rb-a (ECS.ptr->ref ptr-a world)
                      rb-b (ECS.ptr->ref ptr-b world)]
                  (Solver.solve! rb-a rb-b m fixed-dt))))))
        (Diagnostics.end-zone! diag "Phys: Constraint Solver")
 
        collision-occurred)))
