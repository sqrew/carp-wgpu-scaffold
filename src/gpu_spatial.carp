(load "physics_system.carp")

(defmodule GPUSpatial

  (defn cell-count [grid]
    (* @(SpatialGrid.cols grid) (* @(SpatialGrid.rows grid) @(SpatialGrid.layers grid))))

  (defn stride [max-ids]
    (+ 4 max-ids))

  (defn required-floats [grid max-ids]
    (* (GPUSpatial.cell-count grid) (GPUSpatial.stride max-ids)))

  (defn flatten-in-place! [db world grid max-ids data]
    (let [total-cells (GPUSpatial.cell-count grid)
          st (GPUSpatial.stride max-ids)
          heads (SpatialGrid.heads grid)
          entries (SpatialGrid.entries grid)
          max-entities (Array.length (ECSRegistry.generations (GameWorld.registry world)))
          geom-map (the (Array Int) (replicate max-entities &-1))
          active (FieldDatabase.active db)
          handles (FieldDatabase.handles db)]
      (do
        (for [i 0 (Array.length active)]
          (when @(Array.unsafe-nth active i)
            (let [h (Array.unsafe-nth handles i)
                  eid (the Int (Long.to-int (Uint64.to-long (Handle.index h))))]
              (when (< eid max-entities)
                (Array.aset! &geom-map eid i)))))
        (for [i 0 total-cells]
          (let [curr @(Array.unsafe-nth heads i)
                count 0
                base-idx (* i st)]
            (do
              (while (and (not (= curr -1)) (< count max-ids))
                (let [entry (Array.unsafe-nth entries curr)
                      ent-idx-u32 @(GridEntry.id entry)
                      eid-int (Long.to-int (Uint32.to-long ent-idx-u32))
                      geom-id (if (and (>= eid-int 0) (< eid-int max-entities))
                                  @(Array.unsafe-nth &geom-map eid-int)
                                  -1)]
                  (do
                    (Array.aset! data (+ base-idx (+ 4 count)) (the Float (Double.to-float (Double.from-int geom-id))))
                    (set! count (inc count))
                    (set! curr @(GridEntry.next entry)))))
              (Array.aset! data base-idx (the Float (Double.to-float (Double.from-int count))))))))))
)
