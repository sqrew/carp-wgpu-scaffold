;; src/engine_ui.carp

(defmodule Engine
  (use Camera)
  (use Clock)
  (use InputManager)
  (use Collision)
  (use SpatialGrid)
  (use Transform)
  (use Quaternion)
  (use Body)
  (use RigidBody)
  (use PhysicsSystem)
  (use Random)
  (use ECS)
  (use WGPURenderer)
  (use Coordinator)
  (use FieldDatabase)
  (use World)
  (use Raymarch)
  (use Ray)

  (defn tick-billboards! [e]
    (let [world (Engine.world e)
          cam (Engine.camera e)
          cam-pos (Camera.pos cam)]
      (ECS.query world [ent (rb RigidBody) (bbt BillboardTag)]
        (let [panel-pos (RigidBody.position rb)
              dir (Vector3.normalize &(Vector3.sub cam-pos panel-pos))
              pitch (asin @(Vector3.y &dir))
              yaw (- 1.57079632679 (atan2 @(Vector3.z &dir) @(Vector3.x &dir)))
              rot (Quaternion.from-euler yaw pitch 0.0)]
          (RigidBody.set-rotation! rb rot)))))

  (defn close-ui! [e]
    (match @(Engine.active-ui-panel e)
      (Maybe.Nothing) ()
      (Maybe.Just panel-handle)
        (do
          (Engine.set-show-debug-lines! e false)
          (let [world (Engine.world e)]
            (ECS.query world [ent (panel UiPanel)]
              (when (= (ECS.Entity.id &ent) (handle-id &panel-handle))
                (GameWorld.destroy-entity! world &ent))))
          (Engine.set-active-ui-panel! e (Maybe.Nothing))
          (let [void-win (the (Ptr ()) @(InputManager.context (Engine.input e)))
                win (Init.voidptr->glfw-window void-win)]
            (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED))
          (IO.println "UI Panel closed."))))

  (defn open-ui-at-crosshair! [e]
    (let [cam (Engine.camera e)
          world (Engine.world e)
          grid (Engine.grid e)
          cam-pos (Camera.pos cam)
          cam-front (Camera.front cam)
          ray (Ray.make @cam-pos @cam-front)
          config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
          hit (PlayerSystem.march-world world (Engine.world-data e) grid &ray &config)]
      (if @(RaymarchHit.hit &hit)
          (let [hit-p (RaymarchHit.p &hit)
                hit-ent-maybe (UiSystem.find-hit-entity world hit-p)]
            (match hit-ent-maybe
              (Maybe.Nothing)
                (let [target-pos @hit-p
                      target-handle (UiSystem.spawn-voxel-field-source! world @&target-pos)
                      panel-handle (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                  (do
                    (Engine.set-show-debug-lines! e true)
                    (Engine.set-active-ui-panel! e (Maybe.Just panel-handle))
                    (let [void-win (the (Ptr ()) @(InputManager.context (Engine.input e)))
                          win (Init.voidptr->glfw-window void-win)]
                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_NORMAL))
                    (IO.println &(str* "Handle " (Long.str (Uint64.to-long (Handle.index &target-handle))) " clicked at " &(Vector3.str &target-pos)))))
              (Maybe.Just target-handle)
                (let [target-pos (let [pos-val (Vector3.init 0.0 0.0 0.0)]
                                   (do
                                     (ECS.query world [ent (rb RigidBody)]
                                       (when (= (ECS.Entity.id &ent) (handle-id &target-handle))
                                         (set! pos-val @(RigidBody.position rb))))
                                     pos-val))
                       panel-handle (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                  (do
                    (Engine.set-show-debug-lines! e true)
                    (Engine.set-active-ui-panel! e (Maybe.Just panel-handle))
                    (let [void-win (the (Ptr ()) @(InputManager.context (Engine.input e)))
                          win (Init.voidptr->glfw-window void-win)]
                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_NORMAL))
                    (IO.println &(str* "Handle " (Long.str (Uint64.to-long (Handle.index &target-handle))) " clicked at " &(Vector3.str &target-pos)))))))
          (IO.println "Raycast missed terrain/objects."))))

  (defn apply-control-value! [e target label-id val]
    (let [world (Engine.world e)]
      (do
        (IO.println &(str* "apply-control-value! target=" (Long.str (Uint64.to-long (Handle.index &target))) " label-id=" (Int.str label-id) " val=" (Double.str val)))
        (ECS.query world [ent (fi FieldInstance)]
          (when (= (ECS.Entity.id &ent) (handle-id &target))
            (do
              (if (= label-id 0)
                (do
                  (FieldInstance.set-scale! fi (* val 8.0))
                  (ECS.query world [ent2 (col Collidable)]
                    (when (= (ECS.Entity.id &ent2) (handle-id &target))
                      (match-ref (Collidable.volume col)
                        (Volume.Ball sphere) (Sphere.set-radius! sphere (* val 8.0))
                        (Volume.Sdf sdf) (SDF.set-scale! sdf (* val 8.0))
                        _ ()))))
                (if (= label-id 1)
                  (do
                    (FieldInstance.set-gravity! fi (- (* val 10.0) 5.0))
                    (ECS.query world [ent2 (gs GravitySource)]
                      (when (= (ECS.Entity.id &ent2) (handle-id &target))
                        (GravitySource.set-strength! gs (- (* val 10.0) 5.0)))))
                  (if (= label-id 2)
                    (FieldInstance.set-temperature! fi (- (* val 200.0) 100.0))
                    (if (= label-id 3)
                      (FieldInstance.set-charge! fi (- (* val 20.0) 10.0))
                      (if (= label-id 4)
                        (FieldInstance.set-influence! fi (* val 5.0))
                        ())))))
              (do
                (Engine.set-grid-dirty! e true)
                (Engine.set-voxel-dirty! e true))))))))

  (defn tick-ui-drag! [e width height]
    (let [mgr (Engine.input e)]
      (when (InputManager.action-digital? mgr "Laser")
        (match @(Engine.active-ui-panel e)
          (Maybe.Nothing) ()
          (Maybe.Just panel-handle)
            (let [world (Engine.world e)
                  cam (Engine.camera e)
                  mx @(InputManager.last-mouse-x mgr)
                  my @(InputManager.last-mouse-y mgr)
                  sw (Double.from-int width)
                  sh (Double.from-int height)
                  ray (UiSystem.get-cursor-ray cam mx my sw sh)]
              (do
                (IO.println &(str* "UI Drag Click: mx=" (Double.str mx) " my=" (Double.str my)))
                (ECS.query world [ent (rb RigidBody) (panel UiPanel)]
                  (when (= (ECS.Entity.id &ent) (handle-id &panel-handle))
                    (let [panel-pos (RigidBody.position rb)
                          panel-rot (RigidBody.rotation rb)
                          panel-norm (Transform.forward-quat panel-rot)
                          hit-maybe (UiSystem.ray-plane-intersect &ray panel-pos &panel-norm)]
                      (match hit-maybe
                        (Maybe.Nothing) (IO.println "Ray-plane: Miss")
                        (Maybe.Just hit-p)
                          (let [local-hit (UiSystem.world-to-local &hit-p panel-pos panel-rot)
                                lx @(Vector3.x &local-hit)
                                ly @(Vector3.y &local-hit)
                                _ (IO.println &(str* "Ray-plane: Hit local lx=" (Double.str lx) " ly=" (Double.str ly)))
                                controls (UiPanel.controls panel)
                                controls-len (Array.length controls)]
                            (for [i 0 controls-len]
                              (let [ctrl (Array.unsafe-nth controls i)
                                    ctrl-pos (UiControl.local-pos ctrl)
                                    cx @(Vector3.x ctrl-pos)
                                    cy @(Vector3.y ctrl-pos)
                                    cw @(UiControl.width ctrl)]
                                (do
                                  (IO.println &(str* "Checking control " (Int.str i) ": cx=" (Double.str cx) " cy=" (Double.str cy) " cw=" (Double.str cw)))
                                  (when (and (< (abs (- ly cy)) 0.15)
                                             (< (abs (- lx cx)) (/ cw 2.0)))
                                    (let [new-val (Double.clamp 0.0 1.0 (/ (+ (- lx cx) (/ cw 2.0)) cw))]
                                      (do
                                        (IO.println &(str* "Slider " (Int.str i) " drag match: value=" (Double.str new-val)))
                                        (UiControl.set-value! ctrl new-val)
                                         (ECS.with-components world @&ent [panel-fi (fi FieldInstance)]
                                           (do
                                             (if (= i 0)
                                               (FieldInstance.set-humidity! fi new-val)
                                               (if (= i 1)
                                                 (FieldInstance.set-pressure! fi new-val)
                                                 (ECS.with-components world @&ent [panel-ent2 (c Color)]
                                                   (let [cv @(Color.v c)
                                                         cx @(Vector3.x &cv)
                                                         cy @(Vector3.y &cv)
                                                         cz @(Vector3.z &cv)]
                                                     (if (= i 2)
                                                       (Color.set-v! c (Vector3.init new-val cy cz))
                                                       (if (= i 3)
                                                         (Color.set-v! c (Vector3.init cx new-val cz))
                                                         (if (= i 4)
                                                           (Color.set-v! c (Vector3.init cx cy new-val))
                                                           ())))))))))
                                         (Engine.apply-control-value! e @(UiPanel.target panel) @(UiControl.label-id ctrl) new-val))))))))))))))))))

  (sig tick-ui! (Fn [(Ref Engine.Engine) Double Int Int] ()))
  (defn tick-ui! [e dt width height]
    (do
      (Engine.tick-billboards! e)
      (Engine.tick-ui-drag! e width height)))
)
