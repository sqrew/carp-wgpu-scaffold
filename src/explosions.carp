;; src/explosions.carp

(defmodule ExplosionSystem
  (use Vector3)
  (use Quaternion)
  (use ECS)
  (use RigidBody)
  (use Collidable)
  (use Volume)
  (use Color)
  (use Lifetime)

  (defn spawn! [world db pos max-radius force temp-val pres-val]
    (let [exp-ent (GameWorld.create-entity! world)
          params (Vector4.init max-radius 0.0 0.0 0.0)
          geom-id (FieldDatabase.register-instance! db 1 params @pos (Quaternion.identity) 0.1 -1 (Vector3.init 1.0 0.2 0.0) temp-val 0.0 0.0 pres-val 0.0)]
      (do
        (ECS.add-component! world &exp-ent (RigidBody.static @pos (Quaternion.identity) 0.0 0.0))
        (ECS.add-component! world &exp-ent (Collidable.init @(ECS.Entity.handle &exp-ent) (Volume.Ball (Sphere.init @pos 0.1)) (Uint32.from-long 0l) (Uint32.from-long 0l) false))
        (ECS.add-component! world &exp-ent (Color.init (Vector3.init 1.0 0.3 0.0)))
        (ECS.add-component! world &exp-ent (GeometryRef.init geom-id))
        (ECS.add-component! world &exp-ent (Lifetime.init 0.5))
        (ECS.add-component! world &exp-ent (Explosion.init 0.1 20.0 max-radius force pres-val temp-val))
        ())))
)
