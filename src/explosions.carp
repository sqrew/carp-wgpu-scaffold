;; src/explosions.carp

(defmodule ExplosionSystem
  (use Vector3)
  (use Quaternion)
  (use ECS)
  (use RigidBody)
  (use Collidable)
  (use Volume)
  (use Color)
  (use Lifetime)
  (use Engine)

  (defn spawn! [world db pos max-radius force temp-val pres-val]
    (let [exp-ent (GameWorld.create-entity! world)
          params (Vector4.init max-radius 0.0 0.0 0.0)
          r (Double.random-between 0.2 1.0)
          g (Double.random-between 0.2 1.0)
          b (Double.random-between 0.2 1.0)
          col (Vector3.init r g b)
          growth-speed (* max-radius 6.0)]
      (do
        (FieldDatabase.dispatch-event! db pos &(Vector3.init 0.0 0.0 0.0) 1 &params 0.3 (* max-radius 3.0) growth-speed 0.5 temp-val pres-val &col FieldDatabase.default-event-update)
        (ECS.add-component! world &exp-ent (RigidBody.static @pos (Quaternion.identity) 0.0 0.0))
        (ECS.add-component! world &exp-ent (Collidable.init @(ECS.Entity.handle &exp-ent) (Volume.Ball (Sphere.init @pos 0.3)) (Uint32.from-long 1l) (Uint32.from-long 1l) false))
        (ECS.add-component! world &exp-ent (Color.init col))
        (ECS.add-component! world &exp-ent (Lifetime.init 0.5))
        (ECS.add-component! world &exp-ent (Explosion.init 0.1 20.0 max-radius force pres-val temp-val (Maybe.Nothing)))
        ())))

  (defn spawn-implosion! [world db pos max-radius force temp-val pres-val]
    (let [exp-ent (GameWorld.create-entity! world)
          params (Vector4.init max-radius 0.0 0.0 0.0)
          col (Vector3.init 0.1 0.5 1.0)
          growth-speed (* max-radius 6.0)]
      (do
        (FieldDatabase.dispatch-event! db pos &(Vector3.init 0.0 0.0 0.0) 1 &params 0.3 (* max-radius 3.0) growth-speed 0.5 temp-val pres-val &col FieldDatabase.default-event-update)
        (ECS.add-component! world &exp-ent (RigidBody.static @pos (Quaternion.identity) 0.0 0.0))
        (ECS.add-component! world &exp-ent (Collidable.init @(ECS.Entity.handle &exp-ent) (Volume.Ball (Sphere.init @pos 0.3)) (Uint32.from-long 1l) (Uint32.from-long 1l) false))
        (ECS.add-component! world &exp-ent (Color.init col))
        (ECS.add-component! world &exp-ent (Lifetime.init 0.5))
        (ECS.add-component! world &exp-ent (Explosion.init 0.1 20.0 max-radius force pres-val temp-val (Maybe.Nothing)))
        ())))

  (sig step-explosions! (Fn [(Ref Engine.Engine) (Ref GameWorld) (Ref FieldDatabase) Double] ()))
  (defn step-explosions! [e world db dt]
    (do
      (ECS.query world [ent (exp Explosion) (rb RigidBody) (col Collidable)]
        (let [current-r (Explosion.radius exp)
              max-r @(Explosion.max-radius exp)
              speed @(Explosion.radius-speed exp)
              pos (RigidBody.position rb)
              new-r (+ @current-r (* speed dt))]
          (if (< new-r max-r)
              (do
                (Explosion.set-radius! exp new-r)
                (Engine.set-grid-dirty! e true)
                ;; Update Collidable volume sphere radius to expand the spatial grid footprint
                (match-ref (Collidable.volume col)
                  (Volume.Ball s) (Sphere.set-radius! s (* new-r 3.0))
                  _ ())
                ;; 1. Carve terrain dynamically as shockwave expands
                (let [new-handle (Engine.spawn-crater! e @pos new-r @(Explosion.crater-handle exp))
                      crater-data (CraterSpawnData.init @pos new-r 0.0)]
                  (do
                    (Explosion.set-crater-handle! exp new-handle)
                    (Array.push-back! (Engine.craters e) crater-data)
                    (Engine.set-voxel-dirty! e true))))
              (when (< @current-r max-r)
                (let [crater-data (CraterSpawnData.init @pos max-r 0.0)]
                  (do
                    (Explosion.set-radius! exp max-r)
                    (Array.push-back! (Engine.craters e) crater-data)
                    (Engine.set-voxel-dirty! e true)))))))))
)
