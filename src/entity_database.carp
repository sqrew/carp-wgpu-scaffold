;; entity_database.carp

(deftype Vector4 [x Double y Double z Double w Double])
(defmodule Vector4
  (defn init-zero [] (Vector4.init 0.0 0.0 0.0 0.0))
  (defn copy [v]
    (Vector4.init @(Vector4.x v) @(Vector4.y v) @(Vector4.z v) @(Vector4.w v)))
)

(deftype FieldInitialVal [
  slot Int
  val Double
])

(deftype FieldEvent [
  pos (Vector3 Double)
  velocity (Vector3 Double)
  shape-type Int
  params Vector4
  scale Double
  max-scale Double
  growth-speed Double
  lifetime Double
  max-lifetime Double
  fields (Array FieldInitialVal)
  color (Vector3 Double)
  handle-id Int
  update-fn (Fn [(Ptr ()) (Ptr ()) (Ref (Handle ())) (Ref FieldEvent) Double] ())
])

(deftype FieldKernelDef [
  name String
  slot Int
  default-val Double
  min-val Double
  max-val Double
])

(deftype KernelUpdate [
  func (Fn [(Ptr ()) (Ptr ()) Double] ())
])

(deftype EntityDatabase [
  active (Array Bool)
  handles (Array (Handle ()))
  shape-types (Array Int)
  params (Array Vector4)
  positions (Array (Vector3 Double))
  rotations (Array Quaternion)
  scales (Array Double)
  root-csg-indices (Array Int)
  colors (Array (Vector3 Double))
  vector-fields (Array (Array (Vector3 Double)))
  sdfs (Array (Maybe SDF))
  handle-to-index (Array Int)
  max-scale Double
  events (Array FieldEvent)
  next-virtual-id Int
  spatial-grid (SpatialGrid Int)
  entity-fields (Array (Array Vector4))
  influences (Array Double)
])

(defmodule EntityDatabase
  (use Array)
  (use Vector3)
  (use Quaternion)
  (use SpatialGrid)

  (deftemplate voidptr->db-ref (Fn [(Ptr ())] (Ref EntityDatabase))
    "EntityDatabase* $NAME(void* p)"
    "$DECL { return p; }")



  (sig new (Fn [] EntityDatabase))
  (sig get-index-by-handle (Fn [(Ref EntityDatabase) (Ref (Handle ()))] Int))
  (sig register-instance! (Fn [(Ref EntityDatabase) (Ref (Handle ())) Int Vector4 (Vector3 Double) Quaternion Double Int (Vector3 Double) (Maybe SDF)] Int))
  (sig release-instance! (Fn [(Ref EntityDatabase) (Ref (Handle ()))] ()))
  (sig set-scale! (Fn [(Ref EntityDatabase) (Ref (Handle ())) Double] ()))
  (sig set-velocity! (Fn [(Ref EntityDatabase) (Ref (Handle ())) (Vector3 Double)] ()))
  (sig set-position! (Fn [(Ref EntityDatabase) (Ref (Handle ())) (Vector3 Double)] ()))
  (sig set-rotation! (Fn [(Ref EntityDatabase) (Ref (Handle ())) Quaternion] ()))
  (sig set-root-csg-index! (Fn [(Ref EntityDatabase) (Ref (Handle ())) Int] ()))
  (sig rebuild-spatial-grid! (Fn [(Ref EntityDatabase)] ()))

  (defn ensure-capacity! [arr size default-val]
    (while (< (Array.length arr) size)
      (Array.push-back! arr default-val)))

  (defn new []
    (let [n 128
          act (the (Array Bool) (replicate n &false))
          hnd (the (Array (Handle ())) (replicate n &(the (Handle ()) (Handle.init (Uint64.from-long 0l) (Uint32.from-long 0l)))))
          st (the (Array Int) (replicate n &-1))
          pm (the (Array Vector4) (replicate n &(Vector4.init-zero)))
          pos (the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))
          rot (the (Array Quaternion) (replicate n &(Quaternion.identity)))
          sc (the (Array Double) (replicate n &1.0))
          csg (the (Array Int) (replicate n &-1))
          col (the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))
          vec-fields [(the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))]
          sdfs (the (Array (Maybe SDF)) (replicate n &(the (Maybe SDF) (Maybe.Nothing))))
          h-to-idx (the (Array Int) (replicate 1024 &-1))
          grid (the (SpatialGrid Int) (SpatialGrid.new-with-origin 8.0 32 32 32 (Vector3.init -128.0 -128.0 -128.0)))
          esc [(the (Array Vector4) (replicate n &(Vector4.init 0.0 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 0.0 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 0.2 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 0.0 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 0.0 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 1.0 1.0 1.0 1.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 1.0 0.0 0.0 0.0)))
               (the (Array Vector4) (replicate n &(Vector4.init 1.0 0.0 0.0 0.0)))]
          inf (the (Array Double) (replicate n &1.0))]
      (EntityDatabase.init act hnd st pm pos rot sc csg col vec-fields sdfs h-to-idx 4.0 (the (Array FieldEvent) []) 512 grid esc inf)))

  (defn get-index-by-handle [db handle]
    (let [h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
      (if (< h-idx (Array.length (EntityDatabase.handle-to-index db)))
          @(Array.unsafe-nth (EntityDatabase.handle-to-index db) h-idx)
          -1)))

  (defn register-instance! [db handle shape-type-val params-val pos-val rot-val scale-val csg-idx-val color-val sdf-val]
    (let [found-idx -1
          active-arr (EntityDatabase.active db)
          handles-arr (EntityDatabase.handles db)
          len (Array.length active-arr)]
      (do
        (for [i 0 len]
          (when (not @(Array.unsafe-nth active-arr i))
            (when (= found-idx -1)
              (set! found-idx i))))
        (when (= found-idx -1)
          (do
            (Array.push-back! active-arr false)
            (Array.push-back! handles-arr (Handle.init (Uint64.from-long 0l) (Uint32.from-long 0l)))
            (Array.push-back! (EntityDatabase.shape-types db) -1)
            (Array.push-back! (EntityDatabase.params db) (Vector4.init-zero))
            (Array.push-back! (EntityDatabase.positions db) (Vector3.init 0.0 0.0 0.0))
            (Array.push-back! (EntityDatabase.rotations db) (Quaternion.identity))
            (Array.push-back! (EntityDatabase.scales db) 1.0)
            (Array.push-back! (EntityDatabase.root-csg-indices db) -1)
            (Array.push-back! (EntityDatabase.colors db) (Vector3.init 0.0 0.0 0.0))
            (for [f 0 (Array.length (EntityDatabase.vector-fields db))]
              (let [arr (Array.unsafe-nth (EntityDatabase.vector-fields db) f)]
                (Array.push-back! arr (Vector3.init 0.0 0.0 0.0))))
            (Array.push-back! (EntityDatabase.sdfs db) (Maybe.Nothing))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 0) (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 1) (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 2) (Vector4.init 0.2 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 3) (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 4) (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 5) (Vector4.init 1.0 1.0 1.0 1.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 6) (Vector4.init 1.0 0.0 0.0 0.0))
            (Array.push-back! (Array.unsafe-nth (EntityDatabase.entity-fields db) 7) (Vector4.init 1.0 0.0 0.0 0.0))
            (Array.push-back! (EntityDatabase.influences db) 1.0)
            (set! found-idx len)))
        (Array.aset! active-arr found-idx true)
        (Array.aset! handles-arr found-idx @handle)
        (Array.aset! (EntityDatabase.shape-types db) found-idx shape-type-val)
        (Array.aset! (EntityDatabase.params db) found-idx @&params-val)
        (Array.aset! (EntityDatabase.positions db) found-idx @&pos-val)
        (Array.aset! (EntityDatabase.rotations db) found-idx rot-val)
        (Array.aset! (EntityDatabase.scales db) found-idx scale-val)
        (Array.aset! (EntityDatabase.root-csg-indices db) found-idx csg-idx-val)
        (Array.aset! (EntityDatabase.colors db) found-idx color-val)
        (Array.aset! (EntityDatabase.sdfs db) found-idx sdf-val)
        
        (let [h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
          (do
            (ensure-capacity! (EntityDatabase.handle-to-index db) (inc h-idx) -1)
            (Array.aset! (EntityDatabase.handle-to-index db) h-idx found-idx)
            (let [ms (EntityDatabase.max-scale db)]
              (when (> scale-val @ms)
                (EntityDatabase.set-max-scale! db scale-val)))
            (the Int found-idx))))))

  (defn release-instance! [db handle]
    (let [id (get-index-by-handle db handle)
          h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
      (do
        (when (>= id 0)
          (do
            (Array.aset! (EntityDatabase.active db) id false)
            (Array.aset! (EntityDatabase.shape-types db) id -1)
            (for [f 0 (Array.length (EntityDatabase.vector-fields db))]
              (let [arr (Array.unsafe-nth (EntityDatabase.vector-fields db) f)]
                (Array.aset! arr id (Vector3.init 0.0 0.0 0.0))))
            (Array.aset! (EntityDatabase.sdfs db) id (Maybe.Nothing))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 0) id (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 1) id (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 2) id (Vector4.init 0.2 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 3) id (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 4) id (Vector4.init 0.0 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 5) id (Vector4.init 1.0 1.0 1.0 1.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 6) id (Vector4.init 1.0 0.0 0.0 0.0))
            (Array.aset! (Array.unsafe-nth (EntityDatabase.entity-fields db) 7) id (Vector4.init 1.0 0.0 0.0 0.0))
            (Array.aset! (EntityDatabase.influences db) id 1.0)
            ()))
        (when (< h-idx (Array.length (EntityDatabase.handle-to-index db)))
          (do
            (Array.aset! (EntityDatabase.handle-to-index db) h-idx -1)
            ())))))

  (defn set-scale! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (EntityDatabase.scales db) id val)
          (let [ms (EntityDatabase.max-scale db)]
            (when (> val @ms)
              (do
                (EntityDatabase.set-max-scale! db val)
                ())))
          ()))))

  (defn set-velocity! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (Array.unsafe-nth (EntityDatabase.vector-fields db) 0) id val)
          ()))))

  (defn set-position! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (EntityDatabase.positions db) id val)
          ()))))

  (defn set-rotation! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (EntityDatabase.rotations db) id val)
          ()))))

  (defn set-root-csg-index! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (EntityDatabase.root-csg-indices db) id val)
          ()))))

  (defn rebuild-spatial-grid! [db]
    (let [grid (EntityDatabase.spatial-grid db)
          active-arr (EntityDatabase.active db)
          num-entities (Array.length active-arr)
          positions (EntityDatabase.positions db)
          scales (EntityDatabase.scales db)]
      (do
        (SpatialGrid.clear! grid)
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [pos (Array.unsafe-nth positions i)
                  scale @(Array.unsafe-nth scales i)
                  aabb (AABB.init (Vector3.sub pos &(Vector3.init scale scale scale))
                                  (Vector3.add pos &(Vector3.init scale scale scale)))]
              (SpatialGrid.insert! grid &aabb i)))))))
)
