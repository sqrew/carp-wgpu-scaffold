;; src/svo.carp
;; CPU implementation of Sparse Voxel Octree (SVO) for unified geometry and fields.

(load "../carp-geometry/geometry.carp")
(load "noise.carp")

(deftype SvoNode [
  child-mask Int
  child-ptr Int      ;; -1 if leaf
  is-leaf Int
  leaf-idx Int       ;; -1 if inner
])

(deftype LeafVoxel [
  sdf0 Float
  sdf1 Float
  sdf2 Float
  sdf3 Float
  sdf4 Float
  sdf5 Float
  sdf6 Float
  sdf7 Float
  material Float
  temperature Float
  humidity Float
  gravity-mult Float
])

(deftype Svo [
  nodes (Array SvoNode)
  leaves (Array LeafVoxel)
  origin (Vector3 Double)
  size Double
  max-depth Int
])

(deftype SdfSample [d Double mat Float])

(defmodule Svo
  (use Array)
  (use Vector3)
  (use Double)
  (use SDF)

  (defn int-to-uint8 [val]
    (Uint8.from-long (Long.from-int val)))

  (defn uint8-to-int [val]
    (Long.to-int (Uint8.to-long val)))

  (defn procedural-terrain-sdf [pos]
    (let [px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)
          ;; Match noise coordinates from voxel_baker.carp
          terrain-h (* (ProceduralNoise.fbm2d (* px 0.015) (* pz 0.015)) 25.0)
          final-h (- terrain-h 15.0)
          terrain-d (- py final-h)
          cave-val (if (and (< terrain-d 0.0) (> py -40.0))
                       (ProceduralNoise.noise3d (* px 0.08) (* py 0.08) (* pz 0.08))
                       0.0)
          cave-sdf (if (and (< terrain-d 0.0) (> py -40.0))
                       (* (- cave-val 0.65) 12.5)
                       -1000.0)]
      (if (> cave-sdf terrain-d) cave-sdf terrain-d)))

  (defn evaluate-sdf-min [static-sdfs static-mat-ids pos]
    (let [min-d (procedural-terrain-sdf pos)
          mat-id (if (< min-d 0.0) 1.0f 0.0f)
          num-shapes (Array.length static-sdfs)]
      (do
        (for [i 0 num-shapes]
          (let [sdf (Array.unsafe-nth static-sdfs i)
                d (SDF.distance-world sdf pos)]
            (when (< d min-d)
              (do
                (set! min-d d)
                (set! mat-id @(Array.unsafe-nth static-mat-ids i))))))
        (SdfSample.init min-d mat-id))))

  (defn sample-fields [svo db static-sdfs static-mat-ids pos size]
    (let [px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)
          sz size
          p0 @pos
          p1 (Vector3.init (+ px sz) py pz)
          p2 (Vector3.init px (+ py sz) pz)
          p3 (Vector3.init (+ px sz) (+ py sz) pz)
          p4 (Vector3.init px py (+ pz sz))
          p5 (Vector3.init (+ px sz) py (+ pz sz))
          p6 (Vector3.init px (+ py sz) (+ pz sz))
          p7 (Vector3.init (+ px sz) (+ py sz) (+ pz sz))
          res0 (evaluate-sdf-min static-sdfs static-mat-ids &p0)
          res1 (evaluate-sdf-min static-sdfs static-mat-ids &p1)
          res2 (evaluate-sdf-min static-sdfs static-mat-ids &p2)
          res3 (evaluate-sdf-min static-sdfs static-mat-ids &p3)
          res4 (evaluate-sdf-min static-sdfs static-mat-ids &p4)
          res5 (evaluate-sdf-min static-sdfs static-mat-ids &p5)
          res6 (evaluate-sdf-min static-sdfs static-mat-ids &p6)
          res7 (evaluate-sdf-min static-sdfs static-mat-ids &p7)
          sdf0 (the Float (Double.to-float @(SdfSample.d &res0)))
          sdf1 (the Float (Double.to-float @(SdfSample.d &res1)))
          sdf2 (the Float (Double.to-float @(SdfSample.d &res2)))
          sdf3 (the Float (Double.to-float @(SdfSample.d &res3)))
          sdf4 (the Float (Double.to-float @(SdfSample.d &res4)))
          sdf5 (the Float (Double.to-float @(SdfSample.d &res5)))
          sdf6 (the Float (Double.to-float @(SdfSample.d &res6)))
          sdf7 (the Float (Double.to-float @(SdfSample.d &res7)))
          center-pos (Vector3.init (+ px (* sz 0.5)) (+ py (* sz 0.5)) (+ pz (* sz 0.5)))
          center-res (evaluate-sdf-min static-sdfs static-mat-ids &center-pos)
          material @(SdfSample.mat &center-res)
          temp 0.0f
          hum 0.0f
          grav 1.0f]
      (LeafVoxel.init sdf0 sdf1 sdf2 sdf3 sdf4 sdf5 sdf6 sdf7 material temp hum grav)))

  (defn subdivide! [svo db static-sdfs static-mat-ids node-idx pos size depth]
    (let [max-d @(Svo.max-depth svo)]
      (if (>= depth max-d)
          ;; Reached maximum subdivision depth: make this a leaf voxel
          (let [leaf-voxel (sample-fields svo db static-sdfs static-mat-ids pos size)
                leaf-idx (Array.length (Svo.leaves svo))]
            (do
              (Array.push-back! (Svo.leaves svo) leaf-voxel)
              (let [node (Array.unsafe-nth (Svo.nodes svo) node-idx)]
                (do
                  (SvoNode.set-is-leaf! node 1)
                  (SvoNode.set-leaf-idx! node leaf-idx)))))
          ;; Check if the cube node overlaps boundaries
          (let [center-pos (Vector3.init (+ @(Vector3.x pos) (* size 0.5))
                                         (+ @(Vector3.y pos) (* size 0.5))
                                         (+ @(Vector3.z pos) (* size 0.5)))
                sample-res (evaluate-sdf-min static-sdfs static-mat-ids &center-pos)
                center-dist @(SdfSample.d &sample-res)
                max-radius (* size 0.8660254) ;; size * sqrt(3) / 2
                abs-dist (Double.abs center-dist)]
            (if (> abs-dist max-radius)
                ;; Homogeneous node (entirely inside/outside shapes): make this a leaf
                (let [leaf-voxel (sample-fields svo db static-sdfs static-mat-ids pos size)
                      leaf-idx (Array.length (Svo.leaves svo))]
                  (do
                    (Array.push-back! (Svo.leaves svo) leaf-voxel)
                    (let [node (Array.unsafe-nth (Svo.nodes svo) node-idx)]
                      (do
                        (SvoNode.set-is-leaf! node 1)
                        (SvoNode.set-leaf-idx! node leaf-idx)))))
                ;; Node intersects boundaries: subdivide recursively into 8 children
                (let [child-start-idx (Array.length (Svo.nodes svo))
                      mask 0]
                  (do
                    ;; Allocate 8 children nodes contiguously
                    (for [i 0 8]
                      (Array.push-back! (Svo.nodes svo) (SvoNode.init 0 -1 0 -1)))
                    ;; Set parent child-ptr to start index
                    (let [parent-node (Array.unsafe-nth (Svo.nodes svo) node-idx)]
                      (SvoNode.set-child-ptr! parent-node child-start-idx))
                    ;; Recursively subdivide each child octant
                    (let [half-size (* size 0.5)
                          child-pos-arr [
                            (Vector3.init @(Vector3.x pos) @(Vector3.y pos) @(Vector3.z pos))
                            (Vector3.init (+ @(Vector3.x pos) half-size) @(Vector3.y pos) @(Vector3.z pos))
                            (Vector3.init @(Vector3.x pos) (+ @(Vector3.y pos) half-size) @(Vector3.z pos))
                            (Vector3.init (+ @(Vector3.x pos) half-size) (+ @(Vector3.y pos) half-size) @(Vector3.z pos))
                            (Vector3.init @(Vector3.x pos) @(Vector3.y pos) (+ @(Vector3.z pos) half-size))
                            (Vector3.init (+ @(Vector3.x pos) half-size) @(Vector3.y pos) (+ @(Vector3.z pos) half-size))
                            (Vector3.init @(Vector3.x pos) (+ @(Vector3.y pos) half-size) (+ @(Vector3.z pos) half-size))
                            (Vector3.init (+ @(Vector3.x pos) half-size) (+ @(Vector3.y pos) half-size) (+ @(Vector3.z pos) half-size))
                          ]]
                      (do
                        (for [i 0 8]
                          (let [child-pos (Array.unsafe-nth &child-pos-arr i)
                                child-idx (+ child-start-idx i)]
                            (do
                              (subdivide! svo db static-sdfs static-mat-ids child-idx child-pos half-size (inc depth))
                              (let [child-node (Array.unsafe-nth (Svo.nodes svo) child-idx)]
                                (when (or (= @(SvoNode.is-leaf child-node) 1) (> @(SvoNode.child-ptr child-node) -1))
                                  (set! mask (Int.bit-or mask (Int.bit-shift-left 1 i))))))))
                        (let [parent-node (Array.unsafe-nth (Svo.nodes svo) node-idx)]
                          (SvoNode.set-child-mask! parent-node mask)))))))))))

  (defn new [origin size max-depth]
    (Svo.init [] [] origin size max-depth))

  (defn build! [svo db static-sdfs static-mat-ids]
    (do
      (Svo.set-nodes! svo [])
      (Svo.set-leaves! svo [])
      (let [root-node (SvoNode.init 0 -1 0 -1)]
        (do
          (Array.push-back! (Svo.nodes svo) root-node)
          (subdivide! svo db static-sdfs static-mat-ids 0 (Svo.origin svo) @(Svo.size svo) 0)))))

  (defn find-leaf-node [svo pos]
    (let [origin (Svo.origin svo)
          size @(Svo.size svo)
          px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)]
      (if (or (or (< px @(Vector3.x origin)) (> px (+ @(Vector3.x origin) size)))
              (or (or (< py @(Vector3.y origin)) (> py (+ @(Vector3.y origin) size)))
                  (or (< pz @(Vector3.z origin)) (> pz (+ @(Vector3.z origin) size)))))
          (Maybe.Nothing)
          (let [current-node-idx 0
                nodes (Svo.nodes svo)
                leaves (Svo.leaves svo)
                node-pos @origin
                node-size size
                found (Maybe.Nothing)
                looping true]
            (do
              (while looping
                (let [node (Array.unsafe-nth nodes current-node-idx)]
                  (if (= @(SvoNode.is-leaf node) 1)
                      (do
                        (set! found (Maybe.Just @(Array.unsafe-nth leaves @(SvoNode.leaf-idx node))))
                        (set! looping false))
                      (let [child-ptr @(SvoNode.child-ptr node)
                            child-mask @(SvoNode.child-mask node)]
                        (if (= child-ptr -1)
                            (do
                              (set! looping false))
                            (let [half (* node-size 0.5)
                                  octant-x (if (>= px (+ @(Vector3.x &node-pos) half)) 1 0)
                                  octant-y (if (>= py (+ @(Vector3.y &node-pos) half)) 1 0)
                                  octant-z (if (>= pz (+ @(Vector3.z &node-pos) half)) 1 0)
                                  octant-idx (+ octant-x (+ (* octant-y 2) (* octant-z 4)))
                                  bit (Int.bit-and child-mask (Int.bit-shift-left 1 octant-idx))]
                              (if (= bit 0)
                                  (do
                                    (set! looping false))
                                  (do
                                    (set! current-node-idx (+ child-ptr octant-idx))
                                    (set! node-size half)
                                    (Vector3.set-x! &node-pos (+ @(Vector3.x &node-pos) (* (Double.from-int octant-x) half)))
                                    (Vector3.set-y! &node-pos (+ @(Vector3.y &node-pos) (* (Double.from-int octant-y) half)))
                                    (Vector3.set-z! &node-pos (+ @(Vector3.z &node-pos) (* (Double.from-int octant-z) half)))))))))))
              found)))))

  (defn sample-sdf-at [svo pos]
    (let [origin (Svo.origin svo)
          size @(Svo.size svo)
          px @(Vector3.x pos)
          py @(Vector3.y pos)
          pz @(Vector3.z pos)
          res 1000.0]
      (if (or (or (< px @(Vector3.x origin)) (> px (+ @(Vector3.x origin) size)))
              (or (or (< py @(Vector3.y origin)) (> py (+ @(Vector3.y origin) size)))
                  (or (< pz @(Vector3.z origin)) (> pz (+ @(Vector3.z origin) size)))))
          res
          (let [current-node-idx 0
                nodes (Svo.nodes svo)
                leaves (Svo.leaves svo)
                node-pos @origin
                node-size size
                looping true]
            (do
              (while looping
                (let [node (Array.unsafe-nth nodes current-node-idx)]
                  (if (= @(SvoNode.is-leaf node) 1)
                      (let [leaf (Array.unsafe-nth leaves @(SvoNode.leaf-idx node))
                            fx (/ (- px @(Vector3.x &node-pos)) node-size)
                            fy (/ (- py @(Vector3.y &node-pos)) node-size)
                            fz (/ (- pz @(Vector3.z &node-pos)) node-size)
                            
                            v0 (Double.from-float @(LeafVoxel.sdf0 leaf))
                            v1 (Double.from-float @(LeafVoxel.sdf1 leaf))
                            v2 (Double.from-float @(LeafVoxel.sdf2 leaf))
                            v3 (Double.from-float @(LeafVoxel.sdf3 leaf))
                            v4 (Double.from-float @(LeafVoxel.sdf4 leaf))
                            v5 (Double.from-float @(LeafVoxel.sdf5 leaf))
                            v6 (Double.from-float @(LeafVoxel.sdf6 leaf))
                            v7 (Double.from-float @(LeafVoxel.sdf7 leaf))
                            
                            v_01 (+ v0 (* fx (- v1 v0)))
                            v_23 (+ v2 (* fx (- v3 v2)))
                            v_45 (+ v4 (* fx (- v5 v4)))
                            v_67 (+ v6 (* fx (- v7 v6)))
                            
                            v_y0 (+ v_01 (* fy (- v_23 v_01)))
                            v_y1 (+ v_45 (* fy (- v_67 v_45)))
                            
                            interpolated (+ v_y0 (* fz (- v_y1 v_y0)))]
                        (do
                          (set! res interpolated)
                          (set! looping false)))
                      (let [child-ptr @(SvoNode.child-ptr node)
                            child-mask @(SvoNode.child-mask node)]
                        (if (= child-ptr -1)
                            (do
                              (set! looping false))
                            (let [half (* node-size 0.5)
                                  octant-x (if (>= px (+ @(Vector3.x &node-pos) half)) 1 0)
                                  octant-y (if (>= py (+ @(Vector3.y &node-pos) half)) 1 0)
                                  octant-z (if (>= pz (+ @(Vector3.z &node-pos) half)) 1 0)
                                  octant-idx (+ octant-x (+ (* octant-y 2) (* octant-z 4)))
                                  bit (Int.bit-and child-mask (Int.bit-shift-left 1 octant-idx))]
                              (if (= bit 0)
                                  (do
                                    (set! looping false))
                                  (do
                                    (set! current-node-idx (+ child-ptr octant-idx))
                                    (set! node-size half)
                                    (Vector3.set-x! &node-pos (+ @(Vector3.x &node-pos) (* (Double.from-int octant-x) half)))
                                    (Vector3.set-y! &node-pos (+ @(Vector3.y &node-pos) (* (Double.from-int octant-y) half)))
                                    (Vector3.set-z! &node-pos (+ @(Vector3.z &node-pos) (* (Double.from-int octant-z) half)))))))))))
              res)))))
)
