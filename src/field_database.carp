(deftemplate ptr->ref (Fn [(Ptr t)] (Ref t))
  "$t* $NAME($t* p)"
  "$DECL { return p; }"
)

(deftemplate null-ptr (Fn [] (Ptr t))
  "$t* $NAME()"
  "$DECL { return NULL; }"
)

(deftemplate ptr-cast (Fn [(Ptr a)] (Ptr b))
  "$b* $NAME($a* p)"
  "$DECL { return p; }"
)

(deftype FieldDatabase [
  kernels (Array FieldKernelDef)
  kernel-updates (Array KernelUpdate)
])

(defmodule FieldDatabase
  (use Array)
  (use Vector3)
  (use Quaternion)
  (use SpatialGrid)

  (def temp-slot 0)
  (def light-slot 1)
  (def humidity-slot 2)
  (def pressure-slot 3)
  (def stress-slot 4)
  (def ph-slot 5)
  (def density-slot 6)
  (def lifetime-slot 7)
  (def charge-slot 8)
  (def potential-slot 9)
  (def magnetic-slot 10)
  (def time-dilation-slot 11)

  (deftemplate voidptr->db-ref (Fn [(Ptr ())] (Ref FieldDatabase))
    "FieldDatabase* $NAME(void* p)"
    "$DECL { return p; }"
  )

  (sig sync-instance-capacity! (Fn [(Ref FieldDatabase) Int (Ref (Array FieldKernelDef))] ()))
  (sig release-field-instance! (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Handle ()))] ()))
  (sig register-kernel! (Fn [(Ref FieldDatabase) Int String Double Double Double (Fn [(Ptr ()) (Ptr ()) Double] ())] Int))
  (sig get-kernel-slot (Fn [(Ref FieldDatabase) (Ref String)] Int))
  (sig set-scalar-field! (Fn [(Ref EntityDatabase) Int Int Double] ()))
  (sig get-entity-scalar (Fn [(Ref EntityDatabase) Int Int] Double))
  (sig set-field-vector! (Fn [(Ref EntityDatabase) Int Int (Ref Vector4)] ()))
  (sig get-field-vector (Fn [(Ref EntityDatabase) Int Int] Vector4))
  (sig get-shape-bounding-radius (Fn [Int Double (Ref Vector4)] Double))
  (sig evaluate-csg-primitive (Fn [(Ref (Vector3 Double)) Int (Ref (Vector3 Double)) (Ref Quaternion) Double (Ref Vector4)] Double))
  (sig noop-update (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-temperature! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-humidity! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-light! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-pressure! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-charge! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-density! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig tick-lifetime! (Fn [(Ptr ()) (Ptr ()) Double] ()))
  (sig diffuse-scalar-field! (Fn [(Ref FieldDatabase) (Ref EntityDatabase) Int Double Double Double] ()))
  (sig diffuse-velocity! (Fn [(Ref FieldDatabase) (Ref EntityDatabase) Double] ()))
  (sig tick! (Fn [(Ref FieldDatabase) (Ref EntityDatabase) Double] ()))
  (sig sample-analytical-field (Fn [(Ref FieldDatabase) (Ref EntityDatabase) Int (Ref (Vector3 Double)) Double] Double))

  (defn new []
    (let [kernels (the (Array FieldKernelDef) [])
          kernel-updates (the (Array KernelUpdate) [])]
      (FieldDatabase.init kernels kernel-updates)))

  (defn register-kernel! [db slot name default-val min-val max-val update-fn]
    (let [kernel-def (FieldKernelDef.init @&name slot default-val min-val max-val)]
      (do
        (while (<= (Array.length (FieldDatabase.kernels db)) slot)
          (do
            (Array.push-back! (FieldDatabase.kernels db) (FieldKernelDef.init @"" -1 0.0 0.0 0.0))
            (Array.push-back! (FieldDatabase.kernel-updates db) (KernelUpdate.init noop-update))))
        (Array.aset! (FieldDatabase.kernels db) slot kernel-def)
        (Array.aset! (FieldDatabase.kernel-updates db) slot (KernelUpdate.init update-fn))
        slot)))

  (defn get-kernel-slot [db name]
    (let [kernels-arr (FieldDatabase.kernels db)
          len (Array.length kernels-arr)
          found-slot -1]
      (do
        (for [i 0 len]
          (let [k (Array.unsafe-nth kernels-arr i)]
            (when (= (FieldKernelDef.name k) name)
              (set! found-slot i))))
        found-slot)))

  (defn set-scalar-field! [edb slot entity-idx val]
    (let [arr (Array.unsafe-nth (EntityDatabase.entity-fields edb) slot)]
      (if (and (>= entity-idx 0) (< entity-idx (Array.length arr)))
          (let [v (Array.unsafe-nth arr entity-idx)]
            (Array.aset! arr entity-idx (Vector4.init val @(Vector4.y v) @(Vector4.z v) @(Vector4.w v))))
          ())))

  (defn get-entity-scalar [edb slot entity-idx]
    (let [arr (Array.unsafe-nth (EntityDatabase.entity-fields edb) slot)
          v (Array.unsafe-nth arr entity-idx)]
      @(Vector4.x v)))

  (defn set-field-vector! [edb slot entity-idx val-ref]
    (let [arr (Array.unsafe-nth (EntityDatabase.entity-fields edb) slot)]
      (if (and (>= entity-idx 0) (< entity-idx (Array.length arr)))
          (Array.aset! arr entity-idx @val-ref)
          ())))

  (defn get-field-vector [edb slot entity-idx]
    (let [arr (Array.unsafe-nth (EntityDatabase.entity-fields edb) slot)]
      @(Array.unsafe-nth arr entity-idx)))

  (defn clear-grid-to-val! [arr val]
    (let [len (Array.length arr)]
      (for [i 0 len]
        (Array.aset! arr i val))))

  (defn sample-analytical-field [db edb slot pos-ref def-val]
    (let [active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          influences-arr (EntityDatabase.influences edb)
          fields-arr (Array.unsafe-nth (EntityDatabase.entity-fields edb) slot)
          accumulated-val 0.0
          total-weight 0.0]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)]
              (when (> scale-i 0.0)
                (let [to-pos (Vector3.sub pos-i pos-ref)
                      dist (Vector3.mag &to-pos)]
                  (when (< dist scale-i)
                    (let [influence @(Array.unsafe-nth influences-arr i)
                          weight (* (- 1.0 (/ dist scale-i)) influence)
                          v (Array.unsafe-nth fields-arr i)
                          val @(Vector4.x v)]
                      (when (not (and (= slot ph-slot) (= val -999.0)))
                        (do
                          (set! accumulated-val (+ accumulated-val (* val weight)))
                          (set! total-weight (+ total-weight weight)))))))))))
        (if (> total-weight 0.0)
            (/ accumulated-val total-weight)
            def-val))))

  (defn sync-instance-capacity! [db idx kernels] ())

  (defn release-field-instance! [db edb handle]
    (let [id (EntityDatabase.get-index-by-handle edb handle)]
      (do
        (when (>= id 0)
          (let [num-kernels (Array.length (FieldDatabase.kernels db))]
            (do
              (for [slot 0 num-kernels]
                (let [k (Array.unsafe-nth (FieldDatabase.kernels db) slot)
                      def-val @(FieldKernelDef.default-val k)]
                  (set-scalar-field! edb slot id def-val)))
              (EntityDatabase.release-instance! edb handle)
              ()))))))

  (defn noop-update [db-ptr edb-ptr dt] ())

  (defn diffuse-scalar-field! [db edb slot rate ambient-decay-rate dt]
    (let [active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          grid (EntityDatabase.spatial-grid edb)
          kernel (Array.unsafe-nth (FieldDatabase.kernels db) slot)
          def-val @(FieldKernelDef.default-val kernel)
          min-val @(FieldKernelDef.min-val kernel)
          max-val @(FieldKernelDef.max-val kernel)
          new-vals (the (Array Double) (replicate len &0.0))]
      (do
        (for [i 0 len]
          (if @(Array.unsafe-nth active-arr i)
              (let [pos-i (Array.unsafe-nth positions i)
                    scale-i @(Array.unsafe-nth scales i)
                    val-i (get-entity-scalar edb slot i)
                    aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                    (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                    candidates (SpatialGrid.query-unique grid &aabb)
                    cand-len (Array.length &candidates)
                    sum-diff 0.0
                    sum-weight 0.0]
                (do
                  (for [c 0 cand-len]
                    (let [j @(Array.unsafe-nth &candidates c)]
                      (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                        (let [pos-j (Array.unsafe-nth positions j)
                              scale-j @(Array.unsafe-nth scales j)
                              to-j (Vector3.sub pos-j pos-i)
                              dist (Vector3.mag &to-j)
                              max-dist (+ scale-i scale-j)]
                          (when (< dist max-dist)
                            (let [weight (- 1.0 (/ dist max-dist))
                                  val-j (get-entity-scalar edb slot j)]
                              (do
                                (set! sum-diff (+ sum-diff (* weight (- val-j val-i))))
                                (set! sum-weight (+ sum-weight weight)))))))))
                  (let [diffused-change (* rate (* sum-diff dt))
                        decay-change (* ambient-decay-rate (* (- def-val val-i) dt))
                        next-val (Double.clamp min-val max-val (+ val-i (+ diffused-change decay-change)))]
                    (Array.aset! &new-vals i next-val))))
              (Array.aset! &new-vals i 0.0)))
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (set-scalar-field! edb slot i @(Array.unsafe-nth &new-vals i)))))))

  (defn diffuse-temperature! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)]
      (diffuse-scalar-field! db edb temp-slot 0.8 0.05 dt)))

  (defn diffuse-humidity! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)]
      (diffuse-scalar-field! db edb humidity-slot 0.4 0.02 dt)))

  (defn diffuse-pressure! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)]
      (diffuse-scalar-field! db edb pressure-slot 1.5 0.1 dt)))

  (defn diffuse-charge! [db-ptr edb-ptr dt]
    ())

  (defn diffuse-light! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)]
      (diffuse-scalar-field! db edb light-slot 1.2 0.2 dt)))

  (defn diffuse-density! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)]
      (diffuse-scalar-field! db edb density-slot 0.6 0.05 dt)))

  (defn tick-lifetime! [db-ptr edb-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)
          active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)]
      (for [i 0 len]
        (when @(Array.unsafe-nth active-arr i)
          (let [life (get-entity-scalar edb lifetime-slot i)]
            (if (> life 0.0)
                (let [new-life (- life dt)]
                  (if (<= new-life 0.0)
                      (let [handle (Array.unsafe-nth (EntityDatabase.handles edb) i)]
                        (release-field-instance! db edb handle))
                      (set-scalar-field! edb lifetime-slot i new-life)))
                ()))))))

  (defn sd-sphere [p s]
    (- (Vector3.mag p) s))

  (defn max-double [a b] (if (> a b) a b))
  (defn min-double [a b] (if (< a b) a b))

  (defn sd-box [p b]
    (let [qx (- (Double.abs @(Vector3.x p)) @(Vector3.x b))
          qy (- (Double.abs @(Vector3.y p)) @(Vector3.y b))
          qz (- (Double.abs @(Vector3.z p)) @(Vector3.z b))
          max-q (max-double qx (max-double qy qz))
          outside (Vector3.init (max-double qx 0.0) (max-double qy 0.0) (max-double qz 0.0))
          dist-outside (Vector3.mag &outside)
          dist-inside (min-double max-q 0.0)]
      (+ dist-outside dist-inside)))

  (defn sd-cylinder [p r h]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          dx (- xz-len r)
          dy (- (Double.abs @(Vector3.y p)) h)
          outside-x (max-double dx 0.0)
          outside-y (max-double dy 0.0)
          outside (Double.sqrt (+ (* outside-x outside-x) (* outside-y outside-y)))
          inside (min-double (max-double dx dy) 0.0)]
      (+ outside inside)))

  (defn sd-capsule [p r h]
    (let [py (Double.clamp (- 0.0 h) h @(Vector3.y p))
          p-caps (Vector3.init 0.0 py 0.0)
          diff (Vector3.sub p &p-caps)]
      (- (Vector3.mag &diff) r)))

  (defn sd-torus [p R r]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          q (Vector2.init (- xz-len R) @(Vector3.y p))
          q-len (Double.sqrt (+ (* @(Vector2.x &q) @(Vector2.x &q)) (* @(Vector2.y &q) @(Vector2.y &q))))]
      (- q-len r)))

  (defn sd-octahedron [p s]
    (let [qx (Double.abs @(Vector3.x p))
          qy (Double.abs @(Vector3.y p))
          qz (Double.abs @(Vector3.z p))]
      (* (- (+ qx (+ qy qz)) s) 0.57735027)))

  (defn evaluate-csg-primitive [p shape-type pos rot scale params]
    (let [inv-rot (Quaternion.conjugate rot)
          local-p (Quaternion.rotate &inv-rot &(Vector3.sub p pos))
          d 10000.0]
      (do
        (when (= shape-type 1)
          (set! d (sd-sphere &local-p (* @(Vector4.x params) scale))))
        (when (= shape-type 2)
          (let [b (Vector3.init (* @(Vector4.x params) scale) (* @(Vector4.y params) scale) (* @(Vector4.z params) scale))]
            (set! d (sd-box &local-p &b))))
        (when (= shape-type 3)
          (set! d (sd-cylinder &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 4)
          (set! d (sd-capsule &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 5)
          (set! d (sd-torus &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 6)
          (set! d (sd-octahedron &local-p (* @(Vector4.x params) scale))))
        d)))

  (sig evaluate-scene-sdf-material (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Vector3 Double))] (Vector2 Double)))
  (defn evaluate-scene-sdf-material [db edb pos]
    (let [active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          min-d 10000.0
          mat-id 0.0]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (let [inst-d (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) i)
                           (Maybe.Just sdf) (SDF.distance-world sdf pos)
                           (Maybe.Nothing)
                             (let [shape-type @(Array.unsafe-nth (EntityDatabase.shape-types edb) i)
                                   params (Array.unsafe-nth (EntityDatabase.params edb) i)
                                   inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                                   rot (Array.unsafe-nth (EntityDatabase.rotations edb) i)
                                   scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)]
                               (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
              (when (< inst-d min-d)
                (do
                  (set! min-d inst-d)
                  (set! mat-id (Double.from-int (inc i))))))))
        (Vector2.init min-d mat-id))))

  (defn get-shape-bounding-radius [shape-type scale params]
    (if (= shape-type 1)
        (* @(Vector4.x params) scale) ;; Sphere
        (if (= shape-type 2)
            (let [bx (* @(Vector4.x params) scale)
                  by (* @(Vector4.y params) scale)
                  bz (* @(Vector4.z params) scale)]
              (Double.sqrt (+ (* bx bx) (+ (* by by) (* bz bz))))) ;; Box
            (if (= shape-type 3)
                (let [r (* @(Vector4.x params) scale)
                      h (* @(Vector4.y params) scale)]
                  (Double.sqrt (+ (* r r) (* h h)))) ;; Cylinder
                (if (= shape-type 4)
                    (let [r (* @(Vector4.x params) scale)
                          h (* @(Vector4.y params) scale)]
                      (+ r h)) ;; Capsule
                    (if (= shape-type 5)
                        (let [r-torus (* @(Vector4.x params) scale)
                              r-torus-2 (* @(Vector4.y params) scale)]
                          (+ r-torus r-torus-2)) ;; Torus
                        (if (= shape-type 6)
                            (* @(Vector4.x params) scale) ;; Octahedron
                            0.0)))))))

  (sig evaluate-scene-sdf-material-subset (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Vector3 Double)) (Ref (Array Int)) Double] (Vector2 Double)))
  (defn evaluate-scene-sdf-material-subset [db edb pos indices-ref base-d]
    (let [len (Array.length indices-ref)
          min-d base-d
          mat-id 0.0]
      (do
        (for [k 0 len]
          (let [i @(Array.unsafe-nth indices-ref k)
                inst-d (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) i)
                          (Maybe.Just sdf) (SDF.distance-world sdf pos)
                          (Maybe.Nothing)
                            (let [shape-type @(Array.unsafe-nth (EntityDatabase.shape-types edb) i)
                                  params (Array.unsafe-nth (EntityDatabase.params edb) i)
                                  inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                                  rot (Array.unsafe-nth (EntityDatabase.rotations edb) i)
                                  scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)]
                              (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
            (let [csg-op @(Array.unsafe-nth (EntityDatabase.root-csg-indices edb) i)]
              (if (= csg-op -2)
                  (set! min-d (max-double min-d (- 0.0 inst-d)))
                  (if (= csg-op -3)
                      () ;; Non-solid field: skip baking into collision terrain
                      (when (< inst-d min-d)
                        (do
                          (set! min-d inst-d)
                          (set! mat-id (Double.from-int (inc i))))))))))
        (Vector2.init min-d mat-id))))

  (sig calculate-pressure-gradient-grid (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Vector3 Double)) (Ptr (SpatialGrid Uint32))] (Vector3 Double)))
  (defn calculate-pressure-gradient-grid [db edb pos grid-ptr]
    (let [sum-grad-S (Vector3.init 0.0 0.0 0.0)
          sum-grad-W (Vector3.init 0.0 0.0 0.0)
          sum-S 0.0
          sum-W 0.0
          active-arr (EntityDatabase.active edb)
          epsilon 0.01]
      (do
        (if (null? grid-ptr)
          (let [len (Array.length active-arr)]
            (for [i 0 len]
              (when @(Array.unsafe-nth active-arr i)
                (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                      scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                      pres @(Vector4.x (Array.unsafe-nth (Array.unsafe-nth (EntityDatabase.entity-fields edb) pressure-slot) i))
                      to-pos (Vector3.sub pos inst-pos)
                      dist (Vector3.mag &to-pos)
                      d (- dist scale)
                      w-denom (+ (* d d) epsilon)
                      w (/ 1.0 w-denom)]
                  (do
                    (set! sum-S (+ sum-S (* pres w)))
                    (set! sum-W (+ sum-W w))
                    (when (> dist 0.00001)
                      (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                            grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                            grad-w (Vector3.mul &dir grad-w-mag)
                            grad-s (Vector3.mul &grad-w pres)]
                        (do
                          (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                          (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w))))))))))
          (let [grid (ptr->ref grid-ptr)
                aabb (AABB.init (Vector3.sub pos &(Vector3.init 0.01 0.01 0.01))
                                (Vector3.add pos &(Vector3.init 0.01 0.01 0.01)))
                candidates (SpatialGrid.query-unique grid &aabb)
                cand-len (Array.length &candidates)]
            (for [c 0 cand-len]
              (let [h-idx (the Int (Long.to-int (Uint32.to-long @(Array.unsafe-nth &candidates c))))
                    i (if (< h-idx (Array.length (EntityDatabase.handle-to-index edb)))
                          @(Array.unsafe-nth (EntityDatabase.handle-to-index edb) h-idx)
                          -1)]
                (when (>= i 0)
                  (when @(Array.unsafe-nth active-arr i)
                    (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                          scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                          pres @(Vector4.x (Array.unsafe-nth (Array.unsafe-nth (EntityDatabase.entity-fields edb) pressure-slot) i))
                          to-pos (Vector3.sub pos inst-pos)
                          dist (Vector3.mag &to-pos)
                          d (- dist scale)
                          w-denom (+ (* d d) epsilon)
                          w (/ 1.0 w-denom)]
                      (do
                        (set! sum-S (+ sum-S (* pres w)))
                        (set! sum-W (+ sum-W w))
                        (when (> dist 0.00001)
                          (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                                grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                                grad-w (Vector3.mul &dir grad-w-mag)
                                grad-s (Vector3.mul &grad-w pres)]
                            (do
                              (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                              (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w)))))))))))))
        (if (> sum-W 0.00001)
          (let [term1 (Vector3.mul &sum-grad-S sum-W)
                term2 (Vector3.mul &sum-grad-W sum-S)
                num (Vector3.sub &term1 &term2)
                grad (Vector3.mul &num (/ 1.0 (* sum-W sum-W)))]
            grad)
          (Vector3.init 0.0 0.0 0.0)))))

  (sig calculate-pressure-gradient (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-pressure-gradient [db edb pos]
    (calculate-pressure-gradient-grid db edb pos (null-ptr)))

  (sig calculate-induced-velocity (Fn [(Ref FieldDatabase) (Ref EntityDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-induced-velocity [db edb pos]
    (let [sum-vel (Vector3.init 0.0 0.0 0.0)
          sum-W 0.0
          active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          epsilon 0.01]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                  scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                  vel (Array.unsafe-nth (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) i)
                  to-pos (Vector3.sub pos inst-pos)
                  dist (Vector3.mag &to-pos)
                  d (- dist scale)
                  w-denom (+ (* d d) epsilon)
                  w (/ 1.0 w-denom)]
              (do
                (set! sum-vel (Vector3.add &sum-vel &(Vector3.mul vel w)))
                (set! sum-W (+ sum-W w))))))
        (if (> sum-W 0.00001)
          (Vector3.mul &sum-vel (/ 1.0 sum-W))
          (Vector3.init 0.0 0.0 0.0)))))

  (defn default-event-update [db-ptr edb-ptr handle ev dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (EntityDatabase.voidptr->db-ref edb-ptr)
          life @(FieldEvent.lifetime ev)
          max-life @(FieldEvent.max-lifetime ev)
          decay-factor (/ life max-life)
          pos (FieldEvent.pos ev)
          scale @(FieldEvent.scale ev)]
      (do
        (EntityDatabase.set-position! edb handle @pos)
        (EntityDatabase.set-scale! edb handle scale)
        (let [fields-arr (FieldEvent.fields ev)
              len (Array.length fields-arr)
              ent-idx (EntityDatabase.get-index-by-handle edb handle)]
          (when (>= ent-idx 0)
            (for [i 0 len]
              (let [f (Array.unsafe-nth fields-arr i)
                    slot @(FieldInitialVal.slot f)
                    val (* @(FieldInitialVal.val f) decay-factor)]
                 (set-scalar-field! edb slot ent-idx val))))))))

  (defn dispatch-event! [db edb pos vel shape-type params start-scale max-scale growth-speed max-lifetime fields col update-fn]
    (let [curr-id @(EntityDatabase.next-virtual-id edb)
          h-id (if (>= curr-id 1020) 512 curr-id)
          handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
          event (FieldEvent.init @pos @vel shape-type @params start-scale max-scale growth-speed max-lifetime max-lifetime @fields @col h-id update-fn)]
      (do
        (EntityDatabase.set-next-virtual-id! edb (inc h-id))
        (let [discard-idx (EntityDatabase.register-instance! edb &handle shape-type @params @pos (Quaternion.identity) start-scale -1 @col (the (Maybe SDF) (Maybe.Nothing)))]
          (do
            (when (>= discard-idx 0)
              (do
                (sync-instance-capacity! db discard-idx (FieldDatabase.kernels db))
                (let [num-pairs (Array.length fields)]
                  (for [k 0 num-pairs]
                    (let [p (Array.unsafe-nth fields k)
                          slot @(FieldInitialVal.slot p)
                          val @(FieldInitialVal.val p)]
                      (set-scalar-field! edb slot discard-idx val))))
                (Array.aset! (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) discard-idx @vel)
                ()))))
        (Array.push-back! (EntityDatabase.events edb) event))))

  (defn diffuse-velocity! [db edb dt]
    (let [active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          grid (EntityDatabase.spatial-grid edb)
          vel-arr (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0)
          new-vels (the (Array (Vector3 Double)) (replicate len &(Vector3.init 0.0 0.0 0.0)))
          rate 0.8]
      (do
        (for [i 0 len]
          (if @(Array.unsafe-nth active-arr i)
              (let [pos-i (Array.unsafe-nth positions i)
                    scale-i @(Array.unsafe-nth scales i)
                    vel-i (Array.unsafe-nth vel-arr i)
                    aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                    (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                    candidates (SpatialGrid.query-unique grid &aabb)
                    cand-len (Array.length &candidates)
                    sum-diff (Vector3.init 0.0 0.0 0.0)]
                (do
                  (for [c 0 cand-len]
                    (let [j @(Array.unsafe-nth &candidates c)]
                      (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                        (let [pos-j (Array.unsafe-nth positions j)
                              scale-j @(Array.unsafe-nth scales j)
                              to-j (Vector3.sub pos-j pos-i)
                              dist (Vector3.mag &to-j)
                              max-dist (+ scale-i scale-j)]
                          (when (< dist max-dist)
                            (let [weight (- 1.0 (/ dist max-dist))
                                  vel-j (Array.unsafe-nth vel-arr j)
                                  diff-v (Vector3.sub vel-j vel-i)
                                  weighted-diff (Vector3.mul &diff-v weight)]
                              (set! sum-diff (Vector3.add &sum-diff &weighted-diff))))))))
                  (let [diffused-change (Vector3.mul &sum-diff (* rate dt))
                        next-vel (Vector3.add vel-i &diffused-change)]
                    (Array.aset! &new-vels i next-vel))))
              (Array.aset! &new-vels i (Vector3.init 0.0 0.0 0.0))))
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (Array.aset! vel-arr i @(Array.unsafe-nth &new-vels i)))))))

  (defn tick! [db edb dt]
    (let [db (the (Ref FieldDatabase) db)
          edb (the (Ref EntityDatabase) edb)
          ev-arr (EntityDatabase.events edb)
          len (Array.length ev-arr)
          keep-ev []]
      (do
        (EntityDatabase.rebuild-spatial-grid! edb)
        (diffuse-velocity! db edb dt)

        (for [i 0 len]
          (let [ev @(Array.unsafe-nth ev-arr i)
                h-id @(FieldEvent.handle-id &ev)
                handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
                life (- @(FieldEvent.lifetime &ev) dt)
                max-life @(FieldEvent.max-lifetime &ev)
                pos (FieldEvent.pos &ev)
                vel (FieldEvent.velocity &ev)
                new-pos (Vector3.add pos &(Vector3.mul vel dt))
                grow @(FieldEvent.growth-speed &ev)
                scale @(FieldEvent.scale &ev)
                max-sc @(FieldEvent.max-scale &ev)
                new-scale (let [s (+ scale (* grow dt))]
                            (if (> s max-sc) max-sc s))]
            (if (> life 0.0)
                (let [updated-ev (FieldEvent.init @&new-pos @vel @(FieldEvent.shape-type &ev) @(FieldEvent.params &ev) new-scale max-sc grow life max-life @(FieldEvent.fields &ev) @(FieldEvent.color &ev) h-id @(FieldEvent.update-fn &ev))]
                  (do
                    ;; Execute the custom callback function
                    (let [db-ptr (the (Ptr ()) (ptr-cast (Pointer.address db)))
                          edb-ptr (the (Ptr ()) (ptr-cast (Pointer.address edb)))]
                      (@(FieldEvent.update-fn &ev) db-ptr edb-ptr &handle &updated-ev dt))
                    (Array.push-back! &keep-ev updated-ev)))
                (release-field-instance! db edb &handle))))
        (EntityDatabase.set-events! edb keep-ev)
        
        ;; Dynamic kernel updates
        (let [updates-arr (FieldDatabase.kernel-updates db)
              num-updates (Array.length updates-arr)
              db-ptr (the (Ptr ()) (ptr-cast (Pointer.address db)))
              edb-ptr (the (Ptr ()) (ptr-cast (Pointer.address edb)))]
          (for [u-idx 0 num-updates]
            (let [ku (Array.unsafe-nth updates-arr u-idx)
                  update-fn (KernelUpdate.func ku)]
              (@update-fn db-ptr edb-ptr dt))))))
))
