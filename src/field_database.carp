(deftemplate ptr->ref (Fn [(Ptr t)] (Ref t))
  "$t* $NAME($t* p)"
  "$DECL { return p; }"
)

(deftemplate null-ptr (Fn [] (Ptr t))
  "$t* $NAME()"
  "$DECL { return NULL; }"
)

(deftemplate ptr-cast (Fn [(Ptr a)] (Ptr b))
  "$b* $NAME($a* p)"
  "$DECL { return p; }"
)

(deftype FieldDatabase [
  entity-db-ptr (Ptr ())
  kernels (Array FieldKernelDef)
  influences (Array Double)
  kernel-updates (Array KernelUpdate)
  entity-scalars (Array (Array Double))
])

(defmodule FieldDatabase
  (use Array)
  (use Vector3)
  (use Quaternion)
  (use SpatialGrid)

  (deftemplate voidptr->db-ref (Fn [(Ptr ())] (Ref FieldDatabase))
    "FieldDatabase* $NAME(void* p)"
    "$DECL { return p; }"
  )

  (deftemplate entity-db (Fn [(Ref FieldDatabase)] (Ref EntityDatabase))
    "EntityDatabase* $NAME(FieldDatabase* db)"
    "$DECL { return (EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr); }")

  ;; Delegating wrappers for EntityDatabase fields using deftemplates to preserve APIs and type safety
  (deftemplate active (Fn [(Ref FieldDatabase)] (Ref (Array Bool)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->active); }")

  (deftemplate handles (Fn [(Ref FieldDatabase)] (Ref (Array (Handle ()))))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->handles); }")

  (deftemplate shape-types (Fn [(Ref FieldDatabase)] (Ref (Array Int)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->shape_MINUS_types); }")

  (deftemplate params (Fn [(Ref FieldDatabase)] (Ref (Array Vector4)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->params); }")

  (deftemplate positions (Fn [(Ref FieldDatabase)] (Ref (Array (Vector3 Double))))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->positions); }")

  (deftemplate rotations (Fn [(Ref FieldDatabase)] (Ref (Array Quaternion)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->rotations); }")

  (deftemplate scales (Fn [(Ref FieldDatabase)] (Ref (Array Double)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->scales); }")

  (deftemplate root-csg-indices (Fn [(Ref FieldDatabase)] (Ref (Array Int)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->root_MINUS_csg_MINUS_indices); }")

  (deftemplate colors (Fn [(Ref FieldDatabase)] (Ref (Array (Vector3 Double))))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->colors); }")

  (deftemplate vector-fields (Fn [(Ref FieldDatabase)] (Ref (Array (Array (Vector3 Double)))))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->vector_MINUS_fields); }")

  (deftemplate sdfs (Fn [(Ref FieldDatabase)] (Ref (Array (Maybe SDF))))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->sdfs); }")

  (deftemplate handle-to-index (Fn [(Ref FieldDatabase)] (Ref (Array Int)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->handle_MINUS_to_MINUS_index); }")

  (deftemplate max-scale (Fn [(Ref FieldDatabase)] (Ref Double))
    "double* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->max_MINUS_scale); }")

  (deftemplate events (Fn [(Ref FieldDatabase)] (Ref (Array FieldEvent)))
    "Array* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->events); }")

  (deftemplate next-virtual-id (Fn [(Ref FieldDatabase)] (Ref Int))
    "int* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->next_MINUS_virtual_MINUS_id); }")

  (deftemplate spatial-grid (Fn [(Ref FieldDatabase)] (Ref (SpatialGrid Int)))
    "void* $NAME(FieldDatabase* db)"
    "$DECL { return &(((EntityDatabase*)(db->entity_MINUS_db_MINUS_ptr))->spatial_MINUS_grid); }")

  ;; Delegating wrappers for EntityDatabase mutations
  (defn set-position! [db handle val] (EntityDatabase.set-position! (entity-db db) handle val))
  (defn set-rotation! [db handle val] (EntityDatabase.set-rotation! (entity-db db) handle val))
  (defn set-scale! [db handle val] (EntityDatabase.set-scale! (entity-db db) handle val))
  (defn set-velocity! [db handle val] (EntityDatabase.set-velocity! (entity-db db) handle val))
  (defn set-root-csg-index! [db handle val] (EntityDatabase.set-root-csg-index! (entity-db db) handle val))

  (sig new (Fn [] FieldDatabase))
  (sig register-kernel! (Fn [(Ref FieldDatabase) String Double Double Double (Fn [(Ptr ()) Double] ())] Int))
  (sig get-kernel-slot (Fn [(Ref FieldDatabase) (Ref String)] Int))
  (sig set-scalar-field! (Fn [(Ref FieldDatabase) Int Int Double] ()))
  (sig get-entity-scalar (Fn [(Ref FieldDatabase) Int Int] Double))
  (sig get-shape-bounding-radius (Fn [Int Double (Ref Vector4)] Double))
  (sig evaluate-csg-primitive (Fn [(Ref (Vector3 Double)) Int (Ref (Vector3 Double)) (Ref Quaternion) Double (Ref Vector4)] Double))
  (sig get-index-by-handle (Fn [(Ref FieldDatabase) (Ref (Handle ()))] Int))
  (sig register-instance-generic! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Int Vector4 (Vector3 Double) Quaternion Double Int (Vector3 Double) Double (Ref (Array FieldInitialVal)) (Maybe SDF)] Int))
  (sig register-instance! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Int Vector4 (Vector3 Double) Quaternion Double Int (Vector3 Double) Double Double Double Double Double Double Double Double (Vector3 Double) Double (Maybe SDF)] Int))
  (sig release-instance! (Fn [(Ref FieldDatabase) (Ref (Handle ()))] ()))
  (sig set-scalar-by-name! (Fn [(Ref FieldDatabase) (Ref (Handle ())) (Ref String) Double] ()))
  (sig set-influence! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig noop-update (Fn [(Ptr ()) Double] ()))
  (sig diffuse-temperature! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-humidity! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-light! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-pressure! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-charge! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-density! (Fn [(Ptr ()) Double] ()))
  (sig tick-lifetime! (Fn [(Ptr ()) Double] ()))
  (sig diffuse-velocity! (Fn [(Ref FieldDatabase) Double] ()))
  (sig tick! (Fn [(Ref FieldDatabase) Double] ()))
  (sig sample-analytical-field (Fn [(Ref FieldDatabase) Int (Ref (Vector3 Double)) Double] Double))

  (defn new []
    (let [kernels (the (Array FieldKernelDef) [])
          influences (the (Array Double) (replicate 128 &1.0))
          kernel-updates (the (Array KernelUpdate) [])
          entity-scalars (the (Array (Array Double)) [])]
      (FieldDatabase.init (the (Ptr ()) (null-ptr)) kernels influences kernel-updates entity-scalars)))

  (defn register-kernel! [db name default-val min-val max-val update-fn]
    (let [slot (Array.length (FieldDatabase.kernels db))
          kernel-def (FieldKernelDef.init @&name slot default-val min-val max-val)
          ent-cache (the (Array Double) (replicate 128 &default-val))]
      (do
        (Array.push-back! (FieldDatabase.kernels db) kernel-def)
        (Array.push-back! (FieldDatabase.entity-scalars db) ent-cache)
        (Array.push-back! (FieldDatabase.kernel-updates db) (KernelUpdate.init update-fn))
        slot)))

  (defn get-index-by-handle [db handle]
    (EntityDatabase.get-index-by-handle (entity-db db) handle))

  (defn get-kernel-slot [db name]
    (let [kernels-arr (FieldDatabase.kernels db)
          len (Array.length kernels-arr)
          found-slot -1]
      (do
        (for [i 0 len]
          (let [k (Array.unsafe-nth kernels-arr i)]
            (when (= (FieldKernelDef.name k) name)
              (set! found-slot i))))
        found-slot)))

  (defn set-scalar-field! [db slot entity-idx val]
    (let [arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) slot)]
      (if (and (>= entity-idx 0) (< entity-idx (Array.length arr)))
          (Array.aset! arr entity-idx val)
          ())))

  (defn get-entity-scalar [db slot entity-idx]
    (let [arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) slot)]
      @(Array.unsafe-nth arr entity-idx)))

  (defn clear-grid-to-val! [arr val]
    (let [len (Array.length arr)]
      (for [i 0 len]
        (Array.aset! arr i val))))

  (defn sample-analytical-field [db slot pos-ref def-val]
    (let [edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          influences-arr (FieldDatabase.influences db)
          scalars-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) slot)
          accumulated-val 0.0
          total-weight 0.0]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)]
              (when (> scale-i 0.0)
                (let [to-pos (Vector3.sub pos-i pos-ref)
                      dist (Vector3.mag &to-pos)]
                  (when (< dist scale-i)
                    (let [influence @(Array.unsafe-nth influences-arr i)
                          weight (* (- 1.0 (/ dist scale-i)) influence)
                          val @(Array.unsafe-nth scalars-arr i)]
                      (when (not (and (= slot 5) (= val -999.0)))
                        (do
                          (set! accumulated-val (+ accumulated-val (* val weight)))
                          (set! total-weight (+ total-weight weight)))))))))))
        (if (> total-weight 0.0)
            (/ accumulated-val total-weight)
            def-val))))

  (defn register-instance-generic! [db handle shape-type-val params-val pos-val rot-val scale-val csg-idx-val color-val influence-val initial-fields sdf-val]
    (let [edb (entity-db db)
          found-idx (EntityDatabase.register-instance! edb handle shape-type-val params-val pos-val rot-val scale-val csg-idx-val color-val sdf-val)
          len (Array.length (FieldDatabase.influences db))]
      (do
        (while (<= len found-idx)
          (do
            (Array.push-back! (FieldDatabase.influences db) 1.0)
            (for [f 0 (Array.length (FieldDatabase.entity-scalars db))]
              (let [arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) f)
                    k (Array.unsafe-nth (FieldDatabase.kernels db) f)
                    def-val @(FieldKernelDef.default-val k)]
                (Array.push-back! arr def-val)))
            (set! len (inc len))))
        (Array.aset! (FieldDatabase.influences db) found-idx influence-val)
        
        ;; Set initial-fields
        (let [num-pairs (Array.length initial-fields)]
          (for [k 0 num-pairs]
            (let [p (Array.unsafe-nth initial-fields k)
                  slot @(FieldInitialVal.slot p)
                  val @(FieldInitialVal.val p)]
              (set-scalar-field! db slot found-idx val))))
        found-idx)))

  (defn register-instance! [db handle shape-type-val params-val pos-val rot-val scale-val csg-idx-val color-val temp-val age-val hum-val pres-val charge-val gravity-val density-val lifetime-val vel-val influence-val sdf-val]
    (let [initial-fields (the (Array FieldInitialVal)
                           [(FieldInitialVal.init 0 (the Double temp-val))
                            (FieldInitialVal.init 1 (the Double age-val))
                            (FieldInitialVal.init 2 (the Double hum-val))
                            (FieldInitialVal.init 3 (the Double pres-val))
                            (FieldInitialVal.init 4 (the Double charge-val))
                            (FieldInitialVal.init 5 (the Double gravity-val))
                            (FieldInitialVal.init 6 (the Double density-val))
                            (FieldInitialVal.init 7 (the Double lifetime-val))])]
      (do
        (let [idx (the Int (register-instance-generic! db handle (the Int shape-type-val) (the Vector4 params-val) (the (Vector3 Double) pos-val) (the Quaternion rot-val) (the Double scale-val) (the Int csg-idx-val) (the (Vector3 Double) color-val) (the Double influence-val) &initial-fields (the (Maybe SDF) sdf-val)))]
          (do
            (when (>= idx 0)
              (let [edb (entity-db db)]
                (Array.aset! (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) idx (the (Vector3 Double) vel-val))))
            (the Int idx))))))

  (defn release-instance! [db handle]
    (let [edb (entity-db db)
          id (get-index-by-handle db handle)]
      (do
        (when (>= id 0)
          (let [num-kernels (Array.length (FieldDatabase.kernels db))]
            (do
              ;; Reset cache values back to defaults in FieldDatabase
              (for [slot 0 num-kernels]
                (let [k (Array.unsafe-nth (FieldDatabase.kernels db) slot)
                      def-val @(FieldKernelDef.default-val k)]
                  (set-scalar-field! db slot id def-val)))
              (Array.aset! (FieldDatabase.influences db) id 1.0)
              (EntityDatabase.release-instance! edb handle)
              ()))))))

  (defn set-scalar-by-name! [db handle name val]
    (let [slot (get-kernel-slot db name)
          id (get-index-by-handle db handle)]
      (when (and (>= slot 0) (>= id 0))
        (do
          (set-scalar-field! db slot id val)
          ()))))

  (defn set-influence! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (FieldDatabase.influences db) id val)
          ()))))

  (defn noop-update [db-ptr dt] ())

  (defn diffuse-temperature! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          temp-slot 0
          temp-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) temp-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.8
          new-temps (Array.copy temp-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [t-i @(Array.unsafe-nth temp-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  cooling-rate 0.1
                  ambient-temp 0.0
                  delta-temp (* (- ambient-temp t-i) (* cooling-rate dt))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [t-j @(Array.unsafe-nth temp-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- t-j t-i) factor) dt)]
                            (set! delta-temp (+ delta-temp (* transfer diffusion-rate)))))))))
                (Array.aset! &new-temps i (+ t-i delta-temp))))))
        (for [i 0 num-entities]
          (Array.aset! temp-arr i @(Array.unsafe-nth &new-temps i))))))

  (defn diffuse-humidity! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          hum-slot 2
          temp-slot 0
          hum-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) hum-slot)
          temp-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) temp-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.6
          new-hums (Array.copy hum-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [h-i @(Array.unsafe-nth hum-arr i)
                  t-i @(Array.unsafe-nth temp-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  ambient-hum 0.2
                  dissipation-rate 0.05
                  delta-hum (* (- ambient-hum h-i) (* dissipation-rate dt))
                  evap-cond (if (> t-i 0.0)
                                (* (* t-i 0.01) (* (- 1.0 h-i) dt))
                                (* (* t-i 0.02) (* h-i dt)))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (set! delta-hum (+ delta-hum evap-cond))
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [h-j @(Array.unsafe-nth hum-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- h-j h-i) factor) dt)]
                            (set! delta-hum (+ delta-hum (* transfer diffusion-rate)))))))))
                (Array.aset! &new-hums i (Double.clamp 0.0 1.0 (+ h-i delta-hum)))))))
        (for [i 0 num-entities]
          (Array.aset! hum-arr i @(Array.unsafe-nth &new-hums i))))))

  (defn diffuse-pressure! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          pres-slot 3
          temp-slot 0
          pres-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) pres-slot)
          temp-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) temp-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.7
          new-pres (Array.copy pres-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [p-i @(Array.unsafe-nth pres-arr i)
                  t-i @(Array.unsafe-nth temp-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  ambient-pres 0.0
                  dissipation-rate 0.15
                  delta-pres (* (- ambient-pres p-i) (* dissipation-rate dt))
                  expansion-rate 0.25
                  thermal-expansion (* (* t-i expansion-rate) dt)
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (set! delta-pres (+ delta-pres thermal-expansion))
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [p-j @(Array.unsafe-nth pres-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- p-j p-i) factor) dt)]
                            (set! delta-pres (+ delta-pres (* transfer diffusion-rate)))))))))
                (Array.aset! &new-pres i (Double.clamp 0.0 100.0 (+ p-i delta-pres)))))))
        (for [i 0 num-entities]
          (Array.aset! pres-arr i @(Array.unsafe-nth &new-pres i))))))

  (defn diffuse-charge! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          charge-slot 4
          charge-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) charge-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.9
          new-chgs (Array.copy charge-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [c-i @(Array.unsafe-nth charge-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  ambient-chg 0.0
                  discharge-rate 0.1
                  delta-charge (* (- ambient-chg c-i) (* discharge-rate dt))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [c-j @(Array.unsafe-nth charge-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- c-j c-i) factor) dt)]
                            (set! delta-charge (+ delta-charge (* transfer diffusion-rate)))))))))
                (Array.aset! &new-chgs i (Double.clamp -10.0 10.0 (+ c-i delta-charge)))))))
        (for [i 0 num-entities]
          (Array.aset! charge-arr i @(Array.unsafe-nth &new-chgs i))))))

  (defn diffuse-light! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          light-slot 1
          light-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) light-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.7
          new-lights (Array.copy light-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [l-i @(Array.unsafe-nth light-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  decay-rate 0.15
                  ambient-light 0.0
                  delta-light (* (- ambient-light l-i) (* decay-rate dt))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [l-j @(Array.unsafe-nth light-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- l-j l-i) factor) dt)]
                            (set! delta-light (+ delta-light (* transfer diffusion-rate)))))))))
                (Array.aset! &new-lights i (Double.clamp 0.0 1.0 (+ l-i delta-light)))))))
        (for [i 0 num-entities]
          (Array.aset! light-arr i @(Array.unsafe-nth &new-lights i))))))

  (defn diffuse-density! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          density-slot 6
          density-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) density-slot)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          diffusion-rate 0.5
          new-dens (Array.copy density-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [d-i @(Array.unsafe-nth density-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  decay-rate 0.05
                  delta-density (* (- 1.0 d-i) (* decay-rate dt))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [d-j @(Array.unsafe-nth density-arr j)
                             pos-j (Array.unsafe-nth positions j)
                             scale-j @(Array.unsafe-nth scales j)
                             to-j (Vector3.sub pos-j pos-i)
                             dist (Vector3.mag &to-j)
                             max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                transfer (* (* (- d-j d-i) factor) dt)]
                            (set! delta-density (+ delta-density (* transfer diffusion-rate)))))))))
                (Array.aset! &new-dens i (+ d-i delta-density))))))
        (for [i 0 num-entities]
          (Array.aset! density-arr i @(Array.unsafe-nth &new-dens i))))))

  (defn tick-lifetime! [db-ptr dt]
    (let [db (voidptr->db-ref db-ptr)
          edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          lifetime-slot 7
          lifetime-arr (Array.unsafe-nth (FieldDatabase.entity-scalars db) lifetime-slot)]
      (for [i 0 num-entities]
        (when @(Array.unsafe-nth active-arr i)
          (let [curr-life @(Array.unsafe-nth lifetime-arr i)]
            (Array.aset! lifetime-arr i (- curr-life dt)))))))

  (defn sd-sphere [p s]
    (- (Vector3.mag p) s))

  (defn max-double [a b] (if (> a b) a b))
  (defn min-double [a b] (if (< a b) a b))

  (defn sd-box [p b]
    (let [qx (- (Double.abs @(Vector3.x p)) @(Vector3.x b))
          qy (- (Double.abs @(Vector3.y p)) @(Vector3.y b))
          qz (- (Double.abs @(Vector3.z p)) @(Vector3.z b))
          max-q (max-double qx (max-double qy qz))
          outside (Vector3.init (max-double qx 0.0) (max-double qy 0.0) (max-double qz 0.0))
          dist-outside (Vector3.mag &outside)
          dist-inside (min-double max-q 0.0)]
      (+ dist-outside dist-inside)))

  (defn sd-cylinder [p r h]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          dx (- xz-len r)
          dy (- (Double.abs @(Vector3.y p)) h)
          outside-x (max-double dx 0.0)
          outside-y (max-double dy 0.0)
          outside (Double.sqrt (+ (* outside-x outside-x) (* outside-y outside-y)))
          inside (min-double (max-double dx dy) 0.0)]
      (+ outside inside)))

  (defn sd-capsule [p r h]
    (let [py (Double.clamp (- 0.0 h) h @(Vector3.y p))
          p-caps (Vector3.init 0.0 py 0.0)
          diff (Vector3.sub p &p-caps)]
      (- (Vector3.mag &diff) r)))

  (defn sd-torus [p R r]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          q (Vector2.init (- xz-len R) @(Vector3.y p))
          q-len (Double.sqrt (+ (* @(Vector2.x &q) @(Vector2.x &q)) (* @(Vector2.y &q) @(Vector2.y &q))))]
      (- q-len r)))

  (defn sd-octahedron [p s]
    (let [qx (Double.abs @(Vector3.x p))
          qy (Double.abs @(Vector3.y p))
          qz (Double.abs @(Vector3.z p))]
      (* (- (+ qx (+ qy qz)) s) 0.57735027)))

  (defn evaluate-csg-primitive [p shape-type pos rot scale params]
    (let [inv-rot (Quaternion.conjugate rot)
          local-p (Quaternion.rotate &inv-rot &(Vector3.sub p pos))
          d 10000.0]
      (do
        (when (= shape-type 1)
          (set! d (sd-sphere &local-p (* @(Vector4.x params) scale))))
        (when (= shape-type 2)
          (let [b (Vector3.init (* @(Vector4.x params) scale) (* @(Vector4.y params) scale) (* @(Vector4.z params) scale))]
            (set! d (sd-box &local-p &b))))
        (when (= shape-type 3)
          (set! d (sd-cylinder &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 4)
          (set! d (sd-capsule &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 5)
          (set! d (sd-torus &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 6)
          (set! d (sd-octahedron &local-p (* @(Vector4.x params) scale))))
        d)))

  (sig evaluate-scene-sdf-material (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector2 Double)))
  (defn evaluate-scene-sdf-material [db pos]
    (let [edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          min-d 10000.0
          mat-id 0.0]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (let [inst-d (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) i)
                           (Maybe.Just sdf) (SDF.distance-world sdf pos)
                           (Maybe.Nothing)
                             (let [shape-type @(Array.unsafe-nth (EntityDatabase.shape-types edb) i)
                                   params (Array.unsafe-nth (EntityDatabase.params edb) i)
                                   inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                                   rot (Array.unsafe-nth (EntityDatabase.rotations edb) i)
                                   scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)]
                               (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
              (when (< inst-d min-d)
                (do
                  (set! min-d inst-d)
                  (set! mat-id (Double.from-int (inc i))))))))
        (Vector2.init min-d mat-id))))

  (defn get-shape-bounding-radius [shape-type scale params]
    (if (= shape-type 1)
        (* @(Vector4.x params) scale) ;; Sphere
        (if (= shape-type 2)
            (let [bx (* @(Vector4.x params) scale)
                  by (* @(Vector4.y params) scale)
                  bz (* @(Vector4.z params) scale)]
              (Double.sqrt (+ (* bx bx) (+ (* by by) (* bz bz))))) ;; Box
            (if (= shape-type 3)
                (let [r (* @(Vector4.x params) scale)
                      h (* @(Vector4.y params) scale)]
                  (Double.sqrt (+ (* r r) (* h h)))) ;; Cylinder
                (if (= shape-type 4)
                    (let [r (* @(Vector4.x params) scale)
                          h (* @(Vector4.y params) scale)]
                      (+ r h)) ;; Capsule
                    (if (= shape-type 5)
                        (let [R-torus (* @(Vector4.x params) scale)
                              r-torus (* @(Vector4.y params) scale)]
                          (+ R-torus r-torus)) ;; Torus
                        (if (= shape-type 6)
                            (* @(Vector4.x params) scale) ;; Octahedron
                            0.0)))))))

  (sig evaluate-scene-sdf-material-subset (Fn [(Ref FieldDatabase) (Ref (Vector3 Double)) (Ref (Array Int)) Double] (Vector2 Double)))
  (defn evaluate-scene-sdf-material-subset [db pos indices-ref base-d]
    (let [edb (entity-db db)
          len (Array.length indices-ref)
          min-d base-d
          mat-id 0.0]
      (do
        (for [k 0 len]
          (let [i @(Array.unsafe-nth indices-ref k)
                inst-d (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) i)
                          (Maybe.Just sdf) (SDF.distance-world sdf pos)
                          (Maybe.Nothing)
                            (let [shape-type @(Array.unsafe-nth (EntityDatabase.shape-types edb) i)
                                  params (Array.unsafe-nth (EntityDatabase.params edb) i)
                                  inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                                  rot (Array.unsafe-nth (EntityDatabase.rotations edb) i)
                                  scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)]
                              (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
            (let [csg-op @(Array.unsafe-nth (EntityDatabase.root-csg-indices edb) i)]
              (if (= csg-op -2)
                  (set! min-d (max-double min-d (- 0.0 inst-d)))
                  (if (= csg-op -3)
                      () ;; Non-solid field: skip baking into collision terrain
                      (when (< inst-d min-d)
                        (do
                          (set! min-d inst-d)
                          (set! mat-id (Double.from-int (inc i))))))))))
        (Vector2.init min-d mat-id))))

  (sig calculate-pressure-gradient-grid (Fn [(Ref FieldDatabase) (Ref (Vector3 Double)) (Ptr (SpatialGrid Uint32))] (Vector3 Double)))
  (defn calculate-pressure-gradient-grid [db pos grid-ptr]
    (let [edb (entity-db db)
          sum-grad-S (Vector3.init 0.0 0.0 0.0)
          sum-grad-W (Vector3.init 0.0 0.0 0.0)
          sum-S 0.0
          sum-W 0.0
          active-arr (EntityDatabase.active edb)
          epsilon 0.01]
      (do
        (if (null? grid-ptr)
          (let [len (Array.length active-arr)]
            (for [i 0 len]
              (when @(Array.unsafe-nth active-arr i)
                (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                      scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                      pres @(Array.unsafe-nth (Array.unsafe-nth (FieldDatabase.entity-scalars db) 3) i)
                      to-pos (Vector3.sub pos inst-pos)
                      dist (Vector3.mag &to-pos)
                      d (- dist scale)
                      w-denom (+ (* d d) epsilon)
                      w (/ 1.0 w-denom)]
                  (do
                    (set! sum-S (+ sum-S (* pres w)))
                    (set! sum-W (+ sum-W w))
                    (when (> dist 0.00001)
                      (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                            grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                            grad-w (Vector3.mul &dir grad-w-mag)
                            grad-s (Vector3.mul &grad-w pres)]
                        (do
                          (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                          (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w))))))))))
          (let [grid (ptr->ref grid-ptr)
                aabb (AABB.init (Vector3.sub pos &(Vector3.init 0.01 0.01 0.01))
                                (Vector3.add pos &(Vector3.init 0.01 0.01 0.01)))
                candidates (SpatialGrid.query-unique grid &aabb)
                cand-len (Array.length &candidates)]
            (for [c 0 cand-len]
              (let [h-idx (the Int (Long.to-int (Uint32.to-long @(Array.unsafe-nth &candidates c))))
                    i (if (< h-idx (Array.length (EntityDatabase.handle-to-index edb)))
                          @(Array.unsafe-nth (EntityDatabase.handle-to-index edb) h-idx)
                          -1)]
                (when (>= i 0)
                  (when @(Array.unsafe-nth active-arr i)
                    (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                          scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                          pres @(Array.unsafe-nth (Array.unsafe-nth (FieldDatabase.entity-scalars db) 3) i)
                          to-pos (Vector3.sub pos inst-pos)
                          dist (Vector3.mag &to-pos)
                          d (- dist scale)
                          w-denom (+ (* d d) epsilon)
                          w (/ 1.0 w-denom)]
                      (do
                        (set! sum-S (+ sum-S (* pres w)))
                        (set! sum-W (+ sum-W w))
                        (when (> dist 0.00001)
                          (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                                grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                                grad-w (Vector3.mul &dir grad-w-mag)
                                grad-s (Vector3.mul &grad-w pres)]
                            (do
                              (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                              (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w)))))))))))))
        (if (> sum-W 0.00001)
          (let [term1 (Vector3.mul &sum-grad-S sum-W)
                term2 (Vector3.mul &sum-grad-W sum-S)
                num (Vector3.sub &term1 &term2)
                grad (Vector3.mul &num (/ 1.0 (* sum-W sum-W)))]
            grad)
          (Vector3.init 0.0 0.0 0.0)))))

  (sig calculate-pressure-gradient (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-pressure-gradient [db pos]
    (calculate-pressure-gradient-grid db pos (null-ptr)))

  (sig calculate-induced-velocity (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-induced-velocity [db pos]
    (let [edb (entity-db db)
          sum-vel (Vector3.init 0.0 0.0 0.0)
          sum-W 0.0
          active-arr (EntityDatabase.active edb)
          len (Array.length active-arr)
          epsilon 0.01]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) i)
                  scale @(Array.unsafe-nth (EntityDatabase.scales edb) i)
                  vel (Array.unsafe-nth (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) i)
                  to-pos (Vector3.sub pos inst-pos)
                  dist (Vector3.mag &to-pos)
                  d (- dist scale)
                  w-denom (+ (* d d) epsilon)
                  w (/ 1.0 w-denom)]
              (do
                (set! sum-vel (Vector3.add &sum-vel &(Vector3.mul vel w)))
                (set! sum-W (+ sum-W w))))))
        (if (> sum-W 0.00001)
          (Vector3.mul &sum-vel (/ 1.0 sum-W))
          (Vector3.init 0.0 0.0 0.0)))))

  (defn default-event-update [db-ptr handle ev dt]
    (let [db (voidptr->db-ref db-ptr)
          life @(FieldEvent.lifetime ev)
          max-life @(FieldEvent.max-lifetime ev)
          decay-factor (/ life max-life)
          pos (FieldEvent.pos ev)
          scale @(FieldEvent.scale ev)]
      (do
        (FieldDatabase.set-position! db handle @pos)
        (FieldDatabase.set-scale! db handle scale)
        (let [fields-arr (FieldEvent.fields ev)
              len (Array.length fields-arr)
              ent-idx (get-index-by-handle db handle)]
          (when (>= ent-idx 0)
            (for [i 0 len]
              (let [f (Array.unsafe-nth fields-arr i)
                    slot @(FieldInitialVal.slot f)
                    val (* @(FieldInitialVal.val f) decay-factor)]
                (set-scalar-field! db slot ent-idx val))))))))

  (defn dispatch-event! [db pos vel shape-type params start-scale max-scale growth-speed max-lifetime fields col update-fn]
    (let [edb (entity-db db)
          curr-id @(EntityDatabase.next-virtual-id edb)
          h-id (if (>= curr-id 1020) 512 curr-id)
          handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
          event (FieldEvent.init @pos @vel shape-type @params start-scale max-scale growth-speed max-lifetime max-lifetime @fields @col h-id update-fn)]
      (do
        (EntityDatabase.set-next-virtual-id! edb (inc h-id))
        (let [discard-idx (register-instance-generic! db &handle shape-type @params @pos (Quaternion.identity) start-scale -1 @col 1.0 fields (the (Maybe SDF) (Maybe.Nothing)))]
          ())
        (let [idx (get-index-by-handle db &handle)]
          (when (>= idx 0)
            (Array.aset! (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) idx @vel)))
        (Array.push-back! (EntityDatabase.events edb) event))))

  (defn rebuild-spatial-grid! [db]
    (EntityDatabase.rebuild-spatial-grid! (entity-db db)))

  (defn diffuse-velocity! [db dt]
    (let [edb (entity-db db)
          active-arr (EntityDatabase.active edb)
          num-entities (Array.length active-arr)
          vel-arr (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0)
          positions (EntityDatabase.positions edb)
          scales (EntityDatabase.scales edb)
          viscosity 0.4
          new-vels (Array.copy vel-arr)
          grid (EntityDatabase.spatial-grid edb)]
      (do
        (for [i 0 num-entities]
          (when @(Array.unsafe-nth active-arr i)
            (let [v-i (Array.unsafe-nth vel-arr i)
                  pos-i (Array.unsafe-nth positions i)
                  scale-i @(Array.unsafe-nth scales i)
                  friction 0.1
                  delta-vel (Vector3.mul v-i (neg (* friction dt)))
                  aabb (AABB.init (Vector3.sub pos-i &(Vector3.init scale-i scale-i scale-i))
                                  (Vector3.add pos-i &(Vector3.init scale-i scale-i scale-i)))
                  candidates (SpatialGrid.query-unique grid &aabb)
                  num-cand (Array.length &candidates)]
              (do
                (for [k 0 num-cand]
                  (let [j @(Array.unsafe-nth &candidates k)]
                    (when (and (/= i j) @(Array.unsafe-nth active-arr j))
                      (let [v-j (Array.unsafe-nth vel-arr j)
                            pos-j (Array.unsafe-nth positions j)
                            scale-j @(Array.unsafe-nth scales j)
                            to-j (Vector3.sub pos-j pos-i)
                            dist (Vector3.mag &to-j)
                            max-dist (+ scale-i scale-j)]
                        (when (< dist max-dist)
                          (let [factor (- 1.0 (/ dist max-dist))
                                diff (Vector3.sub v-j v-i)
                                transfer (Vector3.mul &diff (* factor dt))]
                            (set! delta-vel (Vector3.add &delta-vel &(Vector3.mul &transfer viscosity)))))))))
                (Array.aset! &new-vels i (Vector3.add v-i &delta-vel))))))
        (for [i 0 num-entities]
          (Array.aset! vel-arr i @(Array.unsafe-nth &new-vels i))))))

  (defn tick! [db dt]
    (let [db (the (Ref FieldDatabase) db)
          edb (entity-db db)
          ev-arr (EntityDatabase.events edb)
          len (Array.length ev-arr)
          keep-ev []]
      (do
        (EntityDatabase.rebuild-spatial-grid! edb)
        (diffuse-velocity! db dt)

        (for [i 0 len]
          (let [ev @(Array.unsafe-nth ev-arr i)
                h-id @(FieldEvent.handle-id &ev)
                handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
                life (- @(FieldEvent.lifetime &ev) dt)
                max-life @(FieldEvent.max-lifetime &ev)
                pos (FieldEvent.pos &ev)
                vel (FieldEvent.velocity &ev)
                new-pos (Vector3.add pos &(Vector3.mul vel dt))
                grow @(FieldEvent.growth-speed &ev)
                scale @(FieldEvent.scale &ev)
                max-sc @(FieldEvent.max-scale &ev)
                new-scale (let [s (+ scale (* grow dt))]
                            (if (> s max-sc) max-sc s))]
            (if (> life 0.0)
                (let [updated-ev (FieldEvent.init @&new-pos @vel @(FieldEvent.shape-type &ev) @(FieldEvent.params &ev) new-scale max-sc grow life max-life @(FieldEvent.fields &ev) @(FieldEvent.color &ev) h-id @(FieldEvent.update-fn &ev))]
                  (do
                    ;; Execute the custom callback function
                    (let [db-ptr (ptr-cast (Pointer.address db))]
                      (@(FieldEvent.update-fn &ev) db-ptr &handle &updated-ev dt))
                    (Array.push-back! &keep-ev updated-ev)))
                (FieldDatabase.release-instance! db &handle))))
        (EntityDatabase.set-events! edb keep-ev)
        
        ;; Dynamic kernel updates
        (let [updates-arr (FieldDatabase.kernel-updates db)
              num-updates (Array.length updates-arr)
              db-ptr (ptr-cast (Pointer.address db))]
          (for [u-idx 0 num-updates]
            (let [ku (Array.unsafe-nth updates-arr u-idx)
                  update-fn (KernelUpdate.func ku)]
              (@update-fn db-ptr dt))))))
))
