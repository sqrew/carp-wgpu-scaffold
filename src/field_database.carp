(deftemplate ptr->ref (Fn [(Ptr t)] (Ref t))
  "$t* $NAME($t* p)"
  "$DECL { return p; }")

(deftemplate null-ptr (Fn [] (Ptr t))
  "$t* $NAME()"
  "$DECL { return NULL; }")

(deftype Vector4 [x Double y Double z Double w Double])
(defmodule Vector4
  (defn init-zero [] (Vector4.init 0.0 0.0 0.0 0.0))
)

(deftype FieldEvent [
  pos (Vector3 Double)
  velocity (Vector3 Double)
  shape-type Int
  params Vector4
  scale Double
  max-scale Double
  growth-speed Double
  lifetime Double
  max-lifetime Double
  temperature Double
  pressure Double
  color (Vector3 Double)
  handle-id Int
  update-fn (Fn [(Ref FieldDatabase) (Ref (Handle ())) (Ref FieldEvent) Double] ())
])

(deftype FieldDatabase [
  active (Array Bool)
  handles (Array (Handle ()))
  shape-types (Array Int)
  params (Array Vector4)
  positions (Array (Vector3 Double))
  rotations (Array Quaternion)
  scales (Array Double)
  root-csg-indices (Array Int)
  colors (Array (Vector3 Double))
  scalar-fields (Array (Array Double))
  vector-fields (Array (Array (Vector3 Double)))
  sdfs (Array (Maybe SDF))
  handle-to-index (Array Int)
  max-scale Double
  events (Array FieldEvent)
  next-virtual-id Int
])

(defmodule FieldDatabase
  (use Array)
  (use Vector3)
  (use Quaternion)
  (use SpatialGrid)

  (defn ensure-capacity! [arr size default-val]
    (while (< (Array.length arr) size)
      (Array.push-back! arr default-val)))

  (defn new []
    (let [n 128
          act (the (Array Bool) (replicate n &false))
          hnd (the (Array (Handle ())) (replicate n &(Handle.init (Uint64.from-long 0l) (Uint32.from-long 0l))))
          st (the (Array Int) (replicate n &-1))
          pm (the (Array Vector4) (replicate n &(Vector4.init-zero)))
          pos (the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))
          rot (the (Array Quaternion) (replicate n &(Quaternion.identity)))
          sc (the (Array Double) (replicate n &1.0))
          csg (the (Array Int) (replicate n &-1))
          col (the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))
          sc-fields [(the (Array Double) (replicate n &0.0))    ;; temp
                     (the (Array Double) (replicate n &0.0))    ;; age
                     (the (Array Double) (replicate n &0.0))    ;; hum
                     (the (Array Double) (replicate n &0.0))    ;; pres
                     (the (Array Double) (replicate n &0.0))    ;; charge
                     (the (Array Double) (replicate n &-999.0)) ;; gravity
                     (the (Array Double) (replicate n &1.0))]   ;; influence
          vec-fields [(the (Array (Vector3 Double)) (replicate n &(Vector3.init 0.0 0.0 0.0)))]
          sdfs (the (Array (Maybe SDF)) (replicate n &(Maybe.Nothing)))
          h-to-idx (the (Array Int) (replicate 1024 &-1))]
      (FieldDatabase.init act hnd st pm pos rot sc csg col sc-fields vec-fields sdfs h-to-idx 4.0 [] 512)))
  (sig new (Fn [] FieldDatabase))
  (sig get-index-by-handle (Fn [(Ref FieldDatabase) (Ref (Handle ()))] Int))
  (sig register-instance! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Int Vector4 (Vector3 Double) Quaternion Double Int (Vector3 Double) Double Double Double Double Double Double (Vector3 Double) Double (Maybe SDF)] Int))
  (sig release-instance! (Fn [(Ref FieldDatabase) (Ref (Handle ()))] ()))
  (sig set-scale! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-velocity! (Fn [(Ref FieldDatabase) (Ref (Handle ())) (Vector3 Double)] ()))
  (sig set-pressure! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-gravity! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-temperature! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-position! (Fn [(Ref FieldDatabase) (Ref (Handle ())) (Vector3 Double)] ()))
  (sig set-rotation! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Quaternion] ()))
  (sig set-age! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-humidity! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-charge! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-influence! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Double] ()))
  (sig set-root-csg-index! (Fn [(Ref FieldDatabase) (Ref (Handle ())) Int] ()))

  (defn get-index-by-handle [db handle]
    (let [h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
      (if (< h-idx (Array.length (FieldDatabase.handle-to-index db)))
          @(Array.unsafe-nth (FieldDatabase.handle-to-index db) h-idx)
          -1)))

  (defn register-instance! [db handle shape-type-val params-val pos-val rot-val scale-val csg-idx-val color-val temp-val age-val hum-val pres-val charge-val gravity-val vel-val influence-val sdf-val]
    (let [found-idx -1
          active-arr (FieldDatabase.active db)
          handles-arr (FieldDatabase.handles db)
          len (Array.length active-arr)]
      (do
        (for [i 0 len]
          (when (not @(Array.unsafe-nth active-arr i))
            (when (= found-idx -1)
              (set! found-idx i))))
        (when (= found-idx -1)
          (do
            (Array.push-back! active-arr false)
            (Array.push-back! handles-arr (Handle.init (Uint64.from-long 0l) (Uint32.from-long 0l)))
            (Array.push-back! (FieldDatabase.shape-types db) -1)
            (Array.push-back! (FieldDatabase.params db) (Vector4.init-zero))
            (Array.push-back! (FieldDatabase.positions db) (Vector3.init 0.0 0.0 0.0))
            (Array.push-back! (FieldDatabase.rotations db) (Quaternion.identity))
            (Array.push-back! (FieldDatabase.scales db) 1.0)
            (Array.push-back! (FieldDatabase.root-csg-indices db) -1)
            (Array.push-back! (FieldDatabase.colors db) (Vector3.init 0.0 0.0 0.0))
            (for [f 0 (Array.length (FieldDatabase.scalar-fields db))]
              (let [arr (Array.unsafe-nth (FieldDatabase.scalar-fields db) f)
                    def-val (if (= f 5) -999.0 (if (= f 6) 1.0 0.0))]
                (Array.push-back! arr def-val)))
            (for [f 0 (Array.length (FieldDatabase.vector-fields db))]
              (let [arr (Array.unsafe-nth (FieldDatabase.vector-fields db) f)]
                (Array.push-back! arr (Vector3.init 0.0 0.0 0.0))))
            (Array.push-back! (FieldDatabase.sdfs db) (Maybe.Nothing))
            (set! found-idx len)))
        (Array.aset! active-arr found-idx true)
        (Array.aset! handles-arr found-idx @handle)
        (Array.aset! (FieldDatabase.shape-types db) found-idx shape-type-val)
        (Array.aset! (FieldDatabase.params db) found-idx params-val)
        (Array.aset! (FieldDatabase.positions db) found-idx pos-val)
        (Array.aset! (FieldDatabase.rotations db) found-idx rot-val)
        (Array.aset! (FieldDatabase.scales db) found-idx scale-val)
        (Array.aset! (FieldDatabase.root-csg-indices db) found-idx csg-idx-val)
        (Array.aset! (FieldDatabase.colors db) found-idx color-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 0) found-idx temp-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 1) found-idx age-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 2) found-idx hum-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 3) found-idx pres-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 4) found-idx charge-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 5) found-idx gravity-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 6) found-idx influence-val)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.vector-fields db) 0) found-idx vel-val)
        (Array.aset! (FieldDatabase.sdfs db) found-idx sdf-val)
        (let [h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
          (do
            (ensure-capacity! (FieldDatabase.handle-to-index db) (inc h-idx) -1)
            (Array.aset! (FieldDatabase.handle-to-index db) h-idx found-idx)
            (let [ms (FieldDatabase.max-scale db)]
              (when (> scale-val @ms)
                (FieldDatabase.set-max-scale! db scale-val)))
            found-idx)))))

  (defn release-instance! [db handle]
    (let [id (get-index-by-handle db handle)
          h-idx (the Int (Long.to-int (Uint64.to-long (Handle.index handle))))]
      (do
        (when (>= id 0)
          (do
            (Array.aset! (FieldDatabase.active db) id false)
            (Array.aset! (FieldDatabase.shape-types db) id -1)
            (for [f 0 (Array.length (FieldDatabase.scalar-fields db))]
              (let [arr (Array.unsafe-nth (FieldDatabase.scalar-fields db) f)
                    def-val (if (= f 5) -999.0 (if (= f 6) 1.0 0.0))]
                (Array.aset! arr id def-val)))
            (for [f 0 (Array.length (FieldDatabase.vector-fields db))]
              (let [arr (Array.unsafe-nth (FieldDatabase.vector-fields db) f)]
                (Array.aset! arr id (Vector3.init 0.0 0.0 0.0))))
            (Array.aset! (FieldDatabase.sdfs db) id (Maybe.Nothing))))
        (when (< h-idx (Array.length (FieldDatabase.handle-to-index db)))
          (Array.aset! (FieldDatabase.handle-to-index db) h-idx -1)))))

  (defn set-scale! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (do
          (Array.aset! (FieldDatabase.scales db) id val)
          (let [ms (FieldDatabase.max-scale db)]
            (when (> val @ms)
              (FieldDatabase.set-max-scale! db val)))))))

  (defn set-velocity! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.vector-fields db) 0) id val))))

  (defn set-pressure! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 3) id val))))

  (defn set-gravity! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 5) id val))))

  (defn set-temperature! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 0) id val))))

  (defn set-position! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (FieldDatabase.positions db) id val))))

  (defn set-rotation! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (FieldDatabase.rotations db) id val))))

  (defn set-age! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 1) id val))))

  (defn set-humidity! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 2) id val))))

  (defn set-charge! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 4) id val))))

  (defn set-influence! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (Array.unsafe-nth (FieldDatabase.scalar-fields db) 6) id val))))

  (defn set-root-csg-index! [db handle val]
    (let [id (get-index-by-handle db handle)]
      (when (>= id 0)
        (Array.aset! (FieldDatabase.root-csg-indices db) id val))))

  (defn sd-sphere [p s]
    (- (Vector3.mag p) s))

  (defn max-double [a b] (if (> a b) a b))
  (defn min-double [a b] (if (< a b) a b))

  (defn sd-box [p b]
    (let [qx (- (Double.abs @(Vector3.x p)) @(Vector3.x b))
          qy (- (Double.abs @(Vector3.y p)) @(Vector3.y b))
          qz (- (Double.abs @(Vector3.z p)) @(Vector3.z b))
          max-q (max-double qx (max-double qy qz))
          outside (Vector3.init (max-double qx 0.0) (max-double qy 0.0) (max-double qz 0.0))
          dist-outside (Vector3.mag &outside)
          dist-inside (min-double max-q 0.0)]
      (+ dist-outside dist-inside)))

  (defn sd-cylinder [p r h]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          dx (- xz-len r)
          dy (- (Double.abs @(Vector3.y p)) h)
          outside-x (max-double dx 0.0)
          outside-y (max-double dy 0.0)
          outside (Double.sqrt (+ (* outside-x outside-x) (* outside-y outside-y)))
          inside (min-double (max-double dx dy) 0.0)]
      (+ outside inside)))

  (defn sd-capsule [p r h]
    (let [py (Double.clamp (- 0.0 h) h @(Vector3.y p))
          p-caps (Vector3.init 0.0 py 0.0)
          diff (Vector3.sub p &p-caps)]
      (- (Vector3.mag &diff) r)))

  (defn sd-torus [p R r]
    (let [xz-len (Double.sqrt (+ (* @(Vector3.x p) @(Vector3.x p)) (* @(Vector3.z p) @(Vector3.z p))))
          q (Vector2.init (- xz-len R) @(Vector3.y p))
          q-len (Double.sqrt (+ (* @(Vector2.x &q) @(Vector2.x &q)) (* @(Vector2.y &q) @(Vector2.y &q))))]
      (- q-len r)))

  (defn sd-octahedron [p s]
    (let [qx (Double.abs @(Vector3.x p))
          qy (Double.abs @(Vector3.y p))
          qz (Double.abs @(Vector3.z p))]
      (* (- (+ qx (+ qy qz)) s) 0.57735027)))

  (defn evaluate-csg-primitive [p shape-type pos rot scale params]
    (let [inv-rot (Quaternion.conjugate rot)
          local-p (Quaternion.rotate &inv-rot &(Vector3.sub p pos))
          d 10000.0]
      (do
        (when (= shape-type 1)
          (set! d (sd-sphere &local-p (* @(Vector4.x params) scale))))
        (when (= shape-type 2)
          (let [b (Vector3.init (* @(Vector4.x params) scale) (* @(Vector4.y params) scale) (* @(Vector4.z params) scale))]
            (set! d (sd-box &local-p &b))))
        (when (= shape-type 3)
          (set! d (sd-cylinder &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 4)
          (set! d (sd-capsule &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 5)
          (set! d (sd-torus &local-p (* @(Vector4.x params) scale) (* @(Vector4.y params) scale))))
        (when (= shape-type 6)
          (set! d (sd-octahedron &local-p (* @(Vector4.x params) scale))))
        d)))

  (sig evaluate-scene-sdf-material (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector2 Double)))
  (defn evaluate-scene-sdf-material [db pos]
    (let [active (FieldDatabase.active db)
          len (Array.length active)
          min-d 10000.0
          mat-id 0.0]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active i)
            (let [inst-d (match-ref (Array.unsafe-nth (FieldDatabase.sdfs db) i)
                           (Maybe.Just sdf) (SDF.distance-world sdf pos)
                           (Maybe.Nothing)
                             (let [shape-type @(Array.unsafe-nth (FieldDatabase.shape-types db) i)
                                   params (Array.unsafe-nth (FieldDatabase.params db) i)
                                   inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                                   rot (Array.unsafe-nth (FieldDatabase.rotations db) i)
                                   scale @(Array.unsafe-nth (FieldDatabase.scales db) i)]
                               (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
              (when (< inst-d min-d)
                (do
                  (set! min-d inst-d)
                  (set! mat-id (Double.from-int (inc i))))))))
        (Vector2.init min-d mat-id))))
 
  (defn get-shape-bounding-radius [shape-type scale params]
    (if (= shape-type 1)
        (* @(Vector4.x params) scale) ;; Sphere
        (if (= shape-type 2)
            (let [bx (* @(Vector4.x params) scale)
                  by (* @(Vector4.y params) scale)
                  bz (* @(Vector4.z params) scale)]
              (Double.sqrt (+ (* bx bx) (+ (* by by) (* bz bz))))) ;; Box
            (if (= shape-type 3)
                (let [r (* @(Vector4.x params) scale)
                      h (* @(Vector4.y params) scale)]
                  (Double.sqrt (+ (* r r) (* h h)))) ;; Cylinder
                (if (= shape-type 4)
                    (let [r (* @(Vector4.x params) scale)
                          h (* @(Vector4.y params) scale)]
                      (+ r h)) ;; Capsule
                    (if (= shape-type 5)
                        (let [R-torus (* @(Vector4.x params) scale)
                              r-torus (* @(Vector4.y params) scale)]
                          (+ R-torus r-torus)) ;; Torus
                        (if (= shape-type 6)
                            (* @(Vector4.x params) scale) ;; Octahedron
                            0.0)))))))
 
  (defn evaluate-scene-sdf-material-subset [db pos indices-ref]
    (let [len (Array.length indices-ref)
          min-d 10000.0
          mat-id 0.0]
      (do
        (for [k 0 len]
          (let [i @(Array.unsafe-nth indices-ref k)
                inst-d (match-ref (Array.unsafe-nth (FieldDatabase.sdfs db) i)
                          (Maybe.Just sdf) (SDF.distance-world sdf pos)
                          (Maybe.Nothing)
                            (let [shape-type @(Array.unsafe-nth (FieldDatabase.shape-types db) i)
                                  params (Array.unsafe-nth (FieldDatabase.params db) i)
                                  inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                                  rot (Array.unsafe-nth (FieldDatabase.rotations db) i)
                                  scale @(Array.unsafe-nth (FieldDatabase.scales db) i)]
                              (evaluate-csg-primitive pos shape-type inst-pos rot scale params)))]
            (when (< inst-d min-d)
              (do
                (set! min-d inst-d)
                (set! mat-id (Double.from-int (inc i)))))))
        (Vector2.init min-d mat-id))))

  (sig calculate-pressure-gradient-grid (Fn [(Ref FieldDatabase) (Ref (Vector3 Double)) (Ptr (SpatialGrid Uint32))] (Vector3 Double)))
  (defn calculate-pressure-gradient-grid [db pos grid-ptr]
    (let [sum-grad-S (Vector3.init 0.0 0.0 0.0)
          sum-grad-W (Vector3.init 0.0 0.0 0.0)
          sum-S 0.0
          sum-W 0.0
          active-arr (FieldDatabase.active db)
          epsilon 0.01]
      (do
        (if (null? grid-ptr)
          (let [len (Array.length active-arr)]
            (for [i 0 len]
              (when @(Array.unsafe-nth active-arr i)
                (let [inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                      scale @(Array.unsafe-nth (FieldDatabase.scales db) i)
                      pres @(Array.unsafe-nth (Array.unsafe-nth (FieldDatabase.scalar-fields db) 3) i)
                      to-pos (Vector3.sub pos inst-pos)
                      dist (Vector3.mag &to-pos)
                      d (- dist scale)
                      w-denom (+ (* d d) epsilon)
                      w (/ 1.0 w-denom)]
                  (do
                    (set! sum-S (+ sum-S (* pres w)))
                    (set! sum-W (+ sum-W w))
                    (when (> dist 0.00001)
                      (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                            grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                            grad-w (Vector3.mul &dir grad-w-mag)
                            grad-s (Vector3.mul &grad-w pres)]
                        (do
                          (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                          (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w))))))))))
          (let [grid (ptr->ref grid-ptr)
                aabb (AABB.init (Vector3.sub pos &(Vector3.init 0.01 0.01 0.01))
                                (Vector3.add pos &(Vector3.init 0.01 0.01 0.01)))
                candidates (SpatialGrid.query-unique grid &aabb)
                cand-len (Array.length &candidates)]
            (for [c 0 cand-len]
              (let [h-idx (the Int (Long.to-int (Uint32.to-long @(Array.unsafe-nth &candidates c))))
                    i (if (< h-idx (Array.length (FieldDatabase.handle-to-index db)))
                          @(Array.unsafe-nth (FieldDatabase.handle-to-index db) h-idx)
                          -1)]
                (when (>= i 0)
                  (when @(Array.unsafe-nth active-arr i)
                    (let [inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                          scale @(Array.unsafe-nth (FieldDatabase.scales db) i)
                          pres @(Array.unsafe-nth (Array.unsafe-nth (FieldDatabase.scalar-fields db) 3) i)
                          to-pos (Vector3.sub pos inst-pos)
                          dist (Vector3.mag &to-pos)
                          d (- dist scale)
                          w-denom (+ (* d d) epsilon)
                          w (/ 1.0 w-denom)]
                      (do
                        (set! sum-S (+ sum-S (* pres w)))
                        (set! sum-W (+ sum-W w))
                        (when (> dist 0.00001)
                          (let [dir (Vector3.mul &to-pos (/ 1.0 dist))
                                grad-w-mag (/ (* -2.0 d) (* w-denom w-denom))
                                grad-w (Vector3.mul &dir grad-w-mag)
                                grad-s (Vector3.mul &grad-w pres)]
                            (do
                              (set! sum-grad-S (Vector3.add &sum-grad-S &grad-s))
                              (set! sum-grad-W (Vector3.add &sum-grad-W &grad-w)))))))))))))
        (if (> sum-W 0.00001)
          (let [term1 (Vector3.mul &sum-grad-S sum-W)
                term2 (Vector3.mul &sum-grad-W sum-S)
                num (Vector3.sub &term1 &term2)
                grad (Vector3.mul &num (/ 1.0 (* sum-W sum-W)))]
            grad)
          (Vector3.init 0.0 0.0 0.0)))))

  (sig calculate-pressure-gradient (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-pressure-gradient [db pos]
    (calculate-pressure-gradient-grid db pos (null-ptr)))

  (sig calculate-induced-velocity (Fn [(Ref FieldDatabase) (Ref (Vector3 Double))] (Vector3 Double)))
  (defn calculate-induced-velocity [db pos]
    (let [sum-vel (Vector3.init 0.0 0.0 0.0)
          sum-W 0.0
          active-arr (FieldDatabase.active db)
          len (Array.length active-arr)
          epsilon 0.01]
      (do
        (for [i 0 len]
          (when @(Array.unsafe-nth active-arr i)
            (let [inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                  scale @(Array.unsafe-nth (FieldDatabase.scales db) i)
                  vel (Array.unsafe-nth (Array.unsafe-nth (FieldDatabase.vector-fields db) 0) i)
                  to-pos (Vector3.sub pos inst-pos)
                  dist (Vector3.mag &to-pos)
                  d (- dist scale)
                  w-denom (+ (* d d) epsilon)
                  w (/ 1.0 w-denom)]
              (do
                (set! sum-vel (Vector3.add &sum-vel &(Vector3.mul vel w)))
                (set! sum-W (+ sum-W w))))))
        (if (> sum-W 0.00001)
          (Vector3.mul &sum-vel (/ 1.0 sum-W))
          (Vector3.init 0.0 0.0 0.0)))))

  (defn default-event-update [db handle ev dt]
    (let [life @(FieldEvent.lifetime ev)
          max-life @(FieldEvent.max-lifetime ev)
          decay-factor (/ life max-life)
          pos (FieldEvent.pos ev)
          scale @(FieldEvent.scale ev)
          temp (* @(FieldEvent.temperature ev) decay-factor)
          pres (* @(FieldEvent.pressure ev) decay-factor)]
      (do
        (FieldDatabase.set-position! db handle @pos)
        (FieldDatabase.set-scale! db handle scale)
        (FieldDatabase.set-temperature! db handle temp)
        (FieldDatabase.set-pressure! db handle pres))))

  (defn dispatch-event! [db pos vel shape-type params start-scale max-scale growth-speed max-lifetime temp pres col update-fn]
    (let [curr-id @(FieldDatabase.next-virtual-id db)
          h-id (if (>= curr-id 1020) 512 curr-id)
          handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
          event (FieldEvent.init @pos @vel shape-type @params start-scale max-scale growth-speed max-lifetime max-lifetime temp pres @col h-id update-fn)]
      (do
        (FieldDatabase.set-next-virtual-id! db (inc h-id))
        (ignore (register-instance! db &handle shape-type @params @pos (Quaternion.identity) start-scale -1 @col temp 0.0 0.0 pres 0.0 -999.0 @vel 1.0 (Maybe.Nothing)))
        (Array.push-back! (FieldDatabase.events db) event))))

  (defn tick! [db dt]
    (let [ev-arr (FieldDatabase.events db)
          len (Array.length ev-arr)
          keep-ev []]
      (do
        (for [i 0 len]
          (let [ev @(Array.unsafe-nth ev-arr i)
                h-id @(FieldEvent.handle-id &ev)
                handle (Handle.init (Uint64.from-long (Long.from-int h-id)) (Uint32.from-long 1l))
                life (- @(FieldEvent.lifetime &ev) dt)
                max-life @(FieldEvent.max-lifetime &ev)
                pos (FieldEvent.pos &ev)
                vel (FieldEvent.velocity &ev)
                new-pos (Vector3.add pos &(Vector3.mul vel dt))
                grow @(FieldEvent.growth-speed &ev)
                scale @(FieldEvent.scale &ev)
                max-sc @(FieldEvent.max-scale &ev)
                new-scale (let [s (+ scale (* grow dt))]
                            (if (> s max-sc) max-sc s))]
            (if (> life 0.0)
                (let [updated-ev (FieldEvent.init @&new-pos @vel @(FieldEvent.shape-type &ev) @(FieldEvent.params &ev) new-scale max-sc grow life max-life @(FieldEvent.temperature &ev) @(FieldEvent.pressure &ev) @(FieldEvent.color &ev) h-id @(FieldEvent.update-fn &ev))]
                  (do
                    ;; Execute the custom callback function
                    (@(FieldEvent.update-fn &ev) db &handle &updated-ev dt)
                    (Array.push-back! &keep-ev updated-ev)))
                (FieldDatabase.release-instance! db &handle))))
        (FieldDatabase.set-events! db keep-ev))))
)
