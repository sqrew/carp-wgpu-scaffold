;; src/shaders.carp

(defmodule Shaders
  (use Pattern)

  (defn replace-all [s pat-str repl-str]
    (Pattern.substitute &(Pattern.init pat-str) s repl-str -1))

  (defn shader-wgsl [limit max-ids ray-steps shadow-steps voxel-res]
    (let [log-res (Double.to-int (/ (Double.log (Double.from-int voxel-res)) (Double.log 2.0)))
          slots-per-dim (/ 384 voxel-res)
          slots-per-dim-sq (* slots-per-dim slots-per-dim)
          voxel-cell-size (/ 32.0 (Double.from-int voxel-res))
          
          limit-str (Int.str limit)
          max-ids-str (Int.str max-ids)
          ray-steps-str (Int.str ray-steps)
          shadow-steps-str (Int.str shadow-steps)
          log-res-str (Int.str log-res)
          voxel-res-sub-1-str (Int.str (- voxel-res 1))
          slots-per-dim-str (Int.str slots-per-dim)
          slots-per-dim-sq-str (Int.str slots-per-dim-sq)
          voxel-res-str (Int.str voxel-res)
          voxel-cell-size-str (Double.str voxel-cell-size)]
      (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/raymarch.wgsl")
        (Result.Success src)
          (let [s1 (replace-all &src "\\{\\{LIMIT\\}\\}" &limit-str)
                s2 (replace-all &s1 "\\{\\{MAX_IDS\\}\\}" &max-ids-str)
                s3 (replace-all &s2 "\\{\\{RAY_STEPS\\}\\}" &ray-steps-str)
                s4 (replace-all &s3 "\\{\\{SHADOW_STEPS\\}\\}" &shadow-steps-str)
                s5 (replace-all &s4 "\\{\\{LOG_RES\\}\\}" &log-res-str)
                s6 (replace-all &s5 "\\{\\{VOXEL_RES_SUB_1\\}\\}" &voxel-res-sub-1-str)
                s7 (replace-all &s6 "\\{\\{SLOTS_PER_DIM\\}\\}" &slots-per-dim-str)
                s8 (replace-all &s7 "\\{\\{SLOTS_PER_DIM_SQ\\}\\}" &slots-per-dim-sq-str)
                s9 (replace-all &s8 "\\{\\{VOXEL_RES\\}\\}" &voxel-res-str)
                s10 (replace-all &s9 "\\{\\{VOXEL_CELL_SIZE\\}\\}" &voxel-cell-size-str)]
            s10)
        (Result.Error err)
          (do
            (IO.println &(str* "Error reading raymarch.wgsl: " &err))
            @""))))

  (defn carve-shader [voxel-res]
    (let [res-str (Int.str voxel-res)
          total-str (Int.str (* voxel-res (* voxel-res voxel-res)))]
      (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/carve.wgsl")
        (Result.Success src)
          (let [s1 (replace-all &src "\\{\\{VOXEL_RES\\}\\}" &res-str)
                s2 (replace-all &s1 "\\{\\{TOTAL_VOXELS\\}\\}" &total-str)]
            s2)
        (Result.Error err)
          (do
            (IO.println &(str* "Error reading carve.wgsl: " &err))
            @""))))

  (defn field-splat-shader [voxel-res]
    (let [res-str (Int.str voxel-res)
          total-str (Int.str (* voxel-res (* voxel-res voxel-res)))]
      (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/field_splat.wgsl")
        (Result.Success src)
          (let [s1 (replace-all &src "\\{\\{VOXEL_RES\\}\\}" &res-str)
                s2 (replace-all &s1 "\\{\\{TOTAL_VOXELS\\}\\}" &total-str)]
            s2)
        (Result.Error err)
          (do
            (IO.println &(str* "Error reading field_splat.wgsl: " &err))
            @""))))

  (defn pack-shader [voxel-res]
    (let [total-str (Int.str (* voxel-res (* voxel-res voxel-res)))]
      (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/pack.wgsl")
        (Result.Success src)
          (replace-all &src "\\{\\{TOTAL_VOXELS\\}\\}" &total-str)
        (Result.Error err)
          (do
            (IO.println &(str* "Error reading pack.wgsl: " &err))
            @""))))
)
