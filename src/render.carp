;; render.carp

(use WGPU)
(use WGPURender)
(use Camera)
(use Transform)
(use RigidBody)
(use LinePass)
(use GPUSpatial)
(use ECS)

(register wgpu-create-render-two-storage-uniform-bind-group
  (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper) WGPUBuffer WGPUBuffer (Ptr WGPUUniformBufferWrapper)] WGPUBindGroup)
  "wgpu_create_render_two_storage_uniform_bind_group")

(deftype WGPURenderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  u-buffer (Ptr WGPUUniformBufferWrapper)
  s-buffer WGPUBuffer
  csg-buffer WGPUBuffer
  bind-group WGPUBindGroup
  depth-texture (Ptr WGPUDepthTexture)
  line-pass LinePassRenderer
  commands (Array RenderCommand)
  u-data (Array Float)
  s-data (Array Float)
  csg-data (Array Float)
])

(defmodule WGPURenderer
  (def max-spheres 128)
  (def max-ids-per-cell 16)
  (def header-size 128)
  (def sphere-data-size 48)

  (sig float-from-int (Fn [Int] Float))
  (defn float-from-int [x]
    (Double.to-float (Double.from-int x)))

  (sig write-csg-node-raw! (Fn [(Ref (Array Float)) Int Int Int Int Int (Ref (Vector3 Double)) Double (Ref Quaternion) Double Double Double Double] ()))
  (defn write-csg-node-raw! [csg-data idx shape-type op-type left-child right-child pos scale rot p0 p1 p2 p3]
    (let [base (* idx 16)]
      (do
        (Array.aset! csg-data base (WGPURenderer.float-from-int shape-type))
        (Array.aset! csg-data (+ base 1) (WGPURenderer.float-from-int op-type))
        (Array.aset! csg-data (+ base 2) (WGPURenderer.float-from-int left-child))
        (Array.aset! csg-data (+ base 3) (WGPURenderer.float-from-int right-child))
        (Array.aset! csg-data (+ base 4) (Double.to-float @(Vector3.x pos)))
        (Array.aset! csg-data (+ base 5) (Double.to-float @(Vector3.y pos)))
        (Array.aset! csg-data (+ base 6) (Double.to-float @(Vector3.z pos)))
        (Array.aset! csg-data (+ base 7) (Double.to-float scale))
        (Array.aset! csg-data (+ base 8) (Double.to-float @(Quaternion.x rot)))
        (Array.aset! csg-data (+ base 9) (Double.to-float @(Quaternion.y rot)))
        (Array.aset! csg-data (+ base 10) (Double.to-float @(Quaternion.z rot)))
        (Array.aset! csg-data (+ base 11) (Double.to-float @(Quaternion.w rot)))
        (Array.aset! csg-data (+ base 12) (Double.to-float p0))
        (Array.aset! csg-data (+ base 13) (Double.to-float p1))
        (Array.aset! csg-data (+ base 14) (Double.to-float p2))
        (Array.aset! csg-data (+ base 15) (Double.to-float p3)))))

  (sig serialize-primitive! (Fn [(Ref SDF) (Ref (Array Float)) Int Bool] ()))
  (defn serialize-primitive! [sdf csg-data idx is-root]
    (let [base-shape (SDF.base sdf)
          pos (if is-root &(Vector3.init 0.0 0.0 0.0) (SDF.position sdf))
          rot (if is-root &(Quaternion.identity) (SDF.rotation sdf))
          scale @(SDF.scale sdf)
          shape-type 0
          p0 0.0
          p1 0.0
          p2 0.0
          p3 0.0]
      (do
        (match-ref base-shape
          (BaseShape.Ball r)
            (do
              (set! shape-type 1)
              (set! p0 @r))
          (BaseShape.Box e)
            (do
              (set! shape-type 2)
              (set! p0 @(Vector3.x e))
              (set! p1 @(Vector3.y e))
              (set! p2 @(Vector3.z e)))
          (BaseShape.Cylinder r h)
            (do
              (set! shape-type 3)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Capsule r h)
            (do
              (set! shape-type 4)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Torus rad-maj rad-min)
            (do
              (set! shape-type 5)
              (set! p0 @rad-maj)
              (set! p1 @rad-min))
          (BaseShape.Octahedron s)
            (do
              (set! shape-type 6)
              (set! p0 @s))
          _ ())
        (write-csg-node-raw! csg-data idx shape-type 0 -1 -1 pos scale rot p0 p1 p2 p3))))

  (sig serialize-sdf! (Fn [(Ref SDF) (Ref (Array Float)) (Ptr Int) Bool] Int))
  (defn serialize-sdf! [sdf csg-data next-idx-ptr is-root]
    (let [nodes (SDF.csg-nodes sdf)
          num-nodes (Array.length nodes)
          zero-v (Vector3.init 0.0 0.0 0.0)
          ident-q (Quaternion.identity)]
      (if (= num-nodes 0)
        (let [curr-idx (Pointer.to-value next-idx-ptr)]
          (do
            (serialize-primitive! sdf csg-data curr-idx is-root)
            (Pointer.set next-idx-ptr (+ curr-idx 1))
            curr-idx))
        (let [curr-lhs (let [curr-idx (Pointer.to-value next-idx-ptr)]
                         (do
                           (serialize-primitive! sdf csg-data curr-idx is-root)
                           (Pointer.set next-idx-ptr (+ curr-idx 1))
                           curr-idx))]
          (do
            (for [i 0 num-nodes]
              (let [child-node (Array.unsafe-nth nodes i)
                    child-op @(CsgNode.op child-node)
                    child-sdf (Box.peek (CsgNode.shape child-node))
                    child-idx (serialize-sdf! child-sdf csg-data next-idx-ptr false)
                    op-idx (Pointer.to-value next-idx-ptr)]
                (do
                  (write-csg-node-raw! csg-data op-idx 0 child-op curr-lhs child-idx
                    &zero-v 1.0 &ident-q 0.0 0.0 0.0 0.0)
                  (Pointer.set next-idx-ptr (+ op-idx 1))
                  (set! curr-lhs op-idx))))
            curr-lhs)))))

  (defn shader-wgsl [limit max-ids]
    (str*
      "struct SphereData {
          pos: vec4<f32>,
          rot: vec4<f32>,
          color: vec4<f32>,
      }
      struct Cell {
          header: vec4<f32>,
          ids: array<vec4<f32>, " (Int.str (/ max-ids 4)) ">,
      }
      struct Uniforms { 
          time: f32, 
          width: f32, 
          height: f32, 
          cell_size: f32,
          cam_pos: vec4<f32>, 
          cam_dir: vec4<f32>,
          cam_right: vec4<f32>,
          cam_up: vec4<f32>,
          bg_color: vec4<f32>,
          grid_dims: vec4<f32>,
          grid_origin: vec4<f32>,
          spheres: array<SphereData, " (Int.str limit) ">
      }
      struct CsgNode {
          info: vec4<f32>,
          pos: vec4<f32>,
          rot: vec4<f32>,
          params: vec4<f32>,
      }
      @group(0) @binding(0) var<storage, read> grid: array<Cell>;
      @group(0) @binding(1) var<uniform> u: Uniforms;
      @group(0) @binding(2) var<storage, read> csg_nodes: array<CsgNode>;

      struct VertexOutput {
          @builtin(position) position: vec4<f32>,
          @location(0) uv: vec2<f32>,
      }

      @vertex
      fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
          var pos = array<vec2<f32>, 3>(
              vec2<f32>(-1.0, -1.0),
              vec2<f32>( 3.0, -1.0),
              vec2<f32>(-1.0,  3.0)
          );
          var out: VertexOutput;
          out.position = vec4<f32>(pos[vi], 0.0, 1.0);
          out.uv = pos[vi];
          return out;
      }

      fn sdPlane(p: vec3<f32>, n: vec3<f32>, h: f32) -> f32 {
          return dot(p, n) + h;
      }

      fn sdSphere(p: vec3<f32>, s: f32) -> f32 {
          return length(p) - s;
      }

      fn sdBox(p: vec3<f32>, b: vec3<f32>) -> f32 {
          let q = abs(p) - b;
          return length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
      }

      fn sdCylinder(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let d = abs(vec2<f32>(length(p.xz), p.y)) - vec2<f32>(r, h);
          return min(max(d.x, d.y), 0.0) + length(max(d, vec2<f32>(0.0)));
      }

      fn sdCapsule(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let py = clamp(p.y, -h, h);
          return length(p - vec3<f32>(0.0, py, 0.0)) - r;
      }

      fn sdTorus(p: vec3<f32>, t: vec2<f32>) -> f32 {
          let q = vec2<f32>(length(p.xz) - t.x, p.y);
          return length(q) - t.y;
      }

      fn sdOctahedron(p: vec3<f32>, s: f32) -> f32 {
          let q = abs(p);
          return (q.x + q.y + q.z - s) * 0.57735027;
      }

      fn rotateVector(v: vec3<f32>, q: vec4<f32>) -> vec3<f32> {
          return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
      }

      fn q_inv(q: vec4<f32>) -> vec4<f32> {
          return vec4<f32>(-q.xyz, q.w);
      }

      fn evaluateCsgPrimitive(p: vec3<f32>, shape_type: u32, pos: vec3<f32>, scale: f32, rot: vec4<f32>, params: vec4<f32>) -> f32 {
          let local_p = rotateVector(p - pos, q_inv(rot)) / scale;
          var d = 10000.0;
          if (shape_type == 1u) {
              d = sdSphere(local_p, params.x);
          } else if (shape_type == 2u) {
              d = sdBox(local_p, params.xyz);
          } else if (shape_type == 3u) {
              d = sdCylinder(local_p, params.x, params.y);
          } else if (shape_type == 4u) {
              d = sdCapsule(local_p, params.x, params.y);
          } else if (shape_type == 5u) {
              d = sdTorus(local_p, params.xy);
          } else if (shape_type == 6u) {
              d = sdOctahedron(local_p, params.x);
          }
          return d * scale;
      }

      fn evaluateNoise(p: vec3<f32>) -> f32 {
          let n1 = sin(p.x * 3.5) * cos(p.y * 3.5) * sin(p.z * 3.5);
          let n2 = sin(p.x * 7.0 + n1 * 2.0) * cos(p.y * 7.0 + n1 * 2.0) * sin(p.z * 7.0 + n1 * 2.0);
          return n1 * 0.12 + n2 * 0.06;
      }

      fn evaluateCsgTree(local_p: vec3<f32>, root_idx: i32) -> f32 {
          var base_idx = root_idx;
          while (true) {
              let node = csg_nodes[base_idx];
              let shape_type = u32(round(node.info.x));
              if (shape_type > 0u) {
                  break;
              }
              base_idx = i32(round(node.info.z)); // left_child
          }
          
          let base_node = csg_nodes[base_idx];
          var d = evaluateCsgPrimitive(local_p, u32(round(base_node.info.x)), base_node.pos.xyz, base_node.pos.w, base_node.rot, base_node.params);
          for (var idx = base_idx + 2; idx <= root_idx; idx = idx + 2) {
              let op_node = csg_nodes[idx];
              let right_child = i32(round(op_node.info.w));
              let right_node = csg_nodes[right_child];
              var d_right = 10000.0;
              let diff = local_p - right_node.pos.xyz;
              if (dot(diff, diff) < 9.0) {
                  d_right = evaluateCsgPrimitive(local_p, u32(round(right_node.info.x)), right_node.pos.xyz, right_node.pos.w, right_node.rot, right_node.params);
              }
              let op = u32(round(op_node.info.y));
              if (op == 0u) {
                  d = min(d, d_right);
              } else if (op == 1u) {
                  let d_right_noisy = d_right + evaluateNoise(local_p);
                  d = max(d, -d_right_noisy);
              } else {
                  d = max(d, d_right);
              }
          }
          return d;
      }

      fn get_wireframe_edge(lp: vec3<f32>, raw_w: f32, thickness: f32) -> f32 {
          if (raw_w > 0.0 && raw_w < 500.0) {
              let rx = smoothstep(thickness, thickness - 0.01, abs(lp.x));
              let ry = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let rz = smoothstep(thickness, thickness - 0.01, abs(lp.z));
              return max(rx, max(ry, rz));
          } else if (raw_w < 0.0 && raw_w > -1000.0) {
              let size = -raw_w;
              let q = abs(lp) - vec3<f32>(size);
              let second_max = max(min(q.x, q.y), max(min(q.x, q.z), min(q.y, q.z)));
              return smoothstep(-thickness, -thickness + 0.01, second_max);
          } else if (raw_w <= -1000.0 && raw_w > -2000.0) {
              let size = -raw_w - 1000.0;
              let r = size;
              let h = size;
              let angle = atan2(lp.z, lp.x);
              let long_line = smoothstep(0.95, 0.98, abs(sin(angle * 4.0)));
              let ring_y = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let ring_cap = smoothstep(thickness, thickness - 0.01, abs(abs(lp.y) - h));
              return max(long_line, max(ring_y, ring_cap));
          } else if (raw_w >= 1000.0 && raw_w < 2000.0) {
              let size = raw_w - 1000.0;
              let r = size;
              let h = size;
              let rad = length(lp.xz);
              let rim = smoothstep(-thickness, -thickness + 0.01, min(rad - r, abs(lp.y) - h));
              let angle = atan2(lp.z, lp.x);
              let vertical_line = smoothstep(0.95, 0.98, abs(sin(angle * 6.0))) * step(abs(lp.y), h);
              return max(rim, vertical_line);
          } else if (raw_w >= 2000.0) {
              let size = raw_w - 2000.0;
              let R = size;
              let major_angle = atan2(lp.z, lp.x);
              let ring_major = smoothstep(0.95, 0.98, abs(sin(major_angle * 8.0)));
              let local_angle = atan2(lp.y, length(lp.xz) - R);
              let ring_tube = smoothstep(0.95, 0.98, abs(sin(local_angle * 6.0)));
              return max(ring_major, ring_tube);
          } else {
              let ex = smoothstep(thickness, thickness - 0.01, abs(lp.x));
              let ey = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let ez = smoothstep(thickness, thickness - 0.01, abs(lp.z));
              return max(ex, max(ey, ez));
          }
      }

      fn worldSDF(p: vec3<f32>, rd: vec3<f32>) -> vec2<f32> {
          var d = vec2<f32>(10000.0, -1.0);
          let floor_data = u.spheres[0];
          if (floor_data.pos.w != 0.0) {
              let local_p = rotateVector(p - floor_data.pos.xyz, q_inv(floor_data.rot));
              let csg_root_idx = i32(round(floor_data.color.w));
              var local_dist = 10000.0;
              if (csg_root_idx >= 0) {
                  local_dist = evaluateCsgTree(local_p, csg_root_idx);
              } else {
                  let size = -floor_data.pos.w;
                  local_dist = sdBox(local_p, vec3<f32>(size));
              }
              if (local_dist < d.x) {
                  d = vec2<f32>(local_dist, 0.0);
              }
          }
          let p_local = p - u.grid_origin.xyz;
          let gx = i32(floor(p_local.x / u.cell_size));
          let gy = i32(floor(p_local.y / u.cell_size));
          let gz = i32(floor(p_local.z / u.cell_size));

          if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
              let cell_min = vec3<f32>(f32(gx), f32(gy), f32(gz)) * u.cell_size;
              let cell_max = cell_min + vec3<f32>(u.cell_size);
              var t_exit = 100.0;
              if (rd.x > 0.0001) { t_exit = min(t_exit, (cell_max.x - p_local.x) / rd.x); }
              else if (rd.x < -0.0001) { t_exit = min(t_exit, (cell_min.x - p_local.x) / rd.x); }
              if (rd.y > 0.0001) { t_exit = min(t_exit, (cell_max.y - p_local.y) / rd.y); }
              else if (rd.y < -0.0001) { t_exit = min(t_exit, (cell_min.y - p_local.y) / rd.y); }
              if (rd.z > 0.0001) { t_exit = min(t_exit, (cell_max.z - p_local.z) / rd.z); }
              else if (rd.z < -0.0001) { t_exit = min(t_exit, (cell_min.z - p_local.z) / rd.z); }

              let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
              let cell = grid[idx];
              let count = min(i32(round(cell.header.x)), " (Int.str max-ids) ");
              for(var i = 0; i < count; i = i + 1) {
                  let s_idx = i32(round(cell.ids[i / 4][i % 4]));
                  if (s_idx >= 0 && s_idx < " (Int.str limit) ") {
                    let s_data = u.spheres[s_idx];
                    let raw_w = s_data.pos.w;
                    if (raw_w != 0.0) {
                      var local_dist = 10000.0;
                      let local_p = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                      let csg_root_idx = i32(round(s_data.color.w));
                      if (csg_root_idx >= 0) {
                          local_dist = evaluateCsgTree(local_p, csg_root_idx);
                      } else {
                          if (raw_w > 0.0 && raw_w < 500.0) {
                            local_dist = sdSphere(local_p, raw_w);
                          } else if (raw_w < 0.0 && raw_w > -1000.0) {
                            let size = -raw_w;
                            local_dist = sdBox(local_p, vec3<f32>(size));
                          } else if (raw_w <= -1000.0 && raw_w > -2000.0) {
                            let size = -raw_w - 1000.0;
                            local_dist = sdCapsule(local_p, size, size);
                          } else if (raw_w >= 1000.0 && raw_w < 2000.0) {
                            let size = raw_w - 1000.0;
                            local_dist = sdCylinder(local_p, size, size);
                          } else if (raw_w >= 2000.0) {
                            let size = raw_w - 2000.0;
                            local_dist = sdTorus(local_p, vec2<f32>(size, 0.25 * size));
                          } else {
                            let size = -raw_w - 2000.0;
                            local_dist = sdOctahedron(local_p, size);
                          }
                      }
                      if (local_dist < d.x) { d = vec2<f32>(local_dist, f32(s_idx)); }
                    }
                  }
              }
              return vec2<f32>(min(d.x, max(t_exit + 0.01, 0.05)), d.y);
          } else {
              return d;
          }
      }

      fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
          var res = 1.0;
          var t = mint;
          for (var i = 0; i < 30; i = i + 1) {
              let h_step = worldSDF(ro + rd * t, rd).x;
              if (h_step < 0.001) {
                  return 0.0;
              }
              let h_true = worldSDF(ro + rd * t, vec3<f32>(0.0)).x;
              res = min(res, k * h_true / t);
              t += clamp(h_step, 0.01, 0.3);
              if (t > maxt) {
                  break;
              }
          }
          return clamp(res, 0.0, 1.0);
      }

      fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
          var occ = 0.0;
          var sca = 1.0;
          for (var i = 0; i < 5; i = i + 1) {
              let hr = 0.01 + 0.12 * f32(i) / 4.0;
              let aopos = p + n * hr;
              let d = worldSDF(aopos, vec3<f32>(0.0)).x;
              occ += -(d - hr) * sca;
              sca *= 0.95;
          }
          return clamp(1.0 - 3.0 * occ, 0.0, 1.0);
      }

      @fragment
      fn fs_main(frag_in: VertexOutput) -> @location(0) vec4<f32> {
          let aspect = u.width / u.height;
          let uv = frag_in.uv * vec2<f32>(aspect, 1.0);
          let ro = u.cam_pos.xyz;
          let rd = normalize(uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz + u.cam_dir.xyz * 1.7320508);
          var t = 0.0;
          var hitId = -1.0;
          for(var i = 0; i < 80; i = i + 1) {
              let p = ro + rd * t;
              let res = worldSDF(p, rd);
              if (res.x < 0.001) { hitId = res.y; break; }
              t += res.x;
              if (t > 100.0) { break; }
          }
          var color = u.bg_color.rgb;
          if (t <= 100.0) {
              let p = ro + rd * t;
              let light_dir = normalize(vec3<f32>(0.5, 1.0, 0.3));
              var normal = vec3<f32>(0.0, 1.0, 0.0);
              var is_sphere = false;
              if (hitId != -1.0) {
                  let s_idx = i32(hitId);
                  let s_data = u.spheres[s_idx];
                  let raw_w = s_data.pos.w;
                  if (raw_w > 0.0 && raw_w < 500.0 && s_data.color.w < 0.0) {
                      is_sphere = true;
                  }
              }

              if (is_sphere) {
                  let s_idx = i32(hitId);
                  let s_data = u.spheres[s_idx];
                  normal = normalize(p - s_data.pos.xyz);
              } else {
                  let eps = vec3<f32>(0.01, 0.0, 0.0);
                  let tx_grad = vec3<f32>(
                      worldSDF(p + eps.xyy, rd).x - worldSDF(p - eps.xyy, rd).x,
                      worldSDF(p + eps.yxy, rd).x - worldSDF(p - eps.yxy, rd).x,
                      worldSDF(p + eps.yyx, rd).x - worldSDF(p - eps.yyx, rd).x
                  );
                  normal = normalize(tx_grad);
              }

              let diffuse = max(dot(normal, light_dir), 0.0);

              let shadow = getShadow(p + normal * 0.02, light_dir, 0.02, 20.0, 16.0);
              let lit = mix(0.2, 1.0, shadow) * diffuse;

              let ao = getAO(p, normal);

              var base_col = vec3<f32>(0.2, 0.2, 0.2);
              var edge = 0.0;
              if (hitId != -1.0) {
                  let s_idx = i32(hitId);
                  let s_data = u.spheres[s_idx];
                  base_col = s_data.color.rgb;
                  
                  let lp = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                  if (s_data.color.w < 0.0) {
                      edge = get_wireframe_edge(lp, s_data.pos.w, 0.08);
                  }
              }

              color = base_col * (lit + 0.15) * ao;

              if (edge > 0.0) {
                  let glow_col = base_col * 2.5 + vec3<f32>(0.25);
                  color = mix(color, glow_col, edge);
              }

              color = mix(color, u.bg_color.rgb, 1.0 - exp(-0.02 * t));
          }
          return vec4<f32>(color, 1.0);
      }
    "))

  (def max-csg-nodes 1024)
  (def csg-node-size 64)

  (defn create [ctx format width height grid]
    (let [u-size (+ WGPURenderer.header-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size))
          shader (shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell)
          s-size (* (GPUSpatial.required-floats grid WGPURenderer.max-ids-per-cell) 4)
          csg-size (* WGPURenderer.max-csg-nodes WGPURenderer.csg-node-size)
          u-data (the (Array Float) (replicate (/ u-size 4) &0.0f))
          s-data (the (Array Float) (replicate (/ s-size 4) &0.0f))
          csg-data (the (Array Float) (replicate (/ csg-size 4) &0.0f))]
      (match (WGPURender.create-uniform-buffer ctx u-size)
        (Result.Error e) (Result.Error (str* "Uniform failed: " e))
        (Result.Success ub)
          (match (WGPU.create-buffer ctx s-size)
            (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Storage failed: " e)))
            (Result.Success sb)
              (match (WGPU.create-buffer ctx csg-size)
                (Result.Error e) (do (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "CSG buffer failed: " e)))
                (Result.Success csg-b)
                  (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &format)
                    (Result.Error e) (do (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Pipeline failed: " e)))
                    (Result.Success pipe)
                      (let [bg (wgpu-create-render-two-storage-uniform-bind-group ctx pipe sb csg-b ub)]
                        (if (WGPURender.bindgroup-null?- bg)
                            (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Bind group failed: " (WGPURender.get-error))))
                            (match (WGPURender.create-depth-texture ctx width height)
                              (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Depth failed: " e)))
                              (Result.Success dt)
                                (match (LinePass.create ctx format 10000)
                                  (Result.Error e) (do (WGPURender.free-depth-texture dt) (WGPURender.free-pipeline pipe) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "LinePass failed: " e)))
                                  (Result.Success lp)
                                    (Result.Success (WGPURenderer.init pipe ub sb csg-b bg dt lp [] u-data s-data csg-data))))))))))))

  (defn clear! [ren]
    (let [cmds (WGPURenderer.commands ren)]
      (while (not (Array.empty? cmds))
        (ignore (Array.pop-back! cmds)))))

  (defn submit! [ren cmd]
    (Array.push-back! (WGPURenderer.commands ren) cmd))

  (defn process-commands! [ctx ren time width height cam grid world]
    (let [bg-color (Vector3.init 0.1 0.1 0.1)
          commands (WGPURenderer.commands ren)
          vp (Camera.view-projection cam)
          vp-data (CameraMat4.data &vp)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols (Double.from-int @(SpatialGrid.cols grid))
          rows (Double.from-int @(SpatialGrid.rows grid))
          layers (Double.from-int @(SpatialGrid.layers grid))
          origin (SpatialGrid.origin grid)
          data (WGPURenderer.u-data ren)
          flat-grid (WGPURenderer.s-data ren)
          csg-data (WGPURenderer.csg-data ren)]
      (do
        ;; Zero out the dynamic spheres part of uniforms (indices 32 onwards) to clear stale data in-place
        (for [i 32 (Array.length data)]
          (Array.aset! data i 0.0f))

        ;; Zero out the flat-grid spatial buffer entirely in-place
        (for [i 0 (Array.length flat-grid)]
          (Array.aset! flat-grid i 0.0f))

        ;; Zero out the CSG data buffer in-place
        (for [i 0 (Array.length csg-data)]
          (Array.aset! csg-data i 0.0f))

        (let [next-csg-node-idx 0]
          (do
            ;; 1. Populate Header (0-127 bytes)
            (Array.aset! data 0 (Double.to-float time))
            (Array.aset! data 1 (Double.to-float (Double.from-int width)))
            (Array.aset! data 2 (Double.to-float (Double.from-int height)))
            (Array.aset! data 3 (Double.to-float cell-size))
            (Array.aset! data 4 (Double.to-float @(Vector3.x cam-pos)))
            (Array.aset! data 5 (Double.to-float @(Vector3.y cam-pos)))
            (Array.aset! data 6 (Double.to-float @(Vector3.z cam-pos)))
            (Array.aset! data 7 1.0f)
            (Array.aset! data 8 (Double.to-float @(Vector3.x cam-dir)))
            (Array.aset! data 9 (Double.to-float @(Vector3.y cam-dir)))
            (Array.aset! data 10 (Double.to-float @(Vector3.z cam-dir)))
            (Array.aset! data 11 0.0f)
            (Array.aset! data 12 (Double.to-float @(Vector3.x cam-right)))
            (Array.aset! data 13 (Double.to-float @(Vector3.y cam-right)))
            (Array.aset! data 14 (Double.to-float @(Vector3.z cam-right)))
            (Array.aset! data 15 0.0f)
            (Array.aset! data 16 (Double.to-float @(Vector3.x cam-up)))
            (Array.aset! data 17 (Double.to-float @(Vector3.y cam-up)))
            (Array.aset! data 18 (Double.to-float @(Vector3.z cam-up)))
            (Array.aset! data 19 0.0f)

            ;; 2. Populate BG Color and Grid Dims (80-127 bytes)
            (for [i 0 (Array.length commands)]
              (match-ref (Array.unsafe-nth commands i)
                (RenderCommand.SetBg bg) (set! bg-color @bg)
                _ ()))
            (Array.aset! data 20 (Double.to-float @(Vector3.x &bg-color)))
            (Array.aset! data 21 (Double.to-float @(Vector3.y &bg-color)))
            (Array.aset! data 22 (Double.to-float @(Vector3.z &bg-color)))
            (Array.aset! data 23 1.0f)
            (Array.aset! data 24 (Double.to-float cols))
            (Array.aset! data 25 (Double.to-float rows))
            (Array.aset! data 26 (Double.to-float layers))
            (Array.aset! data 27 0.0f)
            (Array.aset! data 28 (Double.to-float @(Vector3.x origin)))
            (Array.aset! data 29 (Double.to-float @(Vector3.y origin)))
            (Array.aset! data 30 (Double.to-float @(Vector3.z origin)))
            (Array.aset! data 31 0.0f)

            ;; 3. Populate Spheres using Entity ID as index (128+ bytes)
            (ECS.query world [ent (rb RigidBody) (col Collidable) (color Color)]
              (let [has-parent false]
                (do
                  (ECS.with-components world @&ent [e (p Parent)]
                    (set! has-parent true))
                  (when (and (not has-parent)
                             (< (ECS.Entity.id &ent) (Uint32.from-long (Long.from-int WGPURenderer.max-spheres)))
                             (not (ECS.has-component? world &ent PlayerTag)))
                    (let [id (ECS.Entity.id &ent)
                          pos (RigidBody.position rb)
                          rot (RigidBody.rotation rb)
                          c-val (Color.v color)
                          rad (match-ref (Collidable.volume col)
                                (Volume.Ball b) @(Sphere.radius b)
                                (Volume.Box b) (- 0.0 @(Vector3.x &(Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)))
                                  (Volume.Sdf sdf)
                                    (let [scale @(SDF.scale sdf)]
                                      (match-ref (SDF.base sdf)
                                        (BaseShape.Ball r) (* @r scale)
                                        (BaseShape.Box e) (- 0.0 (* @(Vector3.x e) scale))
                                        (BaseShape.Cylinder r h) (+ 1000.0 (* @r scale))
                                        (BaseShape.Capsule r h) (- 0.0 (+ 1000.0 (* @r scale)))
                                        (BaseShape.Torus rad-maj rad-min) (+ 2000.0 (* @rad-maj scale))
                                        (BaseShape.Octahedron s) (- 0.0 (+ 2000.0 (* @s scale)))
                                        _ 0.0))
                                 _ 0.0)
                          root-csg-idx -1]
                      (do
                        (match-ref (Collidable.volume col)
                          (Volume.Sdf sdf)
                            (when (> (Array.length (SDF.csg-nodes sdf)) 0)
                              (set! root-csg-idx (serialize-sdf! sdf csg-data (Pointer.address &next-csg-node-idx) true)))
                          _ ())
                        (let [base (+ (/ WGPURenderer.header-size 4) (* (the Int (Long.to-int (Uint32.to-long id))) 12))]
                          (do
                            (Array.aset! data base (Double.to-float @(Vector3.x pos)))
                            (Array.aset! data (+ base 1) (Double.to-float @(Vector3.y pos)))
                            (Array.aset! data (+ base 2) (Double.to-float @(Vector3.z pos)))
                            (Array.aset! data (+ base 3) (Double.to-float rad))
                            (Array.aset! data (+ base 4) (Double.to-float @(Quaternion.x rot)))
                            (Array.aset! data (+ base 5) (Double.to-float @(Quaternion.y rot)))
                            (Array.aset! data (+ base 6) (Double.to-float @(Quaternion.z rot)))
                            (Array.aset! data (+ base 7) (Double.to-float @(Quaternion.w rot)))
                            (Array.aset! data (+ base 8) (Double.to-float @(Vector3.x c-val)))
                            (Array.aset! data (+ base 9) (Double.to-float @(Vector3.y c-val)))
                            (Array.aset! data (+ base 10) (Double.to-float @(Vector3.z c-val)))
                            (Array.aset! data (+ base 11) (Double.to-float (Double.from-int root-csg-idx)))))))))))))

        (WGPURender.update-uniform-buffer ctx @(WGPURenderer.u-buffer ren) data)
        (GPUSpatial.flatten-in-place! grid 16 flat-grid)
        (WGPU.write-floats ctx @(WGPURenderer.s-buffer ren) flat-grid)
        (WGPU.write-floats ctx @(WGPURenderer.csg-buffer ren) csg-data)
        (LinePass.update! ctx (WGPURenderer.line-pass ren) vp-data commands))))

  (defn draw [surf ctx ren line-count]
    (match (WGPURender.begin-frame surf ctx)
      (Result.Error _) ()
      (Result.Success frame)
        (do
          (WGPURenderer.run-pass frame @(WGPURenderer.pipeline ren) @(WGPURenderer.bind-group ren) (Maybe.Nothing))
          (LinePass.render frame ctx (WGPURenderer.line-pass ren) line-count @(WGPURenderer.depth-texture ren))
          (WGPURender.end-frame frame surf ctx)
          (WGPURender.free-frame frame))))
)
