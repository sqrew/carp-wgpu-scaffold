;; render.carp

(use WGPU)
(use WGPURender)
(use Camera)
(use Transform)
(use RigidBody)
(use LinePass)
(use GPUSpatial)
(use ECS)

(deftype WGPURenderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  u-buffer (Ptr WGPUUniformBufferWrapper)
  s-buffer WGPUBuffer
  bind-group WGPUBindGroup
  depth-texture (Ptr WGPUDepthTexture)
  line-pass LinePassRenderer
  commands (Array RenderCommand)
])

(defmodule WGPURenderer
  (def max-spheres 128)
  (def max-ids-per-cell 16)
  (def header-size 128)
  (def sphere-data-size 32)

  (defn shader-wgsl [limit max-ids]
    (str*
      "struct SphereData {
          pos: vec4<f32>,
          rot: vec4<f32>,
      }
      struct Cell {
          header: vec4<f32>,
          ids: array<vec4<f32>, " (Int.str (/ max-ids 4)) ">,
      }
      struct Uniforms { 
          time: f32, 
          width: f32, 
          height: f32, 
          cell_size: f32,
          cam_pos: vec4<f32>, 
          cam_dir: vec4<f32>,
          cam_right: vec4<f32>,
          cam_up: vec4<f32>,
          bg_color: vec4<f32>,
          grid_dims: vec4<f32>,
          grid_origin: vec4<f32>,
          spheres: array<SphereData, " (Int.str limit) ">
      }
      @group(0) @binding(0) var<storage, read> grid: array<Cell>;
      @group(0) @binding(1) var<uniform> u: Uniforms;

      struct VertexOutput {
          @builtin(position) position: vec4<f32>,
          @location(0) uv: vec2<f32>,
      }

      @vertex
      fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
          var pos = array<vec2<f32>, 3>(
              vec2<f32>(-1.0, -1.0),
              vec2<f32>( 3.0, -1.0),
              vec2<f32>(-1.0,  3.0)
          );
          var out: VertexOutput;
          out.position = vec4<f32>(pos[vi], 0.0, 1.0);
          out.uv = pos[vi];
          return out;
      }

      fn sdPlane(p: vec3<f32>, n: vec3<f32>, h: f32) -> f32 {
          return dot(p, n) + h;
      }

      fn sdSphere(p: vec3<f32>, s: f32) -> f32 {
          return length(p) - s;
      }

      fn sdBox(p: vec3<f32>, b: vec3<f32>) -> f32 {
          let q = abs(p) - b;
          return length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
      }

      fn sdCylinder(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let d = abs(vec2<f32>(length(p.xz), p.y)) - vec2<f32>(r, h);
          return min(max(d.x, d.y), 0.0) + length(max(d, vec2<f32>(0.0)));
      }

      fn sdCapsule(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let py = clamp(p.y, -h, h);
          return length(p - vec3<f32>(0.0, py, 0.0)) - r;
      }

      fn rotateVector(v: vec3<f32>, q: vec4<f32>) -> vec3<f32> {
          return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
      }

      fn q_inv(q: vec4<f32>) -> vec4<f32> {
          return vec4<f32>(-q.xyz, q.w);
      }

      fn worldSDF(p: vec3<f32>, rd: vec3<f32>) -> vec2<f32> {
          var d = vec2<f32>(p.y, -1.0);
          let p_local = p - u.grid_origin.xyz;
          let gx = i32(floor(p_local.x / u.cell_size));
          let gy = i32(floor(p_local.y / u.cell_size));
          let gz = i32(floor(p_local.z / u.cell_size));

          if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
              let cell_min = vec3<f32>(f32(gx), f32(gy), f32(gz)) * u.cell_size;
              let cell_max = cell_min + vec3<f32>(u.cell_size);
              var t_exit = 100.0;
              if (rd.x > 0.0001) { t_exit = min(t_exit, (cell_max.x - p_local.x) / rd.x); }
              else if (rd.x < -0.0001) { t_exit = min(t_exit, (cell_min.x - p_local.x) / rd.x); }
              if (rd.y > 0.0001) { t_exit = min(t_exit, (cell_max.y - p_local.y) / rd.y); }
              else if (rd.y < -0.0001) { t_exit = min(t_exit, (cell_min.y - p_local.y) / rd.y); }
              if (rd.z > 0.0001) { t_exit = min(t_exit, (cell_max.z - p_local.z) / rd.z); }
              else if (rd.z < -0.0001) { t_exit = min(t_exit, (cell_min.z - p_local.z) / rd.z); }

              let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
              let cell = grid[idx];
              let count = min(i32(round(cell.header.x)), " (Int.str max-ids) ");
              for(var i = 0; i < count; i = i + 1) {
                  let s_idx = i32(round(cell.ids[i / 4][i % 4]));
                  if (s_idx >= 0 && s_idx < " (Int.str limit) ") {
                    let s_data = u.spheres[s_idx];
                    let raw_w = s_data.pos.w;
                    if (raw_w != 0.0) {
                      var local_dist = 10000.0;
                      let local_p = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                      if (raw_w > 0.0 && raw_w < 500.0) {
                        local_dist = sdSphere(local_p, raw_w);
                      } else if (raw_w < 0.0 && raw_w > -1000.0) {
                        let size = -raw_w;
                        local_dist = sdBox(local_p, vec3<f32>(size));
                      } else if (raw_w <= -1000.0) {
                        let size = -raw_w - 1000.0;
                        local_dist = sdCapsule(local_p, size, size);
                      } else {
                        let size = raw_w - 1000.0;
                        local_dist = sdCylinder(local_p, size, size);
                      }
                      if (local_dist < d.x) { d = vec2<f32>(local_dist, f32(s_idx)); }
                    }
                  }
              }
              return vec2<f32>(min(d.x, max(t_exit + 0.01, 0.05)), d.y);
          } else {
              return d;
          }
      }

      fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
          var res = 1.0;
          var t = mint;
          for (var i = 0; i < 30; i = i + 1) {
              let h_step = worldSDF(ro + rd * t, rd).x;
              if (h_step < 0.001) {
                  return 0.0;
              }
              let h_true = worldSDF(ro + rd * t, vec3<f32>(0.0)).x;
              res = min(res, k * h_true / t);
              t += clamp(h_step, 0.01, 0.3);
              if (t > maxt) {
                  break;
              }
          }
          return clamp(res, 0.0, 1.0);
      }

      fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
          var occ = 0.0;
          var sca = 1.0;
          for (var i = 0; i < 5; i = i + 1) {
              let hr = 0.01 + 0.12 * f32(i) / 4.0;
              let aopos = p + n * hr;
              let d = worldSDF(aopos, vec3<f32>(0.0)).x;
              occ += -(d - hr) * sca;
              sca *= 0.95;
          }
          return clamp(1.0 - 3.0 * occ, 0.0, 1.0);
      }

      @fragment
      fn fs_main(frag_in: VertexOutput) -> @location(0) vec4<f32> {
          let aspect = u.width / u.height;
          let uv = frag_in.uv * vec2<f32>(aspect, 1.0);
          let ro = u.cam_pos.xyz;
          let rd = normalize(uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz + u.cam_dir.xyz * 1.5);
          var t = 0.0;
          var hitId = -1.0;
          for(var i = 0; i < 80; i = i + 1) {
              let p = ro + rd * t;
              let res = worldSDF(p, rd);
              if (res.x < 0.001) { hitId = res.y; break; }
              t += res.x;
              if (t > 100.0) { break; }
          }
          var color = u.bg_color.rgb;
          if (t <= 100.0) {
              let p = ro + rd * t;
              let light_dir = normalize(vec3<f32>(0.5, 1.0, 0.3));
              var normal = vec3<f32>(0.0, 1.0, 0.0);
              
              if (hitId != -1.0) {
                  let s_idx = i32(hitId);
                  let s_data = u.spheres[s_idx];
                  normal = normalize(p - s_data.pos.xyz);
              } else {
                  let eps = vec3<f32>(0.05, 0.0, 0.0);
                  let tx_grad = vec3<f32>(
                      worldSDF(p + eps.xyy, rd).x - worldSDF(p - eps.xyy, rd).x,
                      worldSDF(p + eps.yxy, rd).x - worldSDF(p - eps.yxy, rd).x,
                      worldSDF(p + eps.yyx, rd).x - worldSDF(p - eps.yyx, rd).x
                  );
                  normal = normalize(tx_grad);
              }

              // Calculate Diffuse Lighting
              let diffuse = max(dot(normal, light_dir), 0.0);

              // Calculate Soft Shadows
              let shadow = getShadow(p + normal * 0.02, light_dir, 0.02, 20.0, 16.0);
              let lit = mix(0.2, 1.0, shadow) * diffuse;

              // Calculate Ambient Occlusion
              let ao = getAO(p, normal);

              // Base Color Retrieval
              var base_col = vec3<f32>(0.2, 0.2, 0.2);
              if (hitId != -1.0) {
                  let s_idx = i32(hitId);
                  let s_data = u.spheres[s_idx];
                  let lp = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                  let stripe = sin(lp.y * 10.0);
                  let check = smoothstep(-0.1, 0.1, stripe);
                  base_col = mix(vec3<f32>(0.8, 0.2, 0.2), vec3<f32>(0.9, 0.9, 0.9), check);
              } else {
                  let grid_v = sin(p.x * 2.0) * sin(p.z * 2.0);
                  let check = smoothstep(-0.1, 0.1, grid_v);
                  base_col = mix(vec3<f32>(0.2, 0.2, 0.2), vec3<f32>(0.3, 0.3, 0.3), check);
              }

              // Combine diffuse, shadows, ambient term, and ambient occlusion
              color = base_col * (lit + 0.15) * ao;

              // Fog
              color = mix(color, u.bg_color.rgb, 1.0 - exp(-0.02 * t));
          }
          return vec4<f32>(color, 1.0);
      }
    "))

  (defn create [ctx format width height grid]
    (let [u-size (+ WGPURenderer.header-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size))
          shader (shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell)
          s-size (* (GPUSpatial.required-floats grid WGPURenderer.max-ids-per-cell) 4)]
      (match (WGPURender.create-uniform-buffer ctx u-size)
        (Result.Error e) (Result.Error (str* "Uniform failed: " e))
        (Result.Success ub)
          (match (WGPU.create-buffer ctx s-size)
            (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Storage failed: " e)))
            (Result.Success sb)
              (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &format)
                (Result.Error e) (do (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Pipeline failed: " e)))
                (Result.Success pipe)
                  (match (WGPURender.create-render-storage-uniform-bind-group ctx pipe sb ub)
                    (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Bind group failed: " e)))
                    (Result.Success bg)
                      (match (WGPURender.create-depth-texture ctx width height)
                        (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Depth failed: " e)))
                        (Result.Success dt)
                          (match (LinePass.create ctx format 1000)
                            (Result.Error e) (do (WGPURender.free-depth-texture dt) (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "LinePass failed: " e)))
                            (Result.Success lp)
                              (Result.Success (WGPURenderer.init pipe ub sb bg dt lp []))))))))))

  (defn clear! [ren]
    (let [cmds (WGPURenderer.commands ren)]
      (while (not (Array.empty? cmds))
        (ignore (Array.pop-back! cmds)))))

  (defn submit! [ren cmd]
    (Array.push-back! (WGPURenderer.commands ren) cmd))

  (defn process-commands! [ctx ren time width height cam grid world]
    (let [bg-color (Vector3.init 0.1 0.1 0.1)
          commands (WGPURenderer.commands ren)
          vp (Camera.view-projection cam)
          vp-data (CameraMat4.data &vp)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols (Double.from-int @(SpatialGrid.cols grid))
          rows (Double.from-int @(SpatialGrid.rows grid))
          layers (Double.from-int @(SpatialGrid.layers grid))
          origin (SpatialGrid.origin grid)
          data (the (Array Float) (replicate (/ (+ WGPURenderer.header-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size)) 4) &0.0f))]
      (do
        ;; 1. Populate Header (0-127 bytes)
        (Array.aset! &data 0 (Double.to-float time))
        (Array.aset! &data 1 (Double.to-float (Double.from-int width)))
        (Array.aset! &data 2 (Double.to-float (Double.from-int height)))
        (Array.aset! &data 3 (Double.to-float cell-size))
        (Array.aset! &data 4 (Double.to-float @(Vector3.x cam-pos)))
        (Array.aset! &data 5 (Double.to-float @(Vector3.y cam-pos)))
        (Array.aset! &data 6 (Double.to-float @(Vector3.z cam-pos)))
        (Array.aset! &data 7 1.0f)
        (Array.aset! &data 8 (Double.to-float @(Vector3.x cam-dir)))
        (Array.aset! &data 9 (Double.to-float @(Vector3.y cam-dir)))
        (Array.aset! &data 10 (Double.to-float @(Vector3.z cam-dir)))
        (Array.aset! &data 11 0.0f)
        (Array.aset! &data 12 (Double.to-float @(Vector3.x cam-right)))
        (Array.aset! &data 13 (Double.to-float @(Vector3.y cam-right)))
        (Array.aset! &data 14 (Double.to-float @(Vector3.z cam-right)))
        (Array.aset! &data 15 0.0f)
        (Array.aset! &data 16 (Double.to-float @(Vector3.x cam-up)))
        (Array.aset! &data 17 (Double.to-float @(Vector3.y cam-up)))
        (Array.aset! &data 18 (Double.to-float @(Vector3.z cam-up)))
        (Array.aset! &data 19 0.0f)

        ;; 2. Populate BG Color and Grid Dims (80-127 bytes)
        (for [i 0 (Array.length commands)]
          (match-ref (Array.unsafe-nth commands i)
            (RenderCommand.SetBg bg) (set! bg-color @bg)
            _ ()))
        (Array.aset! &data 20 (Double.to-float @(Vector3.x &bg-color)))
        (Array.aset! &data 21 (Double.to-float @(Vector3.y &bg-color)))
        (Array.aset! &data 22 (Double.to-float @(Vector3.z &bg-color)))
        (Array.aset! &data 23 1.0f)
        (Array.aset! &data 24 (Double.to-float cols))
        (Array.aset! &data 25 (Double.to-float rows))
        (Array.aset! &data 26 (Double.to-float layers))
        (Array.aset! &data 27 0.0f)
        (Array.aset! &data 28 (Double.to-float @(Vector3.x origin)))
        (Array.aset! &data 29 (Double.to-float @(Vector3.y origin)))
        (Array.aset! &data 30 (Double.to-float @(Vector3.z origin)))
        (Array.aset! &data 31 0.0f)

        ;; 3. Populate Spheres using Entity ID as index (128+ bytes)
        (ECS.query world [ent (rb RigidBody) (col Collidable)]
          (let [id (ECS.Entity.id &ent)]
            (when (and (< id (Uint32.from-long (Long.from-int WGPURenderer.max-spheres)))
                       (not (ECS.has-component? world &ent PlayerTag)))
              (let [pos (RigidBody.position rb)
                    rot (RigidBody.rotation rb)
                    rad (match-ref (Collidable.volume col)
                          (Volume.Ball b) @(Sphere.radius b)
                          (Volume.Box b) (- 0.0 @(Vector3.x &(Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)))
                            (Volume.Sdf sdf)
                              (let [scale @(SDF.scale sdf)]
                                (match-ref (SDF.base sdf)
                                  (BaseShape.Ball r) (* @r scale)
                                  (BaseShape.Box e) (- 0.0 (* @(Vector3.x e) scale))
                                  (BaseShape.Cylinder r h) (+ 1000.0 (* @r scale))
                                  (BaseShape.Capsule r h) (- 0.0 (+ 1000.0 (* @r scale)))
                                  _ 0.0))
                           _ 0.0)]
                (let [base (+ (/ WGPURenderer.header-size 4) (* (the Int (Long.to-int (Uint32.to-long id))) 8))]
                  (do
                    (Array.aset! &data base (Double.to-float @(Vector3.x pos)))
                    (Array.aset! &data (+ base 1) (Double.to-float @(Vector3.y pos)))
                    (Array.aset! &data (+ base 2) (Double.to-float @(Vector3.z pos)))
                    (Array.aset! &data (+ base 3) (Double.to-float rad))
                    (Array.aset! &data (+ base 4) (Double.to-float @(Quaternion.x rot)))
                    (Array.aset! &data (+ base 5) (Double.to-float @(Quaternion.y rot)))
                    (Array.aset! &data (+ base 6) (Double.to-float @(Quaternion.z rot)))
                    (Array.aset! &data (+ base 7) (Double.to-float @(Quaternion.w rot)))))))))

        (WGPURender.update-uniform-buffer ctx @(WGPURenderer.u-buffer ren) &data)
        (let [flat-grid (GPUSpatial.flatten grid 16)]
          (WGPU.write-floats ctx @(WGPURenderer.s-buffer ren) &flat-grid))
        (LinePass.update! ctx (WGPURenderer.line-pass ren) vp-data commands))))

  (defn draw [surf ctx ren line-count]
    (match (WGPURender.begin-frame surf ctx)
      (Result.Error _) ()
      (Result.Success frame)
        (do
          (WGPURenderer.run-pass frame @(WGPURenderer.pipeline ren) @(WGPURenderer.bind-group ren) (Maybe.Nothing))
          (LinePass.render frame ctx (WGPURenderer.line-pass ren) line-count @(WGPURenderer.depth-texture ren))
          (WGPURender.end-frame frame surf ctx)
          (WGPURender.free-frame frame))))
)
