  csg-buffer WGPUBuffer

  bind-group WGPUBindGroup

  depth-texture (Ptr WGPUDepthTexture)

  line-pass LinePassRenderer

  commands (Array RenderCommand)

  u-data (Array Float)

  instances-data (Array Float)

  s-data (Array Float)

  csg-data (Array Float)

  voxel-texture (Ptr WGPURenderTexture)

  voxel-baked-values-texture (Ptr WGPURenderTexture)

  light-texture (Ptr WGPURenderTexture)

  interaction-texture (Ptr WGPURenderTexture)

  voxel-sampler WGPUSampler

  voxel-data (Array Float)

  voxel-dirty Bool

  carve-pipeline WGPUComputePipeline

  pack-pipeline WGPUComputePipeline

  pack-unorm8-pipeline WGPUComputePipeline

  light-splat-pipeline WGPUComputePipeline

  voxel-gpu-buffer WGPUBuffer

  voxel-half-buffer WGPUBuffer

  voxel-baked-values-half-buffer WGPUBuffer

  carve-params-buffer WGPUBuffer

  light-scratch-buffer WGPUBuffer

  light-half-buffer WGPUBuffer

  light-params-buffer WGPUBuffer

  chunk-lookup-buffer WGPUBuffer

  noise-texture (Ptr WGPURenderTexture)

  noise-sampler WGPUSampler

  pack-bind-group WGPUBindGroup

  fields-active-slots (Array Bool)

  fields-active-ticks (Array Int)

  jit-info-buffer WGPUBuffer

  format String

  gui-pipeline (Ptr WGPUGeomPipelineWrapper)

  gui-ubo (Ptr WGPUUniformBufferWrapper)

  gui-bg WGPUBindGroup

  gui-font-texture (Ptr WGPURenderTexture)

  gui-font-sampler WGPUSampler

  interaction-scratch-buffer WGPUBuffer

  interaction-half-buffer WGPUBuffer

  interaction-params-buffer WGPUBuffer

  interaction-splat-pipeline WGPUComputePipeline

  water-texture (Ptr WGPURenderTexture)

  water-scratch-buffer WGPUBuffer

  water-half-buffer WGPUBuffer

  water-params-buffer WGPUBuffer

  water-splat-pipeline WGPUComputePipeline

  gas-texture (Ptr WGPURenderTexture)

  gas-scratch-buffer WGPUBuffer

  gas-half-buffer WGPUBuffer

  gas-params-buffer WGPUBuffer

  gas-splat-pipeline WGPUComputePipeline

  em-texture (Ptr WGPURenderTexture)

  unpack-pipeline WGPUComputePipeline

  water-pack-bind-group WGPUBindGroup

  gas-pack-bind-group WGPUBindGroup

  light-pack-bind-group WGPUBindGroup

  interaction-pack-bind-group WGPUBindGroup

  jit-water-script String

  jit-water-bind-group WGPUBindGroup

  jit-gas-script String

  jit-gas-bind-group WGPUBindGroup

  terrain-color-texture (Ptr WGPURenderTexture)

  volumetric-texture (Ptr WGPURenderTexture)

  composite-pipeline (Ptr WGPURenderPipelineWrapper)

  composite-bind-group WGPUBindGroup

  gravity-texture (Ptr WGPURenderTexture)

])



(defmodule VoxelBaker

  (sig bake-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref World) (Ref (Maybe SDF))] ()))

  (sig bake-chunk-slices! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref World) Int Int (Ref (Maybe SDF))] ()))

  (sig bake-voxel-grid! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref (SpatialGrid Uint32)) (Ref GameWorld) (Ref World)] ()))

  (sig chunk-overlaps-sphere? (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double] Bool))

  (sig carve-voxel-grid-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Vector3 Double)) Double Int] ()))

  (sig build-voxel-grid-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Vector3 Double)) Double Int Double] ()))

  (sig carve-voxel-grid-cpu! (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double Int Double] ()))

  (sig build-voxel-grid-cpu! (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double Int Double Double] ()))

  (sig pack-and-copy-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) WGPUBuffer Int Int] ()))

  (sig bake-light-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) Double (Ref String) (Ref (Map String WGPUComputePipeline)) Int] ()))

  (sig pack-and-copy-light-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int Int] ()))

  (sig bake-interaction-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) Double (Ref String) (Ref (Map String WGPUComputePipeline)) Int] ()))

  (sig pack-and-copy-interaction-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int Int] ()))

  (sig bake-water-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) Double (Ref String) (Ref (Map String WGPUComputePipeline)) Int] ()))

  (sig pack-and-copy-water-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int Int] ()))

  (sig bake-gas-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) Double (Ref String) (Ref (Map String WGPUComputePipeline)) Int] ()))

  (sig pack-and-copy-gas-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int Int] ()))

  (sig bake-em-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) Double (Ref String) (Ref (Map String WGPUComputePipeline)) Int] ()))

  (sig pack-and-copy-em-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int Int] ()))

)



(defmodule WGPURenderer

  (def max-spheres 1024)

  (def max-ids-per-cell 64)

  (def header-size 624)

  (def sphere-data-size 128)

  (def max-csg-nodes 1024)

  (def csg-node-size 64)



  (def cache-qx-arr (the (Array Int) []))

  (def cache-qz-arr (the (Array Int) []))

  (def cache-qy-arr (the (Array Int) []))

  (def cache-initialized false)



  (sig get-surface-qy (Fn [Int Int] Int))

  (defn get-surface-qy [qx qz]

    (do

      (when (not cache-initialized)

        (do

          (set! cache-qx-arr (replicate 2048 &-999999))

          (set! cache-qz-arr (replicate 2048 &-999999))

          (set! cache-qy-arr (replicate 2048 &0))

          (set! cache-initialized true)))

      (let [hash-idx (Int.mod (Int.abs (+ (* qx 73856093) (* qz 19349663))) 2048)

            cached-qx @(Array.unsafe-nth &cache-qx-arr hash-idx)

            cached-qz @(Array.unsafe-nth &cache-qz-arr hash-idx)]

        (if (and (= qx cached-qx) (= qz cached-qz))

            @(Array.unsafe-nth &cache-qy-arr hash-idx)

            (let [px (* (Double.from-int qx) 32.0)

                  pz (* (Double.from-int qz) 32.0)

                  final-h (get-terrain-height px pz)

                  qy (the Int (Double.to-int (Double.floor (/ final-h 32.0))))]

              (do

                (Array.aset! &cache-qx-arr hash-idx qx)

                (Array.aset! &cache-qz-arr hash-idx qz)

                (Array.aset! &cache-qy-arr hash-idx qy)

                qy))))))



  (sig float-from-int (Fn [Int] Float))

  (defn float-from-int [x]

    (Double.to-float (Double.from-int x)))



  (sig write-ints (Fn [(Ptr WGPUContext) WGPUBuffer (Ref (Array Int))] ()))

  (defn write-ints [ctx buf arr]

    (wgpu-write-buffer-ints ctx buf (ints-array->ptr arr) (Uint64.from-long (Long.from-int (* (Array.length arr) 4)))))



  (sig write-csg-node-raw! (Fn [(Ref (Array Float)) Int Int Int Int Int (Ref (Vector3 Double)) Double (Ref Quaternion) Double Double Double Double] ()))

  (defn write-csg-node-raw! [csg-data idx shape-type op-type left-child right-child pos scale rot p0 p1 p2 p3]

    (let [base (* idx 16)]

      (do

        (Array.aset! csg-data base (WGPURenderer.float-from-int shape-type))

        (Array.aset! csg-data (+ base 1) (WGPURenderer.float-from-int op-type))

        (Array.aset! csg-data (+ base 2) (WGPURenderer.float-from-int left-child))

        (Array.aset! csg-data (+ base 3) (WGPURenderer.float-from-int right-child))

        (Array.aset! csg-data (+ base 4) (Double.to-float @(Vector3.x pos)))

        (Array.aset! csg-data (+ base 5) (Double.to-float @(Vector3.y pos)))

        (Array.aset! csg-data (+ base 6) (Double.to-float @(Vector3.z pos)))

        (Array.aset! csg-data (+ base 7) (Double.to-float scale))

        (Array.aset! csg-data (+ base 8) (Double.to-float @(Quaternion.x rot)))

        (Array.aset! csg-data (+ base 9) (Double.to-float @(Quaternion.y rot)))

        (Array.aset! csg-data (+ base 10) (Double.to-float @(Quaternion.z rot)))

        (Array.aset! csg-data (+ base 11) (Double.to-float @(Quaternion.w rot)))

        (Array.aset! csg-data (+ base 12) (Double.to-float p0))

        (Array.aset! csg-data (+ base 13) (Double.to-float p1))

        (Array.aset! csg-data (+ base 14) (Double.to-float p2))

        (Array.aset! csg-data (+ base 15) (Double.to-float p3)))))



  (sig serialize-primitive! (Fn [(Ref SDF) (Ref (Array Float)) Int Bool] ()))

  (defn serialize-primitive! [sdf csg-data idx is-root]

    (let [base-shape (SDF.base sdf)

          pos (if is-root &(Vector3.init 0.0 0.0 0.0) (SDF.position sdf))

          rot (if is-root &(Quaternion.identity) (SDF.rotation sdf))

          scale @(SDF.scale sdf)

          shape-type 0

          p0 0.0

          p1 0.0

          p2 0.0

          p3 0.0]

      (do

        (match-ref base-shape

          (BaseShape.Ball r)

            (do

              (set! shape-type 1)

              (set! p0 @r))

          (BaseShape.Box e)

            (do

              (set! shape-type 2)

              (set! p0 @(Vector3.x e))

              (set! p1 @(Vector3.y e))

              (set! p2 @(Vector3.z e)))

          (BaseShape.Cylinder r h)

            (do

              (set! shape-type 3)

              (set! p0 @r)

              (set! p1 @h))

          (BaseShape.Capsule r h)

            (do

              (set! shape-type 4)

              (set! p0 @r)

              (set! p1 @h))

          (BaseShape.Torus rad-maj rad-min)

            (do

              (set! shape-type 5)

              (set! p0 @rad-maj)

              (set! p1 @rad-min))

          (BaseShape.Octahedron s)

            (do

              (set! shape-type 6)

              (set! p0 @s))

          _ ())

        (write-csg-node-raw! csg-data idx shape-type 0 -1 -1 pos scale rot p0 p1 p2 p3))))



  (sig serialize-sdf! (Fn [(Ref SDF) (Ref (Array Float)) (Ptr Int) Bool] Int))

  (defn serialize-sdf! [sdf csg-data next-idx-ptr is-root]

    (let [nodes (SDF.csg-nodes sdf)

          num-nodes (Array.length nodes)

          zero-v (Vector3.init 0.0 0.0 0.0)

          ident-q (Quaternion.identity)]

      (if (= num-nodes 0)

        (let [curr-idx (Pointer.to-value next-idx-ptr)]

          (do

            (serialize-primitive! sdf csg-data curr-idx is-root)

            (Pointer.set next-idx-ptr (+ curr-idx 1))

            curr-idx))

        (let [curr-lhs (let [curr-idx (Pointer.to-value next-idx-ptr)]

                         (do

                           (serialize-primitive! sdf csg-data curr-idx is-root)

                           (Pointer.set next-idx-ptr (+ curr-idx 1))

                           curr-idx))]

          (do

            (for [i 0 num-nodes]

              (let [child-node (Array.unsafe-nth nodes i)

                    child-op @(CsgNode.op child-node)

                    child-sdf (Box.peek (CsgNode.shape child-node))

                    child-idx (serialize-sdf! child-sdf csg-data next-idx-ptr false)

                    op-idx (Pointer.to-value next-idx-ptr)]

                (do

                  (write-csg-node-raw! csg-data op-idx 0 child-op curr-lhs child-idx

                    &zero-v 1.0 &ident-q 0.0 0.0 0.0 0.0)

                  (Pointer.set next-idx-ptr (+ op-idx 1))

                  (set! curr-lhs op-idx))))

            curr-lhs)))))



  (sig initialize-noise-texture! (Fn [(Ptr WGPUContext) (Ptr WGPURenderTexture)] ()))

  (defn initialize-noise-texture! [ctx noise-tex]

    (let [num-floats 131072

          noise-data (the (Array Float) (replicate num-floats &0.0f))]

      (do

        (for [i 0 num-floats]

          (Array.aset! &noise-data i (Float.random-between 0.0f 1.0f)))

        (WGPURender.update-3d-texture-subregion-floats ctx noise-tex 0 0 0 32 32 32 &noise-data))))



  (sig create (Fn [(Ptr WGPUContext) String Int Int (Ref (SpatialGrid Uint32)) (Ref Settings)] (Result WGPURenderer String)))

  (defn create [ctx format width height grid settings]

    (let [u-size WGPURenderer.header-size

          instances-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size)

          ray-steps @(Settings.ray-steps settings)

          shadow-steps @(Settings.shadow-steps settings)

          voxel-res @(Settings.voxel-resolution settings)

          shader (Shaders.shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell ray-steps shadow-steps voxel-res)

          s-size (* (GPUSpatial.required-floats grid WGPURenderer.max-ids-per-cell) 4)

          csg-size (* WGPURenderer.max-csg-nodes WGPURenderer.csg-node-size)

          u-data (the (Array Float) (replicate (/ u-size 4) &0.0f))

          instances-data (the (Array Float) (replicate (/ instances-size 4) &0.0f))

          s-data (the (Array Float) (replicate (/ s-size 4) &0.0f))

          csg-data (the (Array Float) (replicate (/ csg-size 4) &0.0f))

          v-gpu-b-size (* voxel-res (* voxel-res (* voxel-res 16)))

          v-half-b-size (* voxel-res (* voxel-res (* voxel-res 8)))
          v-packed-solids-half-b-size (* voxel-res (* voxel-res (* voxel-res 4)))
          v-baked-half-b-size (* voxel-res (* voxel-res (* voxel-res 4)))]

      (match (WGPURender.create-3d-texture ctx 384 384 384 "rg16float")

        (Result.Error e) (Result.Error (str* "3D Texture failed: " e))

        (Result.Success voxel-tex)

          (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba8unorm")

            (Result.Error e) (do (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D Baked Values Texture failed: " e)))

            (Result.Success voxel-baked-values-tex)

              (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba16float")

                (Result.Error e) (do (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D Light Texture failed: " e)))

                (Result.Success light-tex)

              (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba16float")

                (Result.Error e) (do (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D Interaction Texture failed: " e)))

                (Result.Success interaction-tex)

                  (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba8unorm")

                    (Result.Error e) (do (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D Water Texture failed: " e)))

                    (Result.Success water-tex)

                      (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba8unorm")

                        (Result.Error e) (do (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D Gas Texture failed: " e)))

                        (Result.Success gas-tex)

                          (match (WGPURender.create-3d-texture ctx 384 384 384 "rgba16float")

                            (Result.Error e) (do (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "3D EM Texture failed: " e)))

                            (Result.Success em-tex)

                              (match (WGPURender.create-sampler ctx)

                (Result.Error e) (do (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Sampler failed: " e)))

                (Result.Success voxel-samp)

                  (match (WGPURender.create-uniform-buffer ctx u-size)

                    (Result.Error e) (do (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Uniform failed: " e)))

                    (Result.Success ub)

                      (match (WGPU.create-buffer ctx instances-size)

                        (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Instances buffer failed: " e)))

                        (Result.Success inst-b)

                          (match (WGPU.create-buffer ctx s-size)

                        (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Storage failed: " e)))

                        (Result.Success sb)

                          (match (WGPU.create-buffer ctx csg-size)

                            (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "CSG buffer failed: " e)))

                            (Result.Success csg-b)

                                (match (WGPU.create-buffer ctx 133136)

                                (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Chunk lookup buffer failed: " e)))

                                (Result.Success chunk-lookup-b)

                                   (let [raw-lookup-buf chunk-lookup-b]

                                    (match (WGPURender.create-3d-texture ctx 32 32 32 "rgba16float")

                                      (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Noise 3D Texture failed: " e)))

                                      (Result.Success noise-tex)

                                        (match (WGPURender.create-sampler-repeat ctx)

                                          (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Noise Repeat Sampler failed: " e)))

                                          (Result.Success noise-samp)

                                            (do

                                              (WGPURenderer.initialize-noise-texture! ctx noise-tex)

                                              (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &@"rgba16float")

                                                (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Pipeline failed: " e)))

                                                 (Result.Success pipe)

                                                   (match (create-voxel-render-bind-group-chunked-em-result ctx pipe sb csg-b ub voxel-tex voxel-baked-values-tex light-tex interaction-tex water-tex gas-tex em-tex em-tex voxel-samp raw-lookup-buf noise-tex noise-samp inst-b)

                                                     (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Bind group failed: " e)))

                                                     (Result.Success bg)

                                                       (match (WGPURender.create-depth-texture ctx width height)

                                                         (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Depth failed: " e)))

                                                         (Result.Success dt)

                                                          (match (LinePass.create ctx @&format 10000)

                                                            (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "LinePass failed: " e)))

                                                            (Result.Success lp)

                                                              (let [gui-shader-src (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/gui.wgsl") (Result.Success s) s _ @"")

                                                                    gui-pipe (create-gui-pipeline ctx (String.cstr &gui-shader-src) (String.cstr "vs_main") (String.cstr "fs_main") (String.cstr &format) 48)]

                                                                (if (null-ptr? gui-pipe)

                                                                    (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error @"GUI Pipeline failed"))

                                                                    (match (WGPURender.create-uniform-buffer ctx 8)

                                                                        (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "GUI Uniform failed: " e)))

                                                                        (Result.Success gui-ubo)

                                                                          (match (WGPURender.create-render-texture ctx 512 512 "rgba8unorm")

                                                                            (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-uniform-buffer gui-ubo) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "GUI Font Texture failed: " e)))

                                                                            (Result.Success font-tex)

                                                                              (do

                                                                                (upload-font-texture! ctx font-tex)

                                                                                (match (WGPURender.create-sampler ctx)

                                                                                  (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-render-texture font-tex) (WGPURender.free-uniform-buffer gui-ubo) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "GUI Font Sampler failed: " e)))

                                                                                  (Result.Success font-samp)

                                                                                    (let [gui-bg (create-gui-bind-group ctx gui-pipe gui-ubo font-samp font-tex)]

                                                                                      (match (WGPU.create-buffer ctx v-gpu-b-size)

                                                                                        (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-uniform-buffer gui-ubo) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel GPU Buffer failed: " e)))

                                                                                        (Result.Success v-gpu-b)

                                                                                          (match (WGPU.create-buffer ctx v-packed-solids-half-b-size)

                                                                                            (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer v-gpu-b) (WGPURender.free-uniform-buffer gui-ubo) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel Half Buffer failed: " e)))

                                                                                            (Result.Success v-half-b)

                                                                                              (match (WGPU.create-buffer ctx v-baked-half-b-size)
                                                                                                (Result.Error e) (do (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-uniform-buffer gui-ubo) (WGPURender.free-geom-pipeline gui-pipe) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel Baked Values Half Buffer failed: " e)))
                                                                                                (Result.Success v-baked-half-b)
                                                                                                  (match (WGPU.create-buffer ctx 48)
                                                                                                (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer v-baked-half-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Carve params buffer failed: " e)))

                                                                                                (Result.Success c-params-b)

                                                                                                (match (WGPU.create-buffer ctx v-gpu-b-size)

                                                                                                  (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-baked-half-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Light scratch buffer failed: " e)))

