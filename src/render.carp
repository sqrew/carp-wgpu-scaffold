(deftemplate ints-array->ptr (Fn [(Ref (Array Int))] (Ptr Int))

  "int* $NAME(Array__int* arr)"

  "$DECL { return (int*)arr->data; }")



(deftemplate device-poll (Fn [(Ptr WGPUContext)] ())

  "void $NAME(WGPUContext* ctx)"

  "$DECL { wgpuDevicePoll(ctx->device, true, NULL); }")



(deftemplate uniform-buffer-get-buffer (Fn [(Ptr WGPUUniformBufferWrapper)] WGPUBuffer)

  "WGPUBuffer $NAME(WGPUUniformBufferWrapper* ub)"

  "$DECL { return ub->buffer; }")



(deftemplate null-ptr? (Fn [(Ptr a)] Bool)

  "bool $NAME(void* p)"

  "$DECL { return p == NULL; }")



(deftemplate array-zero-floats! (Fn [(Ref (Array Float))] ())

  "void $NAME(Array* arr)"

  "$DECL { if (arr->data) { memset(arr->data, 0, arr->len * sizeof(float)); } }")



(deftemplate wgpu-copy-3d-texture-to-buffer-offset (Fn [(Ptr WGPUContext) (Ptr WGPURenderTexture) Int Int Int WGPUBuffer Int Int Int Int] ())

  "void $NAME(WGPUContext* ctx, WGPURenderTexture* rt, uint32_t src_x, uint32_t src_y, uint32_t src_z, WGPUBuffer buffer, uint64_t buffer_offset, uint32_t width, uint32_t height, uint32_t depth)"

  "$DECL {

    WGPUCommandEncoder encoder = wgpuDeviceCreateCommandEncoder(ctx->device, NULL);

    

    WGPUTexelCopyTextureInfo source = {

        .texture = rt->texture,

        .mipLevel = 0,

        .origin = { .x = src_x, .y = src_y, .z = src_z },

        .aspect = WGPUTextureAspect_All,

    };



    WGPUTexelCopyBufferLayout data_layout = {

        .offset = buffer_offset,

        .bytesPerRow = width * 8, // RGBA16Float = 8 bytes per pixel

        .rowsPerImage = height,

    };



    WGPUTexelCopyBufferInfo destination = {

        .buffer = buffer,

        .layout = data_layout,

    };



    WGPUExtent3D write_size = {

        .width = width,

        .height = height,

        .depthOrArrayLayers = depth,

    };



    wgpuCommandEncoderCopyTextureToBuffer(encoder, &source, &destination, &write_size);

    

    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(encoder, NULL);

    wgpuCommandEncoderRelease(encoder);

    wgpuQueueSubmit(ctx->queue, 1, &cmd);

    wgpuCommandBufferRelease(cmd);

  }")

(deftemplate wgpu-write-texture-3d (Fn [(Ptr WGPUContext) (Ptr WGPURenderTexture) Int Int Int Int Int Int (Ptr Int) Int] ())
  "void $NAME(WGPUContext* ctx, WGPURenderTexture* rt, uint32_t dest_x, uint32_t dest_y, uint32_t dest_z, uint32_t width, uint32_t height, uint32_t depth, void* data, uint32_t bytes_per_pixel)"
  "$DECL {
    WGPUTexelCopyTextureInfo destination = {
        .texture = rt->texture,
        .mipLevel = 0,
        .origin = { .x = dest_x, .y = dest_y, .z = dest_z },
        .aspect = WGPUTextureAspect_All,
    };
    WGPUTexelCopyBufferLayout data_layout = {
        .offset = 0,
        .bytesPerRow = width * bytes_per_pixel,
        .rowsPerImage = height,
    };
    WGPUExtent3D write_size = {
        .width = width,
        .height = height,
        .depthOrArrayLayers = depth,
    };
    wgpuQueueWriteTexture(ctx->queue, &destination, data, width * height * depth * bytes_per_pixel, &data_layout, &write_size);
  }")

(deftemplate wgpu-clear-3d-texture-atlas (Fn [(Ptr WGPUContext) (Ptr WGPURenderTexture) WGPUBuffer Int] ())

  "void $NAME(WGPUContext* ctx, WGPURenderTexture* rt, WGPUBuffer zero_buf, int voxel_res)"

  "$DECL {

    WGPUCommandEncoder encoder = wgpuDeviceCreateCommandEncoder(ctx->device, NULL);

    wgpuCommandEncoderClearBuffer(encoder, zero_buf, 0, wgpuBufferGetSize(zero_buf));

    uint32_t slots_per_dim = 384 / voxel_res;

    uint32_t slots_per_dim_sq = slots_per_dim * slots_per_dim;

    uint32_t total_slots = slots_per_dim_sq * slots_per_dim;

    for (uint32_t slot = 0; slot < total_slots; slot++) {

        uint32_t slot_x = slot % slots_per_dim;

        uint32_t slot_y = (slot / slots_per_dim) % slots_per_dim;

        uint32_t slot_z = slot / slots_per_dim_sq;

        uint32_t dest_x = slot_x * voxel_res;

        uint32_t dest_y = slot_y * voxel_res;

        uint32_t dest_z = slot_z * voxel_res;

        

        WGPUTexelCopyTextureInfo destination = {

            .texture = rt->texture,

            .mipLevel = 0,

            .origin = { .x = dest_x, .y = dest_y, .z = dest_z },

            .aspect = WGPUTextureAspect_All,

        };



        WGPUTexelCopyBufferLayout data_layout = {

            .offset = 0,

            .bytesPerRow = voxel_res * 8,

            .rowsPerImage = voxel_res,

        };



        WGPUTexelCopyBufferInfo source = {

            .buffer = zero_buf,

            .layout = data_layout,

        };



        WGPUExtent3D write_size = {

            .width = voxel_res,

            .height = voxel_res,

            .depthOrArrayLayers = voxel_res,

        };



        wgpuCommandEncoderCopyBufferToTexture(encoder, &source, &destination, &write_size);

    }

    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(encoder, NULL);

    wgpuCommandEncoderRelease(encoder);

    wgpuQueueSubmit(ctx->queue, 1, &cmd);

    wgpuCommandBufferRelease(cmd);

    wgpuDevicePoll(ctx->device, 1, NULL);

  }")



(deftemplate create-voxel-render-bind-group-chunked-em (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper)

                                                            WGPUBuffer WGPUBuffer (Ptr WGPUUniformBufferWrapper)

                                                            (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) WGPUSampler WGPUBuffer

                                                            (Ptr WGPURenderTexture) WGPUSampler WGPUBuffer] WGPUBindGroup)

  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPURenderPipelineWrapper* pipe, WGPUBuffer storage_buf1, WGPUBuffer storage_buf2, WGPUUniformBufferWrapper* ub, WGPURenderTexture* voxel_tex, WGPURenderTexture* voxel_baked_values_tex, WGPURenderTexture* fields_tex, WGPURenderTexture* interaction_tex, WGPURenderTexture* water_tex, WGPURenderTexture* gas_tex, WGPURenderTexture* em_tex, WGPURenderTexture* gravity_tex, WGPUSampler voxel_sampler, WGPUBuffer chunk_lookup_buf, WGPURenderTexture* noise_tex, WGPUSampler noise_sampler, WGPUBuffer instances_buf)"

  "$DECL {

    if (!ctx || !pipe || !ub || !voxel_tex || !voxel_baked_values_tex || !fields_tex || !interaction_tex || !water_tex || !gas_tex || !em_tex || !gravity_tex || !voxel_sampler || !chunk_lookup_buf || !noise_tex || !noise_sampler || !instances_buf) {

        return NULL;

    }



    WGPUBindGroupLayout layout = wgpuRenderPipelineGetBindGroupLayout(pipe->pipeline, 0);

    if (!layout) {

        return NULL;

    }



    WGPUBindGroupEntry entries[16] = {

        { .binding = 0, .buffer = storage_buf1, .offset = 0, .size = WGPU_WHOLE_SIZE },

        { .binding = 1, .buffer = ub->buffer, .offset = 0, .size = ub->size },

        { .binding = 2, .buffer = storage_buf2, .offset = 0, .size = WGPU_WHOLE_SIZE },

        { .binding = 3, .textureView = voxel_tex->view },

        { .binding = 4, .sampler = voxel_sampler },

        { .binding = 5, .buffer = chunk_lookup_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },

        { .binding = 6, .textureView = noise_tex->view },

        { .binding = 7, .sampler = noise_sampler },

        { .binding = 8, .textureView = fields_tex->view },

        { .binding = 9, .textureView = interaction_tex->view },

        { .binding = 10, .textureView = water_tex->view },

        { .binding = 11, .textureView = gas_tex->view },

        { .binding = 12, .textureView = em_tex->view },

        { .binding = 13, .textureView = gravity_tex->view },

        { .binding = 14, .buffer = instances_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },

        { .binding = 15, .textureView = voxel_baked_values_tex->view }

    };



    WGPUBindGroupDescriptor desc = {

        .layout = layout,

        .entryCount = 16,

        .entries = entries,

    };



    WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);

    wgpuBindGroupLayoutRelease(layout);

    return bg;

  }")



(defn create-voxel-render-bind-group-chunked-em-result [ctx pipeline storage-buf1 storage-buf2 ub voxel-tex voxel-baked-values-tex fields-tex interaction-tex water-tex gas-tex em-tex gravity-tex voxel-sampler chunk-lookup-buf noise-tex noise-sampler instances-buf]

  (let [bg (create-voxel-render-bind-group-chunked-em ctx pipeline storage-buf1 storage-buf2 ub voxel-tex voxel-baked-values-tex fields-tex interaction-tex water-tex gas-tex em-tex gravity-tex voxel-sampler chunk-lookup-buf noise-tex noise-sampler instances-buf)]

    (if (WGPURender.bindgroup-null?- bg)

      (Result.Error @"EM Bind group creation failed")

      (Result.Success bg))))



(deftemplate create-jit-bind-group-em (Fn [(Ptr WGPUContext) WGPUComputePipeline WGPUBuffer WGPUBuffer WGPUBuffer WGPUBuffer WGPUBuffer (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) (Ptr WGPURenderTexture) WGPUBuffer] WGPUBindGroup)
  "WGPUBindGroup $NAME(WGPUContext* ctx, WGPUComputePipeline pipeline, WGPUBuffer input_buf, WGPUBuffer output_buf, WGPUBuffer uniform_buf, WGPUBuffer chunk_info_buf, WGPUBuffer chunk_lookup_buf, WGPURenderTexture* voxel_tex, WGPURenderTexture* voxel_baked_values_tex, WGPURenderTexture* water_tex, WGPURenderTexture* gas_tex, WGPURenderTexture* em_tex, WGPURenderTexture* gravity_tex, WGPUBuffer instances_buf)"
  "$DECL {
    if (!ctx || !pipeline || !input_buf || !output_buf || !uniform_buf || !chunk_info_buf || !chunk_lookup_buf || !voxel_tex || !voxel_baked_values_tex || !water_tex || !gas_tex || !em_tex || !gravity_tex || !instances_buf) {
        return NULL;
    }

    WGPUBindGroupLayout layout = wgpuComputePipelineGetBindGroupLayout(pipeline, 0);
    if (!layout) {
        return NULL;
    }

    WGPUBindGroupEntry entries[12] = {
        { .binding = 0, .buffer = input_buf, .offset = 0, .size = wgpuBufferGetSize(input_buf) },
        { .binding = 1, .buffer = output_buf, .offset = 0, .size = wgpuBufferGetSize(output_buf) },
        { .binding = 2, .buffer = uniform_buf, .offset = 0, .size = wgpuBufferGetSize(uniform_buf) },
        { .binding = 3, .buffer = chunk_info_buf, .offset = 0, .size = wgpuBufferGetSize(chunk_info_buf) },
        { .binding = 4, .buffer = chunk_lookup_buf, .offset = 0, .size = wgpuBufferGetSize(chunk_lookup_buf) },
        { .binding = 5, .textureView = voxel_tex->view },
        { .binding = 6, .textureView = water_tex->view },
        { .binding = 7, .textureView = gas_tex->view },
        { .binding = 8, .textureView = em_tex->view },
        { .binding = 9, .textureView = gravity_tex->view },
        { .binding = 10, .buffer = instances_buf, .offset = 0, .size = WGPU_WHOLE_SIZE },
        { .binding = 11, .textureView = voxel_baked_values_tex->view }
    };

    WGPUBindGroupDescriptor desc = {
        .layout = layout,
        .entries = entries,
        .entryCount = 12,
    };



    WGPUBindGroup bg = wgpuDeviceCreateBindGroup(ctx->device, &desc);

    wgpuBindGroupLayoutRelease(layout);

    return bg;

  }")



(defn create-jit-bind-group-em-result [ctx pipeline input-buf output-buf uniform-buf chunk-info-buf chunk-lookup-buf voxel-tex voxel-baked-values-tex water-tex gas-tex em-tex gravity-tex instances-buf]
  (let [bg (create-jit-bind-group-em ctx pipeline input-buf output-buf uniform-buf chunk-info-buf chunk-lookup-buf voxel-tex voxel-baked-values-tex water-tex gas-tex em-tex gravity-tex instances-buf)]

    (if (WGPURender.bindgroup-null?- bg)

      (Result.Error @"JIT EM Bind group creation failed")

      (Result.Success bg))))



