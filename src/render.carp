(load "WGPU.carp")
(load "WGPURender.carp")
(load "../carp-gamecam/camera.carp")
(load "../carp-transform/transform.carp")
(load "../carp-rigidbody/rigidbody.carp")
(load "commands.carp")
(load "line_pass.carp")
(load "gpu_spatial.carp")

(use WGPU)
(use WGPURender)
(use Camera)
(use Transform)
(use RigidBody)
(use LinePass)
(use GPUSpatial)

(deftype Renderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  u-buffer (Ptr WGPUUniformBufferWrapper)
  s-buffer WGPUBuffer
  bind-group WGPUBindGroup
  depth-texture (Ptr WGPUDepthTexture)
  line-pass LinePass
  commands (Array RenderCommand)
])

(defmodule Renderer
  (def max-spheres 64)
  (def max-ids-per-cell 16)
  (def header-size 96)
  (def sphere-data-size 32)

  (defn shader-wgsl [limit max-ids]
    (str*
      "struct SphereData {
          pos: vec4<f32>,
          rot: vec4<f32>,
      }
      struct Cell {
          count: f32,
          ids: array<f32, " (Int.str max-ids) ">,
      }
      struct Uniforms { 
          time: f32, 
          width: f32, 
          height: f32, 
          cell_size: f32,
          cam_pos: vec4<f32>, 
          cam_dir: vec4<f32>,
          cam_right: vec4<f32>,
          cam_up: vec4<f32>,
          bg_color: vec4<f32>,
          grid_dims: vec4<f32>,
          spheres: array<SphereData, " (Int.str limit) ">
      }
      @group(0) @binding(0) var<storage, read> grid: array<Cell>;
      @group(0) @binding(1) var<uniform> u: Uniforms;

      struct VertexOutput {
          @builtin(position) position: vec4<f32>,
          @location(0) uv: vec2<f32>,
      }

      @vertex
      fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
          var pos = array<vec2<f32>, 3>(
              vec2<f32>(-1.0, -1.0),
              vec2<f32>( 3.0, -1.0),
              vec2<f32>(-1.0,  3.0)
          );
          var out: VertexOutput;
          out.position = vec4<f32>(pos[vi], 0.0, 1.0);
          out.uv = pos[vi];
          return out;
      }

      fn sdPlane(p: vec3<f32>, n: vec3<f32>, h: f32) -> f32 {
          return dot(p, n) + h;
      }

      fn sdSphere(p: vec3<f32>, s: f32) -> f32 {
          return length(p) - s;
      }

      fn rotateVector(v: vec3<f32>, q: vec4<f32>) -> vec3<f32> {
          return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
      }

      fn q_inv(q: vec4<f32>) -> vec4<f32> {
          return vec4<f32>(-q.xyz, q.w);
      }

      fn worldSDF(p: vec3<f32>, rd: vec3<f32>) -> f32 {
          var d = sdPlane(p, vec3<f32>(0.0, 1.0, 0.0), 0.0);
          let gx = i32(floor(p.x / u.cell_size));
          let gy = i32(floor(p.y / u.cell_size));
          let gz = i32(floor(p.z / u.cell_size));
          if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
              let cell_min = vec3<f32>(f32(gx), f32(gy), f32(gz)) * u.cell_size;
              let cell_max = cell_min + vec3<f32>(u.cell_size);
              var t_exit = 100.0;
              if (rd.x > 0.0001) { t_exit = min(t_exit, (cell_max.x - p.x) / rd.x); }
              else if (rd.x < -0.0001) { t_exit = min(t_exit, (cell_min.x - p.x) / rd.x); }
              if (rd.y > 0.0001) { t_exit = min(t_exit, (cell_max.y - p.y) / rd.y); }
              else if (rd.y < -0.0001) { t_exit = min(t_exit, (cell_min.y - p.y) / rd.y); }
              if (rd.z > 0.0001) { t_exit = min(t_exit, (cell_max.z - p.z) / rd.z); }
              else if (rd.z < -0.0001) { t_exit = min(t_exit, (cell_min.z - p.z) / rd.z); }
              let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
              let cell = grid[idx];
              let count = min(i32(cell.count), " (Int.str max-ids) ");
              for(var i = 0; i < count; i = i + 1) {
                  let s_idx = i32(cell.ids[i]);
                  let s_data = u.spheres[s_idx];
                  d = min(d, sdSphere(p - s_data.pos.xyz, s_data.pos.w));
              }
              return min(d, max(t_exit + 0.01, 0.05));
          } else {
             for(var i = 0; i < " (Int.str limit) "; i = i + 1) {
                let s_data = u.spheres[i];
                if (s_data.pos.w > 0.0) { d = min(d, sdSphere(p - s_data.pos.xyz, s_data.pos.w)); }
             }
             return d;
          }
      }

      @fragment
      fn fs_main(frag_in: VertexOutput) -> @location(0) vec4<f32> {
          let aspect = u.width / u.height;
          let uv = frag_in.uv * vec2<f32>(aspect, 1.0);
          let ro = u.cam_pos.xyz;
          let rd = normalize(uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz + u.cam_dir.xyz * 1.5);
          var t = 0.0;
          var hit = false;
          for(var i = 0; i < 80; i = i + 1) {
              let p = ro + rd * t;
              let d = worldSDF(p, rd);
              if (d < 0.001) { hit = true; break; }
              t += d;
              if (t > 100.0) { break; }
          }
          var color = u.bg_color.rgb;
          if (hit) {
              let p = ro + rd * t;
              if (p.y > 0.1) {
                  var minDist = 100.0;
                  var hitId = -1;
                  let gx = i32(floor(p.x / u.cell_size));
                  let gy = i32(floor(p.y / u.cell_size));
                  let gz = i32(floor(p.z / u.cell_size));
                  if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
                      let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
                      let cell = grid[idx];
                      let count = min(i32(cell.count), " (Int.str max-ids) ");
                      for(var i = 0; i < count; i = i + 1) {
                          let s_idx = i32(cell.ids[i]);
                          let s_dist = sdSphere(p - u.spheres[s_idx].pos.xyz, u.spheres[s_idx].pos.w);
                          if (s_dist < minDist) { minDist = s_dist; hitId = s_idx; }
                      }
                  } else {
                      for(var i = 0; i < " (Int.str limit) "; i = i + 1) {
                          let s_data = u.spheres[i];
                          if (s_data.pos.w > 0.0) {
                              let s_dist = sdSphere(p - s_data.pos.xyz, s_data.pos.w);
                              if (s_dist < minDist) { minDist = s_dist; hitId = i; }
                          }
                      }
                  }
                  color = vec3<f32>(0.9, 0.9, 0.9);
                  if (hitId != -1) {
                      let s_data = u.spheres[hitId];
                      let lp = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                      let stripe = sin(lp.y * 10.0);
                      let check = smoothstep(-0.1, 0.1, stripe);
                      color = mix(vec3<f32>(0.8, 0.2, 0.2), vec3<f32>(0.9, 0.9, 0.9), check);
                  }
                  let n = normalize(p - ro);
                  color *= dot(n, vec3<f32>(0.0, 1.0, 0.0)) * 0.5 + 0.5;
              } else {
                  let grid_v = sin(p.x * 2.0) * sin(p.z * 2.0);
                  let check = smoothstep(-0.1, 0.1, grid_v);
                  color = mix(color * 0.5, color * 1.5, check);
              }
              color = mix(color, u.bg_color.rgb, 1.0 - exp(-0.02 * t));
          }
          return vec4<f32>(color, 1.0);
      }
    "))

  (defn create [ctx format width height grid]
    (let [u-size (+ (+ Renderer.header-size 16) (* Renderer.max-spheres Renderer.sphere-data-size))
          shader (shader-wgsl Renderer.max-spheres Renderer.max-ids-per-cell)
          s-size (GPUSpatial.required-floats grid Renderer.max-ids-per-cell)]
      (match (WGPURender.create-uniform-buffer ctx u-size)
        (Result.Error e) (Result.Error (str* "Uniform failed: " e))
        (Result.Success ub)
          (match (WGPU.create-buffer ctx s-size)
            (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Storage failed: " e)))
            (Result.Success sb)
              (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &format)
                (Result.Error e) (do (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Pipeline failed: " e)))
                (Result.Success pipe)
                  (match (WGPURender.create-render-storage-uniform-bind-group ctx pipe sb ub)
                    (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Bind group failed: " e)))
                    (Result.Success bg)
                      (match (WGPURender.create-depth-texture ctx width height)
                        (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "Depth failed: " e)))
                        (Result.Success dt)
                          (match (LinePass.create ctx format 1000)
                            (Result.Error e) (do (WGPURender.free-depth-texture dt) (WGPURender.free-pipeline pipe) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (Result.Error (str* "LinePass failed: " e)))
                            (Result.Success lp)
                              (Result.Success (Renderer.init pipe ub sb bg dt lp []))))))))))

  (defn clear! [ren]
    (let [cmds (Renderer.commands ren)]
      (while (not (Array.empty? cmds))
        (ignore (Array.pop-back! cmds)))))

  (defn submit! [ren cmd]
    (Array.push-back! (Renderer.commands ren) cmd))

  (defn process-commands! [ctx ren time width height cam grid entities]
    (let [bg-color (Vector3.init 0.1 0.1 0.1)
          commands (Renderer.commands ren)
          vp (Camera.view-projection cam)
          vp-data (CameraMat4.data &vp)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols (Double.from-int @(SpatialGrid.cols grid))
          rows (Double.from-int @(SpatialGrid.rows grid))
          layers (Double.from-int @(SpatialGrid.layers grid))
          data [ (Double.to-float time)
                 (Double.to-float (Double.from-int width))
                 (Double.to-float (Double.from-int height))
                 (Double.to-float cell-size)
                 (Double.to-float @(Vector3.x cam-pos))
                 (Double.to-float @(Vector3.y cam-pos))
                 (Double.to-float @(Vector3.z cam-pos))
                 1.0f
                 (Double.to-float @(Vector3.x cam-dir))
                 (Double.to-float @(Vector3.y cam-dir))
                 (Double.to-float @(Vector3.z cam-dir))
                 0.0f
                 (Double.to-float @(Vector3.x cam-right))
                 (Double.to-float @(Vector3.y cam-right))
                 (Double.to-float @(Vector3.z cam-right))
                 0.0f
                 (Double.to-float @(Vector3.x cam-up))
                 (Double.to-float @(Vector3.y cam-up))
                 (Double.to-float @(Vector3.z cam-up))
                 0.0f]]
      (do
        (for [i 0 (Array.length commands)]
          (match-ref (Array.unsafe-nth commands i)
            (RenderCommand.SetBg bg) (set! bg-color @bg)
            _ ()))
        (Array.push-back! &data (Double.to-float @(Vector3.x &bg-color)))
        (Array.push-back! &data (Double.to-float @(Vector3.y &bg-color)))
        (Array.push-back! &data (Double.to-float @(Vector3.z &bg-color)))
        (Array.push-back! &data 1.0f)
        (Array.push-back! &data (Double.to-float cols))
        (Array.push-back! &data (Double.to-float rows))
        (Array.push-back! &data (Double.to-float layers))
        (Array.push-back! &data 0.0f)
        (let [sphere-count 0]
          (do
            (for [i 0 (Array.length commands)]
              (when (< sphere-count Renderer.max-spheres)
                (match-ref (Array.unsafe-nth commands i)
                  (RenderCommand.DrawSdf pos radius rot)
                    (do
                      (Array.push-back! &data (Double.to-float @(Vector3.x pos)))
                      (Array.push-back! &data (Double.to-float @(Vector3.y pos)))
                      (Array.push-back! &data (Double.to-float @(Vector3.z pos)))
                      (Array.push-back! &data (Double.to-float @radius))
                      (Array.push-back! &data (Double.to-float @(Quaternion.x rot)))
                      (Array.push-back! &data (Double.to-float @(Quaternion.y rot)))
                      (Array.push-back! &data (Double.to-float @(Quaternion.z rot)))
                      (Array.push-back! &data (Double.to-float @(Quaternion.w rot)))
                      (set! sphere-count (inc sphere-count)))
                  _ ())))
            (for [i sphere-count Renderer.max-spheres]
              (do (for [j 0 8] (Array.push-back! &data 0.0f))))))
        (WGPURender.update-uniform-buffer ctx @(Renderer.u-buffer ren) &data)
        (let [flat-grid (GPUSpatial.flatten grid Renderer.max-ids-per-cell)]
          (WGPU.write-floats ctx @(Renderer.s-buffer ren) &flat-grid))
        (LinePass.update! ctx (Renderer.line-pass ren) vp-data commands))))

  (defn draw [surf ctx ren line-count]
    (match (WGPURender.begin-frame surf ctx)
      (Result.Error _) ()
      (Result.Success frame)
        (do
          (WGPURender.run-pass frame @(Renderer.pipeline ren) @(Renderer.bind-group ren) (Maybe.Nothing))
          (LinePass.render frame ctx (Renderer.line-pass ren) line-count @(Renderer.depth-texture ren))
          (WGPURender.end-frame frame surf ctx)
          (WGPURender.free-frame frame))))
)
