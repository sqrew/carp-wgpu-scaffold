;; render.carp
(load "shaders.carp")
(load "noise.carp")

(use WGPU)
(use WGPURender)
(use Camera)
(use Transform)
(use RigidBody)
(use LinePass)
(use GPUSpatial)
(use ECS)
(use GeometryRef)

(register wgpu-create-render-two-storage-uniform-bind-group
  (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper) WGPUBuffer WGPUBuffer (Ptr WGPUUniformBufferWrapper)] WGPUBindGroup)
  "wgpu_create_render_two_storage_uniform_bind_group")

(register wgpu-write-buffer-ints
  (Fn [(Ptr WGPUContext) WGPUBuffer (Ptr Int) Uint64] ())
  "wgpu_write_buffer")

(deftemplate ints-array->ptr (Fn [(Ref (Array Int))] (Ptr Int))
  "int* $NAME(Array__int* arr)"
  "$DECL { return (int*)arr->data; }")

(deftemplate uniform-buffer-get-buffer (Fn [(Ptr WGPUUniformBufferWrapper)] WGPUBuffer)
  "WGPUBuffer $NAME(WGPUUniformBufferWrapper* ub)"
  "$DECL { return ub->buffer; }")

(deftemplate array-zero-floats! (Fn [(Ref (Array Float))] ())
  "void $NAME(Array* arr)"
  "$DECL { if (arr->data) { memset(arr->data, 0, arr->len * sizeof(float)); } }")

(deftype WGPURenderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  u-buffer (Ptr WGPUUniformBufferWrapper)
  s-buffer WGPUBuffer
  csg-buffer WGPUBuffer
  bind-group WGPUBindGroup
  depth-texture (Ptr WGPUDepthTexture)
  line-pass LinePassRenderer
  commands (Array RenderCommand)
  u-data (Array Float)
  s-data (Array Float)
  csg-data (Array Float)
  voxel-texture (Ptr WGPURenderTexture)
  voxel-sampler WGPUSampler
  voxel-data (Array Float)
  voxel-dirty Bool
  carve-pipeline WGPUComputePipeline
  pack-pipeline WGPUComputePipeline
  voxel-gpu-buffer WGPUBuffer
  voxel-half-buffer WGPUBuffer
  carve-params-buffer WGPUBuffer
  chunk-lookup-buffer (Ptr WGPUUniformBufferWrapper)
  noise-texture (Ptr WGPURenderTexture)
  noise-sampler WGPUSampler
])

(defmodule VoxelBaker
  (sig bake-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Array SDF)) (Ref (Array Float))] ()))
  (sig bake-voxel-grid! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref (SpatialGrid Uint32)) (Ref GameWorld) (Ref World)] ()))
  (sig chunk-overlaps-sphere? (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double] Bool))
  (sig carve-voxel-grid-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Vector3 Double)) Double] ()))
  (sig build-voxel-grid-gpu! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Vector3 Double)) Double] ()))
  (sig carve-voxel-grid-cpu! (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double] ()))
  (sig build-voxel-grid-cpu! (Fn [(Ref Chunk) (Ref (Vector3 Double)) Double] ()))
  (sig pack-and-copy-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) Int] ()))
)

(defmodule WGPURenderer
  (def max-spheres 512)
  (def max-ids-per-cell 64)
  (def header-size 144)
  (def sphere-data-size 64)
  (def max-csg-nodes 1024)
  (def csg-node-size 64)

  (sig float-from-int (Fn [Int] Float))
  (defn float-from-int [x]
    (Double.to-float (Double.from-int x)))

  (sig write-ints (Fn [(Ptr WGPUContext) WGPUBuffer (Ref (Array Int))] ()))
  (defn write-ints [ctx buf arr]
    (wgpu-write-buffer-ints ctx buf (ints-array->ptr arr) (Uint64.from-long (Long.from-int (* (Array.length arr) 4)))))

  (sig write-csg-node-raw! (Fn [(Ref (Array Float)) Int Int Int Int Int (Ref (Vector3 Double)) Double (Ref Quaternion) Double Double Double Double] ()))
  (defn write-csg-node-raw! [csg-data idx shape-type op-type left-child right-child pos scale rot p0 p1 p2 p3]
    (let [base (* idx 16)]
      (do
        (Array.aset! csg-data base (WGPURenderer.float-from-int shape-type))
        (Array.aset! csg-data (+ base 1) (WGPURenderer.float-from-int op-type))
        (Array.aset! csg-data (+ base 2) (WGPURenderer.float-from-int left-child))
        (Array.aset! csg-data (+ base 3) (WGPURenderer.float-from-int right-child))
        (Array.aset! csg-data (+ base 4) (Double.to-float @(Vector3.x pos)))
        (Array.aset! csg-data (+ base 5) (Double.to-float @(Vector3.y pos)))
        (Array.aset! csg-data (+ base 6) (Double.to-float @(Vector3.z pos)))
        (Array.aset! csg-data (+ base 7) (Double.to-float scale))
        (Array.aset! csg-data (+ base 8) (Double.to-float @(Quaternion.x rot)))
        (Array.aset! csg-data (+ base 9) (Double.to-float @(Quaternion.y rot)))
        (Array.aset! csg-data (+ base 10) (Double.to-float @(Quaternion.z rot)))
        (Array.aset! csg-data (+ base 11) (Double.to-float @(Quaternion.w rot)))
        (Array.aset! csg-data (+ base 12) (Double.to-float p0))
        (Array.aset! csg-data (+ base 13) (Double.to-float p1))
        (Array.aset! csg-data (+ base 14) (Double.to-float p2))
        (Array.aset! csg-data (+ base 15) (Double.to-float p3)))))

  (sig serialize-primitive! (Fn [(Ref SDF) (Ref (Array Float)) Int Bool] ()))
  (defn serialize-primitive! [sdf csg-data idx is-root]
    (let [base-shape (SDF.base sdf)
          pos (if is-root &(Vector3.init 0.0 0.0 0.0) (SDF.position sdf))
          rot (if is-root &(Quaternion.identity) (SDF.rotation sdf))
          scale @(SDF.scale sdf)
          shape-type 0
          p0 0.0
          p1 0.0
          p2 0.0
          p3 0.0]
      (do
        (match-ref base-shape
          (BaseShape.Ball r)
            (do
              (set! shape-type 1)
              (set! p0 @r))
          (BaseShape.Box e)
            (do
              (set! shape-type 2)
              (set! p0 @(Vector3.x e))
              (set! p1 @(Vector3.y e))
              (set! p2 @(Vector3.z e)))
          (BaseShape.Cylinder r h)
            (do
              (set! shape-type 3)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Capsule r h)
            (do
              (set! shape-type 4)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Torus rad-maj rad-min)
            (do
              (set! shape-type 5)
              (set! p0 @rad-maj)
              (set! p1 @rad-min))
          (BaseShape.Octahedron s)
            (do
              (set! shape-type 6)
              (set! p0 @s))
          _ ())
        (write-csg-node-raw! csg-data idx shape-type 0 -1 -1 pos scale rot p0 p1 p2 p3))))

  (sig serialize-sdf! (Fn [(Ref SDF) (Ref (Array Float)) (Ptr Int) Bool] Int))
  (defn serialize-sdf! [sdf csg-data next-idx-ptr is-root]
    (let [nodes (SDF.csg-nodes sdf)
          num-nodes (Array.length nodes)
          zero-v (Vector3.init 0.0 0.0 0.0)
          ident-q (Quaternion.identity)]
      (if (= num-nodes 0)
        (let [curr-idx (Pointer.to-value next-idx-ptr)]
          (do
            (serialize-primitive! sdf csg-data curr-idx is-root)
            (Pointer.set next-idx-ptr (+ curr-idx 1))
            curr-idx))
        (let [curr-lhs (let [curr-idx (Pointer.to-value next-idx-ptr)]
                         (do
                           (serialize-primitive! sdf csg-data curr-idx is-root)
                           (Pointer.set next-idx-ptr (+ curr-idx 1))
                           curr-idx))]
          (do
            (for [i 0 num-nodes]
              (let [child-node (Array.unsafe-nth nodes i)
                    child-op @(CsgNode.op child-node)
                    child-sdf (Box.peek (CsgNode.shape child-node))
                    child-idx (serialize-sdf! child-sdf csg-data next-idx-ptr false)
                    op-idx (Pointer.to-value next-idx-ptr)]
                (do
                  (write-csg-node-raw! csg-data op-idx 0 child-op curr-lhs child-idx
                    &zero-v 1.0 &ident-q 0.0 0.0 0.0 0.0)
                  (Pointer.set next-idx-ptr (+ op-idx 1))
                  (set! curr-lhs op-idx))))
            curr-lhs)))))

  (sig initialize-noise-texture! (Fn [(Ptr WGPUContext) (Ptr WGPURenderTexture)] ()))
  (defn initialize-noise-texture! [ctx noise-tex]
    (let [num-floats 131072
          noise-data (the (Array Float) (replicate num-floats &0.0f))]
      (do
        (for [i 0 num-floats]
          (Array.aset! &noise-data i (Float.random-between 0.0f 1.0f)))
        (WGPURender.update-3d-texture-subregion-floats ctx noise-tex 0 0 0 32 32 32 &noise-data))))

  (defn create [ctx format width height grid]
    (let [u-size (+ WGPURenderer.header-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size))
          shader (Shaders.shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell)
          s-size (* (GPUSpatial.required-floats grid WGPURenderer.max-ids-per-cell) 4)
          csg-size (* WGPURenderer.max-csg-nodes WGPURenderer.csg-node-size)
          u-data (the (Array Float) (replicate (/ u-size 4) &0.0f))
          s-data (the (Array Float) (replicate (/ s-size 4) &0.0f))
          csg-data (the (Array Float) (replicate (/ csg-size 4) &0.0f))]
      (match (WGPURender.create-3d-texture ctx 256 256 256 "rgba16float")
        (Result.Error e) (Result.Error (str* "3D Texture failed: " e))
        (Result.Success voxel-tex)
          (match (WGPURender.create-sampler ctx)
            (Result.Error e) (do (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Sampler failed: " e)))
            (Result.Success voxel-samp)
              (match (WGPURender.create-uniform-buffer ctx u-size)
                (Result.Error e) (do (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Uniform failed: " e)))
                (Result.Success ub)
                  (match (WGPU.create-buffer ctx s-size)
                    (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Storage failed: " e)))
                    (Result.Success sb)
                      (match (WGPU.create-buffer ctx csg-size)
                        (Result.Error e) (do (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "CSG buffer failed: " e)))
                        (Result.Success csg-b)
                          (match (WGPURender.create-uniform-buffer ctx 2064)
                            (Result.Error e) (do (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Chunk lookup buffer failed: " e)))
                            (Result.Success chunk-lookup-b)
                               (let [raw-lookup-buf (uniform-buffer-get-buffer chunk-lookup-b)]
                                (match (WGPURender.create-3d-texture ctx 32 32 32 "rgba16float")
                                  (Result.Error e) (do (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Noise 3D Texture failed: " e)))
                                  (Result.Success noise-tex)
                                    (match (WGPURender.create-sampler-repeat ctx)
                                      (Result.Error e) (do (WGPURender.free-render-texture noise-tex) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Noise Repeat Sampler failed: " e)))
                                      (Result.Success noise-samp)
                                        (do
                                          (WGPURenderer.initialize-noise-texture! ctx noise-tex)
                                          (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &format)
                                            (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Pipeline failed: " e)))
                                            (Result.Success pipe)
                                              (match (WGPURender.create-voxel-render-bind-group-chunked ctx pipe sb csg-b ub voxel-tex voxel-samp raw-lookup-buf noise-tex noise-samp)
                                                (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Bind group failed: " e)))
                                                (Result.Success bg)
                                                  (match (WGPURender.create-depth-texture ctx width height)
                                                    (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Depth failed: " e)))
                                                    (Result.Success dt)
                                                      (match (LinePass.create ctx format 10000)
                                                        (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "LinePass failed: " e)))
                                                        (Result.Success lp)
                                                          (match (WGPU.create-buffer ctx 524288)
                                                            (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel GPU Buffer failed: " e)))
                                                            (Result.Success v-gpu-b)
                                                              (match (WGPU.create-buffer ctx 262144)
                                                                (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel Half Buffer failed: " e)))
                                                                (Result.Success v-half-b)
                                                                  (match (WGPU.create-buffer ctx 12)
                                                                    (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Carve params buffer failed: " e)))
                                                                    (Result.Success c-params-b)
                                                                      (match (WGPU.create-pipeline ctx Shaders.carve-shader "main")
                                                                        (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Carve pipeline failed: " e)))
                                                                        (Result.Success c-pipe)
                                                                          (match (WGPU.create-pipeline ctx Shaders.pack-shader "main")
                                                                            (Result.Error e) (do (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-pipeline c-pipe) (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Pack pipeline failed: " e)))
                                                                            (Result.Success p-pipe)
                                                                               (Result.Success (WGPURenderer.init pipe ub sb csg-b bg dt lp [] u-data s-data csg-data voxel-tex voxel-samp [] true c-pipe p-pipe v-gpu-b v-half-b c-params-b chunk-lookup-b noise-tex noise-samp)))))))))))))))))))))))



  (defn clear! [ren]
    (let [cmds (WGPURenderer.commands ren)]
      (while (not (Array.empty? cmds))
        (ignore (Array.pop-back! cmds)))))

  (defn submit! [ren cmd]
    (Array.push-back! (WGPURenderer.commands ren) cmd))

  (defn process-commands! [ctx ren time width height cam grid world world-data csg-dirty grid-dirty voxel-dirty craters metaball-k view-mode shadow-quality show-debug]
    (let [db (World.sdf-db world-data)
          bg-color (Vector3.init 0.1 0.1 0.1)
          commands (WGPURenderer.commands ren)
          vp (Camera.view-projection cam)
          vp-data (CameraMat4.data &vp)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols (Double.from-int @(SpatialGrid.cols grid))
          rows (Double.from-int @(SpatialGrid.rows grid))
          layers (Double.from-int @(SpatialGrid.layers grid))
          origin (SpatialGrid.origin grid)
          data (WGPURenderer.u-data ren)
          flat-grid (WGPURenderer.s-data ren)
          csg-data (WGPURenderer.csg-data ren)]
      (do
        (when csg-dirty
          (array-zero-floats! csg-data))

        (when grid-dirty
          (do
            (array-zero-floats! data)
            (array-zero-floats! flat-grid)))

        (let [next-csg-node-idx 0]
          (do
            ;; 1. Populate Header (0-127 bytes)
            (Array.aset! data 0 (Double.to-float time))
            (Array.aset! data 1 (Double.to-float (Double.from-int width)))
            (Array.aset! data 2 (Double.to-float (Double.from-int height)))
            (Array.aset! data 3 (Double.to-float cell-size))
            (Array.aset! data 4 (Double.to-float @(Vector3.x cam-pos)))
            (Array.aset! data 5 (Double.to-float @(Vector3.y cam-pos)))
            (Array.aset! data 6 (Double.to-float @(Vector3.z cam-pos)))
            (Array.aset! data 7 1.0f)
            (Array.aset! data 8 (Double.to-float @(Vector3.x cam-dir)))
            (Array.aset! data 9 (Double.to-float @(Vector3.y cam-dir)))
            (Array.aset! data 10 (Double.to-float @(Vector3.z cam-dir)))
            (Array.aset! data 11 0.0f)
            (Array.aset! data 12 (Double.to-float @(Vector3.x cam-right)))
            (Array.aset! data 13 (Double.to-float @(Vector3.y cam-right)))
            (Array.aset! data 14 (Double.to-float @(Vector3.z cam-right)))
            (Array.aset! data 15 0.0f)
            (Array.aset! data 16 (Double.to-float @(Vector3.x cam-up)))
            (Array.aset! data 17 (Double.to-float @(Vector3.y cam-up)))
            (Array.aset! data 18 (Double.to-float @(Vector3.z cam-up)))
            (Array.aset! data 19 0.0f)

            ;; 2. Populate BG Color and Grid Dims (80-127 bytes)
            (for [i 0 (Array.length commands)]
              (match-ref (Array.unsafe-nth commands i)
                (RenderCommand.SetBg bg) (set! bg-color @bg)
                _ ()))
            (Array.aset! data 20 (Double.to-float @(Vector3.x &bg-color)))
            (Array.aset! data 21 (Double.to-float @(Vector3.y &bg-color)))
            (Array.aset! data 22 (Double.to-float @(Vector3.z &bg-color)))
            (Array.aset! data 23 (if show-debug 1.0f 0.0f))
            (Array.aset! data 24 (Double.to-float cols))
            (Array.aset! data 25 (Double.to-float rows))
            (Array.aset! data 26 (Double.to-float layers))
            (Array.aset! data 27 (Double.to-float metaball-k))
            (Array.aset! data 28 (Double.to-float @(Vector3.x origin)))
            (Array.aset! data 29 (Double.to-float @(Vector3.y origin)))
            (Array.aset! data 30 (Double.to-float @(Vector3.z origin)))
            (Array.aset! data 31 (Double.to-float (Double.from-int view-mode)))
            (Array.aset! data 32 (Double.to-float (Double.from-int shadow-quality)))
            (Array.aset! data 33 (Double.to-float (Double.from-int shadow-quality)))
            (Array.aset! data 34 0.0f)
            (Array.aset! data 35 0.0f)



            ;; 3. Populate Spheres using Database geom-id as index (128+ bytes)
            (when (or grid-dirty csg-dirty)
              (ECS.query world [ent (rb RigidBody) (col Collidable) (color Color) (g-ref GeometryRef)]
                (let [has-parent false]
                  (do
                    (ECS.with-components world @&ent [e (p Parent)]
                      (set! has-parent true))
                    (when (and (not has-parent)
                               (not (ECS.has-component? world &ent PlayerTag)))
                      (let [id @(GeometryRef.id g-ref)
                            pos (RigidBody.position rb)
                            rot (RigidBody.rotation rb)
                            c-val (Color.v color)
                            is-static (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)
                            is-bouncy (ECS.has-component? world &ent BouncyTag)
                            is-exp false
                            exp-rad 0.0
                            _ (ECS.with-components world @&ent [e (exp Explosion)]
                                (do
                                  (set! is-exp true)
                                  (set! exp-rad @(Explosion.radius exp))))
                            rad (if is-exp exp-rad
                                  (if is-static 0.0
                                    (match-ref (Collidable.volume col)
                                      (Volume.Ball b) (if is-bouncy (* 2.0 @(Sphere.radius b)) @(Sphere.radius b))
                                      (Volume.Box b) (- 0.0 @(Vector3.x &(Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)))
                                      (Volume.Sdf sdf)
                                        (let [scale @(SDF.scale sdf)]
                                          (match-ref (SDF.base sdf)
                                            (BaseShape.Ball r) (if is-bouncy (* 2.0 (* @r scale)) (* @r scale))
                                            (BaseShape.Box e) (- 0.0 (* @(Vector3.x e) scale))
                                            (BaseShape.Cylinder r h) (+ 1000.0 (* @r scale))
                                            (BaseShape.Capsule r h) (- 0.0 (+ 1000.0 (* @r scale)))
                                            (BaseShape.Torus rad-maj rad-min) (+ 2000.0 (* @rad-maj scale))
                                            (BaseShape.Octahedron s) (- 0.0 (+ 2000.0 (* @s scale)))
                                            _ 0.0))
                                      _ 0.0)))
                            root-csg-idx (if is-bouncy -99 -1)]
                        (do
                          (when csg-dirty
                            (do
                              (match-ref (Collidable.volume col)
                                (Volume.Sdf sdf)
                                  (when (> (Array.length (SDF.csg-nodes sdf)) 0)
                                    (set! root-csg-idx (serialize-sdf! sdf csg-data (Pointer.address &next-csg-node-idx) true)))
                                _ ())
                              (FieldDatabase.set-root-csg-index! db id
                                (if is-bouncy @(Array.unsafe-nth (FieldDatabase.root-csg-indices db) id) root-csg-idx))))
                          (let [base (+ (/ WGPURenderer.header-size 4) (* id 16))
                                final-csg-idx @(Array.unsafe-nth (FieldDatabase.root-csg-indices db) id)
                                temp @(Array.unsafe-nth (FieldDatabase.temperatures db) id)
                                age @(Array.unsafe-nth (FieldDatabase.ages db) id)
                                humidity @(Array.unsafe-nth (FieldDatabase.humidities db) id)
                                pressure @(Array.unsafe-nth (FieldDatabase.pressures db) id)]
                            (do
                              (Array.aset! data base (Double.to-float @(Vector3.x pos)))
                              (Array.aset! data (+ base 1) (Double.to-float @(Vector3.y pos)))
                              (Array.aset! data (+ base 2) (Double.to-float @(Vector3.z pos)))
                              (Array.aset! data (+ base 3) (Double.to-float rad))
                              (Array.aset! data (+ base 4) (Double.to-float @(Quaternion.x rot)))
                              (Array.aset! data (+ base 5) (Double.to-float @(Quaternion.y rot)))
                              (Array.aset! data (+ base 6) (Double.to-float @(Quaternion.z rot)))
                              (Array.aset! data (+ base 7) (Double.to-float @(Quaternion.w rot)))
                              (Array.aset! data (+ base 8) (Double.to-float @(Vector3.x c-val)))
                              (Array.aset! data (+ base 9) (Double.to-float @(Vector3.y c-val)))
                              (Array.aset! data (+ base 10) (Double.to-float @(Vector3.z c-val)))
                              (Array.aset! data (+ base 11) (Double.to-float (Double.from-int final-csg-idx)))
                              (Array.aset! data (+ base 12) (Double.to-float temp))
                              (Array.aset! data (+ base 13) (Double.to-float age))
                              (Array.aset! data (+ base 14) (Double.to-float humidity))
                              (Array.aset! data (+ base 15) (Double.to-float pressure)))))))))))))

            (WGPURender.update-uniform-buffer ctx @(WGPURenderer.u-buffer ren) data)

            (let [cam-qx (World.camera-chunk-qx cam-pos)
                  cam-qy (World.camera-chunk-qy cam-pos)
                  cam-qz (World.camera-chunk-qz cam-pos)]
              (do
                ;; If camera moved chunks, run dynamic load/unload
                (when (or (not (= cam-qx @(World.last-cam-x world-data)))
                          (or (not (= cam-qy @(World.last-cam-y world-data)))
                              (not (= cam-qz @(World.last-cam-z world-data)))))
                  (do
                    (World.set-last-cam-x! world-data cam-qx)
                    (World.set-last-cam-y! world-data cam-qy)
                    (World.set-last-cam-z! world-data cam-qz)
                    
                    ;; 1. Unload far chunks (keep only chunks within dx <= 4, dy <= 3, dz <= 4)
                    (let [chunks (World.chunks world-data)
                          keep (the (Array Chunk) [])]
                      (do
                        (for [idx 0 (Array.length chunks)]
                          (let [chunk (Array.unsafe-nth chunks idx)
                                cqx @(Chunk.coord-x chunk)
                                cqy @(Chunk.coord-y chunk)
                                cqz @(Chunk.coord-z chunk)
                                dist-x (Int.abs (- cqx cam-qx))
                                dist-y (Int.abs (- cqy cam-qy))
                                dist-z (Int.abs (- cqz cam-qz))]
                             (if (and (<= dist-x 3) (and (<= dist-y 3) (<= dist-z 3)))
                                 (Array.push-back! &keep @chunk)
                                 ())))
                        (World.set-chunks! world-data keep)))))

                ;; 2. Load missing chunks dynamically around player (up to 1 chunk per frame to prevent hiccups)
                (let [loaded-any false]
                  (do
                    (for [dy -2 3]
                      (for [dz -2 3]
                        (for [dx -2 3]
                          (let [qx (+ cam-qx dx)
                                qy (+ cam-qy dy)
                                qz (+ cam-qz dz)]
                            (when (and (not loaded-any) (not (World.has-chunk? world-data qx qy qz)))
                              (let [slot (World.find-unused-atlas-slot world-data)]
                                (when (>= slot 0)
                                  (let [voxel-data (the (Array Float) (replicate 131072 &1000.0f))
                                        chunk (Chunk.init qx qy qz voxel-data slot)
                                        static-sdfs []
                                        static-mat-ids []]
                                    (do
                                      ;; Get static shapes to bake into this chunk
                                      (ECS.query world [ent (rb RigidBody) (col Collidable)]
                                        (when (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)
                                          (match-ref (Collidable.volume col)
                                            (Volume.Sdf sdf)
                                              (do
                                                (SDF.set-position! sdf @(RigidBody.position rb))
                                                (SDF.set-rotation! sdf @(RigidBody.rotation rb))
                                                (let [saved-nodes @(SDF.csg-nodes sdf)]
                                                  (do
                                                    (SDF.set-csg-nodes! sdf [])
                                                    (Array.push-back! &static-sdfs @sdf)
                                                    (SDF.set-csg-nodes! sdf saved-nodes)))
                                                (Array.push-back! &static-mat-ids (Double.to-float (Double.from-int (inc (the Int (Long.to-int (Uint32.to-long (ECS.Entity.id &ent)))))))))
                                            _ ())))
                                      (bake-chunk! ctx ren &chunk &static-sdfs &static-mat-ids)
                                      (Array.push-back! (World.chunks world-data) chunk)
                                      (set! loaded-any true))))))))))))))

            (let [cam-qx (World.camera-chunk-qx cam-pos)
                  cam-qy (World.camera-chunk-qy cam-pos)
                  cam-qz (World.camera-chunk-qz cam-pos)
                  origin-x (- cam-qx 4)
                  origin-y (- cam-qy 4)
                  origin-z (- cam-qz 4)
                  lookup-data (World.build-chunk-lookup-data world-data origin-x origin-y origin-z)]
              (WGPURenderer.write-ints ctx (uniform-buffer-get-buffer @(WGPURenderer.chunk-lookup-buffer ren)) &lookup-data))

            (when (or @(WGPURenderer.voxel-dirty ren) voxel-dirty)
              (do
                (if (Array.empty? craters)
                  (VoxelBaker.bake-voxel-grid! ctx ren grid world world-data)
                  (do
                    (for [i 0 (Array.length craters)]
                      (let [crater (Array.unsafe-nth craters i)
                            pos (CraterSpawnData.pos crater)
                            rad @(CraterSpawnData.radius crater)
                            op @(CraterSpawnData.op-type crater)
                            chunks (World.chunks world-data)]
                        (for [j 0 (Array.length chunks)]
                          (let [chunk (Array.unsafe-nth chunks j)]
                            (when (VoxelBaker.chunk-overlaps-sphere? chunk pos rad)
                              (do
                                (if (< op 0.5)
                                    (VoxelBaker.carve-voxel-grid-cpu! chunk pos rad)
                                    (VoxelBaker.build-voxel-grid-cpu! chunk pos rad))
                                (WGPU.write-floats ctx @(WGPURenderer.voxel-gpu-buffer ren) (Chunk.voxel-data chunk))
                                (VoxelBaker.pack-and-copy-chunk! ctx ren @(Chunk.atlas-slot chunk))))))))))
                (WGPURenderer.set-voxel-dirty! ren false)))
            
            (when grid-dirty
              (do
                (GPUSpatial.flatten-in-place! world grid WGPURenderer.max-ids-per-cell flat-grid)
                (WGPU.write-floats ctx @(WGPURenderer.s-buffer ren) flat-grid)))

            (when csg-dirty
              (WGPU.write-floats ctx @(WGPURenderer.csg-buffer ren) csg-data))

            (LinePass.update! ctx (WGPURenderer.line-pass ren) vp-data commands))))

  (defn draw [surf ctx ren line-count]
    (match (WGPURender.begin-frame surf ctx)
      (Result.Error _) ()
      (Result.Success frame)
        (do
          (WGPURenderer.run-pass frame @(WGPURenderer.pipeline ren) @(WGPURenderer.bind-group ren) (Maybe.Nothing))
          (LinePass.render frame ctx (WGPURenderer.line-pass ren) line-count @(WGPURenderer.depth-texture ren))
          (WGPURender.end-frame frame surf ctx)
          (WGPURender.free-frame frame))))
)

(load "voxel_baker.carp")
