                                                                                                                                                                              (match (WGPU.create-pipeline ctx &un-shader-src "main")

                                                                                                                                                                                (Result.Error e) (do (WGPU.free-buffer inst-b) (WGPURender.free-sampler font-samp) (WGPURender.free-render-texture font-tex) (WGPURender.free-sampler noise-samp) (WGPURender.free-render-texture noise-tex) (WGPU.free-pipeline l-splat-pipe) (WGPU.free-pipeline p-pipe) (WGPU.free-pipeline p-unorm8-pipe) (WGPU.free-buffer jit-info-b) (WGPU.free-buffer l-params-b) (WGPU.free-buffer l-half-b) (WGPU.free-buffer l-scratch-b) (WGPU.free-pipeline c-pipe) (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-baked-half-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPU.free-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture gas-tex) (WGPURender.free-render-texture water-tex) (WGPURender.free-render-texture interaction-tex) (WGPURender.free-render-texture light-tex) (WGPURender.free-render-texture voxel-baked-values-tex) (WGPURender.free-render-texture voxel-tex) (WGPU.free-buffer w-params-b) (WGPU.free-buffer w-half-b) (WGPU.free-buffer w-scratch-b) (WGPU.free-pipeline i-splat-pipe) (WGPU.free-buffer i-params-b) (WGPU.free-buffer i-half-b) (WGPU.free-buffer i-scratch-b) (WGPU.free-pipeline w-splat-pipe) (Result.Error (str* "Unpack pipeline failed: " e)))

