;; render.carp

(use WGPU)
(use WGPURender)
(use Camera)
(use Transform)
(use RigidBody)
(use LinePass)
(use GPUSpatial)
(use ECS)
(use GeometryRef)

(register wgpu-create-render-two-storage-uniform-bind-group
  (Fn [(Ptr WGPUContext) (Ptr WGPURenderPipelineWrapper) WGPUBuffer WGPUBuffer (Ptr WGPUUniformBufferWrapper)] WGPUBindGroup)
  "wgpu_create_render_two_storage_uniform_bind_group")

(register wgpu-write-buffer-ints
  (Fn [(Ptr WGPUContext) WGPUBuffer (Ptr Int) Uint64] ())
  "wgpu_write_buffer")

(deftemplate ints-array->ptr (Fn [(Ref (Array Int))] (Ptr Int))
  "int* $NAME(Array__int* arr)"
  "$DECL { return (int*)arr->data; }")

(deftemplate uniform-buffer-get-buffer (Fn [(Ptr WGPUUniformBufferWrapper)] WGPUBuffer)
  "WGPUBuffer $NAME(WGPUUniformBufferWrapper* ub)"
  "$DECL { return ub->buffer; }")

(deftype WGPURenderer [
  pipeline (Ptr WGPURenderPipelineWrapper)
  u-buffer (Ptr WGPUUniformBufferWrapper)
  s-buffer WGPUBuffer
  csg-buffer WGPUBuffer
  bind-group WGPUBindGroup
  depth-texture (Ptr WGPUDepthTexture)
  line-pass LinePassRenderer
  commands (Array RenderCommand)
  u-data (Array Float)
  s-data (Array Float)
  csg-data (Array Float)
  voxel-texture (Ptr WGPURenderTexture)
  voxel-sampler WGPUSampler
  voxel-data (Array Float)
  voxel-dirty Bool
  carve-pipeline WGPUComputePipeline
  pack-pipeline WGPUComputePipeline
  voxel-gpu-buffer WGPUBuffer
  voxel-half-buffer WGPUBuffer
  carve-params-buffer WGPUBuffer
  chunk-lookup-buffer (Ptr WGPUUniformBufferWrapper)
])

(defmodule WGPURenderer
  (def max-spheres 128)
  (def max-ids-per-cell 64)
  (def header-size 128)
  (def sphere-data-size 48)

  (sig float-from-int (Fn [Int] Float))
  (defn float-from-int [x]
    (Double.to-float (Double.from-int x)))

  (sig write-ints (Fn [(Ptr WGPUContext) WGPUBuffer (Ref (Array Int))] ()))
  (defn write-ints [ctx buf arr]
    (wgpu-write-buffer-ints ctx buf (ints-array->ptr arr) (Uint64.from-long (Long.from-int (* (Array.length arr) 4)))))

  (sig write-csg-node-raw! (Fn [(Ref (Array Float)) Int Int Int Int Int (Ref (Vector3 Double)) Double (Ref Quaternion) Double Double Double Double] ()))
  (defn write-csg-node-raw! [csg-data idx shape-type op-type left-child right-child pos scale rot p0 p1 p2 p3]
    (let [base (* idx 16)]
      (do
        (Array.aset! csg-data base (WGPURenderer.float-from-int shape-type))
        (Array.aset! csg-data (+ base 1) (WGPURenderer.float-from-int op-type))
        (Array.aset! csg-data (+ base 2) (WGPURenderer.float-from-int left-child))
        (Array.aset! csg-data (+ base 3) (WGPURenderer.float-from-int right-child))
        (Array.aset! csg-data (+ base 4) (Double.to-float @(Vector3.x pos)))
        (Array.aset! csg-data (+ base 5) (Double.to-float @(Vector3.y pos)))
        (Array.aset! csg-data (+ base 6) (Double.to-float @(Vector3.z pos)))
        (Array.aset! csg-data (+ base 7) (Double.to-float scale))
        (Array.aset! csg-data (+ base 8) (Double.to-float @(Quaternion.x rot)))
        (Array.aset! csg-data (+ base 9) (Double.to-float @(Quaternion.y rot)))
        (Array.aset! csg-data (+ base 10) (Double.to-float @(Quaternion.z rot)))
        (Array.aset! csg-data (+ base 11) (Double.to-float @(Quaternion.w rot)))
        (Array.aset! csg-data (+ base 12) (Double.to-float p0))
        (Array.aset! csg-data (+ base 13) (Double.to-float p1))
        (Array.aset! csg-data (+ base 14) (Double.to-float p2))
        (Array.aset! csg-data (+ base 15) (Double.to-float p3)))))

  (sig serialize-primitive! (Fn [(Ref SDF) (Ref (Array Float)) Int Bool] ()))
  (defn serialize-primitive! [sdf csg-data idx is-root]
    (let [base-shape (SDF.base sdf)
          pos (if is-root &(Vector3.init 0.0 0.0 0.0) (SDF.position sdf))
          rot (if is-root &(Quaternion.identity) (SDF.rotation sdf))
          scale @(SDF.scale sdf)
          shape-type 0
          p0 0.0
          p1 0.0
          p2 0.0
          p3 0.0]
      (do
        (match-ref base-shape
          (BaseShape.Ball r)
            (do
              (set! shape-type 1)
              (set! p0 @r))
          (BaseShape.Box e)
            (do
              (set! shape-type 2)
              (set! p0 @(Vector3.x e))
              (set! p1 @(Vector3.y e))
              (set! p2 @(Vector3.z e)))
          (BaseShape.Cylinder r h)
            (do
              (set! shape-type 3)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Capsule r h)
            (do
              (set! shape-type 4)
              (set! p0 @r)
              (set! p1 @h))
          (BaseShape.Torus rad-maj rad-min)
            (do
              (set! shape-type 5)
              (set! p0 @rad-maj)
              (set! p1 @rad-min))
          (BaseShape.Octahedron s)
            (do
              (set! shape-type 6)
              (set! p0 @s))
          _ ())
        (write-csg-node-raw! csg-data idx shape-type 0 -1 -1 pos scale rot p0 p1 p2 p3))))

  (sig serialize-sdf! (Fn [(Ref SDF) (Ref (Array Float)) (Ptr Int) Bool] Int))
  (defn serialize-sdf! [sdf csg-data next-idx-ptr is-root]
    (let [nodes (SDF.csg-nodes sdf)
          num-nodes (Array.length nodes)
          zero-v (Vector3.init 0.0 0.0 0.0)
          ident-q (Quaternion.identity)]
      (if (= num-nodes 0)
        (let [curr-idx (Pointer.to-value next-idx-ptr)]
          (do
            (serialize-primitive! sdf csg-data curr-idx is-root)
            (Pointer.set next-idx-ptr (+ curr-idx 1))
            curr-idx))
        (let [curr-lhs (let [curr-idx (Pointer.to-value next-idx-ptr)]
                         (do
                           (serialize-primitive! sdf csg-data curr-idx is-root)
                           (Pointer.set next-idx-ptr (+ curr-idx 1))
                           curr-idx))]
          (do
            (for [i 0 num-nodes]
              (let [child-node (Array.unsafe-nth nodes i)
                    child-op @(CsgNode.op child-node)
                    child-sdf (Box.peek (CsgNode.shape child-node))
                    child-idx (serialize-sdf! child-sdf csg-data next-idx-ptr false)
                    op-idx (Pointer.to-value next-idx-ptr)]
                (do
                  (write-csg-node-raw! csg-data op-idx 0 child-op curr-lhs child-idx
                    &zero-v 1.0 &ident-q 0.0 0.0 0.0 0.0)
                  (Pointer.set next-idx-ptr (+ op-idx 1))
                  (set! curr-lhs op-idx))))
            curr-lhs)))))

  (defn shader-wgsl [limit max-ids]
    (str*
      "struct SdfInstance {
          pos: vec4<f32>,
          rot: vec4<f32>,
          color: vec4<f32>,
      }
      struct Cell {
          header: vec4<f32>,
          ids: array<vec4<f32>, " (Int.str (/ max-ids 4)) ">,
      }
      struct Uniforms { 
          time: f32, 
          width: f32, 
          height: f32, 
          cell_size: f32,
          cam_pos: vec4<f32>, 
          cam_dir: vec4<f32>,
          cam_right: vec4<f32>,
          cam_up: vec4<f32>,
          bg_color: vec4<f32>,
          grid_dims: vec4<f32>,
          grid_origin: vec4<f32>,
          instances: array<SdfInstance, " (Int.str limit) ">
      }
      struct CsgNode {
          info: vec4<f32>,
          pos: vec4<f32>,
          rot: vec4<f32>,
          params: vec4<f32>,
      }
      struct ChunkLookup {
          origin: vec4<i32>,
          slots: array<vec4<i32>, 128>,
      }
      @group(0) @binding(0) var<storage, read> grid: array<Cell>;
      @group(0) @binding(1) var<uniform> u: Uniforms;
      @group(0) @binding(2) var<storage, read> csg_nodes: array<CsgNode>;
      @group(0) @binding(3) var voxel_texture: texture_3d<f32>;
      @group(0) @binding(4) var voxel_sampler: sampler;
      @group(0) @binding(5) var<uniform> chunk_lookup: ChunkLookup;

      fn positive_mod(n: i32, m: i32) -> i32 {
          let r = n % m;
          if (r < 0) {
              return r + m;
          }
          return r;
      }

       fn getVoxelAt(gx: i32, gy: i32, gz: i32) -> vec4<f32> {
          let qx = gx >> 5u;
          let qy = gy >> 5u;
          let qz = gz >> 5u;
          
          let lx = gx & 31;
          let ly = gy & 31;
          let lz = gz & 31;
          
          let local_q = vec3<i32>(qx, qy, qz) - chunk_lookup.origin.xyz;
          if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(8))) {
              return vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          }
          
          let idx = local_q.x + local_q.y * 8 + local_q.z * 64;
          let slot = chunk_lookup.slots[idx >> 2u][idx & 3];
          if (slot < 0) {
              return vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          }
          
          let slot_x = slot & 7;
          let slot_y = (slot >> 3u) & 7;
          let slot_z = slot >> 6u;
          
          let atlas_coord = vec3<i32>((slot_x << 5u) + lx, (slot_y << 5u) + ly, (slot_z << 5u) + lz);
          return textureLoad(voxel_texture, atlas_coord, 0);
      }

      fn sampleVoxelGrid(p: vec3<f32>) -> vec2<f32> {
          let tx = p / 1.0 - vec3<f32>(0.5);
          let c0 = vec3<i32>(floor(tx));
          let f = fract(tx);
          
          let lx = c0.x & 31;
          let ly = c0.y & 31;
          let lz = c0.z & 31;
          
          var v0 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v1 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v2 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v3 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v4 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v5 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v6 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);
          var v7 = vec4<f32>(1000.0, 0.0, 0.0, 0.0);

          if (lx < 31 && ly < 31 && lz < 31) {
              let qx = c0.x >> 5;
              let qy = c0.y >> 5;
              let qz = c0.z >> 5;
              let local_q = vec3<i32>(qx, qy, qz) - chunk_lookup.origin.xyz;
              if (all(local_q >= vec3<i32>(0)) && all(local_q < vec3<i32>(8))) {
                  let idx = local_q.x + local_q.y * 8 + local_q.z * 64;
                  let slot = chunk_lookup.slots[idx >> 2][idx & 3];
                  if (slot >= 0) {
                      let slot_x = slot & 7;
                      let slot_y = (slot >> 3) & 7;
                      let slot_z = slot >> 6;
                      let base = vec3<i32>(slot_x << 5, slot_y << 5, slot_z << 5);
                      
                      v0 = textureLoad(voxel_texture, base + vec3<i32>(lx,     ly,     lz),     0);
                      v1 = textureLoad(voxel_texture, base + vec3<i32>(lx + 1, ly,     lz),     0);
                      v2 = textureLoad(voxel_texture, base + vec3<i32>(lx,     ly + 1, lz),     0);
                      v3 = textureLoad(voxel_texture, base + vec3<i32>(lx + 1, ly + 1, lz),     0);
                      v4 = textureLoad(voxel_texture, base + vec3<i32>(lx,     ly,     lz + 1), 0);
                      v5 = textureLoad(voxel_texture, base + vec3<i32>(lx + 1, ly,     lz + 1), 0);
                      v6 = textureLoad(voxel_texture, base + vec3<i32>(lx,     ly + 1, lz + 1), 0);
                      v7 = textureLoad(voxel_texture, base + vec3<i32>(lx + 1, ly + 1, lz + 1), 0);
                  }
              }
          } else {
              v0 = getVoxelAt(c0.x,     c0.y,     c0.z);
              v1 = getVoxelAt(c0.x + 1, c0.y,     c0.z);
              v2 = getVoxelAt(c0.x,     c0.y + 1, c0.z);
              v3 = getVoxelAt(c0.x + 1, c0.y + 1, c0.z);
              v4 = getVoxelAt(c0.x,     c0.y,     c0.z + 1);
              v5 = getVoxelAt(c0.x + 1, c0.y,     c0.z + 1);
              v6 = getVoxelAt(c0.x,     c0.y + 1, c0.z + 1);
              v7 = getVoxelAt(c0.x + 1, c0.y + 1, c0.z + 1);
          }
          let sf = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
          let v_01 = mix(v0, v1, sf.x);
          let v_23 = mix(v2, v3, sf.x);
          let v_45 = mix(v4, v5, sf.x);
          let v_67 = mix(v6, v7, sf.x);
          
          let v_y0 = mix(v_01, v_23, sf.y);
          let v_y1 = mix(v_45, v_67, sf.y);
          
          let tex_val = mix(v_y0, v_y1, sf.z);
          
          let dummy_sample = textureSampleLevel(voxel_texture, voxel_sampler, vec3<f32>(0.0), 0.0);
          let dummy = dummy_sample.r * 1e-10;
          
          return vec2<f32>(tex_val.r + dummy, tex_val.g);
      }

       fn sampleVoxelGridPoint(p: vec3<f32>) -> vec2<f32> {
           let tx = p / 1.0;
           let c0 = vec3<i32>(floor(tx));
           let val = getVoxelAt(c0.x, c0.y, c0.z);
           return vec2<f32>(val.x, val.y);
       }

      struct VertexOutput {
          @builtin(position) position: vec4<f32>,
          @location(0) uv: vec2<f32>,
      }

      @vertex
      fn vs_main(@builtin(vertex_index) vi: u32) -> VertexOutput {
          var pos = array<vec2<f32>, 3>(
              vec2<f32>(-1.0, -1.0),
              vec2<f32>( 3.0, -1.0),
              vec2<f32>(-1.0,  3.0)
          );
          var out: VertexOutput;
          out.position = vec4<f32>(pos[vi], 0.0, 1.0);
          out.uv = pos[vi];
          return out;
      }

      fn sdPlane(p: vec3<f32>, n: vec3<f32>, h: f32) -> f32 {
          return dot(p, n) + h;
      }

      fn sdSphere(p: vec3<f32>, s: f32) -> f32 {
          return length(p) - s;
      }

      fn sdBox(p: vec3<f32>, b: vec3<f32>) -> f32 {
          let q = abs(p) - b;
          return length(max(q, vec3<f32>(0.0))) + min(max(q.x, max(q.y, q.z)), 0.0);
      }

      fn sdCylinder(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let d = abs(vec2<f32>(length(p.xz), p.y)) - vec2<f32>(r, h);
          return min(max(d.x, d.y), 0.0) + length(max(d, vec2<f32>(0.0)));
      }

      fn sdCapsule(p: vec3<f32>, r: f32, h: f32) -> f32 {
          let py = clamp(p.y, -h, h);
          return length(p - vec3<f32>(0.0, py, 0.0)) - r;
      }

      fn sdTorus(p: vec3<f32>, t: vec2<f32>) -> f32 {
          let q = vec2<f32>(length(p.xz) - t.x, p.y);
          return length(q) - t.y;
      }

      fn sdOctahedron(p: vec3<f32>, s: f32) -> f32 {
          let q = abs(p);
          return (q.x + q.y + q.z - s) * 0.57735027;
      }

      fn rotateVector(v: vec3<f32>, q: vec4<f32>) -> vec3<f32> {
          return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
      }

      fn q_inv(q: vec4<f32>) -> vec4<f32> {
          return vec4<f32>(-q.xyz, q.w);
      }

      fn evaluateCsgPrimitive(p: vec3<f32>, shape_type: u32, pos: vec3<f32>, scale: f32, rot: vec4<f32>, params: vec4<f32>) -> f32 {
          let local_p = rotateVector(p - pos, q_inv(rot)) / scale;
          var d = 10000.0;
          if (shape_type == 1u) {
              d = sdSphere(local_p, params.x);
          } else if (shape_type == 2u) {
              d = sdBox(local_p, params.xyz);
          } else if (shape_type == 3u) {
              d = sdCylinder(local_p, params.x, params.y);
          } else if (shape_type == 4u) {
              d = sdCapsule(local_p, params.x, params.y);
          } else if (shape_type == 5u) {
              d = sdTorus(local_p, params.xy);
          } else if (shape_type == 6u) {
              d = sdOctahedron(local_p, params.x);
          }
          return d * scale;
      }

      fn evaluateNoise(p: vec3<f32>) -> f32 {
          let n1 = sin(p.x * 3.5) * cos(p.y * 3.5) * sin(p.z * 3.5);
          let n2 = sin(p.x * 7.0 + n1 * 2.0) * cos(p.y * 7.0 + n1 * 2.0) * sin(p.z * 7.0 + n1 * 2.0);
          return n1 * 0.12 + n2 * 0.06;
      }

      fn evaluateCsgTree(local_p: vec3<f32>, root_idx: i32) -> f32 {
          var base_idx = root_idx;
          while (true) {
              let node = csg_nodes[base_idx];
              let shape_type = u32(round(node.info.x));
              if (shape_type > 0u) {
                  break;
              }
              base_idx = i32(round(node.info.z)); // left_child
          }
          
          let base_node = csg_nodes[base_idx];
          var d = evaluateCsgPrimitive(local_p, u32(round(base_node.info.x)), base_node.pos.xyz, base_node.pos.w, base_node.rot, base_node.params);
          for (var idx = base_idx + 2; idx <= root_idx; idx = idx + 2) {
              let op_node = csg_nodes[idx];
              let right_child = i32(round(op_node.info.w));
              let right_node = csg_nodes[right_child];
              var d_right = 10000.0;
              let diff = local_p - right_node.pos.xyz;
              if (dot(diff, diff) < 9.0) {
                  d_right = evaluateCsgPrimitive(local_p, u32(round(right_node.info.x)), right_node.pos.xyz, right_node.pos.w, right_node.rot, right_node.params);
              }
              let op = u32(round(op_node.info.y));
              if (op == 0u) {
                  d = min(d, d_right);
              } else if (op == 1u) {
                  let d_right_noisy = d_right + evaluateNoise(local_p);
                  d = max(d, -d_right_noisy);
              } else {
                  d = max(d, d_right);
              }
          }
          return d;
      }

      fn get_wireframe_edge(lp: vec3<f32>, raw_w: f32, thickness: f32) -> f32 {
          if (raw_w > 0.0 && raw_w < 500.0) {
              let rx = smoothstep(thickness, thickness - 0.01, abs(lp.x));
              let ry = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let rz = smoothstep(thickness, thickness - 0.01, abs(lp.z));
              return max(rx, max(ry, rz));
          } else if (raw_w < 0.0 && raw_w > -1000.0) {
              let size = -raw_w;
              let q = abs(lp) - vec3<f32>(size);
              let second_max = max(min(q.x, q.y), max(min(q.x, q.z), min(q.y, q.z)));
              return smoothstep(-thickness, -thickness + 0.01, second_max);
          } else if (raw_w <= -1000.0 && raw_w > -2000.0) {
              let size = -raw_w - 1000.0;
              let r = size;
              let h = size;
              let angle = atan2(lp.z, lp.x);
              let long_line = smoothstep(0.95, 0.98, abs(sin(angle * 4.0)));
              let ring_y = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let ring_cap = smoothstep(thickness, thickness - 0.01, abs(abs(lp.y) - h));
              return max(long_line, max(ring_y, ring_cap));
          } else if (raw_w >= 1000.0 && raw_w < 2000.0) {
              let size = raw_w - 1000.0;
              let r = size;
              let h = size;
              let rad = length(lp.xz);
              let rim = smoothstep(-thickness, -thickness + 0.01, min(rad - r, abs(lp.y) - h));
              let angle = atan2(lp.z, lp.x);
              let vertical_line = smoothstep(0.95, 0.98, abs(sin(angle * 6.0))) * step(abs(lp.y), h);
              return max(rim, vertical_line);
          } else if (raw_w >= 2000.0) {
              let size = raw_w - 2000.0;
              let R = size;
              let major_angle = atan2(lp.z, lp.x);
              let ring_major = smoothstep(0.95, 0.98, abs(sin(major_angle * 8.0)));
              let local_angle = atan2(lp.y, length(lp.xz) - R);
              let ring_tube = smoothstep(0.95, 0.98, abs(sin(local_angle * 6.0)));
              return max(ring_major, ring_tube);
          } else {
              let ex = smoothstep(thickness, thickness - 0.01, abs(lp.x));
              let ey = smoothstep(thickness, thickness - 0.01, abs(lp.y));
              let ez = smoothstep(thickness, thickness - 0.01, abs(lp.z));
              return max(ex, max(ey, ez));
          }
      }

        fn worldSDF(p: vec3<f32>, rd: vec3<f32>) -> vec3<f32> {
            let voxel_val = sampleVoxelGrid(p);
            var d = vec2<f32>(voxel_val.x, -1.0);
            let p_local = p - u.grid_origin.xyz;
            let gx = i32(floor(p_local.x / u.cell_size));
            let gy = i32(floor(p_local.y / u.cell_size));
            let gz = i32(floor(p_local.z / u.cell_size));

            if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
                let cell_min = vec3<f32>(f32(gx), f32(gy), f32(gz)) * u.cell_size;
                let cell_max = cell_min + vec3<f32>(u.cell_size);
                var t_exit = 100.0;
                if (rd.x > 0.0001) { t_exit = min(t_exit, (cell_max.x - p_local.x) / rd.x); }
                else if (rd.x < -0.0001) { t_exit = min(t_exit, (cell_min.x - p_local.x) / rd.x); }
                if (rd.y > 0.0001) { t_exit = min(t_exit, (cell_max.y - p_local.y) / rd.y); }
                else if (rd.y < -0.0001) { t_exit = min(t_exit, (cell_min.y - p_local.y) / rd.y); }
                if (rd.z > 0.0001) { t_exit = min(t_exit, (cell_max.z - p_local.z) / rd.z); }
                else if (rd.z < -0.0001) { t_exit = min(t_exit, (cell_min.z - p_local.z) / rd.z); }

                let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
                let cell = grid[idx];
                let count = min(i32(round(cell.header.x)), 16);
                for(var i = 0; i < count; i = i + 1) {
                    let s_idx = i32(round(cell.ids[i / 4][i % 4]));
                    if (s_idx >= 0 && s_idx < 1024) {
                      let s_data = u.instances[s_idx];
                      let raw_w = s_data.pos.w;
                      if (raw_w != 0.0) {
                        var local_dist = 10000.0;
                        let local_p = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                        let csg_root_idx = i32(round(s_data.color.w));
                        if (csg_root_idx >= 0) {
                            local_dist = evaluateCsgTree(local_p, csg_root_idx);
                        } else {
                            if (raw_w > 0.0 && raw_w < 500.0) {
                              local_dist = sdSphere(local_p, raw_w);
                            } else if (raw_w < 0.0 && raw_w > -1000.0) {
                              let size = -raw_w;
                              local_dist = sdBox(local_p, vec3<f32>(size));
                            } else if (raw_w <= -1000.0 && raw_w > -2000.0) {
                              let size = -raw_w - 1000.0;
                              local_dist = sdCapsule(local_p, size, size);
                            } else if (raw_w >= 1000.0 && raw_w < 2000.0) {
                              let size = raw_w - 1000.0;
                              local_dist = sdCylinder(local_p, size, size);
                            } else if (raw_w >= 2000.0) {
                              let size = raw_w - 2000.0;
                              local_dist = sdTorus(local_p, vec2<f32>(size, 0.25 * size));
                            } else {
                              let size = -raw_w - 2000.0;
                              local_dist = sdOctahedron(local_p, size);
                            }
                        }
                        if (local_dist < d.x) { d = vec2<f32>(local_dist, f32(s_idx)); }
                      }
                    }
                }
                let h_step = min(d.x, max(t_exit + 0.01, 0.05));
                return vec3<f32>(h_step, d.x, d.y);
            } else {
                return vec3<f32>(d.x, d.x, d.y);
            }
        }

        fn worldSDFPoint(p: vec3<f32>, rd: vec3<f32>) -> vec3<f32> {
            let voxel_val = sampleVoxelGridPoint(p);
            var d = vec2<f32>(voxel_val.x, -1.0);
            let p_local = p - u.grid_origin.xyz;
            let gx = i32(floor(p_local.x / u.cell_size));
            let gy = i32(floor(p_local.y / u.cell_size));
            let gz = i32(floor(p_local.z / u.cell_size));

            if (gx >= 0 && gx < i32(u.grid_dims.x) && gy >= 0 && gy < i32(u.grid_dims.y) && gz >= 0 && gz < i32(u.grid_dims.z)) {
                let cell_min = vec3<f32>(f32(gx), f32(gy), f32(gz)) * u.cell_size;
                let cell_max = cell_min + vec3<f32>(u.cell_size);
                var t_exit = 100.0;
                if (rd.x > 0.0001) { t_exit = min(t_exit, (cell_max.x - p_local.x) / rd.x); }
                else if (rd.x < -0.0001) { t_exit = min(t_exit, (cell_min.x - p_local.x) / rd.x); }
                if (rd.y > 0.0001) { t_exit = min(t_exit, (cell_max.y - p_local.y) / rd.y); }
                else if (rd.y < -0.0001) { t_exit = min(t_exit, (cell_min.y - p_local.y) / rd.y); }
                if (rd.z > 0.0001) { t_exit = min(t_exit, (cell_max.z - p_local.z) / rd.z); }
                else if (rd.z < -0.0001) { t_exit = min(t_exit, (cell_min.z - p_local.z) / rd.z); }

                let idx = gx + i32(u.grid_dims.x) * (gy + i32(u.grid_dims.y) * gz);
                let cell = grid[idx];
                let count = min(i32(round(cell.header.x)), 16);
                for(var i = 0; i < count; i = i + 1) {
                    let s_idx = i32(round(cell.ids[i / 4][i % 4]));
                    if (s_idx >= 0 && s_idx < 1024) {
                      let s_data = u.instances[s_idx];
                      let raw_w = s_data.pos.w;
                      if (raw_w != 0.0) {
                        var local_dist = 10000.0;
                        let local_p = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                        let csg_root_idx = i32(round(s_data.color.w));
                        if (csg_root_idx >= 0) {
                            local_dist = evaluateCsgTree(local_p, csg_root_idx);
                        } else {
                            if (raw_w > 0.0 && raw_w < 500.0) {
                              local_dist = sdSphere(local_p, raw_w);
                            } else if (raw_w < 0.0 && raw_w > -1000.0) {
                              let size = -raw_w;
                              local_dist = sdBox(local_p, vec3<f32>(size));
                            } else if (raw_w <= -1000.0 && raw_w > -2000.0) {
                              let size = -raw_w - 1000.0;
                              local_dist = sdCapsule(local_p, size, size);
                            } else if (raw_w >= 1000.0 && raw_w < 2000.0) {
                              let size = raw_w - 1000.0;
                              local_dist = sdCylinder(local_p, size, size);
                            } else if (raw_w >= 2000.0) {
                              let size = raw_w - 2000.0;
                              local_dist = sdTorus(local_p, vec2<f32>(size, 0.25 * size));
                            } else {
                              let size = -raw_w - 2000.0;
                              local_dist = sdOctahedron(local_p, size);
                            }
                        }
                        if (local_dist < d.x) { d = vec2<f32>(local_dist, f32(s_idx)); }
                      }
                    }
                }
                let h_step = min(d.x, max(t_exit + 0.01, 0.05));
                return vec3<f32>(h_step, d.x, d.y);
            } else {
                return vec3<f32>(d.x, d.x, d.y);
            }
        }

        fn getShadow(ro: vec3<f32>, rd: vec3<f32>, mint: f32, maxt: f32, k: f32) -> f32 {
            var res = 1.0;
            var t = mint;
            var last_h = 1e10;
            for (var i = 0; i < 30; i = i + 1) {
                let sdf_val = worldSDF(ro + rd * t, rd);
                let h = sdf_val.y;
                if (h < 0.001) {
                    return 0.0;
                }
                let y = h * h / (2.0 * last_h);
                let d = sqrt(h * h - y * y);
                res = min(res, k * d / max(0.0001, t - y));
                last_h = h;
                t += clamp(sdf_val.x, 0.01, 0.3);
                if (t > maxt) {
                    break;
                }
            }
            return clamp(res, 0.0, 1.0);
        }

        fn getAO(p: vec3<f32>, n: vec3<f32>) -> f32 {
            var occ = 0.0;
            var sca = 1.0;
            for (var i = 0; i < 5; i = i + 1) {
                let hr = 0.01 + 0.12 * f32(i) / 4.0;
                let aopos = p + n * hr;
                let d = worldSDF(aopos, vec3<f32>(0.0)).y;
                occ += -(d - hr) * sca;
                sca *= 0.95;
            }
            return clamp(1.0 - 3.0 * occ, 0.0, 1.0);
        }

       @fragment
       fn fs_main(frag_in: VertexOutput) -> @location(0) vec4<f32> {
           let aspect = u.width / u.height;
           let uv = frag_in.uv * vec2<f32>(aspect, 1.0);
           let ro = u.cam_pos.xyz;
           let rd = normalize(uv.x * u.cam_right.xyz + uv.y * u.cam_up.xyz + u.cam_dir.xyz * 1.7320508);
           var t = 0.0;
           var hitId = -1.0;
           for(var i = 0; i < 80; i = i + 1) {
               let p = ro + rd * t;
               let res = worldSDFPoint(p, rd);
               if (res.x < 0.001) { hitId = res.z; break; }
               t += res.x;
               if (t > 100.0) { break; }
           }
           if (t <= 100.0) {
               for (var j = 0; j < 3; j = j + 1) {
                   let p = ro + rd * t;
                   let res = worldSDF(p, rd);
                   hitId = res.z;
                   t += res.y;
               }
           }
           var color = u.bg_color.rgb;
           if (t <= 100.0) {
               let p = ro + rd * t;
               let light_dir = normalize(vec3<f32>(0.5, 1.0, 0.3));
               var normal = vec3<f32>(0.0, 1.0, 0.0);
               var is_sphere = false;
               if (hitId != -1.0) {
                   let s_idx = i32(hitId);
                   let s_data = u.instances[s_idx];
                   let raw_w = s_data.pos.w;
                   if (raw_w > 0.0 && raw_w < 500.0 && s_data.color.w < 0.0) {
                       is_sphere = true;
                   }
               }

               if (is_sphere) {
                   let s_idx = i32(hitId);
                   let s_data = u.instances[s_idx];
                   normal = normalize(p - s_data.pos.xyz);
               } else {
                   let eps = 0.01;
                   let d1 = worldSDF(p + vec3<f32>( eps, -eps, -eps), rd).y;
                   let d2 = worldSDF(p + vec3<f32>(-eps, -eps,  eps), rd).y;
                   let d3 = worldSDF(p + vec3<f32>(-eps,  eps, -eps), rd).y;
                   let d4 = worldSDF(p + vec3<f32>( eps,  eps,  eps), rd).y;
                   normal = normalize(
                       vec3<f32>( eps, -eps, -eps) * d1 +
                       vec3<f32>(-eps, -eps,  eps) * d2 +
                       vec3<f32>(-eps,  eps, -eps) * d3 +
                       vec3<f32>( eps,  eps,  eps) * d4
                   );
               }

              let diffuse = max(dot(normal, light_dir), 0.0);

              let shadow = getShadow(p + normal * 0.02, light_dir, 0.02, 20.0, 16.0);
              let lit = mix(0.2, 1.0, shadow) * diffuse;

              let ao = getAO(p, normal);

              var base_col = vec3<f32>(0.2, 0.2, 0.2);
              var edge = 0.0;
              if (hitId != -1.0) {
                  let s_idx = i32(hitId);
                  let s_data = u.instances[s_idx];
                  base_col = s_data.color.rgb;
                  
                  let lp = rotateVector(p - s_data.pos.xyz, q_inv(s_data.rot));
                  if (s_data.color.w < 0.0) {
                      edge = get_wireframe_edge(lp, s_data.pos.w, 0.08);
                  }
              } else {
                  let voxel_val = sampleVoxelGrid(p);
                  let mat_id = i32(round(voxel_val.y));
                  if (mat_id == 1) {
                      base_col = vec3<f32>(0.25, 0.25, 0.25);
                  } else if (mat_id == 2) {
                      base_col = vec3<f32>(0.2, 0.8, 0.2);
                  } else {
                      base_col = vec3<f32>(0.4, 0.4, 0.5);
                  }
              }

              color = base_col * (lit + 0.15) * ao;

              if (edge > 0.0) {
                  let glow_col = base_col * 2.5 + vec3<f32>(0.25);
                  color = mix(color, glow_col, edge);
              }

              color = mix(color, u.bg_color.rgb, 1.0 - exp(-0.02 * t));
              let dither_noise = fract(sin(dot(frag_in.uv + vec2<f32>(u.time), vec2<f32>(12.9898, 78.233))) * 43758.5453) - 0.5;
              color += vec3<f32>(dither_noise) * (1.0 / 255.0);
          }
          return vec4<f32>(color, 1.0);
      }
    "))

  (def max-csg-nodes 1024)
  (def csg-node-size 64)

  (def carve-shader
    "@group(0) @binding(0) var<storage, read_write> voxel_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read>       params: array<f32>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 32768u) { return; }

    let ox = params[0];
    let oy = params[1];
    let oz = params[2];
    let cell_size = params[3];
    let cx = params[4];
    let cy = params[5];
    let cz = params[6];
    let radius = params[7];

    let sx = f32(idx % 32u);
    let sy = f32((idx / 32u) % 32u);
    let sz = f32(idx / (32u * 32u));

    let px = ox + (sx + 0.5) * cell_size;
    let py = oy + (sy + 0.5) * cell_size;
    let pz = oz + (sz + 0.5) * cell_size;

    let dx = px - cx;
    let dy = py - cy;
    let dz = pz - cz;
    let dist_to_crater_center = sqrt(dx*dx + dy*dy + dz*dz);
    let crater_dist = dist_to_crater_center - radius;
    let neg_crater_dist = -crater_dist;

    var val = voxel_gpu_buffer[idx];
    let old_dist = val.x;
    let new_dist = max(old_dist, neg_crater_dist);
    val.x = new_dist;
    voxel_gpu_buffer[idx] = val;
}")

  (def pack-shader
    "@group(0) @binding(0) var<storage, read>       voxel_gpu_buffer: array<vec4<f32>>;
@group(0) @binding(1) var<storage, read_write> voxel_half_buffer: array<vec2<u32>>;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let idx = global_id.x;
    if (idx >= 32768u) { return; }

    let val = voxel_gpu_buffer[idx];
    
    let p1 = pack2x16float(val.xy);
    let p2 = pack2x16float(val.zw);

    voxel_half_buffer[idx] = vec2<u32>(p1, p2);
}")

  (defn create [ctx format width height grid]
    (let [u-size (+ WGPURenderer.header-size (* WGPURenderer.max-spheres WGPURenderer.sphere-data-size))
          shader (shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell)
          s-size (* (GPUSpatial.required-floats grid WGPURenderer.max-ids-per-cell) 4)
          csg-size (* WGPURenderer.max-csg-nodes WGPURenderer.csg-node-size)
          u-data (the (Array Float) (replicate (/ u-size 4) &0.0f))
          s-data (the (Array Float) (replicate (/ s-size 4) &0.0f))
          csg-data (the (Array Float) (replicate (/ csg-size 4) &0.0f))]
      (match (WGPURender.create-3d-texture ctx 256 256 256 "rgba16float")
        (Result.Error e) (Result.Error (str* "3D Texture failed: " e))
        (Result.Success voxel-tex)
          (match (WGPURender.create-sampler ctx)
            (Result.Error e) (do (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Sampler failed: " e)))
            (Result.Success voxel-samp)
              (match (WGPURender.create-uniform-buffer ctx u-size)
                (Result.Error e) (do (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Uniform failed: " e)))
                (Result.Success ub)
                  (match (WGPU.create-buffer ctx s-size)
                    (Result.Error e) (do (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Storage failed: " e)))
                    (Result.Success sb)
                      (match (WGPU.create-buffer ctx csg-size)
                        (Result.Error e) (do (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "CSG buffer failed: " e)))
                        (Result.Success csg-b)
                          (match (WGPURender.create-uniform-buffer ctx 2064)
                            (Result.Error e) (do (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Chunk lookup buffer failed: " e)))
                            (Result.Success chunk-lookup-b)
                              (let [raw-lookup-buf (uniform-buffer-get-buffer chunk-lookup-b)]
                                (match (WGPURender.create-pipeline ctx &shader "vs_main" "fs_main" &format)
                                  (Result.Error e) (do (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Pipeline failed: " e)))
                                  (Result.Success pipe)
                                    (match (WGPURender.create-voxel-render-bind-group-chunked ctx pipe sb csg-b ub voxel-tex voxel-samp raw-lookup-buf)
                                      (Result.Error e) (do (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Bind group failed: " e)))
                                      (Result.Success bg)
                                        (match (WGPURender.create-depth-texture ctx width height)
                                          (Result.Error e) (do (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Depth failed: " e)))
                                          (Result.Success dt)
                                            (match (LinePass.create ctx format 10000)
                                              (Result.Error e) (do (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "LinePass failed: " e)))
                                              (Result.Success lp)
                                                (match (WGPU.create-buffer ctx 524288)
                                                  (Result.Error e) (do (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel GPU Buffer failed: " e)))
                                                  (Result.Success v-gpu-b)
                                                    (match (WGPU.create-buffer ctx 262144)
                                                      (Result.Error e) (do (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Voxel Half Buffer failed: " e)))
                                                      (Result.Success v-half-b)
                                                        (match (WGPU.create-buffer ctx 8)
                                                          (Result.Error e) (do (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Carve params buffer failed: " e)))
                                                          (Result.Success c-params-b)
                                                            (match (WGPU.create-pipeline ctx carve-shader "main")
                                                              (Result.Error e) (do (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Carve pipeline failed: " e)))
                                                              (Result.Success c-pipe)
                                                                (match (WGPU.create-pipeline ctx pack-shader "main")
                                                                  (Result.Error e) (do (WGPU.free-pipeline c-pipe) (WGPU.free-buffer c-params-b) (WGPU.free-buffer v-half-b) (WGPU.free-buffer v-gpu-b) (WGPURender.free-depth-texture dt) (WGPURender.free-bind-group bg) (WGPURender.free-pipeline pipe) (WGPURender.free-uniform-buffer chunk-lookup-b) (WGPU.free-buffer csg-b) (WGPU.free-buffer sb) (WGPURender.free-uniform-buffer ub) (WGPURender.free-sampler voxel-samp) (WGPURender.free-render-texture voxel-tex) (Result.Error (str* "Pack pipeline failed: " e)))
                                                                  (Result.Success p-pipe)
                                                                     (Result.Success (WGPURenderer.init pipe ub sb csg-b bg dt lp [] u-data s-data csg-data voxel-tex voxel-samp [] true c-pipe p-pipe v-gpu-b v-half-b c-params-b chunk-lookup-b))))))))))))))))))))

  (defn pack-and-copy-chunk! [ctx ren slot]
    (let [v-gpu-b @(WGPURenderer.voxel-gpu-buffer ren)
          v-half-b @(WGPURenderer.voxel-half-buffer ren)
          pipe @(WGPURenderer.pack-pipeline ren)
          bufs [v-gpu-b v-half-b]
          slot-x (Int.mod slot 8)
          slot-y (Int.mod (/ slot 8) 8)
          slot-z (/ slot 64)
          ox (* slot-x 32)
          oy (* slot-y 32)
          oz (* slot-z 32)]
      (match (WGPU.create-bind-group ctx pipe &bufs)
        (Result.Error e) (IO.println &(format "Pack Bind Group error: %s" &e))
        (Result.Success bg)
          (do
            (WGPU.dispatch ctx pipe bg 512)
            (WGPU.free-bind-group bg)
            (WGPURender.copy-buffer-to-3d-texture-offset 
              ctx 
              v-half-b 
              @(WGPURenderer.voxel-texture ren) 
              ox oy oz 32 32 32)))))

  (defn chunk-overlaps-sphere? [chunk center radius]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          c-min-x (* (Double.from-int qx) 32.0)
          c-min-y (* (Double.from-int qy) 32.0)
          c-min-z (* (Double.from-int qz) 32.0)
          c-max-x (+ c-min-x 32.0)
          c-max-y (+ c-min-y 32.0)
          c-max-z (+ c-min-z 32.0)
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          px (Double.clamp c-min-x c-max-x cx)
          py (Double.clamp c-min-y c-max-y cy)
          pz (Double.clamp c-min-z c-max-z cz)
          dx (- px cx)
          dy (- py cy)
          dz (- pz cz)
          dist-sq (+ (* dx dx) (+ (* dy dy) (* dz dz)))]
      (< dist-sq (* radius radius))))

  (defn carve-voxel-grid-gpu! [ctx ren chunk center radius]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          cell-size 1.0
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          params-data [(Double.to-float ox) (Double.to-float oy) (Double.to-float oz)
                       (Double.to-float cell-size)
                       (Double.to-float cx) (Double.to-float cy) (Double.to-float cz)
                       (Double.to-float radius)]
          v-gpu-b @(WGPURenderer.voxel-gpu-buffer ren)
          c-params-b @(WGPURenderer.carve-params-buffer ren)
          pipe @(WGPURenderer.carve-pipeline ren)]
      (do
        (WGPU.write-floats ctx v-gpu-b (Chunk.voxel-data chunk))
        (WGPU.write-floats ctx c-params-b &params-data)
        (let [bufs [v-gpu-b c-params-b]]
          (match (WGPU.create-bind-group ctx pipe &bufs)
            (Result.Error e) (IO.println &(format "Carve Bind Group error: %s" &e))
            (Result.Success bg)
              (do
                (WGPU.dispatch ctx pipe bg 512)
                (WGPU.free-bind-group bg))))
        (pack-and-copy-chunk! ctx ren @(Chunk.atlas-slot chunk))
        (let [updated-floats (WGPU.read-floats ctx v-gpu-b 131072)]
          (Chunk.set-voxel-data! chunk updated-floats))
        )))

  (sig bake-chunk! (Fn [(Ptr WGPUContext) (Ref WGPURenderer) (Ref Chunk) (Ref (Array SDF)) (Ref (Array Float))] ()))
  (defn bake-chunk! [ctx ren chunk static-sdfs static-mat-ids]
    (let [voxel-data (Chunk.voxel-data chunk)
          qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          cell-size 1.0
          w-dim 32
          h-dim 32
          d-dim 32
          num-shapes (Array.length static-sdfs)]
      (do
        (for [z 0 d-dim]
          (for [y 0 h-dim]
            (for [x 0 w-dim]
              (let [px (+ ox (* (+ (Double.from-int x) 0.5) cell-size))
                    py (+ oy (* (+ (Double.from-int y) 0.5) cell-size))
                    pz (+ oz (* (+ (Double.from-int z) 0.5) cell-size))
                    p (Vector3.init px py pz)
                    min-d 10000.0
                    mat-id 0.0f]
                (do
                  (for [i 0 num-shapes]
                    (let [sdf (Array.unsafe-nth static-sdfs i)
                          d (SDF.distance-world sdf &p)]
                      (when (< d min-d)
                        (do
                          (set! min-d d)
                          (set! mat-id @(Array.unsafe-nth static-mat-ids i))))))
                  (let [idx (* (+ x (+ (* y w-dim) (* (* z w-dim) h-dim))) 4)]
                    (do
                      (Array.aset! voxel-data idx (Double.to-float min-d))
                      (Array.aset! voxel-data (+ idx 1) mat-id)
                      (Array.aset! voxel-data (+ idx 2) 0.0f)
                      (Array.aset! voxel-data (+ idx 3) 0.0f))))))))
        (WGPU.write-floats ctx @(WGPURenderer.voxel-gpu-buffer ren) voxel-data)
        (pack-and-copy-chunk! ctx ren @(Chunk.atlas-slot chunk))
        )))

  (defn bake-voxel-grid! [ctx ren grid ecs-world world-data]
    (let [static-sdfs []
          static-mat-ids []]
      (do
        (IO.println "BAKING VOXEL GRID (CHUNKED)...")
        (ECS.query ecs-world [ent (rb RigidBody) (col Collidable)]
          (when (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)
            (match-ref (Collidable.volume col)
              (Volume.Sdf sdf)
                (do
                  (SDF.set-position! sdf @(RigidBody.position rb))
                  (SDF.set-rotation! sdf @(RigidBody.rotation rb))
                  (let [saved-nodes @(SDF.csg-nodes sdf)]
                    (do
                      (SDF.set-csg-nodes! sdf [])
                      (Array.push-back! &static-sdfs @sdf)
                      (SDF.set-csg-nodes! sdf saved-nodes)))
                  (Array.push-back! &static-mat-ids (Double.to-float (Double.from-int (inc (the Int (Long.to-int (Uint32.to-long (ECS.Entity.id &ent)))))))))
              _ ())))
        (let [num-shapes (Array.length &static-sdfs)
              chunks (World.chunks world-data)]
          (do
            (IO.println &(format "NUM STATIC SHAPES: %d" num-shapes))
            (for [i 0 (Array.length chunks)]
              (let [chunk (Array.unsafe-nth chunks i)]
                (bake-chunk! ctx ren chunk &static-sdfs &static-mat-ids)))))
        )))

  (defn carve-voxel-grid-cpu! [chunk center radius]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          cell-size 1.0
          voxel-data (Chunk.voxel-data chunk)
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          min-x (- cx radius)
          max-x (+ cx radius)
          min-y (- cy radius)
          max-y (+ cy radius)
          min-z (- cz radius)
          max-z (+ cz radius)
          
          idx-min-x (the Int (Double.to-int (Double.floor (/ (- min-x ox) cell-size))))
          idx-max-x (the Int (Double.to-int (Double.floor (/ (- max-x ox) cell-size))))
          idx-min-y (the Int (Double.to-int (Double.floor (/ (- min-y oy) cell-size))))
          idx-max-y (the Int (Double.to-int (Double.floor (/ (- max-y oy) cell-size))))
          idx-min-z (the Int (Double.to-int (Double.floor (/ (- min-z oz) cell-size))))
          idx-max-z (the Int (Double.to-int (Double.floor (/ (- max-z oz) cell-size))))
          
          start-x (Int.clamp 0 31 idx-min-x)
          end-x (Int.clamp 0 31 idx-max-x)
          start-y (Int.clamp 0 31 idx-min-y)
          end-y (Int.clamp 0 31 idx-max-y)
          start-z (Int.clamp 0 31 idx-min-z)
          end-z (Int.clamp 0 31 idx-max-z)]
      (do
        (for [sz start-z (inc end-z)]
          (let [pz (+ oz (* (+ (Double.from-int sz) 0.5) cell-size))
                dz (- pz cz)
                dz2 (* dz dz)]
            (for [sy start-y (inc end-y)]
              (let [py (+ oy (* (+ (Double.from-int sy) 0.5) cell-size))
                    dy (- py cy)
                    dy2_dz2 (+ (* dy dy) dz2)]
                (for [sx start-x (inc end-x)]
                  (let [px (+ ox (* (+ (Double.from-int sx) 0.5) cell-size))
                        dx (- px cx)
                        dist-to-crater-center (Double.sqrt (+ (* dx dx) dy2_dz2))
                        crater-dist (- dist-to-crater-center radius)
                        idx-full (* (+ sx (+ (* sy 32) (* (* sz 32) 32))) 4)
                        old-dist (Double.from-float @(Array.unsafe-nth voxel-data idx-full))
                        new-dist (let [neg-crater-dist (- 0.0 crater-dist)]
                                   (if (> old-dist neg-crater-dist) old-dist neg-crater-dist))]
                    (Array.aset! voxel-data idx-full (Double.to-float new-dist)))))))))))



  (defn clear! [ren]
    (let [cmds (WGPURenderer.commands ren)]
      (while (not (Array.empty? cmds))
        (ignore (Array.pop-back! cmds)))))

  (defn submit! [ren cmd]
    (Array.push-back! (WGPURenderer.commands ren) cmd))

  (defn process-commands! [ctx ren time width height cam grid world world-data csg-dirty grid-dirty voxel-dirty craters]
    (let [db (World.sdf-db world-data)
          bg-color (Vector3.init 0.1 0.1 0.1)
          commands (WGPURenderer.commands ren)
          vp (Camera.view-projection cam)
          vp-data (CameraMat4.data &vp)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols (Double.from-int @(SpatialGrid.cols grid))
          rows (Double.from-int @(SpatialGrid.rows grid))
          layers (Double.from-int @(SpatialGrid.layers grid))
          origin (SpatialGrid.origin grid)
          data (WGPURenderer.u-data ren)
          flat-grid (WGPURenderer.s-data ren)
          csg-data (WGPURenderer.csg-data ren)]
      (do
        (when csg-dirty
          (for [i 0 (Array.length csg-data)]
            (Array.aset! csg-data i 0.0f)))

        (when grid-dirty
          (do
            (for [i 32 (Array.length data)]
              (Array.aset! data i 0.0f))
            (for [i 0 (Array.length flat-grid)]
              (Array.aset! flat-grid i 0.0f))))

        (let [next-csg-node-idx 0]
          (do
            ;; 1. Populate Header (0-127 bytes)
            (Array.aset! data 0 (Double.to-float time))
            (Array.aset! data 1 (Double.to-float (Double.from-int width)))
            (Array.aset! data 2 (Double.to-float (Double.from-int height)))
            (Array.aset! data 3 (Double.to-float cell-size))
            (Array.aset! data 4 (Double.to-float @(Vector3.x cam-pos)))
            (Array.aset! data 5 (Double.to-float @(Vector3.y cam-pos)))
            (Array.aset! data 6 (Double.to-float @(Vector3.z cam-pos)))
            (Array.aset! data 7 1.0f)
            (Array.aset! data 8 (Double.to-float @(Vector3.x cam-dir)))
            (Array.aset! data 9 (Double.to-float @(Vector3.y cam-dir)))
            (Array.aset! data 10 (Double.to-float @(Vector3.z cam-dir)))
            (Array.aset! data 11 0.0f)
            (Array.aset! data 12 (Double.to-float @(Vector3.x cam-right)))
            (Array.aset! data 13 (Double.to-float @(Vector3.y cam-right)))
            (Array.aset! data 14 (Double.to-float @(Vector3.z cam-right)))
            (Array.aset! data 15 0.0f)
            (Array.aset! data 16 (Double.to-float @(Vector3.x cam-up)))
            (Array.aset! data 17 (Double.to-float @(Vector3.y cam-up)))
            (Array.aset! data 18 (Double.to-float @(Vector3.z cam-up)))
            (Array.aset! data 19 0.0f)

            ;; 2. Populate BG Color and Grid Dims (80-127 bytes)
            (for [i 0 (Array.length commands)]
              (match-ref (Array.unsafe-nth commands i)
                (RenderCommand.SetBg bg) (set! bg-color @bg)
                _ ()))
            (Array.aset! data 20 (Double.to-float @(Vector3.x &bg-color)))
            (Array.aset! data 21 (Double.to-float @(Vector3.y &bg-color)))
            (Array.aset! data 22 (Double.to-float @(Vector3.z &bg-color)))
            (Array.aset! data 23 1.0f)
            (Array.aset! data 24 (Double.to-float cols))
            (Array.aset! data 25 (Double.to-float rows))
            (Array.aset! data 26 (Double.to-float layers))
            (Array.aset! data 27 0.0f)
            (Array.aset! data 28 (Double.to-float @(Vector3.x origin)))
            (Array.aset! data 29 (Double.to-float @(Vector3.y origin)))
            (Array.aset! data 30 (Double.to-float @(Vector3.z origin)))
            (Array.aset! data 31 0.0f)



            ;; 3. Populate Spheres using Database geom-id as index (128+ bytes)
            (when (or grid-dirty csg-dirty)
              (ECS.query world [ent (rb RigidBody) (col Collidable) (color Color) (g-ref GeometryRef)]
                (let [has-parent false]
                  (do
                    (ECS.with-components world @&ent [e (p Parent)]
                      (set! has-parent true))
                    (when (and (not has-parent)
                               (not (ECS.has-component? world &ent PlayerTag)))
                      (let [id @(GeometryRef.id g-ref)
                            pos (RigidBody.position rb)
                            rot (RigidBody.rotation rb)
                            c-val (Color.v color)
                            is-static (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)
                            rad (if is-static 0.0
                                  (match-ref (Collidable.volume col)
                                    (Volume.Ball b) @(Sphere.radius b)
                                    (Volume.Box b) (- 0.0 @(Vector3.x &(Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)))
                                    (Volume.Sdf sdf)
                                      (let [scale @(SDF.scale sdf)]
                                        (match-ref (SDF.base sdf)
                                          (BaseShape.Ball r) (* @r scale)
                                          (BaseShape.Box e) (- 0.0 (* @(Vector3.x e) scale))
                                          (BaseShape.Cylinder r h) (+ 1000.0 (* @r scale))
                                          (BaseShape.Capsule r h) (- 0.0 (+ 1000.0 (* @r scale)))
                                          (BaseShape.Torus rad-maj rad-min) (+ 2000.0 (* @rad-maj scale))
                                          (BaseShape.Octahedron s) (- 0.0 (+ 2000.0 (* @s scale)))
                                          _ 0.0))
                                    _ 0.0))
                            root-csg-idx -1]
                        (do
                          (when csg-dirty
                            (do
                              (match-ref (Collidable.volume col)
                                (Volume.Sdf sdf)
                                  (when (> (Array.length (SDF.csg-nodes sdf)) 0)
                                    (set! root-csg-idx (serialize-sdf! sdf csg-data (Pointer.address &next-csg-node-idx) true)))
                                _ ())
                              (let [inst (Array.unsafe-nth (SdfDatabase.instances db) id)]
                                (SdfInstance.set-root-csg-idx! inst root-csg-idx))))
                          (let [base (+ (/ WGPURenderer.header-size 4) (* id 12))
                                inst (Array.unsafe-nth (SdfDatabase.instances db) id)
                                final-csg-idx @(SdfInstance.root-csg-idx inst)]
                            (do
                              (Array.aset! data base (Double.to-float @(Vector3.x pos)))
                              (Array.aset! data (+ base 1) (Double.to-float @(Vector3.y pos)))
                              (Array.aset! data (+ base 2) (Double.to-float @(Vector3.z pos)))
                              (Array.aset! data (+ base 3) (Double.to-float rad))
                              (Array.aset! data (+ base 4) (Double.to-float @(Quaternion.x rot)))
                              (Array.aset! data (+ base 5) (Double.to-float @(Quaternion.y rot)))
                              (Array.aset! data (+ base 6) (Double.to-float @(Quaternion.z rot)))
                              (Array.aset! data (+ base 7) (Double.to-float @(Quaternion.w rot)))
                              (Array.aset! data (+ base 8) (Double.to-float @(Vector3.x c-val)))
                              (Array.aset! data (+ base 9) (Double.to-float @(Vector3.y c-val)))
                              (Array.aset! data (+ base 10) (Double.to-float @(Vector3.z c-val)))
                              (Array.aset! data (+ base 11) (Double.to-float (Double.from-int final-csg-idx))))))))))))))

            (WGPURender.update-uniform-buffer ctx @(WGPURenderer.u-buffer ren) data)

            (let [cam-qx (World.camera-chunk-qx cam-pos)
                  cam-qy (World.camera-chunk-qy cam-pos)
                  cam-qz (World.camera-chunk-qz cam-pos)
                  origin-x (- cam-qx 4)
                  origin-y (- cam-qy 4)
                  origin-z (- cam-qz 4)
                  lookup-data (World.build-chunk-lookup-data world-data origin-x origin-y origin-z)]
              (WGPURenderer.write-ints ctx (uniform-buffer-get-buffer @(WGPURenderer.chunk-lookup-buffer ren)) &lookup-data))

            (when (or @(WGPURenderer.voxel-dirty ren) voxel-dirty)
              (do
                (if (Array.empty? craters)
                  (bake-voxel-grid! ctx ren grid world world-data)
                  (do
                    (for [i 0 (Array.length craters)]
                      (let [crater (Array.unsafe-nth craters i)
                            pos (CraterSpawnData.pos crater)
                            rad @(CraterSpawnData.radius crater)
                            chunks (World.chunks world-data)]
                        (for [j 0 (Array.length chunks)]
                          (let [chunk (Array.unsafe-nth chunks j)]
                            (when (chunk-overlaps-sphere? chunk pos rad)
                              (do
                                (carve-voxel-grid-cpu! chunk pos rad)
                                (carve-voxel-grid-gpu! ctx ren chunk pos rad)))))))))
                (WGPURenderer.set-voxel-dirty! ren false)))
            
            (when grid-dirty
              (do
                (GPUSpatial.flatten-in-place! world grid WGPURenderer.max-ids-per-cell flat-grid)
                (WGPU.write-floats ctx @(WGPURenderer.s-buffer ren) flat-grid)))

            (when csg-dirty
              (WGPU.write-floats ctx @(WGPURenderer.csg-buffer ren) csg-data))

            (LinePass.update! ctx (WGPURenderer.line-pass ren) vp-data commands))))

  (defn draw [surf ctx ren line-count]
    (match (WGPURender.begin-frame surf ctx)
      (Result.Error _) ()
      (Result.Success frame)
        (do
          (WGPURenderer.run-pass frame @(WGPURenderer.pipeline ren) @(WGPURenderer.bind-group ren) (Maybe.Nothing))
          (LinePass.render frame ctx (WGPURenderer.line-pass ren) line-count @(WGPURenderer.depth-texture ren))
          (WGPURender.end-frame frame surf ctx)
          (WGPURender.free-frame frame))))
)
