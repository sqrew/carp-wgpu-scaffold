;; src/engine_jit.carp

(defmodule Engine
  (use Camera)
  (use Clock)
  (use InputManager)
  (use Collision)
  (use SpatialGrid)
  (use Transform)
  (use Quaternion)
  (use Body)
  (use RigidBody)
  (use PhysicsSystem)
  (use Random)
  (use ECS)
  (use WGPURenderer)
  (use Coordinator)
  (use FieldDatabase)
  (use World)
  (use Raymarch)
  (use Ray)

  (deftemplate null-pipeline (Fn [] WGPUComputePipeline)
    "WGPUComputePipeline $NAME()"
    "$DECL { return NULL; }"
  )

  (sig get-or-compile-jit-pipeline! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) String] WGPUComputePipeline))
  (defn get-or-compile-jit-pipeline! [e ctx master-wgsl-source]
    (let [cache (Engine.jit-cache e)
          cached-pipeline (Map.get-maybe cache &master-wgsl-source)]
      (match cached-pipeline
        (Maybe.Just pipe) pipe
        (Maybe.Nothing)
          (let [diag (Engine.diagnostics e)]
            (do
              (let [_ (IO.write-file &master-wgsl-source &@"/home/sqrew/Desktop/carp-wgpu-scaffold/last_jit_compiled.wgsl")] ())
              (Diagnostics.start-zone! diag "Sync: Compile JIT Shader")
              (let [res (WGPU.create-pipeline ctx &master-wgsl-source "main")]
                (do
                  (Diagnostics.end-zone! diag "Sync: Compile JIT Shader")
                  (match res
                    (Result.Error err)
                      (do
                        (Diagnostics.log! diag (LogLevel.Error)
                          &(str* "Una Driver Compiler Error: " &err))
                        (null-pipeline))
                    (Result.Success native-pipe)
                      (do
                        (Diagnostics.log! diag (LogLevel.Info)
                          &@"Baking fresh physical system pipeline directly to GPU hardware.")
                        (Map.put! cache &master-wgsl-source &native-pipe)
                        native-pipe)))))))))

  (sig has-active-code? (Fn [&String] Bool))
  (defn has-active-code? [content]
    (let [lines-arr (String.lines content)
          has-code false]
      (do
        (for [i 0 (Array.length &lines-arr)]
          (let [line (Array.unsafe-nth &lines-arr i)
                len (String.length line)
                non-space false
                comment false
                c-idx 0]
            (do
              (while (and (< c-idx len) (not non-space))
                (let [ch (String.char-at line c-idx)]
                  (if (Char.whitespace? ch)
                      (set! c-idx (inc c-idx))
                      (do
                        (set! non-space true)
                        (when (and (< (+ c-idx 1) len)
                                   (and (= (Char.to-int ch) 47) 
                                        (= (Char.to-int (String.char-at line (inc c-idx))) 47)))
                          (set! comment true))))))
              (when (and non-space (not comment))
                (set! has-code true)))))
        has-code)))

  (defn read-materials-shader []
    (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/materials.wgsl")
      (Result.Success s) s
      _ @""))

  (sig assemble-dynamic-ecs-shader (Fn [(Ref Engine.Engine) (Ref GameWorld)] String))
  (defn assemble-dynamic-ecs-shader [e world]
    (let [db (Engine.db e)
          world-data (Engine.world-data e)
          res @(World.voxel-resolution world-data)
          res-str (Int.str res)
          res-sq-str (Int.str (* res res))
          total-str (Int.str (* res (* res res)))
          cell-size-str (Double.str (/ 32.0 (Double.from-int res)))
          log-res (if (= res 64) 6 5)
          log-res-str (Int.str log-res)
          voxel-res-sub-1-str (Int.str (- res 1))
          slots-per-dim (/ 384 res)
          slots-per-dim-str (Int.str slots-per-dim)
          slots-per-dim-sq-str (Int.str (* slots-per-dim slots-per-dim))
          header-block 
          (str*
            "            struct PointInstance {
                pos_scale: vec4<f32>,
                rot: vec4<f32>,
                color_csg: vec4<f32>,
                light_fields: vec4<f32>,
                interaction_fields: vec4<f32>,
                em_fields: vec4<f32>,
                shape_info: vec4<f32>,
                gravity_field: vec4<f32>,
            }

            struct SunData {
                dir: vec4<f32>,
                color: vec4<f32>,
                params: vec4<f32>,
            }

            struct Uniforms {
                time: f32, 
                width: f32, 
                height: f32, 
                cell_size: f32,
                cam_pos: vec4<f32>, 
                cam_dir: vec4<f32>,
                cam_right: vec4<f32>,
                cam_up: vec4<f32>,
                bg_color: vec4<f32>,
                grid_dims: vec4<f32>,
                grid_origin: vec4<f32>,
                shadow_ao_quality: vec4<f32>,
                terrain_params1: vec4<f32>,
                terrain_params2: vec4<f32>,
                terrain_params3: vec4<f32>,
                cloud_params1: vec4<f32>,
                cloud_params2: vec4<f32>,
                misc_params: vec4<f32>,
                suns: array<SunData, 8>
            }

            struct ChunkLookup {
                origin: vec4<i32>,
                slots: array<vec4<i32>, 8192>,
                skip_grid: array<vec4<i32>, 128>,
            }

            struct ChunkInfo {
                origin_slot: vec4<f32>,
            }

            @group(0) @binding(0) var<storage, read> input_grid: array<vec4<f32>>;
            @group(0) @binding(1) var<storage, read_write> output_grid: array<vec4<f32>>;
            @group(0) @binding(2) var<uniform> u: Uniforms;
            @group(0) @binding(3) var<storage, read> chunk_info: ChunkInfo;
            @group(0) @binding(4) var<storage, read> chunk_lookup: ChunkLookup;
            @group(0) @binding(5) var voxel_texture: texture_3d<f32>;
            @group(0) @binding(10) var<storage, read> instances: array<PointInstance>;
            @group(0) @binding(6) var water_texture: texture_3d<f32>;
            @group(0) @binding(7) var gas_texture: texture_3d<f32>;
            @group(0) @binding(8) var em_texture: texture_3d<f32>;
            @group(0) @binding(9) var gravity_texture: texture_3d<f32>;
            @group(0) @binding(11) var voxel_baked_values_texture: texture_3d<f32>;

            fn get_water(x: i32, y: i32, z: i32) -> vec4<f32> {
                let world_v = vec3<f32>(round(chunk_info.origin_slot.xyz * (f32(" @&res-str "i) / 32.0))) + vec3<f32>(f32(x), f32(y), f32(z));
                let res_f = f32(" @&res-str "i);
                let q = vec3<i32>(floor(world_v / res_f));
                let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);
                
                let local_q = q - chunk_lookup.origin.xyz;
                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {
                    return vec4<f32>(0.0);
                }
                
                let mx = u32(local_q.x) >> 2u;
                let my = u32(local_q.y) >> 2u;
                let mz = u32(local_q.z) >> 2u;
                let skip_idx = mx + (my << 3u) + (mz << 6u);
                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];
                if (skip_val == 0) {
                    return vec4<f32>(0.0);
                }
                
                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;
                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];
                if (slot < 0) {
                    return vec4<f32>(0.0);
                }
                
                let slot_x = slot % " @&slots-per-dim-str "i;
                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;
                let slot_z = slot / " @&slots-per-dim-sq-str "i;
                
                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + l.x, (slot_y * " @&res-str "i) + l.y, (slot_z * " @&res-str "i) + l.z);
                return textureLoad(water_texture, atlas_coord, 0);
            }

            fn get_gravity(x: i32, y: i32, z: i32) -> vec4<f32> {
                let world_v = vec3<f32>(round(chunk_info.origin_slot.xyz * (f32(" @&res-str "i) / 32.0))) + vec3<f32>(f32(x), f32(y), f32(z));
                let cell_size = u.cell_size;
                let pos = world_v * cell_size;
                
                var sum_grav = vec3<f32>(0.0);
                var sum_td = 0.0;
                var sum_W = 0.0;
                let epsilon = 0.01;
                
                let max_instances = u32(round(u.suns[0].params.y));
                for (var i = 0u; i < max_instances; i = i + 1u) {
                    let inst = instances[i];
                    let rad = inst.pos_scale.w;
                    if (rad > 0.0) {
                        let inst_pos = inst.pos_scale.xyz;
                        let to_pos = pos - inst_pos;
                        let dist = length(to_pos);
                        let d = dist - rad;
                        let w_denom = d * d + epsilon;
                        let w = 1.0 / w_denom;
                        
                        let grav = inst.gravity_field.xyz;
                        let td = inst.gravity_field.w;
                        
                        sum_grav = sum_grav + grav * w;
                        sum_td = sum_td + td * w;
                        sum_W = sum_W + w;
                    }
                }
                
                if (sum_W > 0.00001) {
                    return vec4<f32>(sum_grav / sum_W, sum_td / sum_W);
                } else {
                    return vec4<f32>(0.0, -9.81, 0.0, 1.0);
                }
            }

            fn get_gas(x: i32, y: i32, z: i32) -> vec4<f32> {
                let world_v = vec3<f32>(round(chunk_info.origin_slot.xyz * (f32(" @&res-str "i) / 32.0))) + vec3<f32>(f32(x), f32(y), f32(z));
                let res_f = f32(" @&res-str "i);
                let q = vec3<i32>(floor(world_v / res_f));
                let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);
                
                let local_q = q - chunk_lookup.origin.xyz;
                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {
                    return vec4<f32>(0.0);
                }
                
                let mx = u32(local_q.x) >> 2u;
                let my = u32(local_q.y) >> 2u;
                let mz = u32(local_q.z) >> 2u;
                let skip_idx = mx + (my << 3u) + (mz << 6u);
                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];
                if (skip_val == 0) {
                    return vec4<f32>(0.0);
                }
                
                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;
                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];
                if (slot < 0) {
                    return vec4<f32>(0.0);
                }
                
                let slot_x = slot % " @&slots-per-dim-str "i;
                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;
                let slot_z = slot / " @&slots-per-dim-sq-str "i;
                
                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + l.x, (slot_y * " @&res-str "i) + l.y, (slot_z * " @&res-str "i) + l.z);
                return textureLoad(gas_texture, atlas_coord, 0);
            }

            fn get_voxel(x: i32, y: i32, z: i32) -> vec4<f32> {
                if (x >= 0 && x < " @&res-str " && y >= 0 && y < " @&res-str " && z >= 0 && z < " @&res-str ") {
                    let idx = u32(x + y * " @&res-str " + z * " @&res-sq-str ");
                    return input_grid[idx];
                }
                
                let world_v = vec3<i32>(round(chunk_info.origin_slot.xyz * (f32(" @&res-str "i) / 32.0))) + vec3<i32>(x, y, z);
                let qx = world_v.x >> " @&log-res-str "u;
                let qy = world_v.y >> " @&log-res-str "u;
                let qz = world_v.z >> " @&log-res-str "u;
                
                let lx = world_v.x & " @&voxel-res-sub-1-str "i;
                let ly = world_v.y & " @&voxel-res-sub-1-str "i;
                let lz = world_v.z & " @&voxel-res-sub-1-str "i;
                
                let local_q = vec3<i32>(qx, qy, qz) - chunk_lookup.origin.xyz;
                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {
                    return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                }
                
                let mx = u32(local_q.x) >> 2u;
                let my = u32(local_q.y) >> 2u;
                let mz = u32(local_q.z) >> 2u;
                let skip_idx = mx + (my << 3u) + (mz << 6u);
                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];
                if (skip_val == 0) {
                    return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                }
                
                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;
                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];
                if (slot < 0) {
                    return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                }
                
                let slot_x = slot % " @&slots-per-dim-str "i;
                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;
                let slot_z = slot / " @&slots-per-dim-sq-str "i;
                
                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);
                return textureLoad(voxel_texture, atlas_coord, 0);
            }

            fn get_baked_values(x: i32, y: i32, z: i32) -> vec4<f32> {
                let world_v = vec3<i32>(round(chunk_info.origin_slot.xyz * (f32(" @&res-str "i) / 32.0))) + vec3<i32>(x, y, z);
                let qx = world_v.x >> " @&log-res-str "u;
                let qy = world_v.y >> " @&log-res-str "u;
                let qz = world_v.z >> " @&log-res-str "u;
                
                let lx = world_v.x & " @&voxel-res-sub-1-str "i;
                let ly = world_v.y & " @&voxel-res-sub-1-str "i;
                let lz = world_v.z & " @&voxel-res-sub-1-str "i;
                
                let local_q = vec3<i32>(qx, qy, qz) - chunk_lookup.origin.xyz;
                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {
                    return vec4<f32>(0.0);
                }
                
                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;
                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];
                if (slot < 0) {
                    return vec4<f32>(0.0);
                }
                
                let slot_x = slot % " @&slots-per-dim-str "i;
                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;
                let slot_z = slot / " @&slots-per-dim-sq-str "i;
                
                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);
                return textureLoad(voxel_baked_values_texture, atlas_coord, 0);
            }

            @compute @workgroup_size(64)
            fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
                let idx = global_id.x;
                if (idx >= " @&total-str "u) { return; }
                
                let local_x = i32(idx % " @&res-str "u);
                let local_y = i32((idx / " @&res-str "u) % " @&res-str "u);
                let local_z = i32(idx / " @&res-sq-str "u);
                
                var cell = input_grid[idx];
                let voxel_pos = chunk_info.origin_slot.xyz + vec3<f32>(f32(local_x), f32(local_y), f32(local_z)) * " @&cell-size-str ";
                let dt = 0.00833 * get_gravity(local_x, local_y, local_z).w;
                let dummy_use = u.time * 0.0;
                cell.y += dummy_use;
                var cell_velocity = vec3<f32>(0.0);
                // --- DYNAMIC INJECTIONS LOOP ---")
            footer-block (str* "
                  // Apply velocity displacement to Signed Distance Field
                  cell.y += length(cell_velocity) * 0.01 + vec4<f32>(f32((textureDimensions(voxel_texture) + textureDimensions(water_texture) + textureDimensions(gas_texture) + textureDimensions(em_texture) + textureDimensions(gravity_texture) + textureDimensions(voxel_baked_values_texture)).x) * 0.0f).x;
                  output_grid[idx] = cell;
              }")
           injection-accum @""]
       (do
         (let [file-res (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/physics_rule.wgsl")]
          (match file-res
            (Result.Success content)
              (when (Engine.has-active-code? &content)
                (set! injection-accum (str* injection-accum "\n{\n// === Injected from physics_rule.wgsl ===\n" content "\n}\n")))
            (Result.Error _) ()))
        (ECS.query world [ent (gs GravitySource)]
          (let [inst-idx (EntityDatabase.get-index-by-handle (Engine.entity-db e) (ECS.Entity.handle &ent))]
            (when (>= inst-idx 0)
              (set! injection-accum (str* injection-accum "\n{\n  let instance = instances[" (Int.str inst-idx) "];\n" (GravitySource.wgsl-interaction-snippet) "\n}")))))
        (if (String.empty? &injection-accum)
            @""
            (str* (read-materials-shader) header-block injection-accum footer-block)))))

  (sig assemble-generic-rule-shader (Fn [(Ref Engine.Engine) (Ref GameWorld) (Ref String) (Ref String) (Ref String)] String))
  (defn assemble-generic-rule-shader [e world rule-file-path var-name injection-label]
    (let [world-data (Engine.world-data e)
          res @(World.voxel-resolution world-data)
          res-str (Int.str res)
          res-sq-str (Int.str (* res res))
          total-str (Int.str (* res (* res res)))
          cell-size-str (Double.str (/ 32.0 (Double.from-int res)))
          log-res (if (= res 64) 6 5)
          log-res-str (Int.str log-res)
          voxel-res-sub-1-str (Int.str (- res 1))
          slots-per-dim (/ 384 res)
          slots-per-dim-str (Int.str slots-per-dim)
          slots-per-dim-sq-str (Int.str (* slots-per-dim slots-per-dim))
          header-block 
          (str*
            "            struct PointInstance {
                pos_scale: vec4<f32>,
                rot: vec4<f32>,
                color_csg: vec4<f32>,
                light_fields: vec4<f32>,
                interaction_fields: vec4<f32>,
                em_fields: vec4<f32>,
                shape_info: vec4<f32>,
                gravity_field: vec4<f32>,
            }

            struct SunData {
                dir: vec4<f32>,
                color: vec4<f32>,
                params: vec4<f32>,
            }

            struct Uniforms {
                time: f32,
                width: f32,
                height: f32,
                cell_size: f32,
                cam_pos: vec4<f32>,
                cam_dir: vec4<f32>,
                cam_right: vec4<f32>,
                cam_up: vec4<f32>,
                bg_color: vec4<f32>,
                grid_dims: vec4<f32>,
                grid_origin: vec4<f32>,
                shadow_ao_quality: vec4<f32>,
                terrain_params1: vec4<f32>,
                terrain_params2: vec4<f32>,
                terrain_params3: vec4<f32>,
                cloud_params1: vec4<f32>,
                cloud_params2: vec4<f32>,
                misc_params: vec4<f32>,
                suns: array<SunData, 8>
            }

            struct ChunkLookup {
                origin: vec4<i32>,
                slots: array<vec4<i32>, 8192>,
                skip_grid: array<vec4<i32>, 128>,
            }

            struct ChunkInfo {
                origin_slot: vec4<f32>,
            }

            @group(0) @binding(0) var<storage, read> input_fields: array<vec4<f32>>;
            @group(0) @binding(1) var<storage, read_write> output_fields: array<vec4<f32>>;
            @group(0) @binding(2) var<uniform> u: Uniforms;
            @group(0) @binding(3) var<storage, read> chunk_info: ChunkInfo;
            @group(0) @binding(4) var<storage, read> chunk_lookup: ChunkLookup;
            @group(0) @binding(5) var voxel_texture: texture_3d<f32>;
            @group(0) @binding(10) var<storage, read> instances: array<PointInstance>;
            const GRID_RES: i32 = " @&res-str "i;
"
            (if (or (= var-name &@"em") (or (= var-name &@"fields") (or (= var-name &@"water") (or (= var-name &@"gas") (= var-name &@"light")))))
              (str*
                "            @group(0) @binding(6) var water_texture: texture_3d<f32>;\n"
                "            @group(0) @binding(7) var gas_texture: texture_3d<f32>;\n"
                "            @group(0) @binding(8) var em_texture: texture_3d<f32>;\n"
                "            @group(0) @binding(9) var gravity_texture: texture_3d<f32>;
            @group(0) @binding(11) var voxel_baked_values_texture: texture_3d<f32>;\n\n"
                 "            fn get_baked_values(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                 "                let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));\n"
                 "                let q = vec3<i32>(floor(world_v / f32(GRID_RES)));\n"
                 "                let l = vec3<i32>(world_v - vec3<f32>(q) * f32(GRID_RES));\n"
                 "                let lx = l.x;\n"
                 "                let ly = l.y;\n"
                 "                let lz = l.z;\n"
                 "                let local_q = q - chunk_lookup.origin.xyz;\n"
                 "                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;\n"
                 "                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];\n"
                 "                if (slot < 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                let slot_x = slot % " @&slots-per-dim-str "i;\n"
                 "                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;\n"
                 "                let slot_z = slot / " @&slots-per-dim-sq-str "i;\n"
                 "                let atlas_coord = vec3<i32>((slot_x * GRID_RES) + lx, (slot_y * GRID_RES) + ly, (slot_z * GRID_RES) + lz);\n"
                 "                return textureLoad(voxel_baked_values_texture, atlas_coord, 0);\n"
                 "            }\n\n"
                 "            fn get_water(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                 "                let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));\n"
                 "                let res_f = f32(GRID_RES);\n"
                 "                let q = vec3<i32>(floor(world_v / res_f));\n"
                 "                let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);\n"
                 "                let lx = l.x;\n"
                 "                let ly = l.y;\n"
                 "                let lz = l.z;\n"
                 "                \n"
                 "                let local_q = q - chunk_lookup.origin.xyz;\n"
                 "                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let mx = u32(local_q.x) >> 2u;\n"
                 "                let my = u32(local_q.y) >> 2u;\n"
                 "                let mz = u32(local_q.z) >> 2u;\n"
                 "                let skip_idx = mx + (my << 3u) + (mz << 6u);\n"
                 "                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];\n"
                 "                if (skip_val == 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;\n"
                 "                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];\n"
                 "                if (slot < 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let slot_x = slot % " @&slots-per-dim-str "i;\n"
                 "                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;\n"
                 "                let slot_z = slot / " @&slots-per-dim-sq-str "i;\n"
                 "                \n"
                 "                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);\n"
                 "                return textureLoad(water_texture, atlas_coord, 0);\n"
                 "            }\n\n"
                 "            fn get_gas(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                 "                let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));\n"
                 "                let res_f = f32(GRID_RES);\n"
                 "                let q = vec3<i32>(floor(world_v / res_f));\n"
                 "                let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);\n"
                 "                let lx = l.x;\n"
                 "                let ly = l.y;\n"
                 "                let lz = l.z;\n"
                 "                \n"
                 "                let local_q = q - chunk_lookup.origin.xyz;\n"
                 "                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let mx = u32(local_q.x) >> 2u;\n"
                 "                let my = u32(local_q.y) >> 2u;\n"
                 "                let mz = u32(local_q.z) >> 2u;\n"
                 "                let skip_idx = mx + (my << 3u) + (mz << 6u);\n"
                 "                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];\n"
                 "                if (skip_val == 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;\n"
                 "                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];\n"
                 "                if (slot < 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let slot_x = slot % " @&slots-per-dim-str "i;\n"
                 "                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;\n"
                 "                let slot_z = slot / " @&slots-per-dim-sq-str "i;\n"
                 "                \n"
                 "                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);\n"
                 "                return textureLoad(gas_texture, atlas_coord, 0);\n"
                 "            }\n\n"
                 "            fn get_em(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                 "                let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));\n"
                 "                let res_f = f32(GRID_RES);\n"
                 "                let q = vec3<i32>(floor(world_v / res_f));\n"
                 "                let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);\n"
                 "                let lx = l.x;\n"
                 "                let ly = l.y;\n"
                 "                let lz = l.z;\n"
                 "                \n"
                 "                let local_q = q - chunk_lookup.origin.xyz;\n"
                 "                if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let mx = u32(local_q.x) >> 2u;\n"
                 "                let my = u32(local_q.y) >> 2u;\n"
                 "                let mz = u32(local_q.z) >> 2u;\n"
                 "                let skip_idx = mx + (my << 3u) + (mz << 6u);\n"
                 "                let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];\n"
                 "                if (skip_val == 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;\n"
                 "                let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];\n"
                 "                if (slot < 0) {\n"
                 "                    return vec4<f32>(0.0);\n"
                 "                }\n"
                 "                \n"
                 "                let slot_x = slot % " @&slots-per-dim-str "i;\n"
                 "                let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;\n"
                 "                let slot_z = slot / " @&slots-per-dim-sq-str "i;\n"
                 "                \n"
                 "                let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);\n"
                 "                return textureLoad(em_texture, atlas_coord, 0);\n"
                 "            }\n\n"
                "            fn get_gravity(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                "                let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));\n"
                "                let cell_size = u.cell_size;\n"
                "                let pos = world_v * cell_size;\n"
                "                \n"
                "                var sum_grav = vec3<f32>(0.0);\n"
                "                var sum_td = 0.0;\n"
                "                var sum_W = 0.0;\n"
                "                let epsilon = 0.01;\n"
                "                \n"
                "                let max_instances = u32(round(u.suns[0].params.y));\n"
                "                for (var i = 0u; i < max_instances; i = i + 1u) {\n"
                "                    let inst = instances[i];\n"
                "                    let rad = inst.pos_scale.w;\n"
                "                    if (rad > 0.0) {\n"
                "                        let inst_pos = inst.pos_scale.xyz;\n"
                "                        let to_pos = pos - inst_pos;\n"
                "                        let dist = length(to_pos);\n"
                "                        let d = dist - rad;\n"
                "                        let w_denom = d * d + epsilon;\n"
                "                        let w = 1.0 / w_denom;\n"
                "                        \n"
                "                        let grav = inst.gravity_field.xyz;\n"
                "                        let td = inst.gravity_field.w;\n"
                "                        \n"
                "                        sum_grav = sum_grav + grav * w;\n"
                "                        sum_td = sum_td + td * w;\n"
                "                        sum_W = sum_W + w;\n"
                "                    }\n"
                "                }\n"
                "                \n"
                "                if (sum_W > 0.00001) {\n"
                "                    return vec4<f32>(sum_grav / sum_W, sum_td / sum_W);\n"
                "                } else {\n"
                "                    return vec4<f32>(0.0, -9.81, 0.0, 1.0);\n"
                "                }\n"
                "            }\n\n"
                 "            fn get_fluid(x: i32, y: i32, z: i32) -> vec4<f32> {\n"
                 "                if (x >= 0 && x < " @&res-str "i && y >= 0 && y < " @&res-str "i && z >= 0 && z < " @&res-str "i) {\n"
                 "                    let idx = x + y * " @&res-str "i + z * " @&res-sq-str "i;\n"
                 "                    return input_fields[idx];\n"
                 "                } else {\n"
                 "                    return " (if (= var-name &@"light") "vec4<f32>(0.0)" (if (= var-name &@"gas") "get_gas(x, y, z)" "get_water(x, y, z)")) ";\n"
                 "                }\n"
                 "            }\n\n")
               @"")
 "
             fn get_voxel(x: i32, y: i32, z: i32) -> vec4<f32> {
                 let world_v = chunk_info.origin_slot.xyz + vec3<f32>(f32(x), f32(y), f32(z));
                 let res_f = f32(GRID_RES);
                 let q = vec3<i32>(floor(world_v / res_f));
                 let l = vec3<i32>(world_v - vec3<f32>(q) * res_f);
                 let lx = l.x;
                 let ly = l.y;
                 let lz = l.z;
                 
                 let local_q = q - chunk_lookup.origin.xyz;
                 if (any(local_q < vec3<i32>(0)) || any(local_q >= vec3<i32>(32))) {
                     return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                 }
                 
                 let mx = u32(local_q.x) >> 2u;
                 let my = u32(local_q.y) >> 2u;
                 let mz = u32(local_q.z) >> 2u;
                 let skip_idx = mx + (my << 3u) + (mz << 6u);
                 let skip_val = chunk_lookup.skip_grid[skip_idx >> 2u][skip_idx & 3];
                 if (skip_val == 0) {
                     return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                 }
                 
                 let idx = local_q.x + local_q.y * 32 + local_q.z * 1024;
                 let slot = chunk_lookup.slots[u32(idx) >> 2u][idx & 3];
                 if (slot < 0) {
                     return vec4<f32>(1.0, 1.5, 1.0, 1.0);
                 }
                 
                 let slot_x = slot % " @&slots-per-dim-str "i;
                 let slot_y = (slot / " @&slots-per-dim-str "i) % " @&slots-per-dim-str "i;
                 let slot_z = slot / " @&slots-per-dim-sq-str "i;
                 
                 let atlas_coord = vec3<i32>((slot_x * " @&res-str "i) + lx, (slot_y * " @&res-str "i) + ly, (slot_z * " @&res-str "i) + lz);
                 return textureLoad(voxel_texture, atlas_coord, 0);
             }

            @compute @workgroup_size(64)
            fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
                let idx = global_id.x;
                if (idx >= " @&total-str "u) { return; }
                
                let local_x = i32(idx % " @&res-str "u);
                let local_y = i32((idx / " @&res-str "u) % " @&res-str "u);
                let local_z = i32(idx / " @&res-sq-str "u);
                
                var " @var-name " = input_fields[idx];
                let voxel_pos = chunk_info.origin_slot.xyz + vec3<f32>(f32(local_x), f32(local_y), f32(local_z)) * " @&cell-size-str ";
                 let dt = 0.00833 * get_gravity(local_x, local_y, local_z).w;
                 let dummy_use = u.time * 0.0;
                 " @var-name ".x += dummy_use;
                 // --- DYNAMIC INJECTIONS LOOP ---")
            footer-block (str* "\n                output_fields[idx] = " @var-name " + vec4<f32>(f32((textureDimensions(voxel_texture) + textureDimensions(water_texture) + textureDimensions(gas_texture) + textureDimensions(em_texture) + textureDimensions(gravity_texture) + textureDimensions(voxel_baked_values_texture)).x) * 0.0f);\n            }")
          injection-accum @""]
      (do
        (let [file-res (IO.read-file rule-file-path)]
          (match file-res
            (Result.Success content)
              (when (Engine.has-active-code? &content)
                (set! injection-accum (str* injection-accum "\n{\n// === Injected from " @injection-label " ===\n" content "\n}\n")))
            (Result.Error _) ()))
        (if (String.empty? &injection-accum)
            @""
            (str* (read-materials-shader) header-block injection-accum footer-block)))))

  (sig assemble-light-rule-shader (Fn [(Ref Engine.Engine) (Ref GameWorld)] String))
  (defn assemble-light-rule-shader [e world]
    (assemble-generic-rule-shader e world &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/jit_rules/light_rule.wgsl" &@"light" &@"light_rule.wgsl"))

  (sig evaluate-light-rule-hot-reload! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) (Ref WGPURenderer)] ()))
  (defn evaluate-light-rule-hot-reload! [e ctx ren]
    (let [world (Engine.world e)
          new-source (Engine.assemble-light-rule-shader e world)]
      (if (String.empty? &new-source)
          (when (not (= (Engine.last-known-light-rule e) &new-source))
            (do
              (Engine.set-last-known-light-rule! e @&new-source)
              (IO.println "Light rule JIT system cleared.")
              (World.dirty-all-chunks! (Engine.world-data e))))
          (when (not (= (Engine.last-known-light-rule e) &new-source))
            (do
              (Engine.set-last-known-light-rule! e @&new-source)
              (let [pipe (Engine.get-or-compile-jit-pipeline! e ctx @&new-source)]
                (if (WGPU.pipeline-null?- pipe)
                    ()
                    (do
                       (let [_ (IO.write-file &new-source &@"/home/sqrew/Desktop/carp-wgpu-scaffold/light_compiled.wgsl")] ())
                       (IO.println "Light rule JIT system reloaded and active.")
                       (World.dirty-all-chunks! (Engine.world-data e))))))))))

