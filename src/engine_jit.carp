  (sig evaluate-render-hot-reload! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) (Ref WGPURenderer)] ()))
  (defn evaluate-render-hot-reload! [e ctx ren]
    (let [file-res1 (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/raymarch.wgsl")
          file-res2 (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shading_rule.wgsl")
          content (match file-res1
                    (Result.Success c1)
                      (match file-res2
                        (Result.Success c2) (str* c1 c2)
                        _ c1)
                    _ @"")]
      (if (String.empty? &content)
          ()
          (let [last-known (Engine.last-known-raymarch e)]
            (if (String.empty? last-known)
                (Engine.set-last-known-raymarch! e @&content)
                (when (not (= last-known &content))
                  (do
                    (Engine.set-last-known-raymarch! e @&content)
                    (let [ray-steps @(Settings.ray-steps (Engine.settings e))
                          shadow-steps @(Settings.shadow-steps (Engine.settings e))
                          voxel-res @(World.voxel-resolution (Engine.world-data e))
                          new-shader (Shaders.shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell ray-steps shadow-steps voxel-res)
                          format (WGPURenderer.format ren)
                          pipe-res (WGPURender.create-pipeline ctx &new-shader "vs_main" "fs_main" format)]
                      (match pipe-res
                        (Result.Success new-pipe)
                          (let [old-pipe @(WGPURenderer.pipeline ren)
                                new-bg-res (create-voxel-render-bind-group-chunked-em-result
                                             ctx
                                             new-pipe
                                             @(WGPURenderer.s-buffer ren)
                                             @(WGPURenderer.csg-buffer ren)
                                             @(WGPURenderer.u-buffer ren)
                                             @(WGPURenderer.voxel-texture ren)
                                             @(WGPURenderer.voxel-baked-values-texture ren)
                                             @(WGPURenderer.light-texture ren)
                                             @(WGPURenderer.interaction-texture ren)
                                             @(WGPURenderer.water-texture ren)
                                             @(WGPURenderer.gas-texture ren)
                                             @(WGPURenderer.em-texture ren)
                                             @(WGPURenderer.gravity-texture ren)
                                             @(WGPURenderer.voxel-sampler ren)
                                             @(WGPURenderer.chunk-lookup-buffer ren)
                                             @(WGPURenderer.noise-texture ren)
                                             @(WGPURenderer.noise-sampler ren)
                                             @(WGPURenderer.instances-buffer ren))]
                            (match new-bg-res
                              (Result.Success new-bg)
                                (do
                                  (WGPURender.free-pipeline old-pipe)
                                  (WGPURenderer.set-pipeline! ren new-pipe)
                                  (WGPURender.free-bind-group @(WGPURenderer.bind-group ren))
                                  (WGPURenderer.set-bind-group! ren new-bg)
                                  (IO.println "GPU raymarching render pipeline recompiled successfully!"))
                              (Result.Error err)
                                (do
                                  (WGPURender.free-pipeline new-pipe)
                                  (println* "Failed to create bind group for new render pipeline: " &err))))
                        (Result.Error err)
                          (println* "Failed to compile new render pipeline: " &err))))))))))

  (sig evaluate-carve-hot-reload! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) (Ref WGPURenderer)] ()))
  (defn evaluate-carve-hot-reload! [e ctx ren]
    (let [file-res (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/shaders/carve.wgsl")]
      (match file-res
        (Result.Success content)
          (let [last-known (Engine.last-known-carve e)]
            (if (String.empty? last-known)
                (Engine.set-last-known-carve! e content)
                (when (not (= last-known &content))
                  (do
                    (Engine.set-last-known-carve! e @&content)
                    (let [voxel-res @(World.voxel-resolution (Engine.world-data e))
                          new-shader (Shaders.carve-shader voxel-res)
                          pipe-res (WGPU.create-pipeline ctx &new-shader "main")]
                      (match pipe-res
                        (Result.Success new-pipe)
                          (let [old-pipe @(WGPURenderer.carve-pipeline ren)]
                            (do
                              (WGPU.free-pipeline old-pipe)
                              (WGPURenderer.set-carve-pipeline! ren new-pipe)
                              (IO.println "GPU carve compute pipeline recompiled successfully!")))
                        (Result.Error err)
                          (println* "Failed to compile new carve compute pipeline: " &err)))))))
        (Result.Error _) ())))

  (sig check-global-jit-rules? (Fn [] Bool))
  (defn check-global-jit-rules? []
    (match (IO.read-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/src/physics_rule.wgsl")
      (Result.Success content) (Engine.has-active-code? &content)
      _ false))

  (sig chunk-affected-by-jit? (Fn [(Ref GameWorld) (Ref Chunk) Bool] Bool))
  (defn chunk-affected-by-jit? [world chunk has-global-rules]
    (if has-global-rules
        true
        (let [affected false
              qx @(Chunk.coord-x chunk)
              qy @(Chunk.coord-y chunk)
              qz @(Chunk.coord-z chunk)
              c-min-x (* (Double.from-int qx) 32.0)
              c-min-y (* (Double.from-int qy) 32.0)
              c-min-z (* (Double.from-int qz) 32.0)
              c-max-x (+ c-min-x 32.0)
              c-max-y (+ c-min-y 32.0)
              c-max-z (+ c-min-z 32.0)]
          (do
            (ECS.query world [ent (gs GravitySource) (col Collidable)]
              (match-ref (Collidable.volume col)
                (Volume.Ball sphere)
                  (let [center (Sphere.center sphere)
                        radius @(Sphere.radius sphere)
                        cx @(Vector3.x center)
                        cy @(Vector3.y center)
                        cz @(Vector3.z center)
                        px (Double.clamp c-min-x c-max-x cx)
                        py (Double.clamp c-min-y c-max-y cy)
                        pz (Double.clamp c-min-z c-max-z cz)
                        dx (- px cx)
                        dy (- py cy)
                        dz (- pz cz)
                        dist-sq (+ (* dx dx) (+ (* dy dy) (* dz dz)))]
                    (when (< dist-sq (* radius radius))
                      (set! affected true)))
                _ ()))
            affected))))

  (def readback-frame-counter 0)

  (sig run-jit-physics-loop! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) (Ref WGPURenderer)] ()))
  (defn run-jit-physics-loop! [e ctx ren]
    (do
      (set! readback-frame-counter (Int.mod (inc readback-frame-counter) 6))
      (let [world-data (Engine.world-data e)
          world (Engine.world e)
          chunks (World.chunks world-data)
          num-chunks (Array.length chunks)
          script (Engine.last-known-script e)
          res @(World.voxel-resolution world-data)
          dispatch-cnt (/ (* res (* res res)) 64)]
      (if (String.empty? script)
          ()
          (let [cache (Engine.jit-cache e)
                pipe-maybe (Map.get-maybe cache script)]
            (match pipe-maybe
              (Maybe.Just pipe)
                (let [u-b (WGPURender.uniform-buffer-get-buffer @(WGPURenderer.u-buffer ren))
                      has-global-rules (check-global-jit-rules?)
                      batch (GPUBatcher.begin-batch ctx)
                      chunk-to-read -1]
                  (do
                    (for [i 0 num-chunks]
                      (let [chunk (Array.unsafe-nth chunks i)
                            v-gpu-b @(Chunk.gpu-buffer chunk)]
                        (if (WGPU.buffer-null?- v-gpu-b)
                            ()
                            (when (chunk-affected-by-jit? world chunk has-global-rules)
                              (let [qx-f (Double.to-float (* (Double.from-int @(Chunk.coord-x chunk)) 32.0))
                                    qy-f (Double.to-float (* (Double.from-int @(Chunk.coord-y chunk)) 32.0))
                                    qz-f (Double.to-float (* (Double.from-int @(Chunk.coord-z chunk)) 32.0))
                                    slot-f (Float.from-int @(Chunk.atlas-slot chunk))
                                    origin-data [qx-f qy-f qz-f slot-f]]
                                (do
                                  (let [info-b @(Chunk.jit-info-buffer chunk)
                                        info-b-actual (if (WGPU.buffer-null?- info-b)
                                                          (match (WGPU.create-buffer ctx 16)
                                                            (Result.Success new-info-b)
                                                              (do
                                                                (Chunk.set-jit-info-buffer! chunk new-info-b)
                                                                new-info-b)
                                                            (Result.Error err-val)
                                                              (do
                                                                (IO.println &(format "Error creating JIT info buffer: %s" &err-val))
                                                                (null-buffer)))
                                                          info-b)]
                                    (do
                                      (WGPU.write-floats ctx info-b-actual &origin-data)
                                      (let [cached-bg @(Chunk.jit-bind-group chunk)
                                            bg (if (WGPU.bindgroup-null?- cached-bg)
                                                    (match (create-jit-bind-group-em-result
                                                             ctx
                                                             pipe
                                                             v-gpu-b
                                                             @(WGPURenderer.voxel-gpu-buffer ren)
                                                             u-b
                                                             info-b-actual
                                                             @(WGPURenderer.chunk-lookup-buffer ren)
                                                             @(WGPURenderer.voxel-texture ren)
                                                             @(WGPURenderer.voxel-baked-values-texture ren)
                                                             @(WGPURenderer.water-texture ren)
                                                             @(WGPURenderer.gas-texture ren)
                                                             @(WGPURenderer.em-texture ren)
                                                             @(WGPURenderer.gravity-texture ren)
                                                             @(WGPURenderer.instances-buffer ren))
                                                      (Result.Error err)
                                                        (do
                                                          (IO.println &(str* "JIT Bind Group error: " &err))
                                                          (null-bind-group))
                                                      (Result.Success new-bg)
                                                        (do
                                                          (Chunk.set-jit-bind-group! chunk new-bg)
                                                          new-bg))
                                                   cached-bg)]
                                    (when (not (WGPU.bindgroup-null?- bg))
                                      (do
                                        (GPUBatcher.batch-dispatch batch pipe bg dispatch-cnt)
                                        (GPUBatcher.batch-copy-buffer batch @(WGPURenderer.voxel-gpu-buffer ren) v-gpu-b (Long.from-int (* res (* res (* res 16)))))
                                        (VoxelBaker.pack-and-copy-chunk-batched! batch ctx ren chunk v-gpu-b @(Chunk.atlas-slot chunk) res)
                                        ;; --- Sync to CPU for Player/Physics Collision ---
                                        (let [cam-pos (Camera.pos (Engine.camera e))
                                              p-qx (World.camera-chunk-qx world-data cam-pos)
                                              p-qy (World.camera-chunk-qy world-data cam-pos)
                                              p-qz (World.camera-chunk-qz world-data cam-pos)
                                              c-qx @(Chunk.coord-x chunk)
                                              c-qy @(Chunk.coord-y chunk)
                                              c-qz @(Chunk.coord-z chunk)]
                                          (when (and (= p-qx c-qx)
                                                     (and (= p-qy c-qy)
                                                          (and (= p-qz c-qz)
                                                               (= readback-frame-counter 0))))
                                            (set! chunk-to-read i))))))))))))))
                    (GPUBatcher.end-batch ctx batch)
                    (when (>= chunk-to-read 0)
                      (let [c (Array.unsafe-nth chunks chunk-to-read)
                            v-gpu-b @(Chunk.gpu-buffer c)
                            n-floats (* res (* res (* res 4)))
                            read-back (WGPU.read-floats ctx v-gpu-b n-floats)]
                        (Chunk.set-voxel-data! c read-back)))
                    )
                  )
              _ ())))))))
