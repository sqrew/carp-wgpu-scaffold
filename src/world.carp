(deftemplate null-buffer (Fn [] WGPUBuffer)
  "WGPUBuffer $NAME()"
  "$DECL { return NULL; }")

(deftype Chunk [
  coord-x Int
  coord-y Int
  coord-z Int
  voxel-data (Array Float)
  atlas-slot Int
  modified Bool
  bake-progress Int
  gpu-buffer WGPUBuffer
])

(deftype World [
  field-db FieldDatabase
  grid-origin (Vector3 Double)
  cell-size Double
  grid-width Int
  grid-height Int
  grid-depth Int
  chunks (Array Chunk)
  last-cam-x Int
  last-cam-y Int
  last-cam-z Int
  cache-qx (Array Int)
  cache-qy (Array Int)
  cache-qz (Array Int)
  cache-idx (Array Int)
  modified-chunks (Array Chunk)
  voxel-resolution Int
])

(defmodule World
  (use Vector3)
  (use FieldDatabase)
  (use SpatialGrid)

  (defn create-initial-chunks [voxel-res]
    (let [arr (the (Array Chunk) [])
          size-floats (* voxel-res (* voxel-res (* voxel-res 4)))]
      (do
        (for [z -1 2]
          (for [y -1 2]
            (for [x -1 2]
              (let [voxel-data (the (Array Float) (replicate size-floats &1000.0f))
                    slot (+ (+ (+ x 1) (* (+ y 1) 3)) (* (+ z 1) 9))
                    chunk (Chunk.init x y z voxel-data slot false 0 (null-buffer))]
                (Array.push-back! &arr chunk)))))
        arr)))

  (defn new [origin cell-size w h d voxel-res]
    (let [cqx (the (Array Int) (replicate 64 &-999))
          cqy (the (Array Int) (replicate 64 &-999))
          cqz (the (Array Int) (replicate 64 &-999))
          cidx (the (Array Int) (replicate 64 &-1))
          total-cells (* w (* h d))
          db (FieldDatabase.new)]
      (do
        (ignore (FieldDatabase.register-kernel! &db @"temperature" 0.0 -120.0 120.0 FieldDatabase.diffuse-temperature!))
        (ignore (FieldDatabase.register-kernel! &db @"age" 0.0 0.0 100.0 FieldDatabase.tick-age!))
        (ignore (FieldDatabase.register-kernel! &db @"humidity" 0.2 0.0 1.0 FieldDatabase.diffuse-humidity!))
        (ignore (FieldDatabase.register-kernel! &db @"pressure" 0.0 0.0 100.0 FieldDatabase.diffuse-pressure!))
        (ignore (FieldDatabase.register-kernel! &db @"charge" 0.0 -10.0 10.0 FieldDatabase.diffuse-charge!))
        (ignore (FieldDatabase.register-kernel! &db @"gravity" 1.0 -50.0 50.0 FieldDatabase.noop-update))
        (ignore (FieldDatabase.register-kernel! &db @"density" 1.0 0.0 100.0 FieldDatabase.diffuse-density!))
        (ignore (FieldDatabase.register-kernel! &db @"lifetime" 1.0 0.0 100.0 FieldDatabase.tick-lifetime!))
        (World.init db origin cell-size w h d (create-initial-chunks voxel-res) -999 -999 -999 cqx cqy cqz cidx (the (Array Chunk) []) voxel-res))))

  (defn init-gpu-buffers! [ctx world-data]
    (let [chunks (World.chunks world-data)
          num-chunks (Array.length chunks)
          res @(World.voxel-resolution world-data)
          buf-size (* res (* res (* res 16)))]
      (for [i 0 num-chunks]
        (let [chunk (Array.unsafe-nth chunks i)
              buf (WGPU.create-buffer ctx buf-size)]
          (match buf
            (Result.Error e) (IO.println &(format "Error creating GPU buffer for chunk %d" i))
            (Result.Success b)
              (do
                (WGPU.write-floats ctx b (Chunk.voxel-data chunk))
                (Chunk.set-gpu-buffer! chunk b)))))))

  (defn create-spatial-grid [w]
    (SpatialGrid.new-with-origin
      @(World.cell-size w)
      @(World.grid-width w)
      @(World.grid-height w)
      @(World.grid-depth w)
      @(World.grid-origin w)))

  (defn voxel-cell-size [world] (/ 32.0 (Double.from-int @(World.voxel-resolution world))))
  (defn chunk-size [] 32.0)

  (defn camera-chunk-qx [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.x cam-pos) (World.chunk-size))))))
  (defn camera-chunk-qy [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.y cam-pos) (World.chunk-size))))))
  (defn camera-chunk-qz [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.z cam-pos) (World.chunk-size))))))

  (defn build-chunk-lookup-data [world origin-x origin-y origin-z]
    (let [arr (the (Array Int) (replicate 33284 &0))
          chunks (World.chunks world)
          res @(World.voxel-resolution world)]
      (do
        (Array.aset! &arr 0 origin-x)
        (Array.aset! &arr 1 origin-y)
        (Array.aset! &arr 2 origin-z)
        (Array.aset! &arr 3 0)
        (for [i 4 32772]
          (Array.aset! &arr i -1))
        (for [i 0 (Array.length chunks)]
          (let [chunk (Array.unsafe-nth chunks i)
                qx @(Chunk.coord-x chunk)
                qy @(Chunk.coord-y chunk)
                qz @(Chunk.coord-z chunk)
                lx (- qx origin-x)
                ly (- qy origin-y)
                lz (- qz origin-z)]
            (when (and (= @(Chunk.bake-progress chunk) res)
                       (and (and (>= lx 0) (< lx 32))
                            (and (and (>= ly 0) (< ly 32))
                                 (and (>= lz 0) (< lz 32)))))
              (let [idx (+ 4 (+ lx (+ (* ly 32) (* lz 1024))))
                    mx (/ lx 4)
                    my (/ ly 4)
                    mz (/ lz 4)
                    skip-idx (+ 32772 (+ mx (+ (* my 8) (* mz 64))))]
                (do
                  (Array.aset! &arr idx @(Chunk.atlas-slot chunk))
                  (when (>= @(Chunk.atlas-slot chunk) 0)
                    (Array.aset! &arr skip-idx 1)))))))
        arr)))

  (defn find-chunk [world qx qy qz]
    (let [chunks (World.chunks world)
          len (Array.length chunks)
          found (Maybe.Nothing)]
      (do
        (for [i 0 len]
          (let [chunk (Array.unsafe-nth chunks i)]
            (when (and (= qx @(Chunk.coord-x chunk))
                       (and (= qy @(Chunk.coord-y chunk))
                            (= qz @(Chunk.coord-z chunk))))
              (set! found (Maybe.Just @chunk)))))
        found)))

  (defn get-voxel-at-world-grid [world gx gy gz]
    (let [res @(World.voxel-resolution world)
          res-d (Double.from-int res)
          qx (Double.to-int (Double.floor (/ (Double.from-int gx) res-d)))
          qy (Double.to-int (Double.floor (/ (Double.from-int gy) res-d)))
          qz (Double.to-int (Double.floor (/ (Double.from-int gz) res-d)))
          lx (- gx (* qx res))
          ly (- gy (* qy res))
          lz (- gz (* qz res))
          chunks (World.chunks world)
          found-idx -1
          hash-idx (Int.mod (Int.abs (+ qx (+ (* qy 3) (* qz 9)))) 64)]
      (do
        (let [cached-qx @(Array.unsafe-nth (World.cache-qx world) hash-idx)
              cached-qy @(Array.unsafe-nth (World.cache-qy world) hash-idx)
              cached-qz @(Array.unsafe-nth (World.cache-qz world) hash-idx)]
          (if (and (= qx cached-qx)
                   (and (= qy cached-qy)
                        (= qz cached-qz)))
               (set! found-idx @(Array.unsafe-nth (World.cache-idx world) hash-idx))
               ()))
        (when (= found-idx -1)
          (let [len (Array.length chunks)
                i 0]
            (do
              (while (and (< i len) (= found-idx -1))
                (let [chunk (Array.unsafe-nth chunks i)]
                  (do
                    (when (and (= @(Chunk.coord-x chunk) qx)
                               (and (= @(Chunk.coord-y chunk) qy)
                                    (= @(Chunk.coord-z chunk) qz)))
                      (set! found-idx i))
                    (set! i (inc i)))))
              (Array.aset! (World.cache-qx world) hash-idx qx)
              (Array.aset! (World.cache-qy world) hash-idx qy)
              (Array.aset! (World.cache-qz world) hash-idx qz)
              (Array.aset! (World.cache-idx world) hash-idx found-idx))))
        (if (= found-idx -1)
            1.5
            (let [chunk (Array.unsafe-nth chunks found-idx)
                  voxel-idx (* (+ lx (+ (* ly res) (* (* lz res) res))) 4)
                  val (Double.from-float @(Array.unsafe-nth (Chunk.voxel-data chunk) voxel-idx))]
              (if (< val 1.5) val 1.5))))))

  (defn sample-voxel-grid-trilinear [world p]
    (let [px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          v-size (World.voxel-cell-size world)
          
          tx (- (/ px v-size) 0.5)
          ty (- (/ py v-size) 0.5)
          tz (- (/ pz v-size) 0.5)
          
          c0-x (Double.to-int (Double.floor tx))
          c0-y (Double.to-int (Double.floor ty))
          c0-z (Double.to-int (Double.floor tz))
          
          fx (- tx (Double.from-int c0-x))
          fy (- ty (Double.from-int c0-y))
          fz (- tz (Double.from-int c0-z))
          
          v0 (World.get-voxel-at-world-grid world c0-x c0-y c0-z)
          v1 (World.get-voxel-at-world-grid world (inc c0-x) c0-y c0-z)
          v2 (World.get-voxel-at-world-grid world c0-x (inc c0-y) c0-z)
          v3 (World.get-voxel-at-world-grid world (inc c0-x) (inc c0-y) c0-z)
          v4 (World.get-voxel-at-world-grid world c0-x c0-y (inc c0-z))
          v5 (World.get-voxel-at-world-grid world (inc c0-x) c0-y (inc c0-z))
          v6 (World.get-voxel-at-world-grid world c0-x (inc c0-y) (inc c0-z))
          v7 (World.get-voxel-at-world-grid world (inc c0-x) (inc c0-y) (inc c0-z))
          
          v-01 (+ v0 (* fx (- v1 v0)))
          v-23 (+ v2 (* fx (- v3 v2)))
          v-45 (+ v4 (* fx (- v5 v4)))
          v-67 (+ v6 (* fx (- v7 v6)))
          
          v-y0 (+ v-01 (* fy (- v-23 v-01)))
          v-y1 (+ v-45 (* fy (- v-67 v-45)))]
      (+ v-y0 (* fz (- v-y1 v-y0)))))

  (defn find-unused-atlas-slot [world]
    (let [chunks (World.chunks world)
          res @(World.voxel-resolution world)
          slots-per-dim (/ 384 res)
          total-slots (* slots-per-dim (* slots-per-dim slots-per-dim))
          used-slots (the (Array Bool) (replicate total-slots &false))]
      (do
        (for [i 0 (Array.length chunks)]
          (let [chunk (Array.unsafe-nth chunks i)
                slot @(Chunk.atlas-slot chunk)]
            (when (and (>= slot 0) (< slot total-slots))
              (Array.aset! &used-slots slot true))))
        (let [found-slot -1
              s 0]
          (do
            (while (and (< s total-slots) (= found-slot -1))
              (do
                (when (not @(Array.unsafe-nth &used-slots s))
                  (set! found-slot s))
                (set! s (inc s))))
            found-slot)))))

  (defn has-chunk? [world qx qy qz]
    (let [chunks (World.chunks world)
          found false
          i 0
          len (Array.length chunks)]
      (do
        (while (and (< i len) (not found))
          (let [chunk (Array.unsafe-nth chunks i)]
            (do
              (when (and (= @(Chunk.coord-x chunk) qx)
                         (and (= @(Chunk.coord-y chunk) qy)
                              (= @(Chunk.coord-z chunk) qz)))
                (set! found true))
              (set! i (inc i)))))
        found)))

  (sig save-modified-chunk! (Fn [(Ref World) (Ref Chunk)] ()))
  (defn save-modified-chunk! [world chunk]
    (let [saved-list (World.modified-chunks world)
          len (Array.length saved-list)
          qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          found-idx -1]
      (do
        (for [i 0 len]
          (let [c (Array.unsafe-nth saved-list i)]
            (when (and (= @(Chunk.coord-x c) qx)
                       (and (= @(Chunk.coord-y c) qy)
                            (= @(Chunk.coord-z c) qz)))
              (set! found-idx i))))
        (if (= found-idx -1)
            (let [saved-voxel @(Chunk.voxel-data chunk)
                  saved-chunk (Chunk.init qx qy qz saved-voxel -1 true @(World.voxel-resolution world) (null-buffer))]
              (Array.push-back! saved-list saved-chunk))
            (let [target-chunk (Array.unsafe-nth saved-list found-idx)]
               (Chunk.set-voxel-data! target-chunk @(Chunk.voxel-data chunk)))))))

  (defn dirty-all-chunks! [world]
    (let [chunks (World.chunks world)
          len (Array.length chunks)]
      (for [i 0 len]
        (let [chunk (Array.unsafe-nth chunks i)]
          (Chunk.set-bake-progress! chunk 0)))))

  (defn clear-cache! [world]
    (let [cqx (World.cache-qx world)
          cqy (World.cache-qy world)
          cqz (World.cache-qz world)
          cidx (World.cache-idx world)]
      (do
        (for [i 0 64]
          (do
            (Array.aset! cqx i -999)
            (Array.aset! cqy i -999)
            (Array.aset! cqz i -999)
            (Array.aset! cidx i -1))))))
)
