;; src/world.carp

(deftype Vector4 [x Double y Double z Double w Double])
(defmodule Vector4
  (defn init-zero [] (Vector4.init 0.0 0.0 0.0 0.0))
)

(deftype SdfInstance [
  shape-type Int
  params Vector4
  pos (Vector3 Double)
  rot Quaternion
  scale Double
  root-csg-idx Int
  color (Vector3 Double)
])

(defmodule SdfInstance
  (use Vector3)
  (use Quaternion)

  (defn init-inactive []
    (SdfInstance.init -1 (Vector4.init-zero) (Vector3.init 0.0 0.0 0.0) (Quaternion.identity) 1.0 -1 (Vector3.init 0.0 0.0 0.0)))
)

(deftype SdfDatabase [
  instances (Array SdfInstance)
])

(defmodule SdfDatabase
  (use Array)

  (defn new []
    (let [insts (the (Array SdfInstance) (allocate 128))]
      (do
        (for [i 0 128]
          (Array.aset! &insts i (SdfInstance.init-inactive)))
        (SdfDatabase.init insts))))

  (defn register-instance! [db inst]
    (let [found-idx -1
          insts (SdfDatabase.instances db)]
      (do
        (for [i 0 (Array.length insts)]
          (when (= @(SdfInstance.shape-type (Array.unsafe-nth insts i)) -1)
            (when (= found-idx -1)
              (set! found-idx i))))
        (if (= found-idx -1)
            (let [new-id (Array.length insts)]
              (do
                (Array.push-back! insts @inst)
                new-id))
            (do
              (Array.aset! insts found-idx @inst)
              found-idx)))))

  (defn release-instance! [db id]
    (let [inst (Array.unsafe-nth (SdfDatabase.instances db) id)]
      (SdfInstance.set-shape-type! inst -1)))
)

(deftype Chunk [
  coord-x Int
  coord-y Int
  coord-z Int
  voxel-data (Array Float)
  atlas-slot Int
])

(deftype World [
  sdf-db SdfDatabase
  grid-origin (Vector3 Double)
  cell-size Double
  grid-width Int
  grid-height Int
  grid-depth Int
  chunks (Array Chunk)
])

(defmodule World
  (use Vector3)
  (use SdfDatabase)
  (use SpatialGrid)

  (defn create-initial-chunks []
    (let [arr (the (Array Chunk) [])]
      (do
        (for [z -1 2]
          (for [y -1 2]
            (for [x -1 2]
              (let [voxel-data (the (Array Float) (replicate 131072 &1000.0f))
                    slot (+ (+ (+ x 1) (* (+ y 1) 3)) (* (+ z 1) 9))
                    chunk (Chunk.init x y z voxel-data slot)]
                (Array.push-back! &arr chunk)))))
        arr)))

  (defn new [origin cell-size w h d]
    (World.init (SdfDatabase.new) origin cell-size w h d (create-initial-chunks)))

  (defn create-spatial-grid [w]
    (SpatialGrid.new-with-origin
      @(World.cell-size w)
      @(World.grid-width w)
      @(World.grid-height w)
      @(World.grid-depth w)
      @(World.grid-origin w)))

  (defn voxel-resolution [] 32)
  (defn voxel-cell-size [] 1.0)
  (defn chunk-size [] 32.0)

  (defn camera-chunk-qx [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.x cam-pos) (World.chunk-size))))))
  (defn camera-chunk-qy [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.y cam-pos) (World.chunk-size))))))
  (defn camera-chunk-qz [cam-pos]
    (the Int (Double.to-int (Double.floor (/ @(Vector3.z cam-pos) (World.chunk-size))))))

  (defn build-chunk-lookup-data [world origin-x origin-y origin-z]
    (let [arr (the (Array Int) (replicate 516 &-1))
          chunks (World.chunks world)]
      (do
        (Array.aset! &arr 0 origin-x)
        (Array.aset! &arr 1 origin-y)
        (Array.aset! &arr 2 origin-z)
        (Array.aset! &arr 3 0)
        (for [i 0 (Array.length chunks)]
          (let [chunk (Array.unsafe-nth chunks i)
                qx @(Chunk.coord-x chunk)
                qy @(Chunk.coord-y chunk)
                qz @(Chunk.coord-z chunk)
                lx (- qx origin-x)
                ly (- qy origin-y)
                lz (- qz origin-z)]
            (when (and (and (>= lx 0) (< lx 8))
                       (and (and (>= ly 0) (< ly 8))
                            (and (>= lz 0) (< lz 8))))
              (let [idx (+ 4 (+ lx (+ (* ly 8) (* lz 64))))]
                (Array.aset! &arr idx @(Chunk.atlas-slot chunk))))))
        arr)))

  (defn find-chunk [world qx qy qz]
    (let [chunks (World.chunks world)
          lx (+ qx 1)
          ly (+ qy 1)
          lz (+ qz 1)]
      (if (and (and (>= lx 0) (< lx 3))
               (and (and (>= ly 0) (< ly 3))
                    (and (>= lz 0) (< lz 3))))
          (let [idx (+ lx (+ (* ly 3) (* lz 9)))]
            (Maybe.Just @(Array.unsafe-nth chunks idx)))
          (Maybe.Nothing))))

  (defn get-voxel-at-world-grid [world gx gy gz]
    (let [qx (Int.bit-shift-right gx 5)
          qy (Int.bit-shift-right gy 5)
          qz (Int.bit-shift-right gz 5)
          lx (Int.bit-and gx 31)
          ly (Int.bit-and gy 31)
          lz (Int.bit-and gz 31)
          clx (+ qx 1)
          cly (+ qy 1)
          clz (+ qz 1)
          res 32]
      (if (and (and (>= clx 0) (< clx 3))
               (and (and (>= cly 0) (< cly 3))
                    (and (>= clz 0) (< clz 3))))
          (let [idx (+ clx (+ (* cly 3) (* clz 9)))
                chunk (Array.unsafe-nth (World.chunks world) idx)
                voxel-idx (* (+ lx (+ (* ly res) (* (* lz res) res))) 4)]
            (Double.from-float @(Array.unsafe-nth (Chunk.voxel-data chunk) voxel-idx)))
          1000.0)))

  (defn sample-voxel-grid-trilinear [world p]
    (let [px @(Vector3.x p)
          py @(Vector3.y p)
          pz @(Vector3.z p)
          v-size (World.voxel-cell-size)
          
          tx (- (/ px v-size) 0.5)
          ty (- (/ py v-size) 0.5)
          tz (- (/ pz v-size) 0.5)
          
          c0-x (Double.to-int (Double.floor tx))
          c0-y (Double.to-int (Double.floor ty))
          c0-z (Double.to-int (Double.floor tz))
          
          fx (- tx (Double.from-int c0-x))
          fy (- ty (Double.from-int c0-y))
          fz (- tz (Double.from-int c0-z))
          
          v0 (World.get-voxel-at-world-grid world c0-x c0-y c0-z)
          v1 (World.get-voxel-at-world-grid world (inc c0-x) c0-y c0-z)
          v2 (World.get-voxel-at-world-grid world c0-x (inc c0-y) c0-z)
          v3 (World.get-voxel-at-world-grid world (inc c0-x) (inc c0-y) c0-z)
          v4 (World.get-voxel-at-world-grid world c0-x c0-y (inc c0-z))
          v5 (World.get-voxel-at-world-grid world (inc c0-x) c0-y (inc c0-z))
          v6 (World.get-voxel-at-world-grid world c0-x (inc c0-y) (inc c0-z))
          v7 (World.get-voxel-at-world-grid world (inc c0-x) (inc c0-y) (inc c0-z))
          
          v-01 (+ v0 (* fx (- v1 v0)))
          v-23 (+ v2 (* fx (- v3 v2)))
          v-45 (+ v4 (* fx (- v5 v4)))
          v-67 (+ v6 (* fx (- v7 v6)))
          
          v-y0 (+ v-01 (* fy (- v-23 v-01)))
          v-y1 (+ v-45 (* fy (- v-67 v-45)))]
      (+ v-y0 (* fz (- v-y1 v-y0)))))
)
