;; engine.carp

(defmodule Engine
  (use Camera)
  (use Clock)
  (use InputManager)
  (use Collision)
  (use SpatialGrid)
  (use Transform)
  (use Quaternion)
  (use Body)
  (use RigidBody)
  (use PhysicsSystem)
  (use Random)
  (use ECS)
  (use WGPURenderer)
  (use Coordinator)
  (use SdfDatabase)
  (use World)
  (use Raymarch)
  (use Ray)

  (deftype Engine [
    camera Camera
    clock Clock
    input InputManager
    grid (SpatialGrid Uint32)
    world GameWorld
    bg-color (Vector3 Double)
    accumulator Double
    coordinator Coordinator
    world-data World
    csg-dirty Bool
    grid-dirty Bool
    voxel-dirty Bool
    craters (Array CraterSpawnData)
  ])

  (defn new [win aspect backend]
    (let [mgr (InputManager.create win backend)
          grid-origin (Vector3.init -100.0 -100.0 -100.0)
          world-data (World.new grid-origin 20.0 16 16 16)
          grid (World.create-spatial-grid &world-data)
          world (GameWorld.new)
          coord (Coordinator.new)]
      (do
        (InputManager.add-binding! &mgr "Forward" (InputSource.Key GLFW.Keycode.W) 1.0)
        (InputManager.add-binding! &mgr "Backward" (InputSource.Key GLFW.Keycode.S) 1.0)
        (InputManager.add-binding! &mgr "Left" (InputSource.Key GLFW.Keycode.A) 1.0)
        (InputManager.add-binding! &mgr "Right" (InputSource.Key GLFW.Keycode.D) 1.0)
        (InputManager.add-binding! &mgr "Up" (InputSource.Key GLFW.Keycode.E) 1.0)
        (InputManager.add-binding! &mgr "Down" (InputSource.Key GLFW.Keycode.Q) 1.0)
        (InputManager.add-binding! &mgr "LookX" (InputSource.MouseDeltaX) 0.002)
        (InputManager.add-binding! &mgr "LookY" (InputSource.MouseDeltaY) 0.002)
        (InputManager.add-binding! &mgr "Reset" (InputSource.Key GLFW.Keycode.R) 1.0)
        (InputManager.add-binding! &mgr "Fire" (InputSource.Key GLFW.Keycode.SPACE) 1.0)
        (InputManager.add-binding! &mgr "FireBouncy" (InputSource.Key GLFW.Keycode.F) 1.0)
        (InputManager.add-binding! &mgr "ScaleUp" (InputSource.Key GLFW.Keycode.C) 1.0)
        (InputManager.add-binding! &mgr "ScaleDown" (InputSource.Key GLFW.Keycode.Z) 1.0)
        (InputManager.add-binding! &mgr "Laser" (InputSource.MouseButton GLFW.Mouse.BUTTON_LEFT) 1.0)

        ;; Create Floor Entity (Giant Box SDF)
        (let [f-ent (GameWorld.create-entity! &world)
              f-pos (Vector3.init 0.0 -100.0 0.0)
              f-rb (RigidBody.static @&f-pos (Quaternion.identity) 0.8 0.8)
              f-vol (Volume.Sdf (SDF.init-box (Vector3.init 100.0 100.0 100.0) (Vector3.init 0.0 0.0 0.0) (Quaternion.identity)))
              f-col (Collidable.init @(ECS.Entity.handle &f-ent) f-vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
              f-color (Color.init (Vector3.init 0.25 0.25 0.25))
              params (Vector4.init 100.0 100.0 100.0 0.0)
              inst (SdfInstance.init 2 params f-pos (Quaternion.identity) 1.0 -1 (Vector3.init 0.25 0.25 0.25))
              geom-id (SdfDatabase.register-instance! (World.sdf-db &world-data) &inst)]
          (do
            (ECS.add-component! &world &f-ent f-rb)
            (ECS.add-component! &world &f-ent f-col)
            (ECS.add-component! &world &f-ent f-color)
            (ECS.add-component! &world &f-ent (GeometryRef.init geom-id))))

        ;; Create CSG Root Shape (Static Box) and Child Shape (Cylinder)
        (let [root-ent (GameWorld.create-entity! &world)
              root-pos (Vector3.init 5.0 2.0 0.0)
              root-rb (RigidBody.static @&root-pos (Quaternion.identity) 0.5 0.5)
              root-vol (Volume.Sdf (SDF.init-box (Vector3.init 1.5 1.5 1.5) (Vector3.init 0.0 0.0 0.0) (Quaternion.identity)))
              root-col (Collidable.init @(ECS.Entity.handle &root-ent) root-vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
              root-color (Color.init (Vector3.init 0.2 0.8 0.2))
              params (Vector4.init 1.5 1.5 1.5 0.0)
              inst (SdfInstance.init 2 params root-pos (Quaternion.identity) 1.0 -1 (Vector3.init 0.2 0.8 0.2))
              geom-id (SdfDatabase.register-instance! (World.sdf-db &world-data) &inst)
              child-ent (GameWorld.create-entity! &world)
              child-vol (Volume.Sdf (SDF.init-cylinder 0.6 2.0 (Vector3.init 0.0 0.0 0.0) (Quaternion.identity)))
              child-col (Collidable.init @(ECS.Entity.handle &child-ent) child-vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
              parent-comp (Parent.init @(ECS.Entity.handle &root-ent))
              csg-comp (CsgNode.init (Box.init (SDF.init-sphere 1.0 (Vector3.init 0.0 0.0 0.0) (Quaternion.identity))) 1)]
          (do
            (ECS.add-component! &world &root-ent root-rb)
            (ECS.add-component! &world &root-ent root-col)
            (ECS.add-component! &world &root-ent root-color)
            (ECS.add-component! &world &root-ent (GeometryRef.init geom-id))
            (ECS.add-component! &world &child-ent child-col)
            (ECS.add-component! &world &child-ent parent-comp)
            (ECS.add-component! &world &child-ent csg-comp)
            (let [world-ref &world]
              (ECS.with-components world-ref @&root-ent [e (col Collidable)]
                (match-ref (Collidable.volume col)
                  (Volume.Sdf sdf) (PhysicsSystem.build-csg-tree-rec! world-ref (ECS.Entity.handle &root-ent) sdf)
                  _ ())))))

        ;; Create Player Entity
        (let [p-ent (GameWorld.create-entity! &world)
              p-pos (Vector3.init 5.0 1.0 5.0)
              p-rb (RigidBody.new p-pos (Quaternion.identity) 1.0 0.8 0.5 0.98 0.95 0.5)
              p-vol (Volume.Ball (Sphere.init (Vector3.init 0.0 0.0 0.0) 1.0))
              p-col (Collidable.init @(ECS.Entity.handle &p-ent) p-vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
              p-color (Color.init (Vector3.init 0.0 1.0 0.0))
              p-rot (RotationState.init -1.5707 0.0)]
          (do
            (ECS.add-component! &world &p-ent p-rb)
            (ECS.add-component! &world &p-ent p-col)
            (ECS.add-component! &world &p-ent p-color)
            (ECS.add-component! &world &p-ent p-rot)
            (ECS.add-component! &world &p-ent (PlayerTag.init))))

        (for [y 0 5]
          (for [x 0 5]
            (let [ent (GameWorld.create-entity! &world)
                  x-pos (+ 5.0 (* (- (Double.from-int x) 1.5) 1.05))
                  y-pos (+ 0.55 (* (Double.from-int y) 2.0))
                  z-pos -2.0
                  pos (Vector3.init x-pos y-pos z-pos)
                  rb (RigidBody.new @&pos (Quaternion.identity) 1.0 0.3 0.6 0.98 0.95 0.5)
                  vol (Volume.Sdf (SDF.init-box (Vector3.init 0.5 0.5 0.5) @&pos (Quaternion.identity)))
                  col (Collidable.init @(ECS.Entity.handle &ent) vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)
                  color-idx (Int.random-between 0 4)
                  c-val (if (= color-idx 0)
                            (Vector3.init 0.0 1.0 1.0)
                            (if (= color-idx 1)
                                (Vector3.init 1.0 0.0 1.0)
                                (if (= color-idx 2)
                                    (Vector3.init 1.0 0.5 0.0)
                                    (Vector3.init 1.0 1.0 0.0))))
                  color (Color.init @&c-val)
                  params (Vector4.init 0.5 0.5 0.5 0.0)
                  inst (SdfInstance.init 2 params pos (Quaternion.identity) 1.0 -1 c-val)
                  geom-id (SdfDatabase.register-instance! (World.sdf-db &world-data) &inst)]
              (do
                (ECS.add-component! &world &ent rb)
                (ECS.add-component! &world &ent col)
                (ECS.add-component! &world &ent color)
                (ECS.add-component! &world &ent (GeometryRef.init geom-id))))))

          (Engine.init 
            (Camera.new (Vector3.init 5.0 1.0 5.0) -90.0 0.0 aspect)
            (Clock.new)
            mgr
            grid
            world
            (Vector3.init 0.1 0.1 0.1)
            0.0
            coord
            world-data
            true
            true
            true
            []))))

  (defn db [e]
    (World.sdf-db (Engine.world-data e)))

  (defn spawn-crater! [e pos rad]
    (let [world (Engine.world e)]
      (ECS.query world [ent (col Collidable)]
        (let [has-parent false]
          (do
            (ECS.with-components world @&ent [e (p Parent)]
              (set! has-parent true))
            (when (not has-parent)
              (match-ref (Collidable.volume col)
                (Volume.Sdf parent-sdf)
                  (let [d (SDF.distance-world parent-sdf &pos)]
                    (when (< d (* rad 2.0))
                      (let [parent-pos (SDF.position parent-sdf)
                            parent-rot (SDF.rotation parent-sdf)
                            local-pos (Quaternion.rotate &(Quaternion.inverse parent-rot) &(Vector3.sub &pos parent-pos))]
                        (do
                          (IO.println &(format "CRATER SPAWNED on entity %d" (the Int (Long.to-int (Uint32.to-long (ECS.Entity.id &ent))))))
                          (IO.println &(format "  world-pos: %s" &(Vector3.str &pos)))
                          (IO.println &(format "  parent-pos: %s" &(Vector3.str parent-pos)))
                          (IO.println &(format "  local-pos: %s" &(Vector3.str &local-pos)))
                          (let [parent-handle (ECS.Entity.handle &ent)
                                child-handles []]
                            (do
                              (ECS.query world [c-ent (c-p Parent)]
                                (when (and (Handle.equal? (Parent.handle c-p) parent-handle)
                                           (not (ECS.has-component? world &c-ent Collidable)))
                                  (Array.push-back! &child-handles @(ECS.Entity.handle &c-ent))))
                              (when (>= (Array.length &child-handles) 64)
                                (let [oldest-handle (Array.unsafe-nth &child-handles 0)
                                      oldest-ent (ECS.Entity.init @oldest-handle)]
                                  (GameWorld.destroy-entity! world &oldest-ent)))
                              (let [child-ent (GameWorld.create-entity! world)
                                    parent-comp (Parent.init @(ECS.Entity.handle &ent))
                                    csg-comp (CsgNode.init (Box.init (SDF.init-sphere rad local-pos (Quaternion.identity))) 1)]
                                (do
                                  (ECS.add-component! world &child-ent parent-comp)
                                  (ECS.add-component! world &child-ent csg-comp)
                                  (SDF.set-csg-nodes! parent-sdf [])
                                  (PhysicsSystem.build-csg-tree-rec! world (ECS.Entity.handle &ent) parent-sdf)
                                  (Engine.set-csg-dirty! e true)
                                  (Engine.set-voxel-dirty! e true)
                                  (Engine.set-grid-dirty! e true)))))))))
                _ ())))))))

  (defn register-internal-handlers! [e]
    (Coordinator.subscribe! (Engine.coordinator e)
      &(fn [ev]
        (match-ref ev
          (EventKind.Game game-ev)
            (match-ref game-ev
              (GameEvent.SpawnBullet data)
                (let [pos (BulletSpawnData.pos data)
                      vel (BulletSpawnData.vel data)
                      ang-vel (BulletSpawnData.ang-vel data)
                      scale @(BulletSpawnData.scale data)
                      bouncy @(BulletSpawnData.bouncy data)]
                  (do
                    (Prefab.spawn-bullet! (Engine.world e) (Engine.db e) pos vel ang-vel scale bouncy)
                    (Engine.set-grid-dirty! e true)
                    (Result.Success ())))
              (GameEvent.SpawnCrater data)
                (let [pos (CraterSpawnData.pos data)
                      rad @(CraterSpawnData.radius data)]
                  (do
                    (Engine.spawn-crater! e @pos rad)
                    (Array.push-back! (Engine.craters e) @data)
                    (Result.Success ())))
              _ (Result.Success ()))
          _ (Result.Success ())))))

  (defn destroy-sdf-entity! [world db ent]
    (do
      (ECS.with-components world @ent [e (g-ref GeometryRef)]
        (SdfDatabase.release-instance! db @(GeometryRef.id g-ref)))
      (GameWorld.destroy-entity! world ent)))

  (defn spawn-bullet! [e bouncy]
    (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
      (let [p-pos (RigidBody.position p-rb)
            p-scale (match-ref (Collidable.volume p-col)
                      (Volume.Ball sphere) @(Sphere.radius sphere)
                      _ 1.0)
            
            ;; Use RotationState to determine bullet direction
            yaw-axis (Vector3.init 0.0 1.0 0.0)
            pitch-axis (Vector3.init 1.0 0.0 0.0)
            q-yaw (Quaternion.from-axis-angle yaw-axis @(RotationState.yaw p-rot))
            q-pitch (Quaternion.from-axis-angle pitch-axis @(RotationState.pitch p-rot))
            look-rot (Quaternion.mul &q-yaw &q-pitch)
            p-dir (Transform.forward-quat &look-rot)
            
            ;; Spawn slightly in front of player (distance > player_rad + bullet_rad)
            bullet-pos (Vector3.add p-pos &(Vector3.mul &p-dir (* 1.6 p-scale)))
            bullet-vel (Vector3.mul &p-dir 30.0)
            
            rand-x (Double.random-between -10.0 10.0)
            rand-y (Double.random-between -10.0 10.0)
            rand-z (Double.random-between -10.0 10.0)
            bullet-ang-vel (Vector3.init rand-x rand-y rand-z)
            
            data (BulletSpawnData.init bullet-pos bullet-vel bullet-ang-vel p-scale bouncy)
            ev (EventKind.Game (GameEvent.SpawnBullet data))]
        (Coordinator.dispatch! (Engine.coordinator e) ev))))

  (defn scale-player! [e factor]
    (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-tag PlayerTag)]
      (match-ref (Collidable.volume p-col)
        (Volume.Ball sphere)
          (let [old-r @(Sphere.radius sphere)
                new-r (let [r (* old-r factor)]
                        (if (< r 0.2) 0.2 (if (> r 5.0) 5.0 r)))]
            (Sphere.set-radius! sphere new-r))
        _ ()))
  )

  (sig sample-world-distance (Fn [(Ref GameWorld) (Ref (Array Uint32)) (Ref (Vector3 Double))] Double))
  (defn sample-world-distance [world candidates p]
    (let [min-d (PhysicsSystem.sample-static-world world p)]
      (do
        (for [i 0 (Array.length candidates)]
          (let [id (Array.unsafe-nth candidates i)
                ent (ECS.Entity.init (Handle.init (Uint64.from-long (Uint32.to-long @id)) (Uint32.from-long 1l)))]
            (when (not (ECS.has-component? world &ent PlayerTag))
              (ECS.with-components world ent [e (rb RigidBody) (col Collidable)]
                (let [d (match-ref (Collidable.volume col)
                          (Volume.Ball s) (let [center (RigidBody.position rb)]
                                            (- (Vector3.dist center p) @(Sphere.radius s)))
                          (Volume.Box b) (let [center (RigidBody.position rb)
                                               rot (RigidBody.rotation rb)
                                               half-extents (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)
                                               local-p (Quaternion.rotate &(Quaternion.inverse rot) &(Vector3.sub p center))
                                               q-x (- (Double.abs @(Vector3.x &local-p)) @(Vector3.x &half-extents))
                                               q-y (- (Double.abs @(Vector3.y &local-p)) @(Vector3.y &half-extents))
                                               q-z (- (Double.abs @(Vector3.z &local-p)) @(Vector3.z &half-extents))
                                               ext-x (max q-x 0.0)
                                               ext-y (max q-y 0.0)
                                               ext-z (max q-z 0.0)
                                               ext-len (Double.sqrt (+ (* ext-x ext-x) (+ (* ext-y ext-y) (* ext-z ext-z))))
                                               int-val (min (max q-x (max q-y q-z)) 0.0)]
                                          (+ ext-len int-val))
                          (Volume.Sdf sdf) (SDF.distance-world sdf p)
                          _ 10000.0)]
                  (set! min-d (min min-d d)))))))
        min-d)))

  (sig estimate-normal-world (Fn [(Ref GameWorld) (Ref (Array Uint32)) (Ref (Vector3 Double)) Double] (Vector3 Double)))
  (defn estimate-normal-world [world candidates p eps]
    (let [ex (Vector3.init eps 0.0 0.0)
          ey (Vector3.init 0.0 eps 0.0)
          ez (Vector3.init 0.0 0.0 eps)
          p-x+ (Vector3.add p &ex)
          p-x- (Vector3.sub p &ex)
          p-y+ (Vector3.add p &ey)
          p-y- (Vector3.sub p &ey)
          p-z+ (Vector3.add p &ez)
          p-z- (Vector3.sub p &ez)
          dx (- (sample-world-distance world candidates &p-x+) (sample-world-distance world candidates &p-x-))
          dy (- (sample-world-distance world candidates &p-y+) (sample-world-distance world candidates &p-y-))
          dz (- (sample-world-distance world candidates &p-z+) (sample-world-distance world candidates &p-z-))]
      (Vector3.normalize &(Vector3.init dx dy dz))))

  (sig march-world (Fn [(Ref GameWorld) (Ref (SpatialGrid Uint32)) (Ref Ray) (Ref RaymarchConfig)] RaymarchHit))
  (defn march-world [world grid ray config]
    (let [max-d @(RaymarchConfig.max-dist config)
          candidates (SpatialGrid.query-ray-unique grid ray max-d)
          ro (Ray.origin ray)
          rd (Ray.direction ray)
          t (max @(RaymarchConfig.start-bias config) @(RaymarchConfig.hit-threshold config))
          p (Vector3.init 0.0 0.0 0.0)
          hit false
          steps 0
          max-s @(RaymarchConfig.max-steps config)
          hit-eps @(RaymarchConfig.hit-threshold config)
          step-eps @(RaymarchConfig.min-step config)]
      (do
        (while (and (< steps max-s) (< t max-d))
          (do
            (set! p (Vector3.add ro &(Vector3.mul rd t)))
            (let [d (sample-world-distance world &candidates &p)]
              (do
                (if (< d hit-eps)
                  (do (set! hit true) (break))
                  (set! t (+ t (max d step-eps))))
                (set! steps (inc steps))))))
        (let [norm (if hit (estimate-normal-world world &candidates &p hit-eps) (Vector3.init 0.0 0.0 0.0))]
          (RaymarchHit.init p norm t steps hit)))))

  (defn fire-laser! [e]
    (let [cam (Engine.camera e)
          world (Engine.world e)
          grid (Engine.grid e)
          cam-pos (Camera.pos cam)
          cam-front (Camera.front cam)
          ray (Ray.make @cam-pos @cam-front)
          config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
          hit (march-world world grid &ray &config)]
      (if @(RaymarchHit.hit &hit)
          (let [hit-p (RaymarchHit.p &hit)
                rad 0.55
                crater-data (CraterSpawnData.init @hit-p rad)
                ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
            (do
              (IO.println &(format "Laser hit at %s, spawning crater!" &(Vector3.str hit-p)))
              (Coordinator.dispatch! (Engine.coordinator e) ev)))
          (IO.println "Laser missed!"))))
  (defn process-input! [e]
    (let [mgr (Engine.input e)
          dt (Clock.unscaled-dt (Engine.clock e))]
      (do
        (InputManager.update! mgr)
        (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
          (let [p-scale (match-ref (Collidable.volume p-col)
                          (Volume.Ball sphere) @(Sphere.radius sphere)
                          _ 1.0)]
            (PlayerSystem.apply-movement! p-rb p-rot p-scale mgr dt)))
        (when (InputManager.action-pressed? mgr "Fire")
          (spawn-bullet! e false))
        (when (InputManager.action-pressed? mgr "FireBouncy")
          (spawn-bullet! e true))
        (when (InputManager.action-pressed? mgr "Laser")
          (fire-laser! e))
        (when (InputManager.action-pressed? mgr "ScaleUp")
          (scale-player! e 1.1))
        (when (InputManager.action-pressed? mgr "ScaleDown")
          (scale-player! e 0.9)))))

  (defn tick! [e]
    (let [cam (Engine.camera e)
          grid (Engine.grid e)
          world (Engine.world e)
          dt (Clock.unscaled-dt (Engine.clock e))]
      (do
        (Clock.tick! (Engine.clock e))
        (let [_ (Coordinator.tick! (Engine.coordinator e))] ()) ;; Process pending events
        
        (Engine.set-accumulator! e (+ @(Engine.accumulator e) (min dt 0.033)))
        (Engine.set-bg-color! e (Vector3.init 0.1 0.1 0.1))

        (while (>= @(Engine.accumulator e) PhysicsSystem.fixed-dt)
          (do
            (when (PhysicsSystem.step-ecs! world grid (Engine.coordinator e))
                  (Engine.set-bg-color! e (Vector3.init 0.8 0.2 0.2)))
            (Engine.set-accumulator! e (- @(Engine.accumulator e) PhysicsSystem.fixed-dt))))

        ;; Update Camera using live RotationState to decouple from physics roll & run bounds check
        (PlayerSystem.update-camera-and-bounds! world cam dt)

        ;; Update Lifetimes & Cleanup expired entities
        (let [expired-ents []]
          (do
            (ECS.query world [ent (lt Lifetime)]
              (let [new-time (- @(Lifetime.time lt) dt)]
                (do
                  (Lifetime.set-time! lt new-time)
                  (when (<= new-time 0.0)
                    (Array.push-back! &expired-ents ent)))))
            (for [i 0 (Array.length &expired-ents)]
              (do
                (destroy-sdf-entity! world (Engine.db e) (Array.unsafe-nth &expired-ents i))
                (Engine.set-grid-dirty! e true)
                (Engine.set-csg-dirty! e true)))))

        ;; Cleanup old bullets and craters to keep entity IDs recycled and low (<128)
        (let [p-pos (Vector3.init 0.0 0.0 0.0)
              p-found false]
          (do
            (ECS.query world [p-ent (p-rb RigidBody) (p-tag PlayerTag)]
              (do
                (set! p-pos @(RigidBody.position p-rb))
                (set! p-found true)))
            (when p-found
              (let [to-destroy []]
                (do
                  (ECS.query world [ent (rb RigidBody)]
                    (let [id (ECS.Entity.id &ent)]
                      (when (and (> id (Uint32.from-long 4l)) (not (ECS.has-component? world &ent PlayerTag)))
                        (let [pos (RigidBody.position rb)
                              dist (Vector3.dist pos &p-pos)]
                          (when (or (> dist 80.0) (< @(Vector3.y pos) -10.0))
                            (Array.push-back! &to-destroy ent))))))
                  
                  (for [i 0 (Array.length &to-destroy)]
                    (do
                      (destroy-sdf-entity! world (Engine.db e) (Array.unsafe-nth &to-destroy i))
                      (Engine.set-grid-dirty! e true)
                      (Engine.set-csg-dirty! e true)))
                  
                  (let [any-moving false]
                    (do
                      (ECS.query world [ent (rb RigidBody)]
                        (when (and (not (ECS.has-component? world &ent PlayerTag))
                                   (not @(Body.is-sleeping (RigidBody.body rb)))
                                   (not (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)))
                          (set! any-moving true)))
                      (when any-moving
                        (Engine.set-grid-dirty! e true))))))))))))

  (defn submit-render-commands! [e ren]
    (let [world (Engine.world e)]
      (do
        (ECS.query world [ent (rb RigidBody) (g-ref GeometryRef)]
          (let [id @(GeometryRef.id g-ref)]
            (when (>= id 0)
              (let [inst (Array.unsafe-nth (SdfDatabase.instances (Engine.db e)) id)]
                (do
                  (SdfInstance.set-pos! inst @(RigidBody.position rb))
                  (SdfInstance.set-rot! inst @(RigidBody.rotation rb)))))))
        (WGPURenderer.submit! ren (RenderCommand.SetBg @(Engine.bg-color e)))
        (ECS.query world [ent (rb RigidBody) (col Collidable) (color Color)]
          (let [pos (RigidBody.position rb)
                rot (RigidBody.rotation rb)
                vol (Collidable.volume col)
                col-vec (Color.v color)]
            (DebugDraw.volume! ren pos rot vol col-vec))))))
)
