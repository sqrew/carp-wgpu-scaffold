(defmodule Engine
  (use Camera)
  (use Clock)
  (use InputManager)
  (use Collision)
  (use SpatialGrid)
  (use Transform)
  (use Quaternion)
  (use Body)
  (use RigidBody)
  (use PhysicsSystem)
  (use Random)
  (use ECS)
  (use WGPURenderer)
  (use Coordinator)
  (use FieldDatabase)
  (use World)
  (use Raymarch)
  (use Ray)

  (defn new [win aspect backend cfg]
    (let [mgr (InputManager.create win backend)
          grid-origin (Vector3.init -120.0 -300.0 -120.0)
          world-data (World.new grid-origin 12.0 20 30 20 @(Settings.voxel-resolution &cfg))
          grid (World.create-spatial-grid &world-data)
          world (GameWorld.new)
          coord (Coordinator.new)
          db-ptr (the (Ptr ()) (ptr-cast (Pointer.address (World.field-db &world-data))))
          pres-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 3) FieldKernelStorage.sample FieldKernelStorage.update)
          vel-field (Field.init (FieldKernelStorageVector.init db-ptr (null-ptr) (null-ptr)) FieldKernelStorageVector.sample FieldKernelStorageVector.update)
          temp-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 0) FieldKernelStorage.sample FieldKernelStorage.update)
          light-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 1) FieldKernelStorage.sample FieldKernelStorage.update)
          hum-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 2) FieldKernelStorage.sample FieldKernelStorage.update)
          stress-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 4) FieldKernelStorage.sample FieldKernelStorage.update)
          ph-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 5) FieldKernelStorage.sample FieldKernelStorage.update)
          grav-field (Field.init (GravityFieldStorage.init db-ptr (null-ptr) (null-ptr)) GravityFieldStorage.sample GravityFieldStorage.update)
          time-dilation-field (Field.init (FieldKernelStorage.init db-ptr (null-ptr) (null-ptr) 11) FieldKernelStorage.sample FieldKernelStorage.update)
          diag (Diagnostics.new @"/home/sqrew/Desktop/carp-wgpu-scaffold/diagnostics.log")]
      (do
        (Diagnostics.log! &diag (LogLevel.Info) "=== Engine Started / Diagnostics Initialized ===")
        (register-bindings! &mgr)
        (spawn-csg-demo! &world)
        (spawn-player! &world)
        (spawn-gravity-fields! &world)
        (spawn-physics-blocks! &world)
        (let [r-db (RenderDatabase.create &grid WGPURenderer.max-ids-per-cell)]
          (Engine.init 
            (Camera.new (Vector3.init 5.0 1.0 5.0) -90.0 0.0 aspect)
            (Clock.new)
            mgr
            grid
            world
            (Vector3.init 0.1 0.1 0.1)
            [(Sun.init (Vector3.init 0.5 1.0 0.3) (Vector3.init 1.0 0.95 0.85) 10.0 true 0.2 0.0 1.0 1.0 1.0)
             (Sun.init (Vector3.init -0.5 1.0 -0.3) (Vector3.init 0.5 0.8 1.0) 22.0 true 0.2 3.14159 0.6 1.5 2.0)]
            0.0
            coord
            world-data
            true
            true
            true
            true
            []
            []
            @(Settings.show-debug-lines &cfg)
            0
            @(Settings.shadow-quality &cfg)
            pres-field
            vel-field
            temp-field
            light-field
            hum-field
            stress-field
            ph-field
            grav-field
            time-dilation-field
            r-db
            @(Settings.volumetric-sdf &cfg)
            @(Settings.chunk-loading-enabled &cfg)
            diag
            (Maybe.Nothing)
            (Map.create)
            (the String @"")
            (the String @"")
            (the String @"")
            (the String @"")
            (the String @"")
            (the String @"")
            (the String @"")
            (the String @"")
            cfg
            2.0
            1)))))


  (sig spawn-crater! (Fn [(Ref Engine.Engine) (Vector3 Double) Double Int (Maybe (Handle ()))] (Maybe (Handle ()))))
  (defn spawn-crater! [e pos rad op existing-crater]
    (let [world (Engine.world e)
          result existing-crater]
      (do
        (match existing-crater
          (Maybe.Just child-handle)
            (let [child-ent (ECS.Entity.init child-handle)]
              (ECS.with-components world @&child-ent [c (node CsgNode)]
                (let [child-sdf (Box.peek (CsgNode.shape node))]
                  (do
                    (SDF.set-base! child-sdf (BaseShape.Ball rad))
                    (ECS.with-components world @&child-ent [c (p Parent)]
                      (let [parent-handle (Parent.handle p)
                            parent-ent (ECS.Entity.init @parent-handle)]
                        (ECS.with-components world parent-ent [p-ent (col Collidable)]
                          (match-ref (Collidable.volume col)
                            (Volume.Sdf parent-sdf)
                              (do
                                (SDF.set-csg-nodes! parent-sdf [])
                                (PhysicsSystem.build-csg-tree-rec! world parent-handle parent-sdf)
                                (Engine.set-csg-dirty! e true)
                                (Engine.set-grid-dirty! e true))
                            _ ()))))))))
          (Maybe.Nothing)
            (ECS.query world [parent-ent (swt StaticWorldTag) (col Collidable)]
              (match-ref (Collidable.volume col)
                (Volume.Sdf parent-sdf)
                  (let [d (SDF.distance-world parent-sdf &pos)
                        check-rad (if (< rad 4.0) 4.0 rad)]
                    (when (< d (* check-rad 2.0))
                      (let [parent-pos (SDF.position parent-sdf)
                            parent-rot (SDF.rotation parent-sdf)
                            local-pos (Quaternion.rotate &(Quaternion.inverse parent-rot) &(Vector3.sub &pos parent-pos))
                            parent-handle (ECS.Entity.handle &parent-ent)
                            child-handles []]
                        (do
                          (ECS.query world [c-ent (c-p Parent)]
                            (when (and (Handle.equal? (Parent.handle c-p) parent-handle)
                                       (not (ECS.has-component? world &c-ent Collidable)))
                               (Array.push-back! &child-handles @(ECS.Entity.handle &c-ent))))
                          (when (>= (Array.length &child-handles) 64)
                            (let [oldest-handle (Array.unsafe-nth &child-handles 0)
                                  oldest-ent (ECS.Entity.init @oldest-handle)]
                               (GameWorld.destroy-entity! world &oldest-ent)))
                          (let [child-ent (GameWorld.create-entity! world)
                                parent-comp (Parent.init @parent-handle)
                                csg-comp (CsgNode.init (Box.init (SDF.init-sphere rad local-pos (Quaternion.identity))) op)]
                            (do
                              (ECS.add-component! world &child-ent parent-comp)
                              (ECS.add-component! world &child-ent csg-comp)
                              (SDF.set-csg-nodes! parent-sdf [])
                              (PhysicsSystem.build-csg-tree-rec! world parent-handle parent-sdf)
                              (Engine.set-csg-dirty! e true)
                              (Engine.set-grid-dirty! e true)
                              (set! result (Maybe.Just @(ECS.Entity.handle &child-ent)))))))))
                _ ())))
        result)))

  (defn init-fields! [e]
    (let [db-ptr (the (Ptr ()) (ptr-cast (Pointer.address (World.field-db (Engine.world-data e)))))
          entity-db-ptr (the (Ptr ()) (ptr-cast (Pointer.address (World.entity-db (Engine.world-data e)))))
          grid-ptr (Pointer.address (Engine.grid e))
          pres-field (Engine.pressure-field e)
          vel-field (Engine.velocity-field e)
          temp-field (Engine.temperature-field e)
          light-field (Engine.light-field e)
          hum-field (Engine.humidity-field e)
          stress-field (Engine.stress-field e)
           ph-field (Engine.ph-field e)
           grav-field (Engine.gravity-field e)
           td-field (Engine.time-dilation-field e)]
       (do
         (FieldKernelStorage.set-db-ptr! (Field.storage pres-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage pres-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage pres-field) grid-ptr)
         (FieldKernelStorageVector.set-db-ptr! (Field.storage vel-field) db-ptr)
         (FieldKernelStorageVector.set-entity-db-ptr! (Field.storage vel-field) entity-db-ptr)
         (FieldKernelStorageVector.set-grid-ptr! (Field.storage vel-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage temp-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage temp-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage temp-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage light-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage light-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage light-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage hum-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage hum-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage hum-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage stress-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage stress-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage stress-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage ph-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage ph-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage ph-field) grid-ptr)
         (GravityFieldStorage.set-db-ptr! (Field.storage grav-field) db-ptr)
         (GravityFieldStorage.set-entity-db-ptr! (Field.storage grav-field) entity-db-ptr)
         (GravityFieldStorage.set-grid-ptr! (Field.storage grav-field) grid-ptr)
         (FieldKernelStorage.set-db-ptr! (Field.storage td-field) db-ptr)
         (FieldKernelStorage.set-entity-db-ptr! (Field.storage td-field) entity-db-ptr)
         (FieldKernelStorage.set-grid-ptr! (Field.storage td-field) grid-ptr))))

  (defn spawn-crater-rubble! [e pos rad]
    (let [world (Engine.world e)
          db (Engine.db e)
          mat-res (PhysicsSystem.sample-static-world-material world &pos)
          mat-id (Double.to-int @(Vector2.y &mat-res))
          final-mat (if (or (= mat-id 2) (or (= mat-id 3) (= mat-id 5))) mat-id 3)
          num-rubble (Int.random-between 3 5)]
      (do
        (for [i 0 num-rubble]
          (let [theta (* (Double.random) (* 2.0 3.14159265))
                phi (* (Double.random) 1.57079)
                speed (Double.random-between 5.0 12.0)
                vx (* speed (* (Double.cos phi) (Double.cos theta)))
                vy (* speed (Double.sin phi))
                vz (* speed (* (Double.cos phi) (Double.sin theta)))
                vel (Vector3.init vx vy vz)
                offset (Vector3.init (* (Double.random-between -0.5 0.5) rad) 
                                      (* (Double.random-between 0.0 0.5) rad) 
                                      (* (Double.random-between -0.5 0.5) rad))
                rubble-pos (Vector3.add &pos &offset)
                scale (Double.random-between 0.4 0.8)]
            (Prefab.spawn-rubble! world db &rubble-pos &vel scale final-mat)))
        (Engine.set-grid-dirty! e true))))


  (defn merge-rubble-to-static! [e pos rot vol material-id]
    (let [world (Engine.world e)]
      (ECS.query world [parent-ent (swt StaticWorldTag) (col Collidable)]
        (match-ref (Collidable.volume col)
          (Volume.Sdf parent-sdf)
            (let [parent-pos (SDF.position parent-sdf)
                  parent-rot (SDF.rotation parent-sdf)
                  local-pos (Quaternion.rotate &(Quaternion.inverse parent-rot) &(Vector3.sub &pos parent-pos))
                  local-rot (Quaternion.mul &(Quaternion.inverse parent-rot) &rot)
                  parent-handle (ECS.Entity.handle &parent-ent)
                  child-sdf (match-ref vol
                              (Volume.Sdf shape) @shape
                              _ (SDF.init-sphere 0.45 (Vector3.init 0.0 0.0 0.0) (Quaternion.identity)))
                  _ (do
                      (SDF.set-position! &child-sdf local-pos)
                      (SDF.set-rotation! &child-sdf local-rot))
                  child-ent (GameWorld.create-entity! world)
                  parent-comp (Parent.init @parent-handle)
                  csg-comp (CsgNode.init (Box.init child-sdf) material-id)
                  crater-data (CraterSpawnData.init @&pos 0.6 (Double.from-int material-id))]
              (do
                (ECS.add-component! world &child-ent parent-comp)
                (ECS.add-component! world &child-ent csg-comp)
                (SDF.set-csg-nodes! parent-sdf [])
                (PhysicsSystem.build-csg-tree-rec! world parent-handle parent-sdf)
                (Array.push-back! (Engine.craters e) crater-data)
                (Engine.set-csg-dirty! e true)
                (Engine.set-grid-dirty! e true)
                (Engine.set-voxel-dirty! e true)))
          _ ()))))

  (defn register-internal-handlers! [e]
    (Coordinator.subscribe! (Engine.coordinator e)
      &(fn [ev]
        (match-ref ev
          (EventKind.Game game-ev)
            (match-ref game-ev
              (GameEvent.SpawnBullet data)
                (let [pos (BulletSpawnData.pos data)
                      vel (BulletSpawnData.vel data)
                      ang-vel (BulletSpawnData.ang-vel data)
                      scale @(BulletSpawnData.scale data)
                      bouncy @(BulletSpawnData.bouncy data)
                      liquid-type @(BulletSpawnData.liquid-type data)]
                  (do
                    (Prefab.spawn-bullet! (Engine.world e) (Engine.db e) pos vel ang-vel scale bouncy liquid-type)
                    (Engine.set-grid-dirty! e true)
                    (Result.Success ())))
              (GameEvent.SpawnCrater data)
                (let [pos (CraterSpawnData.pos data)
                      rad @(CraterSpawnData.radius data)
                      op @(CraterSpawnData.op-type data)]
                  (do
                    (if (>= op 0.0)
                      (if (= op 0.0)
                        (let [new-h (Engine.spawn-crater! e @pos rad 1 (Maybe.Nothing))
                              crater-data (CraterSpawnData.init @pos rad 0.0)]
                          (do
                            (Array.push-back! (Engine.craters e) crater-data)
                            (Engine.spawn-crater-rubble! e @pos rad)
                            (Engine.set-voxel-dirty! e true)))
                        (let [build (GrowingBuild.init @pos 0.05 rad (/ rad 0.4) op (Maybe.Nothing))]
                           (Array.push-back! (Engine.growing-builds e) build)))
                      (let [new-h (Engine.spawn-crater! e @pos rad 1 (Maybe.Nothing))
                            crater-data (CraterSpawnData.init @pos rad 0.0)]
                        (do
                          (Array.push-back! (Engine.craters e) crater-data)
                          (Engine.spawn-crater-rubble! e @pos rad)
                          (Engine.set-voxel-dirty! e true))))
                    (Result.Success ())))
              _ (Result.Success ()))
          _ (Result.Success ())))))

  (defn destroy-sdf-entity! [world db edb ent]
    (do
      (FieldDatabase.release-field-instance! db edb (ECS.Entity.handle ent))
      (GameWorld.destroy-entity! world ent)))

  (defn tick-events! [e]
    (let [_ (Coordinator.tick! (Engine.coordinator e))]
      ()))


  (defn tick-simulation! [e dt]
    (let [world (Engine.world e)
          grid (Engine.grid e)
          cfg (Engine.settings e)
          f-dt @(Settings.fixed-dt cfg)]
      (do
        (Engine.set-accumulator! e (+ @(Engine.accumulator e) (min dt 0.033)))
        (while (>= @(Engine.accumulator e) f-dt)
          (do
            (PhysicsSystem.apply-atmospheric-forces! e world (Engine.db e) (Engine.entity-db e) grid (Engine.velocity-field e) (Engine.gravity-field e))
            (let [stepped (PhysicsSystem.step-ecs! e world grid)] ())
            (Engine.set-accumulator! e (- @(Engine.accumulator e) f-dt)))))))

  (defn tick-lifecycle! [e dt]
    (let [cam (Engine.camera e)
          world (Engine.world e)]
      (do
        ;; Update growing builds
        (let [gb-arr (Engine.growing-builds e)
              len (Array.length gb-arr)
              keep-gb []]
          (do
            (for [i 0 len]
              (let [gb @(Array.unsafe-nth gb-arr i)
                    pos (GrowingBuild.pos &gb)
                    curr @(GrowingBuild.current-radius &gb)
                    target @(GrowingBuild.target-radius &gb)
                    speed @(GrowingBuild.speed &gb)
                    mat-id @(GrowingBuild.material-id &gb)
                    new-r (+ curr (* speed dt))]
                (if (< new-r target)
                    (let [updated-gb (GrowingBuild.init @pos new-r target speed mat-id (Maybe.Nothing))
                          crater-data (CraterSpawnData.init @pos new-r mat-id)]
                      (do
                        (Array.push-back! &keep-gb updated-gb)
                        (Array.push-back! (Engine.craters e) crater-data)
                        (Engine.set-voxel-dirty! e true)))
                    (let [new-h (Engine.spawn-crater! e @pos target (Double.to-int mat-id) (Maybe.Nothing))
                          crater-data (CraterSpawnData.init @pos target mat-id)]
                      (do
                        (Array.push-back! (Engine.craters e) crater-data)
                        (Engine.set-voxel-dirty! e true))))))
            (Engine.set-growing-builds! e keep-gb)))

        ;; Update Camera using live RotationState to decouple from physics roll & run bounds check
        (PlayerSystem.update-camera-and-bounds! world cam dt)

        ;; Update Lifetimes & Cleanup expired entities
        (let [expired-ents []]
          (do
            (ECS.query world [ent (lt Lifetime)]
              (let [new-time (- @(Lifetime.time lt) dt)]
                (do
                  (Lifetime.set-time! lt new-time)
                  (when (<= new-time 0.0)
                    (Array.push-back! &expired-ents ent)))))
            (for [i 0 (Array.length &expired-ents)]
              (do
                (destroy-sdf-entity! world (Engine.db e) (Engine.entity-db e) (Array.unsafe-nth &expired-ents i))
                (Engine.set-grid-dirty! e true)
                (Engine.set-csg-dirty! e true)))))

        ;; Merge sleeping rubble into static terrain
        (let [sleeping-rubbles (the (Array RubbleMergeData) [])]
          (do
            (ECS.query world [ent (rb RigidBody) (fi FieldInstance) (col Collidable)]
              (when (and (not (ECS.has-component? world &ent PlayerTag))
                         (not (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)))
                (let [vel (Body.velocity (RigidBody.body rb))
                      speed (Vector3.mag vel)
                      pos @(RigidBody.position rb)
                      rot @(RigidBody.rotation rb)
                      vol (Collidable.volume col)
                      mat-id @(FieldInstance.csg-index fi)
                      handle @(ECS.Entity.handle &ent)]
                  (when (and (or (= mat-id 2) (or (= mat-id 3) (= mat-id 5)))
                             (< speed 0.25))
                    (Array.push-back! &sleeping-rubbles (RubbleMergeData.init handle pos rot @vol mat-id))))))
            (for [i 0 (Array.length &sleeping-rubbles)]
              (let [data (Array.unsafe-nth &sleeping-rubbles i)
                    handle @(RubbleMergeData.handle data)
                    ent (ECS.Entity.init handle)
                    pos (RubbleMergeData.pos data)
                    rot (RubbleMergeData.rot data)
                    vol (RubbleMergeData.vol data)
                    mat-id @(RubbleMergeData.material-id data)]
                (do
                  (println* "Merging rubble of material " mat-id " back into static terrain at " (Vector3.str pos))
                  (Engine.merge-rubble-to-static! e @pos @rot vol mat-id)
                  (destroy-sdf-entity! world (Engine.db e) (Engine.entity-db e) &ent))))))

        ;; Cleanup old bullets and craters to keep entity IDs recycled and low (<128)
        (let [p-pos (Vector3.init 0.0 0.0 0.0)
              p-found false]
          (do
            (ECS.query world [p-ent (p-rb RigidBody) (p-tag PlayerTag)]
              (do
                (set! p-pos @(RigidBody.position p-rb))
                (set! p-found true)))
            (when p-found
              (let [to-destroy []]
                (do
                  (ECS.query world [ent (rb RigidBody)]
                    (when (and (not (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false))
                               (not (ECS.has-component? world &ent PlayerTag)))
                        (let [pos (RigidBody.position rb)
                              dist (Vector3.dist pos &p-pos)]
                          (when (or (> dist 350.0) (< @(Vector3.y pos) -280.0))
                            (Array.push-back! &to-destroy ent)))))
                  
                  (for [i 0 (Array.length &to-destroy)]
                    (do
                      (destroy-sdf-entity! world (Engine.db e) (Engine.entity-db e) (Array.unsafe-nth &to-destroy i))
                      (Engine.set-grid-dirty! e true)
                      (Engine.set-csg-dirty! e true)))
                  
                  (let [any-moving false]
                    (do
                      (ECS.query world [ent (rb RigidBody)]
                        (when (and (not (ECS.has-component? world &ent PlayerTag))
                                   (not @(Body.is-sleeping (RigidBody.body rb)))
                                   (not (match-ref (Body.body-type (RigidBody.body rb)) (BodyType.Static) true _ false)))
                          (set! any-moving true)))
                      (when any-moving
                        (Engine.set-grid-dirty! e true))))))))))))

  (sig rotation-between (Fn [(Ref (Vector3 Double)) (Ref (Vector3 Double))] Quaternion))
  (defn rotation-between [v1 v2]
    (let [cos-theta (Vector3.dot v1 v2)
          k (Double.sqrt (* (Vector3.mag-sq v1) (Vector3.mag-sq v2)))]
      (if (< (+ cos-theta k) 0.0001)
        (let [axis (if (> (Double.abs @(Vector3.x v1)) (Double.abs @(Vector3.z v1)))
                       (Vector3.init (- 0.0 @(Vector3.y v1)) @(Vector3.x v1) 0.0)
                       (Vector3.init 0.0 (- 0.0 @(Vector3.z v1)) @(Vector3.y v1)))
              axis-norm (Vector3.normalize &axis)]
          (Quaternion.from-axis-angle axis-norm 3.1415926535))
        (let [axis (Vector3.cross v1 v2)
              w (+ cos-theta k)
              q (Quaternion.new @(Vector3.x &axis) @(Vector3.y &axis) @(Vector3.z &axis) w)]
          (Quaternion.normalize &q)))))

  (sig tick-field-db-sync! (Fn [(Ref Engine.Engine) Double] ()))
  (defn tick-field-db-sync! [e dt]
    (let [world (Engine.world e)
          db (the (Ref FieldDatabase) (Engine.db e))
          edb (the (Ref EntityDatabase) (Engine.entity-db e))]
      (do
        ;; 1. Update bouncy bullets' FieldInstance properties dynamically
        (ECS.query world [ent (fi FieldInstance) (rb RigidBody) (lt Lifetime) (bt BouncyTag)]
          (let [vel (Body.velocity (RigidBody.body rb))
                speed (Double.sqrt (Vector3.mag-sq vel))
                stretch-factor 0.05
                s-val (+ 0.6 (* speed stretch-factor))
                s-clamped (if (< s-val 0.6) 0.6 (if (> s-val 2.5) 2.5 s-val))
                stretch-amt (Double.to-int (* s-clamped 100.0))
                csg-idx (- -99 stretch-amt)
                lt-time @(Lifetime.time lt)
                max-lt 12.0
                light (/ lt-time max-lt)
                base-temp (* 100.0 (/ lt-time max-lt))
                temp (let [t (+ base-temp (* speed 10.0))]
                       (if (< t 0.0) 0.0 (if (> t 150.0) 150.0 t)))
                pos (RigidBody.position rb)
                y-val @(Vector3.y pos)
                
                ;; Sample the local temperature of the environment
                local-temp (FieldDatabase.sample-analytical-field db edb FieldDatabase.temp-slot pos 0.0)
                
                ;; Revert to standard height-based humidity for entities
                humidity (let [h (* 100.0 (/ y-val -300.0))]
                           (if (< h 0.0) 0.0 (if (> h 100.0) 100.0 h)))
                pressure (let [p (+ 1.0 (/ y-val -10.0))]
                           (if (< p 1.0) 1.0 p))]
            (do
              (FieldInstance.set-scale! fi s-clamped)
              (FieldInstance.set-temperature! fi temp)
              (FieldInstance.set-light! fi light)
              (FieldInstance.set-humidity! fi humidity)
              (FieldInstance.set-pressure! fi pressure)
              (FieldInstance.set-csg-index! fi csg-idx))))

        ;; 2. Release invalid or component-less handles from the FieldDatabase
        (let [active-arr (EntityDatabase.active edb)
              len (Array.length active-arr)
              registry-ref (GameWorld.registry world)]
          (for [i 0 len]
            (when @(Array.unsafe-nth active-arr i)
              (let [h (Array.unsafe-nth (EntityDatabase.handles edb) i)
                    h-id (the Int (Long.to-int (Uint64.to-long (Handle.index h))))]
                (when (< h-id 512)
                  (let [ent-val (ECS.Entity.init @h)]
                    (when (or (not (ECS.Registry.valid? registry-ref &ent-val))
                              (not (ECS.has-component? world &ent-val FieldInstance)))
                      (FieldDatabase.release-field-instance! db edb h))))))))

        ;; 3. Register new FieldInstances or sync existing ones
        (ECS.query world [ent (fi FieldInstance)]
          (let [h (the (Ref (Handle ())) (ECS.Entity.handle &ent))
                db-idx (EntityDatabase.get-index-by-handle edb h)]
            (if (= db-idx -1)
              ;; Register
              (let [pos (Vector3.init 0.0 0.0 0.0)
                    vel (Vector3.init 0.0 0.0 0.0)
                    rot (Quaternion.identity)
                    col (Vector3.init 1.0 1.0 1.0)
                    _rb (when (ECS.has-component? world &ent RigidBody)
                          (ECS.with-components world @&ent [ent-rb (rb RigidBody)]
                            (do
                              (set! pos @(RigidBody.position rb))
                              (set! vel @(Body.velocity (RigidBody.body rb)))
                              (set! rot @(RigidBody.rotation rb)))))
                    _c (when (ECS.has-component? world &ent Color)
                         (ECS.with-components world @&ent [ent-col (c Color)]
                           (set! col @(Color.v c))))
                    sdf-maybe (if (ECS.has-component? world &ent Collidable)
                                  (match (ECS.get-component-ptr world &ent)
                                    (Maybe.Just col-ptr)
                                      (let [collidable-ref (ECS.ptr->ref col-ptr world)]
                                        (match-ref (Collidable.volume collidable-ref)
                                          (Volume.Sdf sdf) (Maybe.Just @sdf)
                                          _ (Maybe.Nothing)))
                                    _ (Maybe.Nothing))
                                  (Maybe.Nothing))]
                (let [new-idx (EntityDatabase.register-instance! edb h
                                              @(FieldInstance.shape-type fi)
                                              @(FieldInstance.params fi)
                                              (the (Vector3 Double) pos)
                                              (the Quaternion rot)
                                              @(FieldInstance.scale fi)
                                              @(FieldInstance.csg-index fi)
                                              (the (Vector3 Double) @&col)
                                              (the (Maybe SDF) sdf-maybe))]
                  (do
                    (when (>= new-idx 0)
                      (do
                        (FieldDatabase.sync-instance-capacity! db new-idx (FieldDatabase.kernels db))
                         (Array.aset! (EntityDatabase.influences edb) new-idx @(FieldInstance.influence fi))
                         (Array.aset! (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0) new-idx (the (Vector3 Double) vel))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.temp-slot new-idx @(FieldInstance.temperature fi))
                          (let [l @(FieldInstance.light fi)
                                l-vec (Vector4.init (* @(Vector3.x &col) l) (* @(Vector3.y &col) l) (* @(Vector3.z &col) l) l)]
                            (FieldDatabase.set-field-vector! edb FieldDatabase.light-slot new-idx &l-vec))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.humidity-slot new-idx @(FieldInstance.humidity fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.pressure-slot new-idx @(FieldInstance.pressure fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.stress-slot new-idx @(FieldInstance.stress fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.ph-slot new-idx @(FieldInstance.ph fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.density-slot new-idx @(FieldInstance.density fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.lifetime-slot new-idx @(FieldInstance.lifetime fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.charge-slot new-idx @(FieldInstance.charge fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.potential-slot new-idx @(FieldInstance.potential fi))
                          (let [m-val @(FieldInstance.magnetic fi)
                                m-vec (Vector4.init @(Vector3.x &m-val) @(Vector3.y &m-val) @(Vector3.z &m-val) 0.0)]
                            (FieldDatabase.set-field-vector! edb FieldDatabase.magnetic-slot new-idx &m-vec))
                          (EntityDatabase.set-gravity! edb h @(FieldInstance.gravity fi))
                          (FieldDatabase.set-scalar-field! edb FieldDatabase.time-dilation-slot new-idx @(FieldInstance.time-dilation fi))
                          ())))))
              ;; Update
              (let [idx db-idx]
                (do
                  (when (ECS.has-component? world &ent RigidBody)
                    (ECS.with-components world @&ent [ent-rb (rb RigidBody)]
                      (do
                        (EntityDatabase.set-position! edb h @(RigidBody.position rb))
                        (EntityDatabase.set-velocity! edb h @(Body.velocity (RigidBody.body rb)))
                        (if (ECS.has-component? world &ent BouncyTag)
                          (let [vel (Body.velocity (RigidBody.body rb))
                                speed (Double.sqrt (Vector3.mag-sq vel))]
                            (if (> speed 0.1)
                              (let [dir (Vector3.mul vel (/ 1.0 speed))
                                    up-axis (Vector3.init 0.0 1.0 0.0)
                                    rot-val (Engine.rotation-between &up-axis &dir)]
                                 (EntityDatabase.set-rotation! edb h rot-val))
                              (EntityDatabase.set-rotation! edb h (Quaternion.identity))))
                          (EntityDatabase.set-rotation! edb h @(RigidBody.rotation rb)))
                        (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) idx)
                          (Maybe.Just sdf)
                            (do
                              (SDF.set-position! sdf @(RigidBody.position rb))
                              (SDF.set-rotation! sdf @(RigidBody.rotation rb)))
                          _ ())))))
                  (EntityDatabase.set-scale! edb h @(FieldInstance.scale fi))
                  (match-ref (Array.unsafe-nth (EntityDatabase.sdfs edb) idx)
                    (Maybe.Just sdf) (SDF.set-scale! sdf @(FieldInstance.scale fi))
                    _ ())
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.temp-slot idx @(FieldInstance.temperature fi))
                  (let [c-val (Array.unsafe-nth (EntityDatabase.colors edb) idx)
                        l @(FieldInstance.light fi)
                        l-vec (Vector4.init (* @(Vector3.x c-val) l) (* @(Vector3.y c-val) l) (* @(Vector3.z c-val) l) l)]
                    (FieldDatabase.set-field-vector! edb FieldDatabase.light-slot idx &l-vec))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.humidity-slot idx @(FieldInstance.humidity fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.pressure-slot idx @(FieldInstance.pressure fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.stress-slot idx @(FieldInstance.stress fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.ph-slot idx @(FieldInstance.ph fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.density-slot idx @(FieldInstance.density fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.lifetime-slot idx @(FieldInstance.lifetime fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.charge-slot idx @(FieldInstance.charge fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.potential-slot idx @(FieldInstance.potential fi))
                  (let [m-val @(FieldInstance.magnetic fi)
                        m-vec (Vector4.init @(Vector3.x &m-val) @(Vector3.y &m-val) @(Vector3.z &m-val) 0.0)]
                    (FieldDatabase.set-field-vector! edb FieldDatabase.magnetic-slot idx &m-vec))
                  (EntityDatabase.set-gravity! edb h @(FieldInstance.gravity fi))
                  (FieldDatabase.set-scalar-field! edb FieldDatabase.time-dilation-slot idx @(FieldInstance.time-dilation fi))
                  (Array.aset! (EntityDatabase.influences edb) idx @(FieldInstance.influence fi))
                  (EntityDatabase.set-root-csg-index! edb h @(FieldInstance.csg-index fi)))))))))

  (defn submit-render-commands! [e]
    (let [world (Engine.world e)
          r-db (Engine.render-db e)]
      (do
        (let [line-cmds (RenderDatabase.line-commands r-db)]
          (while (not (Array.empty? line-cmds))
            (let [popped (Array.pop-back! line-cmds)] ())))
        (when @(Engine.show-debug-lines e)
          (ECS.query world [ent (rb RigidBody) (col Collidable) (color Color)]
            (let [pos (RigidBody.position rb)
                  rot (RigidBody.rotation rb)
                  vol (Collidable.volume col)
                  col-vec (Color.v color)]
              (DebugDraw.volume! r-db pos rot vol col-vec)))))))

  (defn pack-uniform-header! [u-data cam-pos cam-dir cam-right cam-up bg-color
                              cell-size cols rows layers origin
                              view-mode shadow-quality volumetric-sdf show-debug
                              suns lacunarity gain]
    (do
      (Array.aset! u-data 3 (Double.to-float cell-size))
      (Array.aset! u-data 4 (Double.to-float @(Vector3.x cam-pos)))
      (Array.aset! u-data 5 (Double.to-float @(Vector3.y cam-pos)))
      (Array.aset! u-data 6 (Double.to-float @(Vector3.z cam-pos)))
      (Array.aset! u-data 7 1.0f)
      (Array.aset! u-data 8 (Double.to-float @(Vector3.x cam-dir)))
      (Array.aset! u-data 9 (Double.to-float @(Vector3.y cam-dir)))
      (Array.aset! u-data 10 (Double.to-float @(Vector3.z cam-dir)))
      (Array.aset! u-data 11 0.0f)
      (Array.aset! u-data 12 (Double.to-float @(Vector3.x cam-right)))
      (Array.aset! u-data 13 (Double.to-float @(Vector3.y cam-right)))
      (Array.aset! u-data 14 (Double.to-float @(Vector3.z cam-right)))
      (Array.aset! u-data 15 0.0f)
      (Array.aset! u-data 16 (Double.to-float @(Vector3.x cam-up)))
      (Array.aset! u-data 17 (Double.to-float @(Vector3.y cam-up)))
      (Array.aset! u-data 18 (Double.to-float @(Vector3.z cam-up)))
      (Array.aset! u-data 19 0.0f)
      (Array.aset! u-data 20 (Double.to-float @(Vector3.x bg-color)))
      (Array.aset! u-data 21 (Double.to-float @(Vector3.y bg-color)))
      (Array.aset! u-data 22 (Double.to-float @(Vector3.z bg-color)))
      (Array.aset! u-data 23 (if show-debug 1.0f 0.0f))
      (Array.aset! u-data 24 (Double.to-float (Double.from-int cols)))
      (Array.aset! u-data 25 (Double.to-float (Double.from-int rows)))
      (Array.aset! u-data 26 (Double.to-float (Double.from-int layers)))
      (Array.aset! u-data 27 (Double.to-float WGPURenderer.rain-threshold))
      (Array.aset! u-data 28 (Double.to-float @(Vector3.x origin)))
      (Array.aset! u-data 29 (Double.to-float @(Vector3.y origin)))
      (Array.aset! u-data 30 (Double.to-float @(Vector3.z origin)))
      (Array.aset! u-data 31 (Double.to-float (Double.from-int view-mode)))
      (Array.aset! u-data 32 (Double.to-float (Double.from-int shadow-quality)))
      (Array.aset! u-data 33 (Double.to-float (Double.from-int shadow-quality)))
      (Array.aset! u-data 34 (if volumetric-sdf 1.0f 0.0f))
      (Array.aset! u-data 35 (Double.to-float WGPURenderer.water-condensation-speed))
      (Array.aset! u-data 36 (Double.to-float WGPURenderer.plains-scale))
      (Array.aset! u-data 37 (Double.to-float WGPURenderer.plains-offset))
      (Array.aset! u-data 38 (Double.to-float WGPURenderer.canyons-scale))
      (Array.aset! u-data 39 (Double.to-float WGPURenderer.canyons-offset))
      (Array.aset! u-data 40 (Double.to-float WGPURenderer.mountains-scale))
      (Array.aset! u-data 41 (Double.to-float WGPURenderer.mountains-offset))
      (Array.aset! u-data 42 (Double.to-float WGPURenderer.seed-offset))
      (Array.aset! u-data 43 (Double.to-float WGPURenderer.global-frequency))
      (Array.aset! u-data 44 (Double.to-float lacunarity))
      (Array.aset! u-data 45 (Double.to-float gain))
      (Array.aset! u-data 46 (Double.to-float WGPURenderer.water-absorption-threshold))
      (Array.aset! u-data 47 (Double.to-float WGPURenderer.water-vapor-expansion))
      ;; cloud_params1 at 48-51
      (Array.aset! u-data 48 (Double.to-float WGPURenderer.cloud-density))
      (Array.aset! u-data 49 (Double.to-float WGPURenderer.cloud-speed))
      (Array.aset! u-data 50 (Double.to-float WGPURenderer.cloud-min-y))
      (Array.aset! u-data 51 (Double.to-float WGPURenderer.cloud-max-y))
      ;; cloud_params2 at 52-55
      (Array.aset! u-data 52 (Double.to-float WGPURenderer.cloud-color-r))
      (Array.aset! u-data 53 (Double.to-float WGPURenderer.cloud-color-g))
      (Array.aset! u-data 54 (Double.to-float WGPURenderer.cloud-color-b))
      (Array.aset! u-data 55 (Double.to-float WGPURenderer.cloud-noise-scale))
      ;; misc_params at 56-59
      (let [num-suns (Array.length suns)]
         (do
           (Array.aset! u-data 56 (Double.to-float (Double.from-int num-suns)))
           (Array.aset! u-data 57 (Double.to-float WGPURenderer.water-flow-speed))
           (Array.aset! u-data 58 (Double.to-float WGPURenderer.water-erosion-rate))
           (Array.aset! u-data 59 (Double.to-float WGPURenderer.water-evaporation-rate))))
      ;; suns array starting at float index 60 (stride = 12 floats)
      (let [num-to-pack (let [n (Array.length suns)] (if (> n 8) 8 n))]
        (do
          (for [i 0 num-to-pack]
            (let [sun (Array.unsafe-nth suns i)
                  s-dir (Sun.dir sun)
                  s-col (Sun.color sun)
                  s-int @(Sun.intensity sun)
                  s-size @(Sun.size sun)
                  s-gas @(Sun.gassiness sun)
                  base-idx (+ 60 (* i 12))]
              (do
                (Array.aset! u-data base-idx (Double.to-float @(Vector3.x s-dir)))
                (Array.aset! u-data (+ base-idx 1) (Double.to-float @(Vector3.y s-dir)))
                (Array.aset! u-data (+ base-idx 2) (Double.to-float @(Vector3.z s-dir)))
                (Array.aset! u-data (+ base-idx 3) (Double.to-float s-int))
                (Array.aset! u-data (+ base-idx 4) (Double.to-float @(Vector3.x s-col)))
                (Array.aset! u-data (+ base-idx 5) (Double.to-float @(Vector3.y s-col)))
                (Array.aset! u-data (+ base-idx 6) (Double.to-float @(Vector3.z s-col)))
                (Array.aset! u-data (+ base-idx 7) (Double.to-float s-size))
                (Array.aset! u-data (+ base-idx 8) (Double.to-float s-gas))
                (Array.aset! u-data (+ base-idx 9) 0.0f)
                (Array.aset! u-data (+ base-idx 10) 0.0f)
                (Array.aset! u-data (+ base-idx 11) 0.0f))))
          (for [i num-to-pack 8]
            (let [base-idx (+ 60 (* i 12))]
              (do
                (Array.aset! u-data base-idx 0.0f)
                (Array.aset! u-data (+ base-idx 1) 0.0f)
                (Array.aset! u-data (+ base-idx 2) 0.0f)
                (Array.aset! u-data (+ base-idx 3) 0.0f)
                (Array.aset! u-data (+ base-idx 4) 0.0f)
                (Array.aset! u-data (+ base-idx 5) 0.0f)
                (Array.aset! u-data (+ base-idx 6) 0.0f)
                (Array.aset! u-data (+ base-idx 7) 0.0f)
                (Array.aset! u-data (+ base-idx 8) 0.0f)
                (Array.aset! u-data (+ base-idx 9) 0.0f)
                (Array.aset! u-data (+ base-idx 10) 0.0f)
                (Array.aset! u-data (+ base-idx 11) 0.0f))))))))

  (defn pack-instances! [world db edb u-data instances-data csg-data csg-dirty]
    (let [next-csg-node-idx 0
          max-active-id 0]
      (do
        (when csg-dirty
          (ECS.query world [ent (rb RigidBody) (col Collidable)]
            (let [has-parent false]
              (do
                (ECS.with-components world @&ent [e (p Parent)]
                  (set! has-parent true))
                (when (and (not has-parent)
                           (not (ECS.has-component? world &ent PlayerTag)))
                  (match-ref (Collidable.volume col)
                    (Volume.Sdf sdf)
                      (when (> (Array.length (SDF.csg-nodes sdf)) 0)
                        (let [root-csg-idx (WGPURenderer.serialize-sdf! sdf csg-data (Pointer.address &next-csg-node-idx) true)]
                          (EntityDatabase.set-root-csg-index! edb (ECS.Entity.handle &ent) root-csg-idx)))
                    _ ()))))))
        (let [active-arr (EntityDatabase.active edb)
              len (Array.length active-arr)]
          (do
            (for [id 0 (if (< len WGPURenderer.max-spheres) len WGPURenderer.max-spheres)]
              (if @(Array.unsafe-nth active-arr id)
                (let [pos (Array.unsafe-nth (EntityDatabase.positions edb) id)
                      rot (Array.unsafe-nth (EntityDatabase.rotations edb) id)
                      rad-scale @(Array.unsafe-nth (EntityDatabase.scales edb) id)
                      c-val (Array.unsafe-nth (EntityDatabase.colors edb) id)
                      light-val (FieldDatabase.get-field-vector edb FieldDatabase.light-slot id)
                      final-csg-idx @(Array.unsafe-nth (EntityDatabase.root-csg-indices edb) id)
                      shape-type @(Array.unsafe-nth (EntityDatabase.shape-types edb) id)
                      instance-type (if (= final-csg-idx -10) 1.0
                                      (if (= final-csg-idx -5) 2.0
                                        (if (= final-csg-idx -6) 4.0
                                          (if (= final-csg-idx -7) 5.0
                                            (if (= final-csg-idx -8) 6.0
                                              (if (= final-csg-idx -2) 99.0
                                                (if (<= final-csg-idx -99) 3.0 0.0)))))))
                      _ (when (or (or (or (= instance-type 2.0) (= instance-type 4.0)) (= instance-type 5.0)) (= instance-type 6.0))
                          (IO.println &(str* "Active Liquid Bullet Packed: id=" (Int.str id) " type=" (Double.str instance-type) " pos=" (Vector3.str pos) " scale=" (Double.str rad-scale))))
                      base (* id 32)]
                  (do
                    (set! max-active-id (+ id 1))
                    (Array.aset! instances-data base (Double.to-float @(Vector3.x pos)))
                    (Array.aset! instances-data (+ base 1) (Double.to-float @(Vector3.y pos)))
                    (Array.aset! instances-data (+ base 2) (Double.to-float @(Vector3.z pos)))
                    (Array.aset! instances-data (+ base 3) (Double.to-float rad-scale))
                    (Array.aset! instances-data (+ base 4) (Double.to-float @(Quaternion.x rot)))
                    (Array.aset! instances-data (+ base 5) (Double.to-float @(Quaternion.y rot)))
                    (Array.aset! instances-data (+ base 6) (Double.to-float @(Quaternion.z rot)))
                    (Array.aset! instances-data (+ base 7) (Double.to-float @(Quaternion.w rot)))
                    (Array.aset! instances-data (+ base 8) (Double.to-float @(Vector3.x c-val)))
                    (Array.aset! instances-data (+ base 9) (Double.to-float @(Vector3.y c-val)))
                    (Array.aset! instances-data (+ base 10) (Double.to-float @(Vector3.z c-val)))
                    (Array.aset! instances-data (+ base 11) 0.0f)
                    (Array.aset! instances-data (+ base 12) (Double.to-float @(Vector4.x &light-val)))
                    (Array.aset! instances-data (+ base 13) (Double.to-float @(Vector4.y &light-val)))
                    (Array.aset! instances-data (+ base 14) (Double.to-float @(Vector4.z &light-val)))
                    (Array.aset! instances-data (+ base 15) (Double.to-float @(Vector4.w &light-val)))
                    (let [temp (FieldDatabase.get-entity-scalar edb FieldDatabase.temp-slot id)
                          ph (FieldDatabase.get-entity-scalar edb FieldDatabase.ph-slot id)
                          pressure (FieldDatabase.get-entity-scalar edb FieldDatabase.pressure-slot id)
                          mat-id (Double.from-int shape-type)
                          charge (FieldDatabase.get-entity-scalar edb FieldDatabase.charge-slot id)
                          mag (FieldDatabase.get-field-vector edb FieldDatabase.magnetic-slot id)]
                      (do
                        (Array.aset! instances-data (+ base 16) (Double.to-float temp))
                        (Array.aset! instances-data (+ base 17) (Double.to-float ph))
                        (Array.aset! instances-data (+ base 18) (Double.to-float pressure))
                        (Array.aset! instances-data (+ base 19) (Double.to-float mat-id))
                        (Array.aset! instances-data (+ base 20) (Double.to-float @(Vector4.x &mag)))
                        (Array.aset! instances-data (+ base 21) (Double.to-float @(Vector4.y &mag)))
                        (Array.aset! instances-data (+ base 22) (Double.to-float @(Vector4.z &mag)))
                        (Array.aset! instances-data (+ base 23) (Double.to-float charge))))
                    (Array.aset! instances-data (+ base 24) (Double.to-float (Double.from-int shape-type)))
                    (Array.aset! instances-data (+ base 25) (Double.to-float instance-type))
                    (Array.aset! instances-data (+ base 26) (Double.to-float (Double.from-int final-csg-idx)))
                    (let [vel-arr (Array.unsafe-nth (EntityDatabase.vector-fields edb) 0)
                          vel-ref (Array.unsafe-nth vel-arr id)
                          speed (Vector3.mag vel-ref)
                          grav (Array.unsafe-nth (EntityDatabase.gravities edb) id)
                          td (FieldDatabase.get-entity-scalar edb FieldDatabase.time-dilation-slot id)]
                      (do
                        (Array.aset! instances-data (+ base 27) (Double.to-float speed))
                        (Array.aset! instances-data (+ base 28) (Double.to-float @(Vector3.x grav)))
                        (Array.aset! instances-data (+ base 29) (Double.to-float @(Vector3.y grav)))
                        (Array.aset! instances-data (+ base 30) (Double.to-float @(Vector3.z grav)))
                        (Array.aset! instances-data (+ base 31) (Double.to-float td))))))
              (let [base (* id 32)]
                (do
                  (Array.aset! instances-data base 0.0f)
                  (Array.aset! instances-data (+ base 1) 0.0f)
                  (Array.aset! instances-data (+ base 2) 0.0f)
                  (Array.aset! instances-data (+ base 3) 0.0f)
                  (Array.aset! instances-data (+ base 25) 0.0f)
                  ()))))
            (Array.aset! u-data 69 (Double.to-float (Double.from-int max-active-id))))))))

  (defn update-voxel-chunks! [e ctx ren world-data cam-pos]
    (when @(Engine.chunk-loading-enabled e)
      (let [cam-qx (World.camera-chunk-qx cam-pos)
            cam-qy (World.camera-chunk-qy cam-pos)
            cam-qz (World.camera-chunk-qz cam-pos)
            world (Engine.world e)
            chunks (World.chunks world-data)
            num-chunks (Array.length chunks)
            static-world-sdf (Maybe.Nothing)]
        (do
          (ECS.query world [parent-ent (swt StaticWorldTag) (col Collidable)]
            (match-ref (Collidable.volume col)
              (Volume.Sdf parent-sdf) (set! static-world-sdf (Maybe.Just @parent-sdf))
              _ ()))

          (when (or (not (= cam-qx @(World.last-cam-x world-data)))
                    (or (not (= cam-qy @(World.last-cam-y world-data)))
                        (not (= cam-qz @(World.last-cam-z world-data)))))
            (do
              (World.set-last-cam-x! world-data cam-qx)
              (World.set-last-cam-y! world-data cam-qy)
              (World.set-last-cam-z! world-data cam-qz)
              (Engine.set-need-chunk-scan! e true)
              
              (let [keep (the (Array Chunk) [])]
                (do
                  (for [idx 0 num-chunks]
                    (let [chunk (Array.unsafe-nth chunks idx)
                          cqx @(Chunk.coord-x chunk)
                          cqy @(Chunk.coord-y chunk)
                          cqz @(Chunk.coord-z chunk)
                          dist-x (Int.abs (- cqx cam-qx))
                          dist-y (Int.abs (- cqy cam-qy))
                          dist-z (Int.abs (- cqz cam-qz))]
                      (if (and (<= dist-x 2) (and (<= dist-y 2) (<= dist-z 2)))
                          (Array.push-back! &keep @chunk)
                          (do
                            (when @(Chunk.modified chunk)
                              (World.save-modified-chunk! world-data chunk))
                            (let [buf @(Chunk.gpu-buffer chunk)]
                              (when (not (WGPU.buffer-null?- buf))
                                (WGPU.free-buffer buf)))
                            (let [bg @(Chunk.jit-bind-group chunk)]
                              (when (not (WGPU.bindgroup-null?- bg))
                                (WGPU.free-bind-group bg)))
                            (let [pbg @(Chunk.pack-bind-group chunk)]
                              (when (not (WGPU.bindgroup-null?- pbg))
                                (WGPU.free-bind-group pbg)))))))
                  (World.set-chunks! world-data keep)
                  (World.clear-cache! world-data)))))

          (let [chunks (World.chunks world-data)
                num-chunks (Array.length chunks)]
            (do
              ;; Load missing chunks dynamically around player
              (let [loaded-any false
                    baking-idx -1
                    min-dist 999999]
            (do
              (for [i 0 num-chunks]
                (let [c (Array.unsafe-nth chunks i)
                      res @(World.voxel-resolution world-data)]
                  (when (< @(Chunk.bake-progress c) res)
                    (let [qx @(Chunk.coord-x c)
                          qy @(Chunk.coord-y c)
                          qz @(Chunk.coord-z c)
                          dx (Int.abs (- qx cam-qx))
                          dy (Int.abs (- qy cam-qy))
                          dz (Int.abs (- qz cam-qz))
                          dist (+ dx (+ dy dz))]
                      (when (< dist min-dist)
                        (do
                          (set! min-dist dist)
                          (set! baking-idx i)))))))
              (if (/= baking-idx -1)
                  ;; Progress baking the active chunk
                  (let [chunk-ref (Array.unsafe-nth chunks baking-idx)
                        current-prog @(Chunk.bake-progress chunk-ref)
                        res @(World.voxel-resolution world-data)
                        step (let [s (/ res 8)] (if (< s 1) 1 s))
                        next-prog (let [sum (+ current-prog step)] (if (< res sum) res sum))
                        qx @(Chunk.coord-x chunk-ref)
                        qy @(Chunk.coord-y chunk-ref)
                        qz @(Chunk.coord-z chunk-ref)]
                    (do
                      (Diagnostics.start-zone! (Engine.diagnostics e) "Chunks: Slice Baking")
                      (VoxelBaker.bake-chunk-slices! ctx ren chunk-ref world-data current-prog next-prog &static-world-sdf)
                      (Chunk.set-bake-progress! chunk-ref next-prog)
                      (when (= next-prog res)
                        (do
                          (VoxelBaker.compute-chunk-lighting! chunk-ref res)
                          (let [b @(Chunk.gpu-buffer chunk-ref)]
                            (if (WGPU.buffer-null?- b)
                                (match (WGPU.create-buffer ctx (* res (* res (* res 16))))
                                  (Result.Error err) (IO.println &(format "Error creating buffer for baked chunk: %s" &err))
                                  (Result.Success new-b)
                                    (do
                                      (WGPU.write-floats ctx new-b (Chunk.voxel-data chunk-ref))
                                      (Chunk.set-gpu-buffer! chunk-ref new-b)
                                      (VoxelBaker.pack-and-copy-chunk! ctx ren chunk-ref new-b @(Chunk.atlas-slot chunk-ref) res)))
                                (do
                                  (WGPU.write-floats ctx b (Chunk.voxel-data chunk-ref))
                                  (VoxelBaker.pack-and-copy-chunk! ctx ren chunk-ref b @(Chunk.atlas-slot chunk-ref) res))))
                          (Engine.set-need-chunk-scan! e true)))
                      (set! loaded-any true)
                      (Diagnostics.end-zone! (Engine.diagnostics e) "Chunks: Slice Baking")))
                  
                  ;; If no chunk is baking, check if we need to load a new missing chunk
                  (when @(Engine.need-chunk-scan e)
                    (let [lookup-grid (the (Array Bool) (replicate 125 &false))]
                      (do
                        (for [i 0 num-chunks]
                          (let [c (Array.unsafe-nth chunks i)
                                dx (+ @(Chunk.coord-x c) (- 2 cam-qx))
                                dy (+ @(Chunk.coord-y c) (- 2 cam-qy))
                                dz (+ @(Chunk.coord-z c) (- 2 cam-qz))]
                            (when (and (and (>= dx 0) (< dx 5))
                                       (and (and (>= dy 0) (< dy 5))
                                            (and (>= dz 0) (< dz 5))))
                              (Array.aset! &lookup-grid (+ dx (+ (* dy 5) (* dz 25))) true))))
                        (let [loaded-any false]
                          (do
                            (Diagnostics.start-zone! (Engine.diagnostics e) "Chunks: Scan and Load")
                            (for [r 0 3]
                              (when (not loaded-any)
                                (for [dz (- 0 r) (inc r)]
                                  (for [dy (- 0 r) (inc r)]
                                    (for [dx (- 0 r) (inc r)]
                                      (when (and (not loaded-any)
                                                 (or (= (Int.abs dx) r)
                                                     (or (= (Int.abs dy) r)
                                                         (= (Int.abs dz) r))))
                                        (let [qx (+ cam-qx dx)
                                              qy (+ cam-qy dy)
                                              qz (+ cam-qz dz)
                                              chk-dx (+ dx 2)
                                              chk-dy (+ dy 2)
                                              chk-dz (+ dz 2)]
                                          (when (and (and (>= chk-dx 0) (< chk-dx 5))
                                                     (and (and (>= chk-dy 0) (< chk-dy 5))
                                                          (and (>= chk-dz 0) (< chk-dz 5))))
                                            (let [has-c @(Array.unsafe-nth &lookup-grid (+ chk-dx (+ (* chk-dy 5) (* chk-dz 25))))]
                                              (when (not has-c)
                                                (let [slot (World.find-unused-atlas-slot world-data)]
                                                  (do
                                                    (when (< slot 0)
                                                      (let [furthest-idx -1
                                                            max-dist -1]
                                                        (do
                                                          (for [j 0 (Array.length (World.chunks world-data))]
                                                            (let [chunk (Array.unsafe-nth (World.chunks world-data) j)
                                                                  cqx @(Chunk.coord-x chunk)
                                                                  cqy @(Chunk.coord-y chunk)
                                                                  cqz @(Chunk.coord-z chunk)
                                                                  dist-x (Int.abs (- cqx cam-qx))
                                                                  dist-y (Int.abs (- cqy cam-qy))
                                                                  dist-z (Int.abs (- cqz cam-qz))
                                                                  dist (+ dist-x (+ dist-y dist-z))]
                                                              (when (> dist max-dist)
                                                                (do
                                                                  (set! max-dist dist)
                                                                  (set! furthest-idx j)))))
                                                          (when (/= furthest-idx -1)
                                                            (let [evict-chunk (Array.unsafe-nth (World.chunks world-data) furthest-idx)
                                                                  evict-slot @(Chunk.atlas-slot evict-chunk)]
                                                              (do
                                                                (let [buf @(Chunk.gpu-buffer evict-chunk)]
                                                                  (when (not (WGPU.buffer-null?- buf))
                                                                    (WGPU.free-buffer buf)))
                                                                (let [bg @(Chunk.jit-bind-group evict-chunk)]
                                                                  (when (not (WGPU.bindgroup-null?- bg))
                                                                    (WGPU.free-bind-group bg)))
                                                                (let [pbg @(Chunk.pack-bind-group evict-chunk)]
                                                                  (when (not (WGPU.bindgroup-null?- pbg))
                                                                    (WGPU.free-bind-group pbg)))
                                                                (World.set-chunks! world-data (Array.remove-nth furthest-idx @(World.chunks world-data)))
                                                                (set! slot evict-slot)))))))
                                                    (when (>= slot 0)
                                                      (let [saved-list (World.modified-chunks world-data)
                                                            len (Array.length saved-list)
                                                            found-idx -1]
                                                        (do
                                                          (for [i 0 len]
                                                            (let [c (Array.unsafe-nth saved-list i)]
                                                              (when (and (= @(Chunk.coord-x c) qx)
                                                                         (and (= @(Chunk.coord-y c) qy)
                                                                              (= @(Chunk.coord-z c) qz)))
                                                                (set! found-idx i))))
                                                          (if (= found-idx -1)
                                                              (let [res @(World.voxel-resolution world-data)
                                                                    size-floats (* res (* res (* res 4)))
                                                                    voxel-data (the (Array Float) (replicate size-floats &1000.0f))
                                                                    chunk (Chunk.init qx qy qz voxel-data slot false 0 (null-buffer) (null-bind-group) (null-bind-group) (null-buffer))]
                                                                (do
                                                                  (Array.push-back! (World.chunks world-data) chunk)))
                                                              (let [saved-chunk (Array.unsafe-nth saved-list found-idx)
                                                                    voxel-data @(Chunk.voxel-data saved-chunk)
                                                                    res @(World.voxel-resolution world-data)
                                                                    size-floats (* res (* res (* res 4)))]
                                                                (match (WGPU.create-buffer ctx (* size-floats 4))
                                                                  (Result.Error err) (IO.println &(format "Error creating buffer for loaded chunk: %s" &err))
                                                                  (Result.Success b)
                                                                    (let [_ (WGPU.write-floats ctx b &voxel-data)
                                                                          chunk (Chunk.init qx qy qz voxel-data slot true res b (null-bind-group) (null-bind-group) (null-buffer))]
                                                                      (do
                                                                        (VoxelBaker.pack-and-copy-chunk! ctx ren &chunk b slot res)
                                                                        (Array.push-back! (World.chunks world-data) chunk))))))
                                                          (set! loaded-any true))))))))))))))))
                            (when (not loaded-any)
                              (Engine.set-need-chunk-scan! e false))
                            (Diagnostics.end-zone! (Engine.diagnostics e) "Chunks: Scan and Load")))))))))))))))

  (defn bake-voxels-if-dirty! [e ctx ren grid world world-data craters voxel-dirty]
    (when (or @(Engine.voxel-dirty e) voxel-dirty)
      (let [static-world-sdf (Maybe.Nothing)]
        (do
          (ECS.query world [parent-ent (swt StaticWorldTag) (col Collidable)]
            (match-ref (Collidable.volume col)
              (Volume.Sdf parent-sdf) (set! static-world-sdf (Maybe.Just @parent-sdf))
              _ ()))
          (if (Array.empty? craters)
            (match @(Engine.active-ui-panel e)
              (Maybe.Just target-handle)
                (let [target-pos (Vector3.init 0.0 0.0 0.0)
                      target-scale 1.0]
                  (do
                    (ECS.query world [ent (rb RigidBody) (fi FieldInstance)]
                      (when (= (ECS.Entity.id &ent) (handle-id &target-handle))
                        (do
                          (set! target-pos @(RigidBody.position rb))
                          (set! target-scale @(FieldInstance.scale fi)))))
                    (let [chunks (World.chunks world-data)
                          num-chunks (Array.length chunks)]
                      (for [j 0 num-chunks]
                        (let [chunk (Array.unsafe-nth chunks j)]
                          (when (VoxelBaker.chunk-overlaps-sphere? chunk &target-pos (+ target-scale 4.0))
                            (VoxelBaker.bake-chunk! ctx ren chunk world-data &static-world-sdf)))))))
              _ (World.dirty-all-chunks! world-data))
          (let [chunks (World.chunks world-data)
                num-chunks (Array.length chunks)
                num-craters (Array.length craters)
                diag (Engine.diagnostics e)]
            (for [j 0 num-chunks]
              (let [chunk (Array.unsafe-nth chunks j)
                    res @(World.voxel-resolution world-data)
                    cell-size (World.voxel-cell-size world-data)
                    overlapped false]
                  (for [i 0 num-craters]
                    (let [crater (Array.unsafe-nth craters i)
                          pos (CraterSpawnData.pos crater)
                          rad @(CraterSpawnData.radius crater)
                          op @(CraterSpawnData.op-type crater)]
                      (when (VoxelBaker.chunk-overlaps-sphere? chunk pos rad)
                        (do
                          (Diagnostics.with-zone diag "Bake: Carve CPU"
                            (if (= op 0.0)
                                (VoxelBaker.carve-voxel-grid-cpu! chunk pos rad res cell-size)
                                (VoxelBaker.build-voxel-grid-cpu! chunk pos rad res cell-size op)))
                          (Diagnostics.with-zone diag "Bake: Carve GPU"
                            (if (= op 0.0)
                                (VoxelBaker.carve-voxel-grid-gpu! ctx ren chunk pos rad res)
                                (VoxelBaker.build-voxel-grid-gpu! ctx ren chunk pos rad res op)))
                          (Chunk.set-modified! chunk true)
                          (set! overlapped true)))))
                  (when overlapped
                    (do
                      (VoxelBaker.compute-chunk-lighting! chunk res)
                      (let [b @(Chunk.gpu-buffer chunk)]
                        (when (not (WGPU.buffer-null?- b))
                          (do
                            (WGPU.write-floats ctx b (Chunk.voxel-data chunk))
                            (VoxelBaker.pack-and-copy-chunk! ctx ren chunk b @(Chunk.atlas-slot chunk) res))))))))))
        (Engine.set-voxel-dirty! e false)))))

  (def field-bake-frame-counter 0)

  (defn bake-all-fields-gpu! [e ctx ren]
    (let [world-data (Engine.world-data e)
          db (World.field-db world-data)
          edb (World.entity-db world-data)
          chunks (World.chunks world-data)
          num-chunks (Array.length chunks)
          num-instances (Double.from-int (Array.length (EntityDatabase.active edb)))
          active-arr (EntityDatabase.active edb)
          num-active (Array.length active-arr)
          voxel-res @(World.voxel-resolution world-data)
          active-ticks (WGPURenderer.fields-active-ticks ren)
          active-slots (WGPURenderer.fields-active-slots ren)
          cam (Engine.camera e)
          cam-pos (Camera.pos cam)
          cam-qx (World.camera-chunk-qx cam-pos)
          cam-qy (World.camera-chunk-qy cam-pos)
          cam-qz (World.camera-chunk-qz cam-pos)]
      (do
        ; 1. First pass: check overlaps and propagate active ticks to neighbors
        (for [i 0 num-chunks]
          (let [chunk (Array.unsafe-nth chunks i)
                slot @(Chunk.atlas-slot chunk)
                current-ticks @(Array.unsafe-nth active-ticks slot)
                overlaps false]
            (do
              (for [k 0 num-active]
                (when @(Array.unsafe-nth active-arr k)
                  (let [scale @(Array.unsafe-nth (EntityDatabase.scales edb) k)]
                    (when (> scale 0.0)
                      (let [inst-pos (Array.unsafe-nth (EntityDatabase.positions edb) k)]
                        (when (VoxelBaker.chunk-overlaps-sphere? chunk inst-pos scale)
                          (set! overlaps true)))))))
              (if overlaps
                (do
                  (Array.aset! active-ticks slot 90) ; Keep active for 180 frames (3 seconds)
                  (Array.aset! active-slots slot true))
                (when (and (> current-ticks 0) @(Array.unsafe-nth active-slots slot))
                  (let [cx @(Chunk.coord-x chunk)
                        cy @(Chunk.coord-y chunk)
                        cz @(Chunk.coord-z chunk)
                        nx-l (dec cx) nx-r (inc cx)
                        ny-d (dec cy) ny-u (inc cy)
                        nz-b (dec cz) nz-f (inc cz)]
                    (do
                      ; Left
                      (match (World.find-chunk world-data nx-l cy cz)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ())
                      ; Right
                      (match (World.find-chunk world-data nx-r cy cz)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ())
                      ; Down
                      (match (World.find-chunk world-data cx ny-d cz)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ())
                      ; Up
                      (match (World.find-chunk world-data cx ny-u cz)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ())
                      ; Back
                      (match (World.find-chunk world-data cx cy nz-b)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ())
                      ; Front
                      (match (World.find-chunk world-data cx cy nz-f)
                        (Maybe.Just nc) (let [ns @(Chunk.atlas-slot &nc) nt @(Array.unsafe-nth active-ticks ns)]
                                          (when (< nt (- current-ticks 30)) (do (Array.aset! active-ticks ns (- current-ticks 30)) (Array.aset! active-slots ns true)))) _ ()))))))))
        
        ; 2. Second pass: run simulation for all active chunks and decrement ticks
        (for [i 0 num-chunks]
          (let [chunk (Array.unsafe-nth chunks i)
                slot @(Chunk.atlas-slot chunk)
                current-ticks @(Array.unsafe-nth active-ticks slot)
                is-active @(Array.unsafe-nth active-slots slot)
                cx @(Chunk.coord-x chunk)
                cy @(Chunk.coord-y chunk)
                cz @(Chunk.coord-z chunk)
                dx (Int.abs (- cx cam-qx))
                dy (Int.abs (- cy cam-qy))
                dz (Int.abs (- cz cam-qz))
                near-player (and (<= dx 1) (and (<= dy 1) (<= dz 1)))
                is-light-frame (= (Int.mod i 128) field-bake-frame-counter)
                is-interaction-frame (= (Int.mod i 4) (Int.mod field-bake-frame-counter 4))]
            (when near-player
              (do
                (when is-light-frame
                  (VoxelBaker.bake-light-gpu! ctx ren chunk num-instances (Engine.last-known-light-rule e) (Engine.jit-cache e) voxel-res))
                (when is-interaction-frame
                  (VoxelBaker.bake-interaction-gpu! ctx ren chunk num-instances (Engine.last-known-interaction-rule e) (Engine.jit-cache e) voxel-res))
                (VoxelBaker.bake-water-gpu! ctx ren chunk num-instances (Engine.last-known-water-rule e) (Engine.jit-cache e) voxel-res)
                (VoxelBaker.bake-gas-gpu! ctx ren chunk num-instances (Engine.last-known-gas-rule e) (Engine.jit-cache e) voxel-res)
                (VoxelBaker.bake-em-gpu! ctx ren chunk num-instances (Engine.last-known-em-rule e) (Engine.jit-cache e) voxel-res)
                (if (> current-ticks 0)
                  (let [new-ticks (dec current-ticks)]
                    (do
                      (Array.aset! active-ticks slot new-ticks)
                      (Array.aset! active-slots slot (> new-ticks 0))))
                  (Array.aset! active-slots slot false))))))
        (set! field-bake-frame-counter (Int.mod (inc field-bake-frame-counter) 128)))))

  (defn sync-render-db! [e ctx ren]
    (let [r-db (Engine.render-db e)
          u-data (RenderDatabase.u-data r-db)
          instances-data (RenderDatabase.instances-data r-db)
          flat-grid (RenderDatabase.s-data r-db)
          csg-data (RenderDatabase.csg-data r-db)
          lookup-data (RenderDatabase.lookup-data r-db)
          geom-map (RenderDatabase.geom-map r-db)
          world (Engine.world e)
          world-data (Engine.world-data e)
          grid (Engine.grid e)
          db (Engine.db e)
          cam (Engine.camera e)
          cam-pos (Camera.pos cam)
          cam-dir (Camera.front cam)
          cam-right (Camera.right cam)
          cam-up (Camera.up cam)
          cell-size @(SpatialGrid.cell-size grid)
          cols @(SpatialGrid.cols grid)
          rows @(SpatialGrid.rows grid)
          layers @(SpatialGrid.layers grid)
          origin (SpatialGrid.origin grid)
          show-debug @(Engine.show-debug-lines e)
          view-mode @(Engine.view-mode e)
          shadow-quality @(Engine.shadow-quality e)
          bg-color @(Engine.bg-color e)
          csg-dirty @(Engine.csg-dirty e)
          grid-dirty @(Engine.grid-dirty e)
          voxel-dirty @(Engine.voxel-dirty e)
          diag (Engine.diagnostics e)
          craters (Engine.craters e)]
      (do
        (RenderDatabase.set-voxel-dirty! r-db voxel-dirty)
        (RenderDatabase.set-csg-dirty! r-db csg-dirty)
        (RenderDatabase.set-grid-dirty! r-db grid-dirty)

        (when (or grid-dirty csg-dirty)
          (do
            (array-zero-floats! u-data)
            (array-zero-floats! flat-grid)
            (array-zero-floats! instances-data)))

        ;; 1. Pack Uniform Header (indices 0 to 115)
        (Diagnostics.with-zone diag "Sync: Pack Uniforms"
          (let [lac WGPURenderer.lacunarity
                gn WGPURenderer.gain
                suns-ref (Engine.suns e)]
            (Engine.pack-uniform-header! u-data cam-pos cam-dir cam-right cam-up &bg-color
                                         cell-size cols rows layers origin
                                         view-mode shadow-quality @(Engine.volumetric-sdf e) show-debug
                                         suns-ref lac gn)))

        ;; 2. Pack CSG Node Hierarchies & Active Instances (index >= 36)
        (Diagnostics.with-zone diag "Sync: Pack CSG Instances"
          (Engine.pack-instances! world db (Engine.entity-db e) u-data instances-data csg-data csg-dirty))

        ;; 3. Dynamic Chunk Loading / progressive baking
        (Diagnostics.with-zone diag "Sync: Update Voxel Chunks"
          (Engine.update-voxel-chunks! e ctx ren world-data cam-pos))

        ;; 4. Build Chunk Lookup Data
        (Diagnostics.with-zone diag "Sync: Build Chunk Lookup"
          (let [cam-qx (World.camera-chunk-qx cam-pos)
                cam-qy (World.camera-chunk-qy cam-pos)
                cam-qz (World.camera-chunk-qz cam-pos)
                origin-x (- cam-qx 16)
                origin-y (- cam-qy 16)
                origin-z (- cam-qz 16)
                new-lookup-data (World.build-chunk-lookup-data world-data origin-x origin-y origin-z)]
            (copy-ints! lookup-data &new-lookup-data)))

        ;; 5. Bake voxel grid (if dirty)
        (Diagnostics.with-zone diag "Sync: Bake Voxels"
          (do
            (Engine.bake-voxels-if-dirty! e ctx ren grid world world-data craters voxel-dirty)
            (Engine.set-craters! e [])))

        ;; 5.5 Bake dynamic fields on the GPU
        (Diagnostics.with-zone diag "Sync: Bake Fields GPU"
          (Engine.bake-all-fields-gpu! e ctx ren))

        ;; 6. Flatten Spatial Grid (if dirty)
        (Diagnostics.with-zone diag "Sync: Flatten Spatial Grid"
          (when grid-dirty
            (GPUSpatial.flatten-in-place! (Engine.entity-db e) grid 64 flat-grid geom-map))))))

  (defn tick! [e ctx ren width height]
    (let [dt (Clock.unscaled-dt (Engine.clock e))
          diag (Engine.diagnostics e)]
      (Diagnostics.with-zone diag "Total Frame Time"
        (Clock.tick! (Engine.clock e))
        (let [suns-ref (Engine.suns e)]
          (for [i 0 (Array.length suns-ref)]
            (let [sun (Array.unsafe-nth suns-ref i)]
              (when @(Sun.cycle-active sun)
                (let [speed @(Sun.speed sun)
                      new-time (let [t (+ @(Sun.time sun) (* speed dt))]
                                 (if (>= t 24.0) (- t 24.0) t))
                      angle (* (/ new-time 24.0) (* 2.0 3.1415926535))
                      orbit @(Sun.orbit-angle sun)
                      lx (* (Double.cos angle) (Double.cos orbit))
                      ly (Double.sin angle)
                      lz (* (Double.cos angle) (Double.sin orbit))
                      ldir (Vector3.init lx ly lz)]
                  (do
                    (Sun.set-time! sun new-time)
                    (Sun.set-dir! sun ldir)))))))
        (let [suns-ref (Engine.suns e)
              max-alt -1.0]
          (do
            (for [i 0 (Array.length suns-ref)]
              (let [sun (Array.unsafe-nth suns-ref i)
                    alt @(Vector3.y (Sun.dir sun))]
                (when (> alt max-alt)
                  (set! max-alt alt))))
            (if (> max-alt 0.0)
              (let [t (let [val (* max-alt 4.0)] (if (< val 0.0) 0.0 (if (> val 1.0) 1.0 val)))
                    r (+ 0.45 (* t (- 0.1 0.45)))
                    g (+ 0.08 (* t (- 0.3 0.08)))
                    b (+ 0.18 (* t (- 0.65 0.18)))]
                (Engine.set-bg-color! e (Vector3.init r g b)))
              (let [t (let [val (* (- 0.0 max-alt) 4.0)] (if (< val 0.0) 0.0 (if (> val 1.0) 1.0 val)))
                    r (+ 0.45 (* t (- 0.005 0.45)))
                    g (+ 0.08 (* t (- 0.005 0.08)))
                    b (+ 0.18 (* t (- 0.02 0.18)))]
                (Engine.set-bg-color! e (Vector3.init r g b))))))
        (Engine.tick-events! e)
        (Diagnostics.with-zone diag "Input Handling"
          (Engine.tick-input! e dt))
        (Diagnostics.with-zone diag "Physics Simulation"
          (Engine.tick-simulation! e dt))
        (Diagnostics.with-zone diag "ECS Lifecycle"
          (Engine.tick-lifecycle! e dt))
        (Diagnostics.with-zone diag "Field DB Sync"
          (do
            (Engine.tick-field-db-sync! e dt)
            (FieldDatabase.tick! (Engine.db e) (Engine.entity-db e) dt)
            (when (> (Array.length (EntityDatabase.events (Engine.entity-db e))) 0)
              (Engine.set-grid-dirty! e true))))
        (Diagnostics.with-zone diag "Render Submit & Sync"
          (do
            (Diagnostics.with-zone diag "Sync: JIT Hot Reload"
              (do
                (Engine.evaluate-jit-hot-reload! e ctx ren)
                (Engine.evaluate-render-hot-reload! e ctx ren)
                (Engine.evaluate-carve-hot-reload! e ctx ren)
                (Engine.evaluate-light-rule-hot-reload! e ctx ren)
                (Engine.evaluate-interaction-rule-hot-reload! e ctx ren)
                (Engine.evaluate-water-rule-hot-reload! e ctx ren)
                (Engine.evaluate-gas-rule-hot-reload! e ctx ren)
                (Engine.evaluate-em-rule-hot-reload! e ctx ren)))
            (Diagnostics.with-zone diag "Sync: JIT Physics Loop"
              (Engine.run-jit-physics-loop! e ctx ren))
            (Diagnostics.with-zone diag "Sync: Submit Render Cmds"
              (Engine.submit-render-commands! e))
            (Diagnostics.with-zone diag "Sync: Render DB Update"
              (Engine.sync-render-db! e ctx ren)))))))

  (sig reload-settings! (Fn [(Ref Engine.Engine) (Ptr WGPUContext) (Ref WGPURenderer)] ()))
  (defn reload-settings! [e ctx ren]
    (let [new-cfg (Settings.load-from-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/settings.cfg")
          old-cfg (Engine.settings e)
          steps-changed (or (not (= @(Settings.ray-steps &new-cfg) @(Settings.ray-steps old-cfg)))
                            (not (= @(Settings.shadow-steps &new-cfg) @(Settings.shadow-steps old-cfg))))
          qual-changed (or (not (= @(Settings.shadow-quality &new-cfg) @(Settings.shadow-quality old-cfg)))
                           (or (not (= @(Settings.volumetric-sdf &new-cfg) @(Settings.volumetric-sdf old-cfg)))
                               (not (= @(Settings.chunk-loading-enabled &new-cfg) @(Settings.chunk-loading-enabled old-cfg)))))
          show-debug-changed (not (= @(Settings.show-debug-lines &new-cfg) @(Settings.show-debug-lines old-cfg)))]
      (do
        (when (or (or steps-changed qual-changed) show-debug-changed)
          (do
            (IO.println "Settings configuration changed, reloading...")
            (Engine.set-shadow-quality! e @(Settings.shadow-quality &new-cfg))
            (Engine.set-volumetric-sdf! e @(Settings.volumetric-sdf &new-cfg))
            (Engine.set-chunk-loading-enabled! e @(Settings.chunk-loading-enabled &new-cfg))
            (Engine.set-show-debug-lines! e @(Settings.show-debug-lines &new-cfg))
            
            (when steps-changed
              (let [ray-steps @(Settings.ray-steps &new-cfg)
                    shadow-steps @(Settings.shadow-steps &new-cfg)
                    voxel-res @(Settings.voxel-resolution &new-cfg)
                    new-shader (Shaders.shader-wgsl WGPURenderer.max-spheres WGPURenderer.max-ids-per-cell ray-steps shadow-steps voxel-res)
                    format (WGPURenderer.format ren)
                    pipe-res (WGPURender.create-pipeline ctx &new-shader "vs_main" "fs_main" format)]
                (match pipe-res
                  (Result.Success new-pipe)
                    (let [old-pipe @(WGPURenderer.pipeline ren)]
                      (do
                        (WGPURender.free-pipeline old-pipe)
                        (WGPURenderer.set-pipeline! ren new-pipe)
                        (let [old-bg @(WGPURenderer.bind-group ren)
                               new-bg-res (create-voxel-render-bind-group-chunked-em-result ctx new-pipe 
                                            @(WGPURenderer.s-buffer ren) 
                                            @(WGPURenderer.csg-buffer ren) 
                                            @(WGPURenderer.u-buffer ren) 
                                            @(WGPURenderer.voxel-texture ren) 
                                            @(WGPURenderer.voxel-baked-values-texture ren) 
                                            @(WGPURenderer.light-texture ren) 
                                            @(WGPURenderer.interaction-texture ren) 
                                            @(WGPURenderer.water-texture ren) 
                                            @(WGPURenderer.gas-texture ren) 
                                            @(WGPURenderer.em-texture ren) 
                                            @(WGPURenderer.gravity-texture ren) 
                                            @(WGPURenderer.voxel-sampler ren) 
                                            @(WGPURenderer.chunk-lookup-buffer ren) 
                                            @(WGPURenderer.noise-texture ren) 
                                            @(WGPURenderer.noise-sampler ren)
                                            @(WGPURenderer.instances-buffer ren))]
                          (match new-bg-res
                            (Result.Success bg)
                              (do
                                (WGPURender.free-bind-group old-bg)
                                (WGPURenderer.set-bind-group! ren bg)
                                (IO.println "GPU raymarching pipelines recompiled successfully!"))
                            (Result.Error err)
                              (println* "Failed to recreate render bind group: " &err)))))
                  (Result.Error err)
                    (println* "Failed to recompile render pipeline: " &err))))
            
            (Engine.set-settings! e new-cfg))))))
)
