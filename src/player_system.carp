;; player_system.carp
;; Encapsulates player controller & camera alignment systems.

(defmodule PlayerSystem
  (use Double)
  (use Vector3)
  (use Quaternion)
  (use Transform)
  (use Body)
  (use RigidBody)
  (use Collision)
  (use InputManager)
  (use RotationState)
  (use Camera)
  (use ECS)
  (use Clock)
  (use SpatialGrid)
  (use PhysicsSystem)
  (use Random)
  (use Coordinator)
  (use FieldDatabase)
  (use World)
  (use Raymarch)
  (use Ray)

  (defn apply-movement! [p-rb p-rot p-scale mgr dt]
    (let [move-speed (* 20.0 p-scale)
          yaw @(RotationState.yaw p-rot)
          pitch @(RotationState.pitch p-rot)
          dx (InputManager.action-analog mgr "LookX")
          dy (InputManager.action-analog mgr "LookY")
          new-yaw (+ yaw dx)
          new-pitch (clamp -1.5 1.5 (+ pitch dy))
          yaw-axis (Vector3.init 0.0 1.0 0.0)
          pitch-axis (Vector3.init 1.0 0.0 0.0)
          q-yaw (Quaternion.from-axis-angle yaw-axis new-yaw)
          q-pitch (Quaternion.from-axis-angle pitch-axis new-pitch)
          look-rot (Quaternion.mul &q-yaw &q-pitch)
          forward (Transform.forward-quat &look-rot)
          right (Transform.right-quat &look-rot)
          move-dir (Vector3.init 0.0 0.0 0.0)]
      (do
        (RotationState.set-yaw! p-rot new-yaw)
        (RotationState.set-pitch! p-rot new-pitch)
        (when (InputManager.action-digital? mgr "Forward") (set! move-dir (Vector3.add &move-dir &forward)))
        (when (InputManager.action-digital? mgr "Backward") (set! move-dir (Vector3.sub &move-dir &forward)))
        (when (InputManager.action-digital? mgr "Left") (set! move-dir (Vector3.sub &move-dir &right)))
        (when (InputManager.action-digital? mgr "Right") (set! move-dir (Vector3.add &move-dir &right)))
        (when (not (< (Vector3.mag-sq &move-dir) 0.001))
          (let [accel (Vector3.mul &(Vector3.normalize &move-dir) move-speed)]
            (RigidBody.apply-force! p-rb &accel)))
        (when (InputManager.action-digital? mgr "Up")
          (let [up-force (Vector3.init 0.0 (* move-speed 1.5) 0.0)]
            (RigidBody.apply-force! p-rb &up-force)))
        (when (InputManager.action-digital? mgr "Down")
          (let [down-force (Vector3.init 0.0 (- 0.0 (* move-speed 1.2)) 0.0)]
            (RigidBody.apply-force! p-rb &down-force)))
        (RigidBody.set-rotation! p-rb look-rot))))

  (defn update-camera-and-bounds! [world cam dt]
    (ECS.query world [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
      (let [yaw @(RotationState.yaw p-rot)
            pitch @(RotationState.pitch p-rot)
            
            ;; Reconstruct rotation for camera (unaffected by body roll)
            yaw-axis (Vector3.init 0.0 1.0 0.0)
            pitch-axis (Vector3.init 1.0 0.0 0.0)
            q-yaw (Quaternion.from-axis-angle yaw-axis yaw)
            q-pitch (Quaternion.from-axis-angle pitch-axis pitch)
            look-rot (Quaternion.mul &q-yaw &q-pitch)
            r (match-ref (Collidable.volume p-col)
                (Volume.Ball sphere) @(Sphere.radius sphere)
                _ 1.0)
            eye-pos (Vector3.add (RigidBody.position p-rb) &(Vector3.init 0.0 (* 0.8 r) 0.0))]
        (do
          (Camera.set-pos! cam eye-pos)
          (Camera.set-front! cam (Transform.forward-quat &look-rot))
          (Camera.set-right! cam (Transform.right-quat &look-rot))
          (Camera.set-up! cam (Transform.up-quat &look-rot))))))

  (def last-fire-time 0.0)

  (defn spawn-bullet! [e bouncy]
    (let [current-time (Clock.total (Engine.clock e))]
      (when (or (not bouncy) (>= (- current-time @&last-fire-time) 0.05))
        (do
          (when bouncy (set! last-fire-time current-time))
          (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
      (let [p-pos (RigidBody.position p-rb)
            p-scale (match-ref (Collidable.volume p-col)
                      (Volume.Ball sphere) @(Sphere.radius sphere)
                      _ 1.0)
            
            ;; Use RotationState to determine bullet direction
            yaw-axis (Vector3.init 0.0 1.0 0.0)
            pitch-axis (Vector3.init 1.0 0.0 0.0)
            q-yaw (Quaternion.from-axis-angle yaw-axis @(RotationState.yaw p-rot))
            q-pitch (Quaternion.from-axis-angle pitch-axis @(RotationState.pitch p-rot))
            look-rot (Quaternion.mul &q-yaw &q-pitch)
            p-dir (Transform.forward-quat &look-rot)
            
            ;; Spawn slightly in front of player (distance > player_rad + bullet_rad)
            bullet-pos (Vector3.add p-pos &(Vector3.mul &p-dir (* 1.6 p-scale)))
            bullet-vel (Vector3.mul &p-dir 10.0)
            
            rand-x (Double.random-between -10.0 10.0)
            rand-y (Double.random-between -10.0 10.0)
            rand-z (Double.random-between -10.0 10.0)
            bullet-ang-vel (Vector3.init rand-x rand-y rand-z)
            
            b-scale (if bouncy (* p-scale (Double.random-between 0.2 2.0)) p-scale)
            data (BulletSpawnData.init bullet-pos bullet-vel bullet-ang-vel b-scale bouncy false)
            ev (EventKind.Game (GameEvent.SpawnBullet data))]
        (Coordinator.dispatch! (Engine.coordinator e) ev)))))))

  (defn scale-player! [e factor]
    (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-tag PlayerTag)]
      (match-ref (Collidable.volume p-col)
        (Volume.Ball sphere)
          (let [old-r @(Sphere.radius sphere)
                new-r (let [r (* old-r factor)]
                        (if (< r 0.2) 0.2 (if (> r 5.0) 5.0 r)))]
            (Sphere.set-radius! sphere new-r))
        _ ()))
  )

  (sig sample-world-distance (Fn [(Ref GameWorld) (Ref World) (Ref (Array Uint32)) (Ref (Vector3 Double))] Double))
  (defn sample-world-distance [world world-data candidates p]
    (let [min-d (PhysicsSystem.sample-static-world world-data p)]
      (do
        (for [i 0 (Array.length candidates)]
          (let [id (Array.unsafe-nth candidates i)
                ent (ECS.Entity.init (Handle.init (Uint64.from-long (Uint32.to-long @id)) (Uint32.from-long 1l)))]
            (when (not (ECS.has-component? world &ent PlayerTag))
              (ECS.with-components world ent [e (rb RigidBody) (col Collidable)]
                (let [d (match-ref (Collidable.volume col)
                          (Volume.Ball s) (let [center (RigidBody.position rb)]
                                            (- (Vector3.dist center p) @(Sphere.radius s)))
                          (Volume.Box b) (let [center (RigidBody.position rb)
                                               rot (RigidBody.rotation rb)
                                               half-extents (Vector3.mul &(Vector3.sub (AABB.max b) (AABB.min b)) 0.5)
                                               local-p (Quaternion.rotate &(Quaternion.inverse rot) &(Vector3.sub p center))
                                               q-x (- (Double.abs @(Vector3.x &local-p)) @(Vector3.x &half-extents))
                                               q-y (- (Double.abs @(Vector3.y &local-p)) @(Vector3.y &half-extents))
                                               q-z (- (Double.abs @(Vector3.z &local-p)) @(Vector3.z &half-extents))
                                               ext-x (max q-x 0.0)
                                               ext-y (max q-y 0.0)
                                               ext-z (max q-z 0.0)
                                               ext-len (Double.sqrt (+ (* ext-x ext-x) (+ (* ext-y ext-y) (* ext-z ext-z))))
                                               int-val (min (max q-x (max q-y q-z)) 0.0)]
                                          (+ ext-len int-val))
                          (Volume.Sdf sdf) (SDF.distance-world sdf p)
                          _ 10000.0)]
                  (set! min-d (min min-d d)))))))
        min-d)))

  (sig estimate-normal-world (Fn [(Ref GameWorld) (Ref World) (Ref (Array Uint32)) (Ref (Vector3 Double)) Double] (Vector3 Double)))
  (defn estimate-normal-world [world world-data candidates p eps]
    (let [ex (Vector3.init eps 0.0 0.0)
          ey (Vector3.init 0.0 eps 0.0)
          ez (Vector3.init 0.0 0.0 eps)
          p-x+ (Vector3.add p &ex)
          p-x- (Vector3.sub p &ex)
          p-y+ (Vector3.add p &ey)
          p-y- (Vector3.sub p &ey)
          p-z+ (Vector3.add p &ez)
          p-z- (Vector3.sub p &ez)
          dx (- (sample-world-distance world world-data candidates &p-x+) (sample-world-distance world world-data candidates &p-x-))
          dy (- (sample-world-distance world world-data candidates &p-y+) (sample-world-distance world world-data candidates &p-y-))
          dz (- (sample-world-distance world world-data candidates &p-z+) (sample-world-distance world world-data candidates &p-z-))]
      (Vector3.normalize &(Vector3.init dx dy dz))))

  (sig march-world (Fn [(Ref GameWorld) (Ref World) (Ref (SpatialGrid Uint32)) (Ref Ray) (Ref RaymarchConfig)] RaymarchHit))
  (defn march-world [world world-data grid ray config]
    (let [max-d @(RaymarchConfig.max-dist config)
          candidates (SpatialGrid.query-ray-unique grid ray max-d)
          ro (Ray.origin ray)
          rd (Ray.direction ray)
          t (max @(RaymarchConfig.start-bias config) @(RaymarchConfig.hit-threshold config))
          p (Vector3.init 0.0 0.0 0.0)
          hit false
          steps 0
          max-s @(RaymarchConfig.max-steps config)
          hit-eps @(RaymarchConfig.hit-threshold config)
          step-eps @(RaymarchConfig.min-step config)]
      (do
        (while (and (< steps max-s) (< t max-d))
          (do
            (set! p (Vector3.add ro &(Vector3.mul rd t)))
            (let [d (sample-world-distance world world-data &candidates &p)]
              (do
                (if (< d hit-eps)
                  (do (set! hit true) (break))
                  (set! t (+ t (max d step-eps))))
                (set! steps (inc steps))))))
        (let [norm (if hit (estimate-normal-world world world-data &candidates &p hit-eps) (Vector3.init 0.0 0.0 0.0))]
          (RaymarchHit.init p norm t steps hit)))))

  (defn fire-laser! [e]
    (let [cam (Engine.camera e)
          world (Engine.world e)
          grid (Engine.grid e)
          cam-pos (Camera.pos cam)
          cam-front (Camera.front cam)
          ray (Ray.make @cam-pos @cam-front)
          config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
          hit (march-world world (Engine.world-data e) grid &ray &config)]
      (if @(RaymarchHit.hit &hit)
          (let [hit-p (RaymarchHit.p &hit)
                p-rad (let [r 1.0]
                        (do
                          (ECS.query world [p-ent (p-col Collidable) (p-tag PlayerTag)]
                            (match-ref (Collidable.volume p-col)
                              (Volume.Ball sphere) (set! r @(Sphere.radius sphere))
                              _ ()))
                          r))
                rad (* p-rad 1.2)
                crater-data (CraterSpawnData.init @hit-p rad 0.0)
                ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
            (do
              (IO.println &(str* "Laser hit at " &(Vector3.str hit-p) ", spawning crater of radius " &(Double.str rad)))
              (Coordinator.dispatch! (Engine.coordinator e) ev)))
          (IO.println "Laser missed!"))))

  (defn build-laser! [e]
    (let [cam (Engine.camera e)
          world (Engine.world e)
          grid (Engine.grid e)
          cam-pos (Camera.pos cam)
          cam-front (Camera.front cam)
          ray (Ray.make @cam-pos @cam-front)
          config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
          hit (march-world world (Engine.world-data e) grid &ray &config)]
      (if @(RaymarchHit.hit &hit)
          (let [hit-p (RaymarchHit.p &hit)
                p-rad (let [r 1.0]
                        (do
                          (ECS.query world [p-ent (p-col Collidable) (p-tag PlayerTag)]
                            (match-ref (Collidable.volume p-col)
                              (Volume.Ball sphere) (set! r @(Sphere.radius sphere))
                              _ ()))
                          r))
                rad (* p-rad 1.5)
                mat-id @(Engine.selected-material e)
                crater-data (CraterSpawnData.init @hit-p rad mat-id)
                ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
            (do
              (IO.println &(str* "Build hit at " &(Vector3.str hit-p) ", building sphere of radius " &(Double.str rad) " with material ID " &(Double.str mat-id)))
              (Coordinator.dispatch! (Engine.coordinator e) ev)))
          (IO.println "Build missed!"))))

  (defn fire-implosion-laser! [e]
    (let [cam (Engine.camera e)
          world (Engine.world e)
          grid (Engine.grid e)
          cam-pos (Camera.pos cam)
          cam-front (Camera.front cam)
          ray (Ray.make @cam-pos @cam-front)
          config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
          hit (march-world world (Engine.world-data e) grid &ray &config)]
      (if @(RaymarchHit.hit &hit)
          (let [hit-p (RaymarchHit.p &hit)
                p-rad (let [r 1.0]
                        (do
                          (ECS.query world [p-ent (p-col Collidable) (p-tag PlayerTag)]
                            (match-ref (Collidable.volume p-col)
                              (Volume.Ball sphere) (set! r @(Sphere.radius sphere))
                              _ ()))
                          r))
                rad (* p-rad 1.5)
                crater-data (CraterSpawnData.init @hit-p rad 2.0)
                ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
            (do
              (IO.println &(str* "Implosion hit at " &(Vector3.str hit-p) ", spawning implosion of radius " &(Double.str rad)))
              (Coordinator.dispatch! (Engine.coordinator e) ev)))
          (IO.println "Implosion missed!"))))
  (defn spawn-water-bullet! [e]
    (let [current-time (Clock.total (Engine.clock e))]
      (when (>= (- current-time @&last-fire-time) 0.05)
        (do
          (set! last-fire-time current-time)
          (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
      (let [p-pos (RigidBody.position p-rb)
            p-scale (match-ref (Collidable.volume p-col)
                      (Volume.Ball sphere) @(Sphere.radius sphere)
                      _ 1.0)
            yaw-axis (Vector3.init 0.0 1.0 0.0)
            pitch-axis (Vector3.init 1.0 0.0 0.0)
            q-yaw (Quaternion.from-axis-angle yaw-axis @(RotationState.yaw p-rot))
            q-pitch (Quaternion.from-axis-angle pitch-axis @(RotationState.pitch p-rot))
            look-rot (Quaternion.mul &q-yaw &q-pitch)
            p-dir (Transform.forward-quat &look-rot)
            bullet-pos (Vector3.add p-pos &(Vector3.mul &p-dir (* 1.6 p-scale)))
            bullet-vel (Vector3.mul &p-dir 10.0)
            rand-x (Double.random-between -10.0 10.0)
            rand-y (Double.random-between -10.0 10.0)
            rand-z (Double.random-between -10.0 10.0)
            bullet-ang-vel (Vector3.init rand-x rand-y rand-z)
            b-scale (* p-scale 1.5)
            data (BulletSpawnData.init bullet-pos bullet-vel bullet-ang-vel b-scale false true)
            ev (EventKind.Game (GameEvent.SpawnBullet data))]
        (Coordinator.dispatch! (Engine.coordinator e) ev)))))))
  )
)