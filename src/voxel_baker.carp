;; src/voxel_baker.carp

(defmodule VoxelBaker
  (use Vector3)
  (use ECS)
  (use RigidBody)
  (use Collidable)
  (use Volume)
  (use SDF)
  (use FieldDatabase)

  (def sdf-padding 6.0)

  (defn smin [a b k]
    (let [h (let [diff (- k (Double.abs (- a b)))]
              (if (> diff 0.0) (/ diff k) 0.0))]
      (let [min-val (if (< a b) a b)]
        (- min-val (* (* (* h h) h) (* k (/ 1.0 6.0)))))))

  (defn smax [a b k]
    (let [h (let [diff (- k (Double.abs (- a b)))]
              (if (> diff 0.0) (/ diff k) 0.0))]
      (let [max-val (if (> a b) a b)]
        (+ max-val (* (* (* h h) h) (* k (/ 1.0 6.0)))))))

  (defn pack-and-copy-chunk! [ctx ren chunk v-gpu-b slot res]
    (let [v-half-b @(WGPURenderer.voxel-half-buffer ren)
          pipe @(WGPURenderer.pack-pipeline ren)
          slots-per-dim (/ 384 res)
          slots-per-dim-sq (* slots-per-dim slots-per-dim)
          slot-x (Int.mod slot slots-per-dim)
          slot-y (Int.mod (/ slot slots-per-dim) slots-per-dim)
          slot-z (/ slot slots-per-dim-sq)
          ox (* slot-x res)
          oy (* slot-y res)
          oz (* slot-z res)
          dispatch-cnt (/ (* res (* res res)) 64)
          cached-bg @(Chunk.pack-bind-group chunk)
          bg (if (WGPU.bindgroup-null?- cached-bg)
                 (let [pack-bufs [v-gpu-b v-half-b]]
                   (match (WGPU.create-bind-group ctx pipe &pack-bufs)
                     (Result.Error e) (do (IO.println &(format "Pack Bind Group error: %s" &e)) (null-bind-group))
                     (Result.Success new-bg)
                       (do
                         (Chunk.set-pack-bind-group! chunk new-bg)
                         new-bg)))
                 cached-bg)]
      (when (not (WGPU.bindgroup-null?- bg))
        (do
          (WGPU.dispatch ctx pipe bg dispatch-cnt)
          (WGPURender.copy-buffer-to-3d-texture-offset 
            ctx 
            v-half-b 
            @(WGPURenderer.voxel-texture ren) 
            ox oy oz res res res)))))

  (defn chunk-overlaps-sphere? [chunk center radius]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          c-min-x (* (Double.from-int qx) 32.0)
          c-min-y (* (Double.from-int qy) 32.0)
          c-min-z (* (Double.from-int qz) 32.0)
          c-max-x (+ c-min-x 32.0)
          c-max-y (+ c-min-y 32.0)
          c-max-z (+ c-min-z 32.0)
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          px (Double.clamp c-min-x c-max-x cx)
          py (Double.clamp c-min-y c-max-y cy)
          pz (Double.clamp c-min-z c-max-z cz)
          dx (- px cx)
          dy (- py cy)
          dz (- pz cz)
          dist-sq (+ (* dx dx) (+ (* dy dy) (* dz dz)))
          r-padded (+ radius sdf-padding)]
      (< dist-sq (* r-padded r-padded))))

  (defn run-voxel-action-gpu! [ctx ren chunk center radius op-type res]
    (let [v-gpu-b @(Chunk.gpu-buffer chunk)]
      (if (WGPU.buffer-null?- v-gpu-b)
        ()
        (let [cx @(Vector3.x center)
              cy @(Vector3.y center)
              cz @(Vector3.z center)
              qx @(Chunk.coord-x chunk)
              qy @(Chunk.coord-y chunk)
              qz @(Chunk.coord-z chunk)
              ox (* (Double.from-int qx) 32.0)
              oy (* (Double.from-int qy) 32.0)
              oz (* (Double.from-int qz) 32.0)
              cell-size (/ 32.0 (Double.from-int res))
              params-data [(Double.to-float ox) (Double.to-float oy) (Double.to-float oz)
                           (Double.to-float cell-size)
                           (Double.to-float cx) (Double.to-float cy) (Double.to-float cz)
                           (Double.to-float radius)
                           (Double.to-float op-type)
                           0.0f 0.0f 0.0f]
              c-params-b @(WGPURenderer.carve-params-buffer ren)
              pipe @(WGPURenderer.carve-pipeline ren)
              dispatch-cnt (/ (* res (* res res)) 64)]
          (do
            (WGPU.write-floats ctx c-params-b &params-data)
            (let [bufs [v-gpu-b c-params-b]]
              (match (WGPU.create-bind-group ctx pipe &bufs)
                (Result.Error e) (IO.println &(format "Voxel action Bind Group error: %s" &e))
                (Result.Success bg)
                  (do
                    (WGPU.dispatch ctx pipe bg dispatch-cnt)
                    (WGPU.free-bind-group bg))))
            (pack-and-copy-chunk! ctx ren chunk v-gpu-b @(Chunk.atlas-slot chunk) res)
            )))))

  (defn carve-voxel-grid-gpu! [ctx ren chunk center radius res]
    (run-voxel-action-gpu! ctx ren chunk center radius 0.0 res))

  (defn build-voxel-grid-gpu! [ctx ren chunk center radius res]
    (run-voxel-action-gpu! ctx ren chunk center radius 1.0 res))

  (defn bake-chunk-slices! [ctx ren chunk world-data start-z end-z static-world-sdf]
    (let [voxel-data (Chunk.voxel-data chunk)
          qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          res @(World.voxel-resolution world-data)
          cell-size (World.voxel-cell-size world-data)
          w-dim res
          h-dim res
          db (World.field-db world-data)
          near-indices (the (Array Int) [])
          chunk-center (Vector3.init (+ ox 16.0) (+ oy 16.0) (+ oz 16.0))
          chunk-radius 28.0
          active-arr (FieldDatabase.active db)
          num-active (Array.length active-arr)]
      (do
        (for [i 0 num-active]
          (when @(Array.unsafe-nth active-arr i)
            (let [shape-type @(Array.unsafe-nth (FieldDatabase.shape-types db) i)]
              (when (/= shape-type -1)
                (let [scale @(Array.unsafe-nth (FieldDatabase.scales db) i)
                      params (Array.unsafe-nth (FieldDatabase.params db) i)
                      inst-pos (Array.unsafe-nth (FieldDatabase.positions db) i)
                      R (FieldDatabase.get-shape-bounding-radius shape-type scale params)
                      diff (Vector3.sub &chunk-center inst-pos)
                      dist (Vector3.mag &diff)]
                  (when (<= dist (+ chunk-radius R))
                    (Array.push-back! &near-indices i)))))))
        (for [z start-z end-z]
          (for [x 0 w-dim]
            (let [px (+ ox (* (+ (Double.from-int x) 0.5) cell-size))
                  pz (+ oz (* (+ (Double.from-int z) 0.5) cell-size))
                  final-h (WGPURenderer.get-terrain-height px pz)]
              (for [y 0 h-dim]
                (let [py (+ oy (* (+ (Double.from-int y) 0.5) cell-size))
                      p (Vector3.init px py pz)
                      
                      raw-terrain-d (- py final-h)
                      max-scale (if (> WGPURenderer.plains-scale WGPURenderer.canyons-scale)
                                    (if (> WGPURenderer.plains-scale WGPURenderer.mountains-scale) WGPURenderer.plains-scale WGPURenderer.mountains-scale)
                                    (if (> WGPURenderer.canyons-scale WGPURenderer.mountains-scale) WGPURenderer.canyons-scale WGPURenderer.mountains-scale))
                      safety-factor (/ 1.0 (+ 1.0 (* max-scale (* WGPURenderer.global-frequency 0.015))))
                      terrain-d (* raw-terrain-d (* 0.55 safety-factor))
                      
                      ;; Carve out caves if below terrain height using 3D noise
                      cave-val (if (< terrain-d 0.0)
                                   (noise3d (* px 0.08) (* py 0.08) (* pz 0.08))
                                    0.0)
                      
                      ;; Compute smooth cave SDF (using optimal 1/0.08 = 12.5 scale factor for correct gradient of 1.0)
                      cave-sdf (if (< terrain-d 0.0)
                                   (* (- cave-val 0.65) 12.5)
                                   -1000.0)
                      
                      ;; Combine terrain and cave smoothly
                      voxel-d (if (> cave-sdf terrain-d) cave-sdf terrain-d)
                      
                      min-d (match-ref static-world-sdf
                              (Maybe.Just parent-sdf)
                                (let [d voxel-d
                                      nodes (SDF.csg-nodes parent-sdf)]
                                  (do
                                    (for [i 0 (Array.length nodes)]
                                      (let [node (Array.unsafe-nth nodes i)
                                            node-op @(CsgNode.op node)
                                            child-sdf (Box.peek (CsgNode.shape node))
                                            child-pos (SDF.position child-sdf)
                                            diff (Vector3.sub &p child-pos)
                                            dist-sq (Vector3.mag-sq &diff)]
                                        (when (= node-op 1)
                                          (let [d-right (match @(SDF.base child-sdf)
                                                          (BaseShape.Ball r) (- (sqrt dist-sq) r)
                                                          _ (SDF.distance-world child-sdf &p))]
                                            (set! d (smax d (- 0.0 d-right) 2.5))))))
                                    d))
                              _ voxel-d)
                      mat-id (if (< min-d 0.0) 1.0f 0.0f)]
                  (do
                    ;; Bake dynamic/static SDF colliders from FieldDatabase
                    (when (> (Array.length &near-indices) 0)
                      (let [scene-res (FieldDatabase.evaluate-scene-sdf-material-subset db &p &near-indices min-d)
                            scene-d @(Vector2.x &scene-res)
                            scene-mat @(Vector2.y &scene-res)]
                        (do
                          (set! min-d scene-d)
                          (when (> scene-mat 0.0)
                            (set! mat-id (Double.to-float scene-mat))))))
                    (let [idx (* (+ x (+ (* y w-dim) (* (* z w-dim) h-dim))) 4)]
                      (do
                        (Array.aset! voxel-data idx (Double.to-float min-d))
                        (Array.aset! voxel-data (+ idx 1) mat-id)
                        (Array.aset! voxel-data (+ idx 2) 0.0f)
                        (Array.aset! voxel-data (+ idx 3) 0.0f))))))))))))

  (deftemplate compute-chunk-lighting-c! (Fn [(Ref (Array Float)) Int] ())
    "void $NAME(Array* voxel_data, int res)"
    "$DECL {
        if (!voxel_data || !voxel_data->data) return;
        int res_sq = res * res;
        float* data = voxel_data->data;
        for (int z = 0; z < res; z++) {
            int z_offset = z * res_sq;
            for (int y = 0; y < res; y++) {
                int y_offset = y * res;
                int zy_offset = z_offset + y_offset;
                for (int x = 0; x < res; x++) {
                    int idx = (x + zy_offset) * 4;
                    float d = data[idx];
                    
                    bool solid_l = (x - 1 >= 0)   ? (data[((x - 1) + zy_offset) * 4] < 0.0f) : (d < 0.0f);
                    bool solid_r = (x + 1 < res)  ? (data[((x + 1) + zy_offset) * 4] < 0.0f) : (d < 0.0f);
                    bool solid_d = (y - 1 >= 0)   ? (data[(x + z_offset + (y - 1) * res) * 4] < 0.0f) : (d < 0.0f);
                    bool solid_u = (y + 1 < res)  ? (data[(x + z_offset + (y + 1) * res) * 4] < 0.0f) : (d < 0.0f);
                    bool solid_b = (z - 1 >= 0)   ? (data[(x + y_offset + (z - 1) * res_sq) * 4] < 0.0f) : (d < 0.0f);
                    bool solid_f = (z + 1 < res)  ? (data[(x + y_offset + (z + 1) * res_sq) * 4] < 0.0f) : (d < 0.0f);
                    
                    int num_solid = 0;
                    if (solid_l) num_solid++;
                    if (solid_r) num_solid++;
                    if (solid_d) num_solid++;
                    if (solid_u) num_solid++;
                    if (solid_b) num_solid++;
                    if (solid_f) num_solid++;
                    
                    float ao_val = 1.0f - ((float)num_solid * 0.15f);
                    if (ao_val < 0.1f) ao_val = 0.1f;
                    if (ao_val > 1.0f) ao_val = 1.0f;
                    
                    float shadow_val = solid_u ? 0.2f : 1.0f;
                    
                    data[idx + 2] = shadow_val;
                    data[idx + 3] = ao_val;
                }
            }
        }
    }")

  (defn compute-chunk-lighting! [chunk res]
    (compute-chunk-lighting-c! (Chunk.voxel-data chunk) res))

  (defn bake-chunk! [ctx ren chunk world-data static-world-sdf]
    (let [res @(World.voxel-resolution world-data)]
      (do
        (bake-chunk-slices! ctx ren chunk world-data 0 res static-world-sdf)
        (compute-chunk-lighting! chunk res)
        (let [b @(Chunk.gpu-buffer chunk)]
          (if (WGPU.buffer-null?- b)
            (match (WGPU.create-buffer ctx (* res (* res (* res 16))))
              (Result.Error e) (IO.println &(format "Error creating dynamic GPU buffer in bake-chunk!: %s" &e))
              (Result.Success new-b)
                (do
                  (WGPU.write-floats ctx new-b (Chunk.voxel-data chunk))
                  (Chunk.set-gpu-buffer! chunk new-b)
                  (pack-and-copy-chunk! ctx ren chunk new-b @(Chunk.atlas-slot chunk) res)))
            (do
              (WGPU.write-floats ctx b (Chunk.voxel-data chunk))
              (pack-and-copy-chunk! ctx ren chunk b @(Chunk.atlas-slot chunk) res)))))))

  (defn bake-voxel-grid! [ctx ren grid ecs-world world-data]
    (let [chunks (World.chunks world-data)
          static-world-sdf (Maybe.Nothing)]
      (do
        (ECS.query ecs-world [parent-ent (swt StaticWorldTag) (col Collidable)]
          (match-ref (Collidable.volume col)
            (Volume.Sdf parent-sdf) (set! static-world-sdf (Maybe.Just @parent-sdf))
            _ ()))
        (IO.println "BAKING VOXEL GRID (CHUNKED)...")
        (for [i 0 (Array.length chunks)]
          (let [chunk (Array.unsafe-nth chunks i)]
            (bake-chunk! ctx ren chunk world-data &static-world-sdf))))))

  (defn carve-voxel-grid-cpu! [chunk center radius res cell-size]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          voxel-data (Chunk.voxel-data chunk)
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          min-x (- cx (+ radius sdf-padding))
          max-x (+ cx (+ radius sdf-padding))
          min-y (- cy (+ radius sdf-padding))
          max-y (+ cy (+ radius sdf-padding))
          min-z (- cz (+ radius sdf-padding))
          max-z (+ cz (+ radius sdf-padding))
          
          idx-min-x (the Int (Double.to-int (Double.floor (/ (- min-x ox) cell-size))))
          idx-max-x (the Int (Double.to-int (Double.floor (/ (- max-x ox) cell-size))))
          idx-min-y (the Int (Double.to-int (Double.floor (/ (- min-y oy) cell-size))))
          idx-max-y (the Int (Double.to-int (Double.floor (/ (- max-y oy) cell-size))))
          idx-min-z (the Int (Double.to-int (Double.floor (/ (- min-z oz) cell-size))))
          idx-max-z (the Int (Double.to-int (Double.floor (/ (- max-z oz) cell-size))))
          
          res-sub-1 (- res 1)
          start-x (Int.clamp 0 res-sub-1 idx-min-x)
          end-x (Int.clamp 0 res-sub-1 idx-max-x)
          start-y (Int.clamp 0 res-sub-1 idx-min-y)
          end-y (Int.clamp 0 res-sub-1 idx-max-y)
          start-z (Int.clamp 0 res-sub-1 idx-min-z)
          end-z (Int.clamp 0 res-sub-1 idx-max-z)]
      (do
        (for [sz start-z (inc end-z)]
          (let [pz (+ oz (* (+ (Double.from-int sz) 0.5) cell-size))
                dz (- pz cz)
                dz2 (* dz dz)]
            (for [sy start-y (inc end-y)]
              (let [py (+ oy (* (+ (Double.from-int sy) 0.5) cell-size))
                    dy (- py cy)
                    dy2_dz2 (+ (* dy dy) dz2)]
                (for [sx start-x (inc end-x)]
                  (let [idx-full (* (+ sx (+ (* sy res) (* (* sz res) res))) 4)]
                    (do
                      (when (or (>= idx-full (Array.length voxel-data)) (< idx-full 0))
                        (IO.println &(str* "CARVE OOB: idx-full=" (Int.str idx-full) " len=" (Int.str (Array.length voxel-data)) " sx=" (Int.str sx) " sy=" (Int.str sy) " sz=" (Int.str sz) " start-x=" (Int.str start-x) " end-x=" (Int.str end-x))))
                      (let [px (+ ox (* (+ (Double.from-int sx) 0.5) cell-size))
                            dx (- px cx)
                            dist-to-crater-center (Double.sqrt (+ (* dx dx) dy2_dz2))
                            crater-dist (- dist-to-crater-center radius)
                            old-dist (Double.from-float @(Array.unsafe-nth voxel-data idx-full))
                            new-dist (smax old-dist (- 0.0 crater-dist) 2.5)]
                        (Array.aset! voxel-data idx-full (Double.to-float new-dist)))))))))))))

  (defn build-voxel-grid-cpu! [chunk center radius res cell-size]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          voxel-data (Chunk.voxel-data chunk)
          cx @(Vector3.x center)
          cy @(Vector3.y center)
          cz @(Vector3.z center)
          min-x (- cx (+ radius sdf-padding))
          max-x (+ cx (+ radius sdf-padding))
          min-y (- cy (+ radius sdf-padding))
          max-y (+ cy (+ radius sdf-padding))
          min-z (- cz (+ radius sdf-padding))
          max-z (+ cz (+ radius sdf-padding))
          
          idx-min-x (the Int (Double.to-int (Double.floor (/ (- min-x ox) cell-size))))
          idx-max-x (the Int (Double.to-int (Double.floor (/ (- max-x ox) cell-size))))
          idx-min-y (the Int (Double.to-int (Double.floor (/ (- min-y oy) cell-size))))
          idx-max-y (the Int (Double.to-int (Double.floor (/ (- max-y oy) cell-size))))
          idx-min-z (the Int (Double.to-int (Double.floor (/ (- min-z oz) cell-size))))
          idx-max-z (the Int (Double.to-int (Double.floor (/ (- max-z oz) cell-size))))
          
          res-sub-1 (- res 1)
          start-x (Int.clamp 0 res-sub-1 idx-min-x)
          end-x (Int.clamp 0 res-sub-1 idx-max-x)
          start-y (Int.clamp 0 res-sub-1 idx-min-y)
          end-y (Int.clamp 0 res-sub-1 idx-max-y)
          start-z (Int.clamp 0 res-sub-1 idx-min-z)
          end-z (Int.clamp 0 res-sub-1 idx-max-z)]
      (do
        (for [sz start-z (inc end-z)]
          (let [pz (+ oz (* (+ (Double.from-int sz) 0.5) cell-size))
                dz (- pz cz)
                dz2 (* dz dz)]
            (for [sy start-y (inc end-y)]
              (let [py (+ oy (* (+ (Double.from-int sy) 0.5) cell-size))
                    dy (- py cy)
                    dy2_dz2 (+ (* dy dy) dz2)]
                (for [sx start-x (inc end-x)]
                  (let [idx-full (* (+ sx (+ (* sy res) (* (* sz res) res))) 4)]
                    (do
                      (when (or (>= idx-full (Array.length voxel-data)) (< idx-full 0) (>= (+ idx-full 1) (Array.length voxel-data)))
                        (IO.println &(str* "BUILD OOB: idx-full=" (Int.str idx-full) " len=" (Int.str (Array.length voxel-data)) " sx=" (Int.str sx) " sy=" (Int.str sy) " sz=" (Int.str sz) " start-x=" (Int.str start-x) " end-x=" (Int.str end-x))))
                      (let [px (+ ox (* (+ (Double.from-int sx) 0.5) cell-size))
                            dx (- px cx)
                            dist-to-sphere-center (Double.sqrt (+ (* dx dx) dy2_dz2))
                            sphere-dist (- dist-to-sphere-center radius)
                            old-dist (Double.from-float @(Array.unsafe-nth voxel-data idx-full))
                            new-dist (smin old-dist sphere-dist 2.5)]
                        (do
                          (Array.aset! voxel-data idx-full (Double.to-float new-dist))
                          (when (< sphere-dist 0.0)
                            (Array.aset! voxel-data (+ idx-full 1) 2.0f))))))))))))))

  (defn pack-and-copy-fields-chunk! [ctx ren slot]
    (let [f-scratch-b @(WGPURenderer.fields-scratch-buffer ren)
          f-half-b @(WGPURenderer.fields-half-buffer ren)
          pipe @(WGPURenderer.pack-pipeline ren)
          slot-x (Int.mod slot 12)
          slot-y (Int.mod (/ slot 12) 12)
          slot-z (/ slot 144)
          ox (* slot-x 32)
          oy (* slot-y 32)
          oz (* slot-z 32)
          pack-bufs [f-scratch-b f-half-b]]
      (match (WGPU.create-bind-group ctx pipe &pack-bufs)
        (Result.Error e) (IO.println &(format "Pack Fields Bind Group error: %s" &e))
        (Result.Success bg)
          (do
            (WGPU.dispatch ctx pipe bg 512)
            (WGPU.free-bind-group bg)
            (WGPURender.copy-buffer-to-3d-texture-offset 
              ctx 
              f-half-b 
              @(WGPURenderer.fields-texture ren) 
              ox oy oz 32 32 32)))))

  (defn bake-fields-gpu! [ctx ren chunk num-instances]
    (let [qx @(Chunk.coord-x chunk)
          qy @(Chunk.coord-y chunk)
          qz @(Chunk.coord-z chunk)
          ox (* (Double.from-int qx) 32.0)
          oy (* (Double.from-int qy) 32.0)
          oz (* (Double.from-int qz) 32.0)
          cell-size 1.0
          params-data [(Double.to-float ox) (Double.to-float oy) (Double.to-float oz)
                       (Double.to-float cell-size)
                       (Double.to-float num-instances)
                       0.0f 0.0f 0.0f]
          f-scratch-b @(WGPURenderer.fields-scratch-buffer ren)
          f-params-b @(WGPURenderer.fields-params-buffer ren)
          pipe @(WGPURenderer.fields-splat-pipeline ren)
          u-b @(WGPURenderer.u-buffer ren)
          raw-u-b (WGPURender.uniform-buffer-get-buffer u-b)
          bufs [f-scratch-b raw-u-b f-params-b]]
      (do
        (WGPU.write-floats ctx f-params-b &params-data)
        (match (WGPU.create-bind-group ctx pipe &bufs)
          (Result.Error e) (IO.println &(format "Fields Bake Bind Group error: %s" &e))
          (Result.Success bg)
            (do
              (WGPU.dispatch ctx pipe bg 512)
              (WGPU.free-bind-group bg)
              (pack-and-copy-fields-chunk! ctx ren @(Chunk.atlas-slot chunk)))))))
)
