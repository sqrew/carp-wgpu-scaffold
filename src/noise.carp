;; src/noise.carp

(load "../carp-noise/noise.carp")

(defmodule WGPURenderer
  (def plains-scale 12.0)
  (def plains-offset -18.0)
  (def canyons-scale 45.0)
  (def canyons-offset -25.0)
  (def mountains-scale 60.0)
  (def mountains-offset -30.0)
  (def seed-offset 0.0)
  (def global-frequency 1.0)
  (def lacunarity 2.0)
  (def gain 0.5)
  (def voxel-cleanup-threshold 0.05)

  (def cloud-density 0.45)
  (def active-tab 0)
  (def cloud-speed 2.0)
  (def cloud-min-y 60.0)
  (def cloud-max-y 90.0)
  (def cloud-color-r 0.9)
  (def cloud-color-g 0.4)
  (def cloud-color-b 0.45)
  (def cloud-noise-scale 0.004)
  (def water-flow-speed 1.0)
  (def water-erosion-rate 1.0)
  (def water-evaporation-rate 0.005)
  (def water-absorption-threshold 0.08)
  (def water-vapor-expansion 2.0)
  (def water-condensation-speed 18.0)
  (def rain-threshold 0.82)

  (defn lerp [a b t]
    (+ a (* t (- b a))))

  (defn fade [t]
    (* (* t t) (- 3.0 (* 2.0 t))))

  (defn noise2d [x z]
    (Noise.Fast.noise2d x z))

  (defn fbm2d [x z]
    (Noise.Fast.fbm2d x z gain lacunarity))

  (defn clamp-double [low high val]
    (if (< val low) low (if (> val high) high val)))

  (defn rigid-fbm2d [x z]
    (Noise.Fast.rigid-fbm2d x z gain lacunarity))

  (defn get-terrain-height [x z]
    (let [sx (+ x seed-offset)
          sz (+ z seed-offset)
          b-val (noise2d (* sx (* 0.003 global-frequency)) (* sz (* 0.003 global-frequency)))
          w1 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.2)) 0.35)))
          w2 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.5)) 0.35)))
          w3 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.8)) 0.35)))
          sum (+ w1 (+ w2 w3))
          sum-safe (if (< sum 0.0001) 0.0001 sum)
          W1 (/ w1 sum-safe)
          W2 (/ w2 sum-safe)
          W3 (/ w3 sum-safe)
          h-plains (+ (* (fbm2d (* sx (* 0.015 global-frequency)) (* sz (* 0.015 global-frequency))) plains-scale) plains-offset)
          base-canyon (fbm2d (* sx (* 0.012 global-frequency)) (* sz (* 0.012 global-frequency)))
          bc5 (* base-canyon 5.0)
          fbc (Double.floor bc5)
          tbc (- bc5 fbc)
          stepped-canyon (+ fbc (* 0.1 (fade tbc)))
          h-canyons (+ (* (/ stepped-canyon 5.0) canyons-scale) canyons-offset)
          h-mountains (+ (* (rigid-fbm2d (* sx (* 0.01 global-frequency)) (* sz (* 0.01 global-frequency))) mountains-scale) mountains-offset)]
      (+ (* W1 h-plains) (+ (* W2 h-canyons) (* W3 h-mountains)))))

  (defn noise3d [x y z]
    (Noise.Fast.noise3d x y z))
)
