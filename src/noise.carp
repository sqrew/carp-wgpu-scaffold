;; src/noise.carp

(defmodule WGPURenderer
  (def plains-scale 12.0)
  (def plains-offset -18.0)
  (def canyons-scale 45.0)
  (def canyons-offset -25.0)
  (def mountains-scale 60.0)
  (def mountains-offset -30.0)
  (def seed-offset 0.0)
  (def global-frequency 1.0)
  (def lacunarity 2.0)
  (def gain 0.5)

  (def cloud-density 0.45)
  (def cloud-speed 2.0)
  (def cloud-min-y 60.0)
  (def cloud-max-y 90.0)
  (def cloud-color-r 0.9)
  (def cloud-color-g 0.4)
  (def cloud-color-b 0.45)
  (def cloud-noise-scale 0.004)

  (defn hash2d [x z]
    (let [s (Double.sin (+ (* x 12.9898) (* z 78.233)))
          mult (* s 43758.5453123)]
      (- mult (Double.floor mult))))


  (defn lerp [a b t]
    (+ a (* t (- b a))))

  (defn fade [t]
    (* (* t t) (- 3.0 (* 2.0 t))))

  (defn noise2d [x z]
    (let [fx (Double.floor x)
          fz (Double.floor z)
          tx (- x fx)
          tz (- z fz)
          ix (Double.to-int fx)
          iz (Double.to-int fz)
          v00 (hash2d (Double.from-int ix) (Double.from-int iz))
          v10 (hash2d (Double.from-int (inc ix)) (Double.from-int iz))
          v01 (hash2d (Double.from-int ix) (Double.from-int (inc iz)))
          v11 (hash2d (Double.from-int (inc ix)) (Double.from-int (inc iz)))
          u (fade tx)
          v (fade tz)
          x0 (lerp v00 v10 u)
          x1 (lerp v01 v11 u)]
      (lerp x0 x1 v)))

  (defn fbm2d [x z]
    (let [n1 (noise2d x z)
          n2 (* gain (noise2d (* x lacunarity) (* z lacunarity)))
          n3 (* (* gain gain) (noise2d (* x (* lacunarity lacunarity)) (* z (* lacunarity lacunarity))))]
      (+ n1 (+ n2 n3))))

  (defn clamp-double [low high val]
    (if (< val low) low (if (> val high) high val)))

  (defn rigid-fbm2d [x z]
    (let [n1 (- 1.0 (Double.abs (- (* (noise2d x z) 2.0) 1.0)))
          n2 (* gain (- 1.0 (Double.abs (- (* (noise2d (* x lacunarity) (* z lacunarity)) 2.0) 1.0))))
          n3 (* (* gain gain) (- 1.0 (Double.abs (- (* (noise2d (* x (* lacunarity lacunarity)) (* z (* lacunarity lacunarity))) 2.0) 1.0))))]
      (+ n1 (+ n2 n3))))

  (defn get-terrain-height [x z]
    (let [sx (+ x seed-offset)
          sz (+ z seed-offset)
          b-val (noise2d (* sx (* 0.003 global-frequency)) (* sz (* 0.003 global-frequency)))
          w1 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.2)) 0.35)))
          w2 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.5)) 0.35)))
          w3 (clamp-double 0.0 1.0 (- 1.0 (/ (Double.abs (- b-val 0.8)) 0.35)))
          sum (+ w1 (+ w2 w3))
          sum-safe (if (< sum 0.0001) 0.0001 sum)
          W1 (/ w1 sum-safe)
          W2 (/ w2 sum-safe)
          W3 (/ w3 sum-safe)
          h-plains (+ (* (fbm2d (* sx (* 0.015 global-frequency)) (* sz (* 0.015 global-frequency))) plains-scale) plains-offset)
          base-canyon (fbm2d (* sx (* 0.012 global-frequency)) (* sz (* 0.012 global-frequency)))
          bc5 (* base-canyon 5.0)
          fbc (Double.floor bc5)
          tbc (- bc5 fbc)
          stepped-canyon (+ fbc (* 0.1 (fade tbc)))
          h-canyons (+ (* (/ stepped-canyon 5.0) canyons-scale) canyons-offset)
          h-mountains (+ (* (rigid-fbm2d (* sx (* 0.01 global-frequency)) (* sz (* 0.01 global-frequency))) mountains-scale) mountains-offset)]
      (+ (* W1 h-plains) (+ (* W2 h-canyons) (* W3 h-mountains)))))

  (defn hash3d [x y z]
    (let [s (Double.sin (+ (+ (* x 12.9898) (* y 78.233)) (* z 144.7272)))
          mult (* s 43758.5453123)]
      (- mult (Double.floor mult))))

  (defn noise3d [x y z]
    (let [fx (Double.floor x)
          fy (Double.floor y)
          fz (Double.floor z)
          tx (- x fx)
          ty (- y fy)
          tz (- z fz)
          ix (Double.to-int fx)
          iy (Double.to-int fy)
          iz (Double.to-int fz)
          v000 (hash3d (Double.from-int ix) (Double.from-int iy) (Double.from-int iz))
          v100 (hash3d (Double.from-int (inc ix)) (Double.from-int iy) (Double.from-int iz))
          v010 (hash3d (Double.from-int ix) (Double.from-int (inc iy)) (Double.from-int iz))
          v110 (hash3d (Double.from-int (inc ix)) (Double.from-int (inc iy)) (Double.from-int iz))
          v001 (hash3d (Double.from-int ix) (Double.from-int iy) (Double.from-int (inc iz)))
          v101 (hash3d (Double.from-int (inc ix)) (Double.from-int iy) (Double.from-int (inc iz)))
          v011 (hash3d (Double.from-int ix) (Double.from-int (inc iy)) (Double.from-int (inc iz)))
          v111 (hash3d (Double.from-int (inc ix)) (Double.from-int (inc iy)) (Double.from-int (inc iz)))
          u (fade tx)
          v (fade ty)
          w (fade tz)
          x00 (lerp v000 v100 u)
          x10 (lerp v010 v110 u)
          x01 (lerp v001 v101 u)
          x11 (lerp v011 v111 u)
          y0 (lerp x00 x10 v)
          y1 (lerp x01 x11 v)]
      (lerp y0 y1 w)))
)
