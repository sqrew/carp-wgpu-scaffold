(load "../carp-transform/transform.carp")
(load "../carp-dynamics/dynamics.carp")
(load "../carp-collision/collision.carp")
(load "../carp-rigidbody/rigidbody.carp")
(load "../carp-input/input.carp")

(use Vector3)
(use Double)
(use Transform)
(use Quaternion)
(use Body)
(use RigidBody)
(use Collision)
(use InputManager)

(deftype Player [
  rigidbody RigidBody
  collidable Collidable
  yaw Double
  pitch Double
])

(defmodule Player
  (defn new [pos aspect]
    (let [handle (Handle.init (Uint64.from-long 9999l) (Uint32.from-long 1l))
          ;; HARDENED TUNING: 1.0kg, low restitution, low friction for gliding, tighter damping
          rb (RigidBody.new pos (Quaternion.identity) 1.0 0.2 0.1 0.95 0.99 1.0)
          vol (Volume.Ball (Sphere.init (Vector3.init 0.0 0.0 0.0) 0.5))
          col (Collidable.init handle vol (Uint32.from-long 1l) (Uint32.from-long 1l) false)]
      (do
        (Body.set-inv-inertia! (RigidBody.body &rb) 0.0)
        (Player.init rb col -1.5707 0.0))))

  (defn process-input! [p mgr dt]
    (let [rb (Player.rigidbody p)
          trans (RigidBody.transform rb)
          body (RigidBody.body rb)
          ;; HARDENED TUNING: Snappier movement force
          force-mag 50.0]
      (do
        ;; 1. Update Yaw/Pitch from Mouse
        (let [dx (InputManager.action-analog mgr "LookX")
              dy (InputManager.action-analog mgr "LookY")]
          (do
            (Player.set-yaw! p (+ @(Player.yaw p) dx))
            (Player.set-pitch! p (clamp -1.5 1.5 (+ @(Player.pitch p) dy)))))

        ;; 2. Reconstruct Rotation
        (let [yaw-axis (Vector3.init 0.0 1.0 0.0)
              pitch-axis (Vector3.init 1.0 0.0 0.0)
              q-yaw (Quaternion.from-axis-angle &yaw-axis @(Player.yaw p))
              q-pitch (Quaternion.from-axis-angle &pitch-axis @(Player.pitch p))
              final-rot (Quaternion.mul &q-yaw &q-pitch)]
          (Transform.set-rotation! trans final-rot))
        
        ;; 3. Apply Movement Forces
        (when (InputManager.action-digital? mgr "Forward") 
          (RigidBody.apply-force! rb &(Vector3.mul &(Transform.forward trans) force-mag)))
        (when (InputManager.action-digital? mgr "Backward")
          (RigidBody.apply-force! rb &(Vector3.mul &(Transform.forward trans) (- 0.0 force-mag))))
        (when (InputManager.action-digital? mgr "Left")
          (RigidBody.apply-force! rb &(Vector3.mul &(Transform.right trans) (- 0.0 force-mag))))
        (when (InputManager.action-digital? mgr "Right")
          (RigidBody.apply-force! rb &(Vector3.mul &(Transform.right trans) force-mag)))
        (when (InputManager.action-digital? mgr "Up")
          (RigidBody.apply-force! rb &(Vector3.init 0.0 force-mag 0.0)))
        (when (InputManager.action-digital? mgr "Down")
          (RigidBody.apply-force! rb &(Vector3.init 0.0 (- 0.0 force-mag) 0.0)))

        ;; 4. Handle Reset
        (when (InputManager.action-pressed? mgr "Reset")
          (do
            (RigidBody.set-position! rb (Vector3.init 5.0 1.0 5.0))
            (Body.set-velocity! body (Vector3.init 0.0 0.0 0.0))
            (Player.set-yaw! p -1.5707)
            (Player.set-pitch! p 0.0))))))

  (defn sync-volume! [p]
    (let [rb (Player.rigidbody p)
          col (Player.collidable p)
          pos @(RigidBody.position rb)]
      (match-ref (Collidable.volume col)
        (Volume.Ball s) (Sphere.set-center! s pos)
        _ ())))
)
