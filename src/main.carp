;; Load Core Libraries First
(load "Vector.carp")
(load "Map.carp")
(load "Result.carp")
(load "Random.carp")
(load "GLFW.carp")
(load "WGPU.carp")
(load "WGPURender.carp")

(defndynamic remove-g [lst]
  (if (empty? lst)
      '()
      (if (= (car lst) "-g")
          (remove-g (cdr lst))
          (cons (car lst) (remove-g (cdr lst))))))

(Project.config "cflag" (remove-g (Project.get-config "cflag")))

(add-lib "-lX11")

(register-type GLFWwindow)
(register-type GLFWmonitor)

;; Load Custom Libraries
(load "../carp-transform/transform.carp")
(load "../carp-dynamics/dynamics.carp")
(load "../carp-rigidbody/rigidbody.carp")
(load "../carp-geometry/geometry.carp")
(load "../carp-handle/handle.carp")
(load "../carp-spatial/grid.carp")
(load "../carp-noise/noise.carp")
(load "../carp-collision/collision.carp")
(load "../carp-raymarch/raymarch.carp")
(load "../carp-physics/physics.carp")
(load "../carp-input/input.carp")
(load "../carp-input/glfw_backend.carp")
(load "../carp-gametime/gametime.carp")
(load "../carp-gamecam/camera.carp")
(load "../carp-gui/gui.carp")

;; Define ECS Protocol globally
(defprotocol (HasComponent w c)
  [(get-storage (Fn [(Ref w q)] (Ref (SparseSet c) q)))])

(load "../carp-ecs-lite/src/ecs.carp")

;; --- PROJECT MODULES ---
(load "../carp-diagnostics/diagnostics.carp")
(load "settings.carp")
(load "events.carp")
(load "coordinator.carp")
(load "commands.carp")
(load "entity_database.carp")
(load "field_database.carp")
(load "components.carp")
(load "ui_system.carp")
(load "fields.carp")
(load "world.carp")
(load "render_database.carp")
(load "engine_type.carp")
(load "prefab.carp")
(load "init.carp")
(load "line_pass.carp")
(load "gpu_spatial.carp")
(load "render.carp")
(load "physics_system.carp")
(load "debug_draw.carp")
(load "player_system.carp")
(load "engine.carp")

(use Init)
(use Engine)
(use WGPURenderer)
(use GLFW)
(use Camera)
(use Clock)
(use RigidBody)
(use Transform)
(use ECS)
(use Gui)

(defn draw-editor-ui! [win eng-ref gui-ctx-ref dt-frame cfg-ref
                       pvx-ptr pvy-ptr pvw-ptr pvh-ptr lwd-ptr rwd-ptr
                       vsdf-ptr sdl-ptr fdt-ptr rst-ptr sst-ptr
                       sim-open-ptr ray-open-ptr terrain-open-ptr lighting-open-ptr
                       gui-time-val gui-cmd-val gui-vert-val]
  (let [win-w 0
        win-h 0
        _w1 (GLFW.get-window-size win (Pointer.address &win-w) (Pointer.address &win-h))
        fb-w 0
        fb-h 0
        _w2 (GLFW.get-framebuffer-size win (Pointer.address &fb-w) (Pointer.address &fb-h))
        scale-x (/ (Double.from-int fb-w) (Double.from-int win-w))
        scale-y (/ (Double.from-int fb-h) (Double.from-int win-h))
        cursor-x 0.0
        cursor-y 0.0
        _c1 (GLFW.get-cursor-pos win (Pointer.address &cursor-x) (Pointer.address &cursor-y))
        mx (* cursor-x scale-x)
        my (* cursor-y scale-y)
        left-clicked (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_LEFT) GLFW.PRESS)
        left-pressed (and left-clicked (not (Pointer.to-value lwd-ptr)))
        right-clicked (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_RIGHT) GLFW.PRESS)
        right-pressed (and right-clicked (not (Pointer.to-value rwd-ptr)))]
    (do
      (let [vx-val 280.0f
            vy-val 10.0f
            vw-val (- (Float.from-int fb-w) 290.0f)
            vh-val (- (Float.from-int fb-h) 20.0f)]
        (do
          (Pointer.set pvx-ptr (* vx-val (Double.to-float scale-x)))
          (Pointer.set pvy-ptr (* vy-val (Double.to-float scale-y)))
          (Pointer.set pvw-ptr (* vw-val (Double.to-float scale-x)))
          (Pointer.set pvh-ptr (* vh-val (Double.to-float scale-y)))))

      (Context.begin gui-ctx-ref mx my left-clicked left-clicked)

      (Context.begin-panel gui-ctx-ref (copy "Editor Controls") 10.0f 10.0f 260.0f (- (Float.from-int fb-h) 20.0f) (copy "Voxel Engine Editor"))
      (Context.label gui-ctx-ref (copy "--- Diagnostics ---"))
      (Context.label gui-ctx-ref (str* "FPS: " (Int.str (Double.to-int (/ 1000.0 dt-frame)))))
      (Context.label gui-ctx-ref (str* "GUI CPU: " (Double.str gui-time-val) " ms"))
      (Context.label gui-ctx-ref (str* "GUI Cmds: " (Int.str gui-cmd-val) " (Verts: " (Int.str gui-vert-val) ")"))
      (let [cam (Engine.camera eng-ref)
            cam-pos (Camera.pos cam)
            pos-str (str* "Pos: " (Double.str @(Vector3.x cam-pos)) ", " (Double.str @(Vector3.y cam-pos)) ", " (Double.str @(Vector3.z cam-pos)))]
        (Context.label gui-ctx-ref pos-str))
      (let [mat-id @(Engine.selected-material eng-ref)
            mat-name (if (= mat-id 2.0) "Natural Biome Green"
                     (if (= mat-id 3.0) "Stone Grey"
                     (if (= mat-id 5.0) "Sand Beige"
                     (if (= mat-id 6.0) "Snow / Ice"
                     (if (= mat-id 7.0) "Volcanic Obsidian"
                     (if (= mat-id 8.0) "Deep Cave Moss"
                     (if (= mat-id 9.0) "Amethyst Purple Crystal"
                     (if (= mat-id 10.0) "Clay Brown"
                     (if (= mat-id 11.0) "Glowing Neon Cyan"
                     (if (= mat-id 12.0) "Shiny Gold / Brass"
                     (if (= mat-id 13.0) "Pulsating Lava Crimson"
                      "Dark Obsidian")))))))))))
            mat-str (str* "Build Mat [K]: " mat-name)]
        (Context.label gui-ctx-ref mat-str))
      (Gui.separator gui-ctx-ref)

      ;; Tab Selector buttons
      (Context.label gui-ctx-ref (copy "--- Category ---"))
      (let [curr-tab WGPURenderer.active-tab]
        (do
          (when (Context.button gui-ctx-ref "tab_visuals_btn" (copy (if (= curr-tab 0) ">> Visuals & Sim <<" "   Visuals & Sim   ")))
            (set! WGPURenderer.active-tab 0))
          (when (Context.button gui-ctx-ref "tab_terrain_btn" (copy (if (= curr-tab 1) ">> Terrain Param <<" "   Terrain Param   ")))
            (set! WGPURenderer.active-tab 1))
          (when (Context.button gui-ctx-ref "tab_lighting_btn" (copy (if (= curr-tab 2) ">> Lighting & Sky <<" "   Lighting & Sky   ")))
            (set! WGPURenderer.active-tab 2))
          (when (Context.button gui-ctx-ref "tab_quality_btn" (copy (if (= curr-tab 3) ">> Renderer Quality <<" "   Renderer Quality   ")))
            (set! WGPURenderer.active-tab 3))
          (when (Context.button gui-ctx-ref "tab_selected_btn" (copy (if (= curr-tab 4) ">> Selected Source <<" "   Selected Source   ")))
            (set! WGPURenderer.active-tab 4))
          (Gui.separator gui-ctx-ref)

          (cond
            (= curr-tab 0)
              (do
                (let [fixed-dt (Pointer.to-value fdt-ptr)]
                  (do
                    (match (Context.slider gui-ctx-ref "fixed_dt_slider" fixed-dt 0.005f 0.05f (copy "Fixed DT"))
                      (Maybe.Just nv)
                        (do
                          (Pointer.set fdt-ptr nv)
                          (Settings.set-fixed-dt! cfg-ref (Double.from-float nv))
                          (Engine.set-settings! eng-ref @cfg-ref))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Time increment step for physics simulation update."))))

            (= curr-tab 1)
              (do
                (let [ps (Double.to-float WGPURenderer.plains-scale)]
                  (do
                    (match (Context.slider gui-ctx-ref "plains_scale_slider" ps 0.0f 50.0f (copy "Plains Scale"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.plains-scale (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Scale value for noise plains.")))

                (let [po (Double.to-float WGPURenderer.plains-offset)]
                  (do
                    (match (Context.slider gui-ctx-ref "plains_offset_slider" po -50.0f 50.0f (copy "Plains Offset"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.plains-offset (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Height offset offset for noise plains.")))

                (let [cs (Double.to-float WGPURenderer.canyons-scale)]
                  (do
                    (match (Context.slider gui-ctx-ref "canyons_scale_slider" cs 0.0f 100.0f (copy "Canyons Scale"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.canyons-scale (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Scale value for canyon formations.")))

                (let [co (Double.to-float WGPURenderer.canyons-offset)]
                  (do
                    (match (Context.slider gui-ctx-ref "canyons_offset_slider" co -100.0f 50.0f (copy "Canyons Offset"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.canyons-offset (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Depth offset value for canyons.")))

                (let [ms (Double.to-float WGPURenderer.mountains-scale)]
                  (do
                    (match (Context.slider gui-ctx-ref "mountains_scale_slider" ms 0.0f 150.0f (copy "Mtns Scale"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.mountains-scale (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Scale value for mountain heights.")))

                (let [mo (Double.to-float WGPURenderer.mountains-offset)]
                  (do
                    (match (Context.slider gui-ctx-ref "mountains_offset_slider" mo -150.0f 50.0f (copy "Mtns Offset"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.mountains-offset (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Height offset value for mountains.")))

                (let [so (Double.to-float WGPURenderer.seed-offset)]
                  (do
                    (match (Context.slider gui-ctx-ref "seed_offset_slider" so 0.0f 1000.0f (copy "Terrain Seed"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.seed-offset (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Seed offset for terrain noise.")))

                (let [gf (Double.to-float WGPURenderer.global-frequency)]
                  (do
                    (match (Context.slider gui-ctx-ref "global_freq_slider" gf 0.1f 5.0f (copy "Global Freq"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.global-frequency (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Base frequency of terrain noise.")))

                (let [lac (Double.to-float WGPURenderer.lacunarity)]
                  (do
                    (match (Context.slider gui-ctx-ref "lacunarity_slider" lac 1.2f 4.0f (copy "Lacunarity"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.lacunarity (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Frequency multiplier per fractal octave.")))

                (let [g (Double.to-float WGPURenderer.gain)]
                  (do
                    (match (Context.slider gui-ctx-ref "gain_slider" g 0.1f 0.9f (copy "Fractal Gain"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.gain (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Amplitude multiplier per fractal octave.")))

                (let [vt (Double.to-float WGPURenderer.voxel-cleanup-threshold)]
                  (do
                    (match (Context.slider gui-ctx-ref "cleanup_threshold_slider" vt 0.0f 0.99f (copy "Voxel Cleanup %"))
                      (Maybe.Just nv)
                        (do
                          (set! WGPURenderer.voxel-cleanup-threshold (Double.from-float nv))
                          (set! WGPURenderer.cache-initialized false)
                          (World.dirty-all-chunks! (Engine.world-data eng-ref))
                          (Engine.set-voxel-dirty! eng-ref true)
                          (Engine.set-grid-dirty! eng-ref true))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Auto-delete threshold for voxels with very small solid thicknesses.")))

                (when (Context.button gui-ctx-ref "reset_terrain_btn" (copy "Reset Terrain Config"))
                  (do
                    (set! WGPURenderer.plains-scale 12.0)
                    (set! WGPURenderer.plains-offset -18.0)
                    (set! WGPURenderer.canyons-scale 45.0)
                    (set! WGPURenderer.canyons-offset -25.0)
                    (set! WGPURenderer.mountains-scale 60.0)
                    (set! WGPURenderer.mountains-offset -30.0)
                    (set! WGPURenderer.seed-offset 0.0)
                    (set! WGPURenderer.global-frequency 1.0)
                    (set! WGPURenderer.lacunarity 2.0)
                    (set! WGPURenderer.gain 0.5)
                    (set! WGPURenderer.voxel-cleanup-threshold 0.05)
                    (set! WGPURenderer.cache-initialized false)
                    (World.dirty-all-chunks! (Engine.world-data eng-ref))
                    (Engine.set-voxel-dirty! eng-ref true)
                    (Engine.set-grid-dirty! eng-ref true)))
                (Context.tooltip gui-ctx-ref "Reset all terrain parameters to defaults.")

                (when (Context.button gui-ctx-ref "rebake_terrain_btn" (copy "Rebake/Regen Terrain"))
                  (do
                    (set! WGPURenderer.cache-initialized false)
                    (World.dirty-all-chunks! (Engine.world-data eng-ref))
                    (Engine.set-voxel-dirty! eng-ref true)
                    (Engine.set-grid-dirty! eng-ref true)))
                (Context.tooltip gui-ctx-ref "Force regenerates all terrain chunks from the seed."))

            (= curr-tab 2)
              (do
                (let [suns-arr (Engine.suns eng-ref)
                      num-suns (Array.length suns-arr)]
                  (do
                    (Context.label gui-ctx-ref (str* "Active Suns: " (Int.str num-suns)))
                    (when (< num-suns 8)
                      (when (Context.button gui-ctx-ref "add_sun_btn" (copy "[+] Spawn Another Sun"))
                        (Array.push-back! (Engine.suns eng-ref) 
                          (Sun.init (Vector3.init 0.0 1.0 0.0)
                                    (Vector3.init 1.0 1.0 1.0)
                                    12.0
                                    true
                                    0.2
                                    (* (Double.random) (* 2.0 3.1415926))
                                    1.0
                                    1.0
                                    1.0))))
                    (when (> num-suns 0)
                      (do
                        (when (Context.button gui-ctx-ref "rem_sun_btn" (copy "[-] Despawn Last Sun"))
                          (let [dummy (Array.pop-back! (Engine.suns eng-ref))]
                            ()))
                        (for [i 0 num-suns]
                          (let [sun (Array.unsafe-nth (Engine.suns eng-ref) i)
                                id-str (Int.str i)
                                cycle-btn-id (str* "sun_cycle_" &id-str)
                                time-sld-id (str* "sun_time_" &id-str)
                                orbit-sld-id (str* "sun_orbit_" &id-str)
                                r-sld-id (str* "sun_r_" &id-str)
                                g-sld-id (str* "sun_g_" &id-str)
                                b-sld-id (str* "sun_b_" &id-str)
                                intensity-sld-id (str* "sun_intensity_" &id-str)
                                size-sld-id (str* "sun_size_" &id-str)
                                gassiness-sld-id (str* "sun_gassiness_" &id-str)
                                
                                active @(Sun.cycle-active sun)
                                btn-label (if active (str* "Sun #" &id-str " Cycle: ACTIVE") (str* "Sun #" &id-str " Cycle: PAUSED"))
                                time-val (Double.to-float @(Sun.time sun))
                                orbit-val (Double.to-float @(Sun.orbit-angle sun))
                                intensity-val (Double.to-float @(Sun.intensity sun))
                                size-val (Double.to-float @(Sun.size sun))
                                gassiness-val (Double.to-float @(Sun.gassiness sun))
                                col @(Sun.color sun)
                                cr (Double.to-float @(Vector3.x &col))
                                cg (Double.to-float @(Vector3.y &col))
                                cb (Double.to-float @(Vector3.z &col))]
                            (do
                              (Context.label gui-ctx-ref (str* "--- Sun " &id-str " ---"))
                              (when (Context.button gui-ctx-ref &cycle-btn-id (copy &btn-label))
                                (Sun.set-cycle-active! sun (not active)))
                              (match (Context.slider gui-ctx-ref &time-sld-id time-val 0.0f 24.0f (copy "Time (Hours)"))
                                (Maybe.Just nv) (Sun.set-time! sun (Double.from-float nv))
                                (Maybe.Nothing) ())
                              (match (Context.slider gui-ctx-ref &orbit-sld-id orbit-val 0.0f 6.28318f (copy "Orbit Angle"))
                                (Maybe.Just nv) (Sun.set-orbit-angle! sun (Double.from-float nv))
                                (Maybe.Nothing) ())
                              (match (Context.slider gui-ctx-ref &r-sld-id cr 0.0f 1.0f (copy "Color R"))
                                (Maybe.Just nv) (Sun.set-color! sun (Vector3.init (Double.from-float nv) @(Vector3.y &col) @(Vector3.z &col)))
                                (Maybe.Nothing) ())
                              (match (Context.slider gui-ctx-ref &g-sld-id cg 0.0f 1.0f (copy "Color G"))
                                (Maybe.Just nv) (Sun.set-color! sun (Vector3.init @(Vector3.x &col) (Double.from-float nv) @(Vector3.z &col)))
                                (Maybe.Nothing) ())
                              (match (Context.slider gui-ctx-ref &b-sld-id cb 0.0f 1.0f (copy "Color B"))
                                (Maybe.Just nv) (Sun.set-color! sun (Vector3.init @(Vector3.x &col) @(Vector3.y &col) (Double.from-float nv)))
                                (Maybe.Nothing) ())

                              ;; Intensity Slider
                              (match (Context.slider gui-ctx-ref &intensity-sld-id intensity-val 0.0f 5.0f (copy "Intensity"))
                                (Maybe.Just nv) (Sun.set-intensity! sun (Double.from-float nv))
                                (Maybe.Nothing) ())

                              ;; Size Slider
                              (match (Context.slider gui-ctx-ref &size-sld-id size-val 1.0f 100.0f (copy "Disk Size"))
                                (Maybe.Just nv) (Sun.set-size! sun (Double.from-float nv))
                                (Maybe.Nothing) ())

                              ;; Gassiness Slider
                              (match (Context.slider gui-ctx-ref &gassiness-sld-id gassiness-val 1.0f 10.0f (copy "Gassiness"))
                                (Maybe.Just nv) (Sun.set-gassiness! sun (Double.from-float nv))
                                (Maybe.Nothing) ())
                              (Gui.separator gui-ctx-ref))))))))
                              
                (Gui.separator gui-ctx-ref)
                
                ;; Cloud & Sky Settings
                (Gui.separator gui-ctx-ref)
                (Context.label gui-ctx-ref (copy "--- Cloud & Sky Settings ---"))
                (let [cd (Double.to-float WGPURenderer.cloud-density)]
                  (match (Context.slider gui-ctx-ref "cloud_density_slider" cd 0.0f 1.0f (copy "Cloud Density"))
                    (Maybe.Just nv) (set! WGPURenderer.cloud-density (Double.from-float nv))
                    (Maybe.Nothing) ()))
                (let [cs (Double.to-float WGPURenderer.cloud-speed)]
                  (match (Context.slider gui-ctx-ref "cloud_speed_slider" cs 0.0f 10.0f (copy "Wind Speed"))
                    (Maybe.Just nv) (set! WGPURenderer.cloud-speed (Double.from-float nv))
                    (Maybe.Nothing) ()))
                (let [cmin (Double.to-float WGPURenderer.cloud-min-y)]
                  (match (Context.slider gui-ctx-ref "cloud_min_y_slider" cmin 10.0f 200.0f (copy "Cloud Min Y"))
                    (Maybe.Just nv) (set! WGPURenderer.cloud-min-y (Double.from-float nv))
                    (Maybe.Nothing) ()))
                (let [cmax (Double.to-float WGPURenderer.cloud-max-y)]
                  (match (Context.slider gui-ctx-ref "cloud_max_y_slider" cmax 20.0f 300.0f (copy "Cloud Max Y"))
                    (Maybe.Just nv) (set! WGPURenderer.cloud-max-y (Double.from-float nv))
                    (Maybe.Nothing) ()))
                (let [ccr (Double.to-float WGPURenderer.cloud-color-r)
                      ccg (Double.to-float WGPURenderer.cloud-color-g)
                      ccb (Double.to-float WGPURenderer.cloud-color-b)]
                  (do
                    (match (Context.slider gui-ctx-ref "cloud_r_slider" ccr 0.0f 1.0f (copy "Cloud R"))
                      (Maybe.Just nv) (set! WGPURenderer.cloud-color-r (Double.from-float nv))
                      (Maybe.Nothing) ())
                    (match (Context.slider gui-ctx-ref "cloud_g_slider" ccg 0.0f 1.0f (copy "Cloud G"))
                      (Maybe.Just nv) (set! WGPURenderer.cloud-color-g (Double.from-float nv))
                      (Maybe.Nothing) ())
                    (match (Context.slider gui-ctx-ref "cloud_b_slider" ccb 0.0f 1.0f (copy "Cloud B"))
                      (Maybe.Just nv) (set! WGPURenderer.cloud-color-b (Double.from-float nv))
                      (Maybe.Nothing) ())))
                (let [cns (Double.to-float WGPURenderer.cloud-noise-scale)]
                  (match (Context.slider gui-ctx-ref "cloud_noise_scale_slider" cns 0.0005f 0.02f (copy "Noise Scale"))
                    (Maybe.Just nv) (set! WGPURenderer.cloud-noise-scale (Double.from-float nv))
                    (Maybe.Nothing) ())))

            (= curr-tab 3)
              (do
                (let [ray-steps (Pointer.to-value rst-ptr)]
                  (do
                    (match (Context.slider gui-ctx-ref "ray_steps_slider" ray-steps 20.0f 150.0f (copy "Ray Steps"))
                      (Maybe.Just nv)
                        (do
                          (Pointer.set rst-ptr nv)
                          (Settings.set-ray-steps! cfg-ref (Double.to-int (Double.from-float nv)))
                          (Engine.set-settings! eng-ref @cfg-ref))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Max steps for rendering primary camera rays.")))

                (let [shadow-steps (Pointer.to-value sst-ptr)]
                  (do
                    (match (Context.slider gui-ctx-ref "shadow_steps_slider" shadow-steps 4.0f 32.0f (copy "Shadow Steps"))
                      (Maybe.Just nv)
                        (do
                          (Pointer.set sst-ptr nv)
                          (Settings.set-shadow-steps! cfg-ref (Double.to-int (Double.from-float nv)))
                          (Engine.set-settings! eng-ref @cfg-ref))
                      (Maybe.Nothing) ())
                    (Context.tooltip gui-ctx-ref "Max steps for shadow tracing calculations."))))
            (= curr-tab 4)
              (do
                (let [active-panel-maybe @(Engine.active-ui-panel eng-ref)]
                  (match active-panel-maybe
                    (Maybe.Nothing)
                      (Context.label gui-ctx-ref (copy "No source selected. Click in viewport to spawn/select."))
                    (Maybe.Just panel-handle)
                      (let [world (Engine.world eng-ref)
                            found-panel-maybe (let [val (Maybe.Nothing)]
                                                (do
                                                  (ECS.query world [ent (p-comp UiPanel)]
                                                    (when (= (ECS.Entity.id &ent) (handle-id &panel-handle))
                                                      (set! val (Maybe.Just @p-comp))))
                                                  val))]
                        (match found-panel-maybe
                          (Maybe.Nothing)
                            (Context.label gui-ctx-ref (copy "Error: Panel entity not found."))
                          (Maybe.Just panel)
                            (let [target-handle @(UiPanel.target &panel)]
                              (ECS.query world [ent2 (target-fi FieldInstance) (color Color)]
                                (when (= (ECS.Entity.id &ent2) (handle-id &target-handle))
                                  (do
                                    (Context.label gui-ctx-ref (copy "--- Source Properties ---"))
                                    
                                    ;; Dropdown menu to customize primitive shape type
                                    (Context.label gui-ctx-ref (copy "Shape Primitive:"))
                                    (let [shape-options [@"Sphere" @"Box" @"Cylinder" @"Capsule" @"Torus" @"Cone" @"Black Hole"]
                                          current-shape-type @(FieldInstance.shape-type target-fi)
                                          current-shape-idx (dec current-shape-type)]
                                      (match (Context.combo gui-ctx-ref "shape_combo" &shape-options current-shape-idx)
                                        (Maybe.Just new-idx)
                                          (do
                                            (if (= new-idx 6)
                                              (do
                                                (FieldInstance.set-shape-type! target-fi 7)
                                                (FieldInstance.set-csg-index! target-fi -10))
                                              (do
                                                (FieldInstance.set-shape-type! target-fi (inc new-idx))
                                                (FieldInstance.set-csg-index! target-fi -1)))
                                            (Engine.set-grid-dirty! eng-ref true)
                                            (Engine.set-voxel-dirty! eng-ref true))
                                        (Maybe.Nothing) ()))
                                    (Context.tooltip gui-ctx-ref "Change the CSG/SDF primitive geometry shape of this field source.")
                                    (Gui.separator gui-ctx-ref)
                                    
                                    (let [controls (UiPanel.controls &panel)]
                                      (do
                                        (let [ctrl (Array.unsafe-nth controls 0)
                                              curr-val (Double.to-float @(UiControl.value ctrl))]
                                          (match (Context.slider gui-ctx-ref "scale_slider" curr-val 0.0f 1.0f (copy "Scale"))
                                            (Maybe.Just nv)
                                              (let [d-nv (Double.from-float nv)]
                                                (do
                                                  (UiControl.set-value! ctrl d-nv)
                                                  (FieldInstance.set-humidity! target-fi d-nv)
                                                  (Engine.apply-control-value! eng-ref @&target-handle 0 d-nv)))
                                            (Maybe.Nothing) ()))
                                        (Context.tooltip gui-ctx-ref "Change volumetric sphere radius or box bounds scale.")
                                        
                                        (let [ctrl (Array.unsafe-nth controls 1)
                                              curr-val (Double.to-float @(UiControl.value ctrl))]
                                          (match (Context.slider gui-ctx-ref "grav_slider" curr-val 0.0f 1.0f (copy "Gravity"))
                                            (Maybe.Just nv)
                                              (let [d-nv (Double.from-float nv)]
                                                (do
                                                  (UiControl.set-value! ctrl d-nv)
                                                  (FieldInstance.set-pressure! target-fi d-nv)
                                                  (Engine.apply-control-value! eng-ref @&target-handle 1 d-nv)))
                                            (Maybe.Nothing) ()))
                                        (Context.tooltip gui-ctx-ref "Gravity acceleration pull strength exerted on simulation particles.")
                                        
                                        (let [ctrl (Array.unsafe-nth controls 2)
                                              curr-val (Double.to-float @(UiControl.value ctrl))
                                              cv @(Color.v color)
                                              cy @(Vector3.y &cv)
                                              cz @(Vector3.z &cv)]
                                          (match (Context.slider gui-ctx-ref "temp_slider" curr-val 0.0f 1.0f (copy (if (= @(FieldInstance.shape-type target-fi) 7) "Disk Radius" "Temperature")))
                                            (Maybe.Just nv)
                                              (let [d-nv (Double.from-float nv)]
                                                (do
                                                  (UiControl.set-value! ctrl d-nv)
                                                  (Color.set-v! color (Vector3.init d-nv cy cz))
                                                  (Engine.apply-control-value! eng-ref @&target-handle 2 d-nv)))
                                            (Maybe.Nothing) ()))
                                        (Context.tooltip gui-ctx-ref "Thermal field value mapped to RED shader color channel.")
                                        
                                        (let [ctrl (Array.unsafe-nth controls 3)
                                              curr-val (Double.to-float @(UiControl.value ctrl))
                                              cv @(Color.v color)
                                              cx @(Vector3.x &cv)
                                              cz @(Vector3.z &cv)]
                                          (match (Context.slider gui-ctx-ref "chg_slider" curr-val 0.0f 1.0f (copy (if (= @(FieldInstance.shape-type target-fi) 7) "Disk Thickness" "Stress")))
                                            (Maybe.Just nv)
                                              (let [d-nv (Double.from-float nv)]
                                                (do
                                                  (UiControl.set-value! ctrl d-nv)
                                                  (Color.set-v! color (Vector3.init cx d-nv cz))
                                                  (Engine.apply-control-value! eng-ref @&target-handle 3 d-nv)))
                                            (Maybe.Nothing) ()))
                                        (Context.tooltip gui-ctx-ref "Physical stress/structural load value.")
                                        
                                        (let [ctrl (Array.unsafe-nth controls 4)
                                              curr-val (Double.to-float @(UiControl.value ctrl))
                                              cv @(Color.v color)
                                              cx @(Vector3.x &cv)
                                              cy @(Vector3.y &cv)]
                                          (match (Context.slider gui-ctx-ref "inf_slider" curr-val 0.0f 1.0f (copy (if (= @(FieldInstance.shape-type target-fi) 7) "Disk Smoothness" "Influence")))
                                            (Maybe.Just nv)
                                              (let [d-nv (Double.from-float nv)]
                                                (do
                                                  (UiControl.set-value! ctrl d-nv)
                                                  (Color.set-v! color (Vector3.init cx cy d-nv))
                                                  (Engine.apply-control-value! eng-ref @&target-handle 4 d-nv)))
                                            (Maybe.Nothing) ()))
                                        (Context.tooltip gui-ctx-ref "Physical decay radius modifier of force/collision calculations."))))))))))))
            ()
            )))



      (Gui.separator gui-ctx-ref)
      (when (Context.button gui-ctx-ref "bake_grid_btn" (copy "Bake Voxel Grid"))
        (do
          (Engine.set-voxel-dirty! eng-ref true)
          (Engine.set-grid-dirty! eng-ref true)))
      (Context.tooltip gui-ctx-ref "Build the sparse voxel grid buffer mapping physical volumes.")

      (when (Context.button gui-ctx-ref "close_editor_btn" (copy "Close Editor [TAB]"))
        (do
          (Engine.close-ui! eng-ref)
          (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)))
      (Context.tooltip gui-ctx-ref "Return to game viewport with captured mouse focus.")

      (Context.end-panel gui-ctx-ref)
      
      ()

      (let [pvx (Pointer.to-value pvx-ptr)
            pvy (Pointer.to-value pvy-ptr)
            pvw (Pointer.to-value pvw-ptr)
            pvh (Pointer.to-value pvh-ptr)
            is-in-viewport (and (and (>= mx (Double.from-float pvx)) (< mx (Double.from-float (+ pvx pvw))))
                                (and (>= my (Double.from-float pvy)) (< my (Double.from-float (+ pvy pvh)))))]
        (do
          (when (and left-pressed is-in-viewport)
            (let [vmx (- mx (Double.from-float pvx))
                  vmy (- my (Double.from-float pvy))
                  vsw (Double.from-float pvw)
                  vsh (Double.from-float pvh)
                  cam (Engine.camera eng-ref)
                  world (Engine.world eng-ref)
                  grid (Engine.grid eng-ref)
                  ray (UiSystem.get-cursor-ray cam vmx vmy vsw vsh)
                  config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
                  hit (PlayerSystem.march-world world (Engine.world-data eng-ref) grid &ray &config)]
              (when @(RaymarchHit.hit &hit)
                (let [hit-p (RaymarchHit.p &hit)
                      hit-ent-maybe (UiSystem.find-hit-entity world hit-p)
                      cam-pos (Camera.pos cam)]
                  (match hit-ent-maybe
                    (Maybe.Nothing)
                      (let [target-pos @hit-p
                            target-handle (UiSystem.spawn-voxel-field-source! world @&target-pos)
                            new-panel (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                        (do
                          (Engine.set-show-debug-lines! eng-ref true)
                          (Engine.set-active-ui-panel! eng-ref (Maybe.Just new-panel))
                          (IO.println &(str* "Spawned and selected new source #" (Long.str (Uint64.to-long (Handle.index &target-handle)))))))
                    (Maybe.Just target-handle)
                      (let [target-pos (let [pos-val (Vector3.init 0.0 0.0 0.0)]
                                         (do
                                           (ECS.query world [ent (rb RigidBody)]
                                             (when (= (ECS.Entity.id &ent) (handle-id &target-handle))
                                               (set! pos-val @(RigidBody.position rb))))
                                           pos-val))
                            new-panel (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                        (do
                          (Engine.set-show-debug-lines! eng-ref true)
                          (Engine.set-active-ui-panel! eng-ref (Maybe.Just new-panel))
                          (IO.println &(str* "Selected existing source #" (Long.str (Uint64.to-long (Handle.index &target-handle))))))))))))
          
          (when (and right-pressed is-in-viewport)
            (let [vmx (- mx (Double.from-float pvx))
                  vmy (- my (Double.from-float pvy))
                  vsw (Double.from-float pvw)
                  vsh (Double.from-float pvh)
                  cam (Engine.camera eng-ref)
                  world (Engine.world eng-ref)
                  grid (Engine.grid eng-ref)
                  ray (UiSystem.get-cursor-ray cam vmx vmy vsw vsh)
                  config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
                  hit (PlayerSystem.march-world world (Engine.world-data eng-ref) grid &ray &config)]
              (when @(RaymarchHit.hit &hit)
                (let [hit-p (RaymarchHit.p &hit)
                      p-rad 1.0
                      rad (* p-rad 1.2)
                      crater-data (CraterSpawnData.init @hit-p rad 0.0)
                      ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
                  (do
                    (IO.println &(str* "Editor laser hit at " &(Vector3.str hit-p)))
                    (Coordinator.dispatch! (Engine.coordinator eng-ref) ev))))))))

      (Pointer.set lwd-ptr left-clicked)
      (Pointer.set rwd-ptr right-clicked))))

(defn main []
  (let [cfg (Settings.load-from-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/settings.cfg")
        width @(Settings.width &cfg)
        height @(Settings.height &cfg)
        aspect (/ (Double.from-int width) (Double.from-int height))]
    (match (Init.create-app width height "Carp WGPU Game Scaffold")
      (Result.Error e) (do (println* "Initialization Error: " &e) -1)
      (Result.Success app)
        (let [ctx @(App.ctx &app)
              win @(App.win &app)
              surf @(App.surf &app)
              _ (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
              backend (GLFWBackend.init)
              eng (Engine.new (glfw-window->voidptr win) aspect backend @&cfg)]
              (do
              (let [_ (Engine.register-internal-handlers! &eng)] ())
              (let [_ (Engine.init-fields! &eng)] ())
              (match (WGPURenderer.create ctx (WGPURender.surface-format surf) width height (Engine.grid &eng) &cfg)
              (Result.Error e) (do (println* "Renderer Error: " &e) -2)
              (Result.Success ren)
                (do
                  (World.init-gpu-buffers! ctx (Engine.world-data &eng))
                  (println* "Engine started.")
                  (let [frame-count 0
                        current-width width
                        current-height height
                        gui-ctx (Context.create)
                        editor-mode false
                        tab-was-down false
                        fixed-dt-val (Double.to-float @(Settings.fixed-dt &cfg))
                        volumetric-sdf-val @(Settings.volumetric-sdf &cfg)
                        show-debug-lines-val @(Settings.show-debug-lines &cfg)
                        ray-steps-val (Float.from-int @(Settings.ray-steps &cfg))
                        shadow-steps-val (Float.from-int @(Settings.shadow-steps &cfg))
                        dt-frame 16.6
                        left-was-down false
                        right-was-down false
                        pvx 0.0f
                        pvy 0.0f
                        pvw 0.0f
                        pvh 0.0f
                        gui-flat-verts []
                        gui-num-verts (Uint32.from-long 0l)
                        sim-open-val true
                        ray-open-val true
                        terrain-open-val false
                        lighting-open-val true
                        gui-time-val 0.0
                        gui-cmd-val 0
                        gui-vert-val 0]
                    (while (= (GLFW.window-should-close win) 0)
                      (do
                        (let [t-start (System.nanotime)
                            _poll (GLFW.poll-events)
                            w 0
                            h 0
                            _ (GLFW.get-framebuffer-size win (Pointer.address &w) (Pointer.address &h))]
                        (do
                          (when (or (/= w current-width) (/= h current-height))
                            (do
                              (WGPURender.resize-surface surf ctx w h)
                              (let [old-dt @(WGPURenderer.depth-texture &ren)]
                                (do
                                  (WGPURender.free-depth-texture old-dt)
                                  (match (WGPURender.create-depth-texture ctx w h)
                                    (Result.Error e) (println* "Error resizing depth texture: " &e)
                                    (Result.Success new-dt) (WGPURenderer.set-depth-texture! &ren new-dt))))
                              (Camera.set-aspect! (Engine.camera &eng) (/ (Double.from-int w) (Double.from-int h)))
                              (set! current-width w)
                              (set! current-height h)))
                          ;; Toggle Editor Mode with TAB key
                          (let [tab-pressed-now (= (GLFW.get-key win GLFW.TAB) GLFW.PRESS)]
                            (do
                              (when (and tab-pressed-now (not tab-was-down))
                                (do
                                  (set! editor-mode (not editor-mode))
                                  (if editor-mode
                                    (do
                                      (Engine.set-active-ui-panel! &eng (Maybe.Just (Handle.init (Uint64.from-long 999999l) (Uint32.from-long 0l))))
                                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_NORMAL)
                                      (IO.println "Editor Mode: ENABLED"))
                                    (do
                                      (Engine.close-ui! &eng)
                                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
                                      (IO.println "Editor Mode: DISABLED")))))
                              (set! tab-was-down tab-pressed-now)))

                           ;; GUI State Updates and Layouts
                           (let [fps (/ 1000.0 dt-frame)]
                             (do
                               (set! gui-flat-verts [])
                               (set! gui-num-verts (Uint32.from-long 0l))
                                 (if editor-mode
                                    (do
                                       (let [diag (Engine.diagnostics &eng)]
                                         (Diagnostics.start-zone! diag "GUI Update & Layout"))
                                       (let [t-gui-start (System.nanotime)]
                                         (do
                                           (draw-editor-ui! win &eng &gui-ctx dt-frame &cfg
                                                            (Pointer.address &pvx) (Pointer.address &pvy) (Pointer.address &pvw) (Pointer.address &pvh)
                                                            (Pointer.address &left-was-down) (Pointer.address &right-was-down)
                                                            (Pointer.address &volumetric-sdf-val) (Pointer.address &show-debug-lines-val)
                                                            (Pointer.address &fixed-dt-val) (Pointer.address &ray-steps-val) (Pointer.address &shadow-steps-val)
                                                            (Pointer.address &sim-open-val) (Pointer.address &ray-open-val) (Pointer.address &terrain-open-val) (Pointer.address &lighting-open-val)
                                                            gui-time-val gui-cmd-val gui-vert-val)
                                           (set! gui-cmd-val (Array.length (Context.draw-commands &gui-ctx)))
                                           (set! gui-flat-verts (Context.generate-vertices-flat &gui-ctx))
                                           (set! gui-vert-val (/ (Array.length &gui-flat-verts) 12))
                                           (set! gui-num-verts (Uint32.from-long (Long.from-int gui-vert-val)))
                                           (set! gui-time-val (/ (Double.from-long (Uint64.to-long (Uint64.- (System.nanotime) t-gui-start))) 1000000.0))))
                                       (let [diag (Engine.diagnostics &eng)]
                                         (Diagnostics.end-zone! diag "GUI Update & Layout")))
                                  (let [w-fb 0
                                        h-fb 0
                                        _ (GLFW.get-framebuffer-size win (Pointer.address &w-fb) (Pointer.address &h-fb))]
                                    (do
                                      (set! pvx 0.0f)
                                      (set! pvy 0.0f)
                                      (set! pvw (Float.from-int w-fb))
                                      (set! pvh (Float.from-int h-fb))
                                      (set! left-was-down (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_LEFT) GLFW.PRESS))
                                      (set! right-was-down (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_RIGHT) GLFW.PRESS)))))))
 
                           (let [_tick (Engine.tick! &eng ctx &ren current-width current-height)
                                  t-after-tick (System.nanotime)
                                  cam (Engine.camera &eng)
                                  time (Clock.total (Engine.clock &eng))
                                  _clear (WGPURenderer.clear! &ren)
                                  v-w (if editor-mode (Float.to-int pvw) current-width)
                                  v-h (if editor-mode (Float.to-int pvh) current-height)
                                  line-count (WGPURenderer.process-commands! ctx &ren 
                                                      time v-w v-h cam (Engine.render-db &eng))
                                  t-after-proc (System.nanotime)
                                  _draw (WGPURenderer.draw surf ctx &ren line-count &gui-flat-verts &gui-num-verts editor-mode pvx pvy pvw pvh)
                                 t-after-draw (System.nanotime)
                                 _csg (Engine.set-csg-dirty! &eng false)
                                 _grid (Engine.set-grid-dirty! &eng false)
                                 _voxel (Engine.set-voxel-dirty! &eng false)
                                 _craters (Engine.set-craters! &eng [])
                                 t-end (System.nanotime)
                                 dt-tick (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-tick t-start))) 1000000.0)
                                 dt-proc (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-proc t-after-tick))) 1000000.0)
                                 dt-draw (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-draw t-after-proc))) 1000000.0)
                                 _ (set! dt-frame (/ (Double.from-long (Uint64.to-long (Uint64.- t-end t-start))) 1000000.0))]
                            (do
                              (set! frame-count (inc frame-count))
                              (when (= (Int.mod frame-count 120) 0)
                                (Engine.reload-settings! &eng ctx &ren))
                              (when (= (Int.mod frame-count 60) 0)
                                (do
                                  (println* "Frame " frame-count " | Pos: (" @(Vector3.x (Camera.pos cam)) ", " @(Vector3.y (Camera.pos cam)) ", " @(Vector3.z (Camera.pos cam)) ") | Tick: " dt-tick "ms | Proc: " dt-proc "ms | Draw: " dt-draw "ms")
                                  (let [fps (/ 1000.0 dt-frame)
                                        title (str* "Carp WGPU Game Scaffold | FPS: " (Double.str fps))]
                                    (GLFW.set-window-title win (String.cstr &title))))))))))))

                  (let [world-data (Engine.world-data &eng)
                        c-stats (World.cache-stats world-data)
                        queries @(Array.unsafe-nth c-stats 0)
                        hits @(Array.unsafe-nth c-stats 1)
                        rate (if (> queries 0) (* (/ (Double.from-int hits) (Double.from-int queries)) 100.0) 0.0)
                        cache-log-msg (str* "Voxel Cache Stats | Queries: " (Int.str queries)
                                            " | Hits: " (Int.str hits)
                                            " | Hit Rate: " (Double.str rate) "%\n")]
                    (do
                      (Diagnostics.log! (Engine.diagnostics &eng) (LogLevel.Info) &cache-log-msg)
                      (Diagnostics.print-stats! (Engine.diagnostics &eng))))
                  (Init.destroy-app app)
                  0)))))))
