(use Gui)

(defn draw-editor-ui! [win eng-ref gui-ctx-ref dt-frame cfg-ref
                       pvx-ptr pvy-ptr pvw-ptr pvh-ptr lwd-ptr rwd-ptr
                       vsdf-ptr sdl-ptr fdt-ptr rst-ptr sst-ptr]
  (let [win-w 0
        win-h 0
        _w1 (GLFW.get-window-size win (Pointer.address &win-w) (Pointer.address &win-h))
        fb-w 0
        fb-h 0
        _w2 (GLFW.get-framebuffer-size win (Pointer.address &fb-w) (Pointer.address &fb-h))
        scale-x (/ (Double.from-int fb-w) (Double.from-int win-w))
        scale-y (/ (Double.from-int fb-h) (Double.from-int win-h))
        cursor-x 0.0
        cursor-y 0.0
        _c1 (GLFW.get-cursor-pos win (Pointer.address &cursor-x) (Pointer.address &cursor-y))
        mx (* cursor-x scale-x)
        my (* cursor-y scale-y)
        left-clicked (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_LEFT) GLFW.PRESS)
        left-pressed (and left-clicked (not (Pointer.to-value lwd-ptr)))
        right-clicked (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_RIGHT) GLFW.PRESS)
        right-pressed (and right-clicked (not (Pointer.to-value rwd-ptr)))]
    (do
      (let [vx-val 280.0f
            vy-val 10.0f
            vw-val (- (Float.from-int fb-w) 290.0f)
            vh-val (- (Float.from-int fb-h) 20.0f)]
        (do
          (Pointer.set pvx-ptr (* vx-val (Double.to-float scale-x)))
          (Pointer.set pvy-ptr (* vy-val (Double.to-float scale-y)))
          (Pointer.set pvw-ptr (* vw-val (Double.to-float scale-x)))
          (Pointer.set pvh-ptr (* vh-val (Double.to-float scale-y)))))

      (Context.begin gui-ctx-ref mx my left-clicked left-clicked)

      (Context.begin-panel gui-ctx-ref (copy "Editor Controls") 10.0f 10.0f 260.0f (- (Float.from-int fb-h) 20.0f) (copy "Voxel Engine Editor"))
      (Context.label gui-ctx-ref (copy "--- Diagnostics ---"))
      (Context.label gui-ctx-ref (str* "FPS: " (Int.str (Double.to-int (/ 1000.0 dt-frame)))))
      (let [cam (Engine.camera eng-ref)
            cam-pos (Camera.pos cam)
            pos-str (str* "Pos: " (Double.str @(Vector3.x cam-pos)) ", " (Double.str @(Vector3.y cam-pos)) ", " (Double.str @(Vector3.z cam-pos)))]
        (Context.label gui-ctx-ref pos-str))
      
      (Context.label gui-ctx-ref (copy "--- Visuals & Sim ---"))
      (let [vsdf (Pointer.to-value vsdf-ptr)
            btn-label (if vsdf "Volumetric SDF: ON" "Volumetric SDF: OFF")]
        (when (Context.button gui-ctx-ref "vol_sdf_btn" (copy btn-label))
          (do
            (Pointer.set vsdf-ptr (not vsdf))
            (Engine.set-volumetric-sdf! eng-ref (not vsdf))
            (Engine.set-grid-dirty! eng-ref true))))

      (let [sdl (Pointer.to-value sdl-ptr)
            btn-label (if sdl "Debug Lines: ON" "Debug Lines: OFF")]
        (when (Context.button gui-ctx-ref "dbg_lines_btn" (copy btn-label))
          (do
            (Pointer.set sdl-ptr (not sdl))
            (Engine.set-show-debug-lines! eng-ref (not sdl)))))

      (let [fixed-dt (Pointer.to-value fdt-ptr)]
        (match (Context.slider gui-ctx-ref "fixed_dt_slider" fixed-dt 0.005f 0.05f (copy "Fixed DT"))
          (Maybe.Just nv)
            (do
              (Pointer.set fdt-ptr nv)
              (Settings.set-fixed-dt! cfg-ref (Double.from-float nv))
              (Engine.set-settings! eng-ref @cfg-ref))
          (Maybe.Nothing) ()))

      (Context.label gui-ctx-ref (copy "--- Raymarcher ---"))
      (let [ray-steps (Pointer.to-value rst-ptr)]
        (match (Context.slider gui-ctx-ref "ray_steps_slider" ray-steps 20.0f 150.0f (copy "Ray Steps"))
          (Maybe.Just nv)
            (do
              (Pointer.set rst-ptr nv)
              (Settings.set-ray-steps! cfg-ref (Double.to-int (Double.from-float nv)))
              (Engine.set-settings! eng-ref @cfg-ref))
          (Maybe.Nothing) ()))

      (let [shadow-steps (Pointer.to-value sst-ptr)]
        (match (Context.slider gui-ctx-ref "shadow_steps_slider" shadow-steps 4.0f 32.0f (copy "Shadow Steps"))
          (Maybe.Just nv)
            (do
              (Pointer.set sst-ptr nv)
              (Settings.set-shadow-steps! cfg-ref (Double.to-int (Double.from-float nv)))
              (Engine.set-settings! eng-ref @cfg-ref))
          (Maybe.Nothing) ()))

      (when (Context.button gui-ctx-ref "bake_grid_btn" (copy "Bake Voxel Grid"))
        (do
          (Engine.set-voxel-dirty! eng-ref true)
          (Engine.set-grid-dirty! eng-ref true)))

      (when (Context.button gui-ctx-ref "close_editor_btn" (copy "Close Editor [TAB]"))
        (do
          (Engine.close-ui! eng-ref)
          (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)))

      (Context.end-panel gui-ctx-ref)
      
      (let [active-panel-maybe @(Engine.active-ui-panel eng-ref)]
        (match active-panel-maybe
          (Maybe.Nothing)
            (Context.label gui-ctx-ref (copy "No source selected. Click in viewport to spawn/select."))
          (Maybe.Just panel-handle)
            (let [world (Engine.world eng-ref)
                  found-panel-maybe (let [val (Maybe.Nothing)]
                                      (do
                                        (ECS.query world [ent (p-comp UiPanel)]
                                          (when (= (ECS.Entity.id &ent) (handle-id &panel-handle))
                                            (set! val (Maybe.Just @p-comp))))
                                        val))]
              (match found-panel-maybe
                (Maybe.Nothing) ()
                (Maybe.Just panel)
                  (ECS.query world [ent (rb RigidBody) (p-comp UiPanel) (fi FieldInstance) (color Color)]
                    (when (= (ECS.Entity.id &ent) (handle-id &panel-handle))
                      (do
                        (Context.begin-panel gui-ctx-ref (copy "field_panel") (- (Float.from-int win-w) 270.0f) 10.0f 260.0f (- (Float.from-int fb-h) 20.0f) (copy "Field Source Properties"))
                        (Context.label gui-ctx-ref (copy "--- Properties ---"))
                        (let [controls (UiPanel.controls &panel)]
                          (do
                            (let [ctrl (Array.unsafe-nth controls 0)
                                  curr-val (Double.to-float @(UiControl.value ctrl))]
                              (match (Context.slider gui-ctx-ref "scale_slider" curr-val 0.0f 1.0f (copy "Scale"))
                                (Maybe.Just nv)
                                  (let [d-nv (Double.from-float nv)]
                                    (do
                                      (UiControl.set-value! ctrl d-nv)
                                      (FieldInstance.set-humidity! fi d-nv)
                                      (Engine.apply-control-value! eng-ref @(UiPanel.target &panel) 0 d-nv)))
                                (Maybe.Nothing) ()))
                            (let [ctrl (Array.unsafe-nth controls 1)
                                  curr-val (Double.to-float @(UiControl.value ctrl))]
                              (match (Context.slider gui-ctx-ref "grav_slider" curr-val 0.0f 1.0f (copy "Gravity"))
                                (Maybe.Just nv)
                                  (let [d-nv (Double.from-float nv)]
                                    (do
                                      (UiControl.set-value! ctrl d-nv)
                                      (FieldInstance.set-pressure! fi d-nv)
                                      (Engine.apply-control-value! eng-ref @(UiPanel.target &panel) 1 d-nv)))
                                (Maybe.Nothing) ()))
                            (let [ctrl (Array.unsafe-nth controls 2)
                                  curr-val (Double.to-float @(UiControl.value ctrl))
                                  cv @(Color.v color)
                                  cy @(Vector3.y &cv)
                                  cz @(Vector3.z &cv)]
                              (match (Context.slider gui-ctx-ref "temp_slider" curr-val 0.0f 1.0f (copy "Temperature"))
                                (Maybe.Just nv)
                                  (let [d-nv (Double.from-float nv)]
                                    (do
                                      (UiControl.set-value! ctrl d-nv)
                                      (Color.set-v! color (Vector3.init d-nv cy cz))
                                      (Engine.apply-control-value! eng-ref @(UiPanel.target &panel) 2 d-nv)))
                                (Maybe.Nothing) ()))
                            (let [ctrl (Array.unsafe-nth controls 3)
                                  curr-val (Double.to-float @(UiControl.value ctrl))
                                  cv @(Color.v color)
                                  cx @(Vector3.x &cv)
                                  cz @(Vector3.z &cv)]
                              (match (Context.slider gui-ctx-ref "chg_slider" curr-val 0.0f 1.0f (copy "Charge"))
                                (Maybe.Just nv)
                                  (let [d-nv (Double.from-float nv)]
                                    (do
                                      (UiControl.set-value! ctrl d-nv)
                                      (Color.set-v! color (Vector3.init cx d-nv cz))
                                      (Engine.apply-control-value! eng-ref @(UiPanel.target &panel) 3 d-nv)))
                                (Maybe.Nothing) ()))
                            (let [ctrl (Array.unsafe-nth controls 4)
                                  curr-val (Double.to-float @(UiControl.value ctrl))
                                  cv @(Color.v color)
                                  cx @(Vector3.x &cv)
                                  cy @(Vector3.y &cv)]
                              (match (Context.slider gui-ctx-ref "inf_slider" curr-val 0.0f 1.0f (copy "Influence"))
                                (Maybe.Just nv)
                                  (let [d-nv (Double.from-float nv)]
                                    (do
                                      (UiControl.set-value! ctrl d-nv)
                                      (Color.set-v! color (Vector3.init cx cy d-nv))
                                      (Engine.apply-control-value! eng-ref @(UiPanel.target &panel) 4 d-nv)))
                                (Maybe.Nothing) ()))
                            (when (Context.button gui-ctx-ref "close_panel_btn" (copy "Dismiss Panel"))
                              (do
                                (Engine.close-ui! eng-ref)
                                (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)))
                            (Context.end-panel gui-ctx-ref))))))))))

      (let [pvx (Pointer.to-value pvx-ptr)
            pvy (Pointer.to-value pvy-ptr)
            pvw (Pointer.to-value pvw-ptr)
            pvh (Pointer.to-value pvh-ptr)
            is-in-viewport (and (and (>= mx (Double.from-float pvx)) (< mx (Double.from-float (+ pvx pvw))))
                                (and (>= my (Double.from-float pvy)) (< my (Double.from-float (+ pvy pvh)))))]
        (do
          (when (and left-pressed is-in-viewport)
            (let [vmx (- mx (Double.from-float pvx))
                  vmy (- my (Double.from-float pvy))
                  vsw (Double.from-float pvw)
                  vsh (Double.from-float pvh)
                  cam (Engine.camera eng-ref)
                  world (Engine.world eng-ref)
                  grid (Engine.grid eng-ref)
                  ray (UiSystem.get-cursor-ray cam vmx vmy vsw vsh)
                  config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
                  hit (PlayerSystem.march-world world (Engine.world-data eng-ref) grid &ray &config)]
              (when @(RaymarchHit.hit &hit)
                (let [hit-p (RaymarchHit.p &hit)
                      hit-ent-maybe (UiSystem.find-hit-entity world hit-p)
                      cam-pos (Camera.pos cam)]
                  (match hit-ent-maybe
                    (Maybe.Nothing)
                      (let [target-pos @hit-p
                            target-handle (UiSystem.spawn-voxel-field-source! world @&target-pos)
                            new-panel (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                        (do
                          (Engine.set-show-debug-lines! eng-ref true)
                          (Engine.set-active-ui-panel! eng-ref (Maybe.Just new-panel))
                          (IO.println &(str* "Spawned and selected new source #" (Long.str (Uint64.to-long (Handle.index &target-handle)))))))
                    (Maybe.Just target-handle)
                      (let [target-pos (let [pos-val (Vector3.init 0.0 0.0 0.0)]
                                         (do
                                           (ECS.query world [ent (rb RigidBody)]
                                             (when (= (ECS.Entity.id &ent) (handle-id &target-handle))
                                               (set! pos-val @(RigidBody.position rb))))
                                           pos-val))
                            new-panel (UiSystem.spawn-ui-panel! world @&target-handle @&target-pos @cam-pos)]
                        (do
                          (Engine.set-show-debug-lines! eng-ref true)
                          (Engine.set-active-ui-panel! eng-ref (Maybe.Just new-panel))
                          (IO.println &(str* "Selected existing source #" (Long.str (Uint64.to-long (Handle.index &target-handle))))))))))))
          
          (when (and right-pressed is-in-viewport)
            (let [vmx (- mx (Double.from-float pvx))
                  vmy (- my (Double.from-float pvy))
                  vsw (Double.from-float pvw)
                  vsh (Double.from-float pvh)
                  cam (Engine.camera eng-ref)
                  world (Engine.world eng-ref)
                  grid (Engine.grid eng-ref)
                  ray (UiSystem.get-cursor-ray cam vmx vmy vsw vsh)
                  config (RaymarchConfig.init 128 100.0 0.005 0.001 0.05)
                  hit (PlayerSystem.march-world world (Engine.world-data eng-ref) grid &ray &config)]
              (when @(RaymarchHit.hit &hit)
                (let [hit-p (RaymarchHit.p &hit)
                      p-rad 1.0
                      rad (* p-rad 1.2)
                      crater-data (CraterSpawnData.init @hit-p rad 0.0)
                      ev (EventKind.Game (GameEvent.SpawnCrater crater-data))]
                  (do
                    (IO.println &(str* "Editor laser hit at " &(Vector3.str hit-p)))
                    (Coordinator.dispatch! (Engine.coordinator eng-ref) ev))))))))

      (Pointer.set lwd-ptr left-clicked)
      (Pointer.set rwd-ptr right-clicked))))

(defn main []
  (let [cfg (Settings.load-from-file &@"/home/sqrew/Desktop/carp-wgpu-scaffold/settings.cfg")
        width @(Settings.width &cfg)
        height @(Settings.height &cfg)
        aspect (/ (Double.from-int width) (Double.from-int height))]
    (match (Init.create-app width height "Carp WGPU Game Scaffold")
      (Result.Error e) (do (println* "Initialization Error: " &e) -1)
      (Result.Success app)
        (let [ctx @(App.ctx &app)
              win @(App.win &app)
              surf @(App.surf &app)
              _ (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
              backend (GLFWBackend.init)
              eng (Engine.new (glfw-window->voidptr win) aspect backend @&cfg)]
              (do
              (let [_ (Engine.register-internal-handlers! &eng)] ())
              (let [_ (Engine.init-fields! &eng)] ())
              (match (WGPURenderer.create ctx (WGPURender.surface-format surf) width height (Engine.grid &eng) &cfg)
              (Result.Error e) (do (println* "Renderer Error: " &e) -2)
              (Result.Success ren)
                (do
                  (World.init-gpu-buffers! ctx (Engine.world-data &eng))
                  (println* "Engine started.")
                  (let [frame-count 0
                        current-width width
                        current-height height
                        gui-ctx (Context.create)
                        editor-mode false
                        tab-was-down false
                        fixed-dt-val (Double.to-float @(Settings.fixed-dt &cfg))
                        volumetric-sdf-val @(Settings.volumetric-sdf &cfg)
                        show-debug-lines-val @(Settings.show-debug-lines &cfg)
                        ray-steps-val (Float.from-int @(Settings.ray-steps &cfg))
                        shadow-steps-val (Float.from-int @(Settings.shadow-steps &cfg))
                        dt-frame 16.6
                        left-was-down false
                        right-was-down false
                        pvx 0.0f
                        pvy 0.0f
                        pvw 0.0f
                        pvh 0.0f
                        gui-flat-verts []
                        gui-num-verts (Uint32.from-long 0l)]
                    (while (= (GLFW.window-should-close win) 0)
                      (do
                        (let [t-start (System.nanotime)
                            _poll (GLFW.poll-events)
                            w 0
                            h 0
                            _ (GLFW.get-framebuffer-size win (Pointer.address &w) (Pointer.address &h))]
                        (do
                          (when (or (/= w current-width) (/= h current-height))
                            (do
                              (WGPURender.resize-surface surf ctx w h)
                              (let [old-dt @(WGPURenderer.depth-texture &ren)]
                                (do
                                  (WGPURender.free-depth-texture old-dt)
                                  (match (WGPURender.create-depth-texture ctx w h)
                                    (Result.Error e) (println* "Error resizing depth texture: " &e)
                                    (Result.Success new-dt) (WGPURenderer.set-depth-texture! &ren new-dt))))
                              (Camera.set-aspect! (Engine.camera &eng) (/ (Double.from-int w) (Double.from-int h)))
                              (set! current-width w)
                              (set! current-height h)))
                          ;; Toggle Editor Mode with TAB key
                          (let [tab-pressed-now (= (GLFW.get-key win GLFW.TAB) GLFW.PRESS)]
                            (do
                              (when (and tab-pressed-now (not tab-was-down))
                                (do
                                  (set! editor-mode (not editor-mode))
                                  (if editor-mode
                                    (do
                                      (Engine.set-active-ui-panel! &eng (Maybe.Just (Handle.init (Uint64.from-long 999999l) (Uint32.from-long 0l))))
                                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_NORMAL)
                                      (IO.println "Editor Mode: ENABLED"))
                                    (do
                                      (Engine.close-ui! &eng)
                                      (GLFW.set-input-mode win GLFW.CURSOR GLFW.CURSOR_DISABLED)
                                      (IO.println "Editor Mode: DISABLED")))))
                              (set! tab-was-down tab-pressed-now)))

                           ;; GUI State Updates and Layouts
                           (let [fps (/ 1000.0 dt-frame)]
                             (do
                               (set! gui-flat-verts [])
                               (set! gui-num-verts (Uint32.from-long 0l))
                                (if editor-mode
                                  (do
                                     (draw-editor-ui! win &eng &gui-ctx dt-frame &cfg
                                                      (Pointer.address &pvx) (Pointer.address &pvy) (Pointer.address &pvw) (Pointer.address &pvh)
                                                      (Pointer.address &left-was-down) (Pointer.address &right-was-down)
                                                      (Pointer.address &volumetric-sdf-val) (Pointer.address &show-debug-lines-val)
                                                      (Pointer.address &fixed-dt-val) (Pointer.address &ray-steps-val) (Pointer.address &shadow-steps-val))
                                    (IO.println &(str* "UI Draw commands count: " (Int.str (Array.length (Context.draw-commands &gui-ctx)))))
                                    (set! gui-flat-verts (Context.generate-vertices-flat &gui-ctx))
                                    (IO.println &(str* "UI Flat Verts count: " (Int.str (Array.length &gui-flat-verts))))
                                    (set! gui-num-verts (Uint32.from-long (Long.from-int (/ (Array.length &gui-flat-verts) 8)))))
                                  (let [w-fb 0
                                        h-fb 0
                                        _ (GLFW.get-framebuffer-size win (Pointer.address &w-fb) (Pointer.address &h-fb))]
                                    (do
                                      (set! pvx 0.0f)
                                      (set! pvy 0.0f)
                                      (set! pvw (Float.from-int w-fb))
                                      (set! pvh (Float.from-int h-fb))
                                      (set! left-was-down (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_LEFT) GLFW.PRESS))
                                      (set! right-was-down (= (GLFW.get-mouse-button win GLFW.Mouse.BUTTON_RIGHT) GLFW.PRESS)))))))
 
                           (let [_tick (Engine.tick! &eng ctx &ren current-width current-height)
                                  t-after-tick (System.nanotime)
                                  cam (Engine.camera &eng)
                                  time (Clock.total (Engine.clock &eng))
                                  _clear (WGPURenderer.clear! &ren)
                                  v-w (if editor-mode (Float.to-int pvw) current-width)
                                  v-h (if editor-mode (Float.to-int pvh) current-height)
                                  line-count (WGPURenderer.process-commands! ctx &ren 
                                                      time v-w v-h cam (Engine.render-db &eng))
                                  t-after-proc (System.nanotime)
                                  _draw (WGPURenderer.draw surf ctx &ren line-count &gui-flat-verts &gui-num-verts editor-mode pvx pvy pvw pvh)
                                 t-after-draw (System.nanotime)
                                 _csg (Engine.set-csg-dirty! &eng false)
                                 _grid (Engine.set-grid-dirty! &eng false)
                                 _voxel (Engine.set-voxel-dirty! &eng false)
                                 _craters (Engine.set-craters! &eng [])
                                 t-end (System.nanotime)
                                 dt-tick (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-tick t-start))) 1000000.0)
                                 dt-proc (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-proc t-after-tick))) 1000000.0)
                                 dt-draw (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-draw t-after-proc))) 1000000.0)
                                 _ (set! dt-frame (/ (Double.from-long (Uint64.to-long (Uint64.- t-end t-start))) 1000000.0))]
                            (do
                              (set! frame-count (inc frame-count))
                              (when (= (Int.mod frame-count 120) 0)
                                (Engine.reload-settings! &eng ctx &ren))
                              (when (= (Int.mod frame-count 60) 0)
                                (do
                                  (println* "Frame " frame-count " | Pos: (" @(Vector3.x (Camera.pos cam)) ", " @(Vector3.y (Camera.pos cam)) ", " @(Vector3.z (Camera.pos cam)) ") | Tick: " dt-tick "ms | Proc: " dt-proc "ms | Draw: " dt-draw "ms")
                                  (let [fps (/ 1000.0 dt-frame)
                                        title (str* "Carp WGPU Game Scaffold | FPS: " (Double.str fps))]
                                    (GLFW.set-window-title win (String.cstr &title))))))))))))

                  (println* "Shutting down...")
                  (Diagnostics.print-stats! (Engine.diagnostics &eng))
                  (Init.destroy-app app)
                  0)))))))
