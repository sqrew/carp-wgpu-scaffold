;; Load Core Libraries First
(load "Vector.carp")
(load "Map.carp")
(load "Result.carp")
(load "Random.carp")
(load "GLFW.carp")
(load "WGPU.carp")
(load "WGPURender.carp")

(add-lib "-lX11")

(register-type GLFWwindow)
(register-type GLFWmonitor)

;; Load Custom Libraries
(load "../carp-transform/transform.carp")
(load "../carp-dynamics/dynamics.carp")
(load "../carp-rigidbody/rigidbody.carp")
(load "../carp-geometry/geometry.carp")
(load "../carp-handle/handle.carp")
(load "../carp-spatial/grid.carp")
(load "../carp-collision/collision.carp")
(load "../carp-raymarch/raymarch.carp")
(load "../carp-physics/physics.carp")
(load "../carp-input/input.carp")
(load "../carp-input/glfw_backend.carp")
(load "../carp-gametime/gametime.carp")
(load "../carp-gamecam/camera.carp")

;; Define ECS Protocol globally
(defprotocol (HasComponent w c)
  [(get-storage (Fn [(Ref w q)] (Ref (SparseSet c) q)))])

(load "../carp-ecs-lite/src/ecs.carp")

;; --- PROJECT MODULES ---
(load "events.carp")
(load "coordinator.carp")
(load "commands.carp")
(load "components.carp")
(load "field_database.carp")
(load "world.carp")
(load "prefab.carp")
(load "init.carp")
(load "gpu_spatial.carp")
(load "line_pass.carp")
(load "render.carp")
(load "physics_system.carp")
(load "debug_draw.carp")
(load "engine_type.carp")
(load "player_system.carp")
(load "explosions.carp")
(load "engine.carp")

(use Init)
(use Engine)
(use WGPURenderer)
(use GLFW)
(use Camera)
(use Clock)
(use RigidBody)
(use Transform)
(use ECS)

(defn main []
  (let [width 1280
        height 720
        aspect (/ (Double.from-int width) (Double.from-int height))]
    (match (Init.create-app width height "Carp WGPU Game Scaffold")
      (Result.Error e) (do (println* "Initialization Error: " &e) -1)
      (Result.Success app)
        (let [ctx @(App.ctx &app)
              win @(App.win &app)
              surf @(App.surf &app)
              backend (GLFWBackend.init)
              eng (Engine.new (glfw-window->voidptr win) aspect backend)]
              (do
              (let [_ (Engine.register-internal-handlers! &eng)] ())
              (match (WGPURenderer.create ctx (WGPURender.surface-format surf) width height (Engine.grid &eng))              (Result.Error e) (do (println* "Renderer Error: " &e) -2)
              (Result.Success ren)
                (do
                  (println* "Engine started.")
                  (let [frame-count 0]
                    (while (= (GLFW.window-should-close win) 0)
                      (let [t-start (System.nanotime)
                            _poll (GLFW.poll-events)
                            _input (Engine.process-input! &eng)
                            t-after-input (System.nanotime)
                            _tick (Engine.tick! &eng)
                            t-after-tick (System.nanotime)
                            cam (Engine.camera &eng)
                            time (Clock.total (Engine.clock &eng))
                            _clear (WGPURenderer.clear! &ren)
                            _submit (Engine.submit-render-commands! &eng &ren)
                            line-count (WGPURenderer.process-commands! ctx &ren 
                                               time width height cam (Engine.grid &eng) (Engine.world &eng) (Engine.world-data &eng)
                                               @(Engine.csg-dirty &eng) @(Engine.grid-dirty &eng) @(Engine.voxel-dirty &eng)
                                               (Engine.craters &eng) @(Engine.metaball-k &eng) @(Engine.view-mode &eng) @(Engine.shadow-quality &eng) @(Engine.show-debug-lines &eng))
                            t-after-proc (System.nanotime)
                            _draw (WGPURenderer.draw surf ctx &ren line-count)
                            t-after-draw (System.nanotime)
                            _csg (Engine.set-csg-dirty! &eng false)
                            _grid (Engine.set-grid-dirty! &eng false)
                            _voxel (Engine.set-voxel-dirty! &eng false)
                            _craters (Engine.set-craters! &eng [])
                            t-end (System.nanotime)
                            dt-tick (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-tick t-after-input))) 1000000.0)
                            dt-proc (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-proc t-after-tick))) 1000000.0)
                            dt-draw (/ (Double.from-long (Uint64.to-long (Uint64.- t-after-draw t-after-proc))) 1000000.0)
                            dt-frame (/ (Double.from-long (Uint64.to-long (Uint64.- t-end t-start))) 1000000.0)]
                        (do
                          (set! frame-count (inc frame-count))
                          (when (= (Int.mod frame-count 60) 0)
                             (println* "Frame " frame-count " | Pos: (" @(Vector3.x (Camera.pos cam)) ", " @(Vector3.y (Camera.pos cam)) ", " @(Vector3.z (Camera.pos cam)) ") | Tick: " dt-tick "ms | Proc: " dt-proc "ms | Draw: " dt-draw "ms"))))))

                  (println* "Shutting down...")
                  (Init.destroy-app app)
                  0)))))))
