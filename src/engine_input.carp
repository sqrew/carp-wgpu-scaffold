;; src/engine_input.carp

(defmodule Engine
  (use Camera)
  (use Clock)
  (use InputManager)
  (use Collision)
  (use SpatialGrid)
  (use Transform)
  (use Quaternion)
  (use Body)
  (use RigidBody)
  (use PhysicsSystem)
  (use Random)
  (use ECS)
  (use WGPURenderer)
  (use Coordinator)
  (use FieldDatabase)
  (use World)
  (use Raymarch)
  (use Ray)
  (defn register-bindings! [mgr]
    (do
      (InputManager.add-binding! mgr "Forward" (InputSource.Key GLFW.Keycode.W) 1.0)
      (InputManager.add-binding! mgr "Backward" (InputSource.Key GLFW.Keycode.S) 1.0)
      (InputManager.add-binding! mgr "Left" (InputSource.Key GLFW.Keycode.A) 1.0)
      (InputManager.add-binding! mgr "Right" (InputSource.Key GLFW.Keycode.D) 1.0)
      (InputManager.add-binding! mgr "Up" (InputSource.Key GLFW.Keycode.E) 1.0)
      (InputManager.add-binding! mgr "Down" (InputSource.Key GLFW.Keycode.Q) 1.0)
      (InputManager.add-binding! mgr "LookX" (InputSource.MouseDeltaX) 0.002)
      (InputManager.add-binding! mgr "LookY" (InputSource.MouseDeltaY) 0.002)
      (InputManager.add-binding! mgr "StopMovement" (InputSource.Key GLFW.Keycode.R) 1.0)
      (InputManager.add-binding! mgr "ResetPlayer" (InputSource.Key GLFW.Keycode.Y) 1.0)
      (InputManager.add-binding! mgr "Teleport" (InputSource.Key GLFW.Keycode.T) 1.0)
      (InputManager.add-binding! mgr "Fire" (InputSource.Key GLFW.Keycode.SPACE) 1.0)
      (InputManager.add-binding! mgr "FireBouncy" (InputSource.Key GLFW.Keycode.F) 1.0)
      (InputManager.add-binding! mgr "ScaleUp" (InputSource.Key GLFW.Keycode.C) 1.0)
      (InputManager.add-binding! mgr "ScaleDown" (InputSource.Key GLFW.Keycode.Z) 1.0)
      (InputManager.add-binding! mgr "Laser" (InputSource.MouseButton GLFW.Mouse.BUTTON_LEFT) 1.0)
      (InputManager.add-binding! mgr "Build" (InputSource.MouseButton GLFW.Mouse.BUTTON_RIGHT) 1.0)
      (InputManager.add-binding! mgr "Implode" (InputSource.Key GLFW.Keycode.I) 1.0)
      (InputManager.add-binding! mgr "ToggleDebug" (InputSource.Key GLFW.Keycode.P) 1.0)
      (InputManager.add-binding! mgr "CycleViewMode" (InputSource.Key GLFW.Keycode.M) 1.0)
      (InputManager.add-binding! mgr "CycleShadowQuality" (InputSource.Key GLFW.Keycode.O) 1.0)
      (InputManager.add-binding! mgr "ToggleVolumetricSdf" (InputSource.Key GLFW.Keycode.V) 1.0)
      (InputManager.add-binding! mgr "ToggleChunkLoading" (InputSource.Key GLFW.Keycode.L) 1.0)
      (InputManager.add-binding! mgr "ToggleUI" (InputSource.Key GLFW.Keycode.U) 1.0)
      (InputManager.add-binding! mgr "CycleMaterial" (InputSource.Key GLFW.Keycode.K) 1.0)))

  (sig tick-settings-input! (Fn [(Ref Engine.Engine) (Ref InputManager)] ()))
  (defn tick-settings-input! [e mgr]
    (do
      (when (InputManager.action-pressed? mgr "ScaleUp")
        (PlayerSystem.scale-player! e 1.1))
      (when (InputManager.action-pressed? mgr "ScaleDown")
        (PlayerSystem.scale-player! e 0.9))
      (when (InputManager.action-pressed? mgr "ToggleDebug")
        (let [show @(Engine.show-debug-lines e)
              new-show (not show)]
          (do
            (Engine.set-show-debug-lines! e new-show)
            (IO.println &(str* "Debug Lines: " (if new-show "ON" "OFF")))
            (Diagnostics.print-stats! (Engine.diagnostics e)))))
      (when (InputManager.action-pressed? mgr "CycleViewMode")
        (let [mode @(Engine.view-mode e)
              new-mode (Int.mod (+ mode 1) 5)]
          (do
            (Engine.set-view-mode! e new-mode)
            (Engine.set-grid-dirty! e true)
            (IO.println &(str* "Active Scalar Field View: "
              (if (= new-mode 0) "Normal (Water Volume)"
              (if (= new-mode 1) "Temperature"
              (if (= new-mode 2) "Age / Spawn Time"
              (if (= new-mode 3) "Humidity"
              "Pressure")))))))))
      (when (InputManager.action-pressed? mgr "CycleShadowQuality")
        (let [curr @(Engine.shadow-quality e)
              next (Int.mod (+ curr 1) 3)]
          (do
            (Engine.set-shadow-quality! e next)
            (IO.println &(str* "Shadow/AO Quality (0=Off, 1=Normal, 2=High): " (Int.str next))))))
      (when (InputManager.action-pressed? mgr "ToggleVolumetricSdf")
        (let [is-on @(Engine.volumetric-sdf e)
              mode @(Engine.view-mode e)]
          (do
            (if (not is-on)
                (do
                  (Engine.set-volumetric-sdf! e true)
                  (Engine.set-view-mode! e 0)
                  (IO.println "Volumetric Sdf Fog Mode: ON (SDF Vol Fog)"))
                (if (= mode 0)
                    (do
                      (Engine.set-volumetric-sdf! e true)
                      (Engine.set-view-mode! e 4)
                      (IO.println "Volumetric Sdf Fog Mode: ON (Pressure Field)"))
                    (if (= mode 4)
                        (do
                          (Engine.set-view-mode! e 1)
                          (IO.println "Volumetric Sdf Fog Mode: ON (Temperature)"))
                        (if (= mode 1)
                            (do
                              (Engine.set-view-mode! e 2)
                              (IO.println "Volumetric Sdf Fog Mode: ON (Age / Spawn Time)"))
                            (if (= mode 2)
                                (do
                                  (Engine.set-view-mode! e 3)
                                  (IO.println "Volumetric Sdf Fog Mode: ON (Humidity)"))
                                (do
                                  (Engine.set-volumetric-sdf! e false)
                                  (Engine.set-view-mode! e 0)
                                  (IO.println "Volumetric Sdf Fog Mode: OFF")))))))
            (Engine.set-grid-dirty! e true))))
      (when (InputManager.action-pressed? mgr "ToggleChunkLoading")
        (let [curr @(Engine.chunk-loading-enabled e)]
          (do
            (Engine.set-chunk-loading-enabled! e (not curr))
            (IO.println (if curr "Background chunk loading DISABLED" "Background chunk loading ENABLED")))))
      (when (InputManager.action-pressed? mgr "CycleMaterial")
        (let [curr @(Engine.selected-material e)
              next (if (= curr 2.0) 3.0
                   (if (= curr 3.0) 5.0
                   (if (= curr 5.0) 6.0
                   (if (= curr 6.0) 7.0
                   (if (= curr 7.0) 8.0
                   (if (= curr 8.0) 9.0
                   (if (= curr 9.0) 10.0
                   (if (= curr 10.0) 11.0
                   (if (= curr 11.0) 12.0
                   (if (= curr 12.0) 13.0
                   (if (= curr 13.0) 14.0
                   2.0)))))))))))]
          (do
            (Engine.set-selected-material! e next)
            (IO.println &(str* "Selected Build Material: "
              (if (= next 2.0) "Natural Biome Green"
              (if (= next 3.0) "Stone Grey"
              (if (= next 5.0) "Sand Beige"
              (if (= next 6.0) "Snow / Ice"
              (if (= next 7.0) "Volcanic Obsidian"
              (if (= next 8.0) "Deep Cave Moss"
              (if (= next 9.0) "Amethyst Purple Crystal"
              (if (= next 10.0) "Clay Brown"
              (if (= next 11.0) "Glowing Neon Cyan"
              (if (= next 12.0) "Shiny Gold / Brass"
              (if (= next 13.0) "Pulsating Lava Crimson"
              "Dark Obsidian"))))))))))))))))))

  (sig tick-gameplay-input! (Fn [(Ref Engine.Engine) (Ref InputManager) Double (Ref RigidBody) (Ref RotationState) Double] ()))
  (defn tick-gameplay-input! [e mgr dt p-rb p-rot p-scale]
    (do
      (PlayerSystem.apply-movement! p-rb p-rot p-scale mgr dt)
      (when (InputManager.action-pressed? mgr "StopMovement")
        (do
          (Body.set-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))
          (Body.set-angular-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))))
      (when (InputManager.action-pressed? mgr "ResetPlayer")
        (do
          (RigidBody.set-position! p-rb (Vector3.init 0.0 35.0 0.0))
          (Body.set-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))
          (Body.set-angular-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))))
      (when (InputManager.action-pressed? mgr "Teleport")
        (let [cam (Engine.camera e)
              grid (Engine.grid e)
              cam-pos (Camera.pos cam)
              cam-front (Camera.front cam)
              ray (Ray.make @cam-pos @cam-front)
              config (RaymarchConfig.init 128 150.0 0.005 0.001 0.05)
              hit (PlayerSystem.march-world (Engine.world e) (Engine.world-data e) grid &ray &config)]
          (if @(RaymarchHit.hit &hit)
              (let [hit-p (RaymarchHit.p &hit)
                    dest (Vector3.add hit-p &(Vector3.init 0.0 2.5 0.0))]
                (do
                  (RigidBody.set-position! p-rb @&dest)
                  (Body.set-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))
                  (Body.set-angular-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))
                  (IO.println &(str* "Teleported player to " &(Vector3.str &dest)))))
              (IO.println "Teleport target missed or too far!"))))))

  (sig tick-input! (Fn [(Ref Engine.Engine) Double] ()))
  (defn tick-input! [e dt]
    (let [mgr (Engine.input e)]
      (do
        (InputManager.update! mgr)
        (if (Maybe.just? (Engine.active-ui-panel e))
            (do
              (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-tag PlayerTag)]
                (do
                  (Body.set-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))
                  (Body.set-angular-velocity! (RigidBody.body p-rb) (Vector3.init 0.0 0.0 0.0))))
              (when (InputManager.action-pressed? mgr "ToggleUI")
                (Engine.close-ui! e)))
            (do
              (ECS.query (Engine.world e) [p-ent (p-rb RigidBody) (p-col Collidable) (p-rot RotationState) (p-tag PlayerTag)]
                (let [p-scale (match-ref (Collidable.volume p-col)
                                (Volume.Ball sphere) @(Sphere.radius sphere)
                                _ 1.0)]
                  (tick-gameplay-input! e mgr dt p-rb p-rot p-scale)))
              (when (InputManager.action-pressed? mgr "Fire")
                (PlayerSystem.spawn-bullet! e false))
              (when (InputManager.action-digital? mgr "FireBouncy")
                (PlayerSystem.spawn-bullet! e true))
              (when (InputManager.action-pressed? mgr "Laser")
                (PlayerSystem.fire-laser! e))
              (when (InputManager.action-pressed? mgr "Build")
                (PlayerSystem.build-laser! e))
              (when (InputManager.action-pressed? mgr "Implode")
                (PlayerSystem.fire-implosion-laser! e))
              (when (InputManager.action-pressed? mgr "ToggleUI")
                (Engine.open-ui-at-crosshair! e))))
        (tick-settings-input! e mgr))))
)
