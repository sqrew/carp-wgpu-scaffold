;; src/settings.carp

(load "Pattern.carp")

(deftype Settings [
  width Int
  height Int
  shadow-quality Int
  ao-quality Int
  volumetric-sdf Bool
  show-debug-lines Bool
  chunk-loading-enabled Bool
  fixed-dt Double
  physics-iterations Int
  gravity (Vector3 Double)
  ray-steps Int
  shadow-steps Int
  voxel-resolution Int
  step-density-multiplier Double
])

(defmodule Settings
  (defn default []
    (Settings.init
      1280
      720
      2
      2
      false
      true
      true
      0.00833
      8
      (Vector3.init 0.0 -9.81 0.0)
      80
      16
      64
      1.25))

  (defn parse-bool [s]
    (or (= s "true") (= s "1")))

  (defn load-from-file [filepath]
    (let [file-res (IO.read-file filepath)
          cfg (Settings.default)]
      (match file-res
        (Result.Success content)
          (let [lines-arr (String.lines &content)]
            (do
              (for [i 0 (Array.length &lines-arr)]
                (let [line (Array.unsafe-nth &lines-arr i)
                      parts (String.split-by line &[\=])]
                  (when (= (Array.length &parts) 2)
                    (let [key (Pattern.trim (Array.unsafe-nth &parts 0))
                          val (Pattern.trim (Array.unsafe-nth &parts 1))]
                      (do
                        (when (= &key "width")
                          (match (Int.from-string &val)
                            (Maybe.Just w)
                              (if (and (>= w 256) (<= w 8192))
                                (Settings.set-width! &cfg w)
                                (IO.println "Warning: width out of bounds [256, 8192], ignoring config value."))
                            _ ()))
                        (when (= &key "height")
                          (match (Int.from-string &val)
                            (Maybe.Just h)
                              (if (and (>= h 144) (<= h 8192))
                                (Settings.set-height! &cfg h)
                                (IO.println "Warning: height out of bounds [144, 8192], ignoring config value."))
                            _ ()))
                        (when (= &key "shadow_quality")
                          (match (Int.from-string &val)
                            (Maybe.Just sq)
                              (if (and (>= sq 0) (<= sq 3))
                                (Settings.set-shadow-quality! &cfg sq)
                                (IO.println "Warning: shadow_quality out of bounds [0, 3], ignoring config value."))
                            _ ()))
                        (when (= &key "ao_quality")
                          (match (Int.from-string &val)
                            (Maybe.Just aq)
                              (if (and (>= aq 0) (<= aq 3))
                                (Settings.set-ao-quality! &cfg aq)
                                (IO.println "Warning: ao_quality out of bounds [0, 3], ignoring config value."))
                            _ ()))
                        (when (= &key "volumetric_sdf")
                          (Settings.set-volumetric-sdf! &cfg (Settings.parse-bool &val)))
                        (when (= &key "show_debug_lines")
                          (Settings.set-show-debug-lines! &cfg (Settings.parse-bool &val)))
                        (when (= &key "chunk_loading_enabled")
                          (Settings.set-chunk-loading-enabled! &cfg (Settings.parse-bool &val)))
                        (when (= &key "fixed_dt")
                          (match (Double.from-string &val)
                            (Maybe.Just dt)
                              (if (and (>= dt 0.001) (<= dt 0.2))
                                (Settings.set-fixed-dt! &cfg dt)
                                (IO.println "Warning: fixed_dt out of bounds [0.001, 0.2], ignoring config value."))
                            _ ()))
                        (when (= &key "physics_iterations")
                          (match (Int.from-string &val)
                            (Maybe.Just iter)
                              (if (and (>= iter 1) (<= iter 64))
                                (Settings.set-physics-iterations! &cfg iter)
                                (IO.println "Warning: physics_iterations out of bounds [1, 64], ignoring config value."))
                            _ ()))
                        (when (= &key "gravity_y")
                          (match (Double.from-string &val)
                            (Maybe.Just gy)
                              (if (and (>= gy -100.0) (<= gy 100.0))
                                (Settings.set-gravity! &cfg (Vector3.init 0.0 gy 0.0))
                                (IO.println "Warning: gravity_y out of bounds [-100.0, 100.0], ignoring config value."))
                            _ ()))
                        (when (= &key "voxel_resolution")
                          (match (Int.from-string &val)
                            (Maybe.Just vr)
                              (if (or (or (= vr 16) (= vr 32))
                                      (or (or (= vr 64) (= vr 128))
                                          (= vr 256)))
                                (Settings.set-voxel-resolution! &cfg vr)
                                (IO.println "Warning: voxel_resolution must be 16, 32, 64, 128, or 256. Ignoring config value."))
                            _ ()))
                        (when (= &key "step_density_multiplier")
                          (match (Double.from-string &val)
                            (Maybe.Just sdm)
                              (if (and (>= sdm 0.1) (<= sdm 5.0))
                                (Settings.set-step-density-multiplier! &cfg sdm)
                                (IO.println "Warning: step_density_multiplier out of bounds [0.1, 5.0], ignoring config value."))
                            _ ())))))))
              (let [res @(Settings.voxel-resolution &cfg)
                    mult @(Settings.step-density-multiplier &cfg)
                    computed-ray (Double.to-int (* (Double.from-int res) mult))
                    computed-shadow (Double.to-int (* (Double.from-int computed-ray) 0.2))]
                (do
                  (Settings.set-ray-steps! &cfg computed-ray)
                  (Settings.set-shadow-steps! &cfg computed-shadow)
                  cfg))))
        (Result.Error _)
          (let [default-content @"width=1280\nheight=720\nshadow_quality=2\nao_quality=2\nvolumetric_sdf=false\nshow_debug_lines=true\nchunk_loading_enabled=true\nfixed_dt=0.00833\nphysics_iterations=8\ngravity_y=-9.81\nvoxel_resolution=64\nstep_density_multiplier=1.25\n"
                _ (IO.write-file filepath &default-content)]
            cfg))))
)
