;; src/events.carp

(deftype BulletSpawnData [
  pos (Vector3 Double)
  vel (Vector3 Double)
  ang-vel (Vector3 Double)
  scale Double
  bouncy Bool
  water Bool
])

(deftype SystemEvent
  (Quit [])
  (WindowResize [Int Int]))
(deftype CraterSpawnData [
  pos (Vector3 Double)
  radius Double
  op-type Double
])

(deftype GrowingBuild [
  pos (Vector3 Double)
  current-radius Double
  target-radius Double
  speed Double
  material-id Double
  crater-handle (Maybe (Handle ()))
])

(deftype GameEvent
  (SpawnBullet [BulletSpawnData])
  (EntityDestroyed [Uint32])
  (SpawnCrater [CraterSpawnData]))

(deftype InputEvent
  (Action [String Double])) ;; Name and value

(deftype UIEvent
  (MenuOpen [])
  (MenuClose [])
  (ButtonClicked [String]))

(deftype EventKind
  (System [SystemEvent])
  (Game [GameEvent])
  (Input [InputEvent])
  (UI [UIEvent]))

(deftype RubbleMergeData [
  handle (Handle ())
  pos (Vector3 Double)
  rot Quaternion
  vol Volume
  material-id Int
])

