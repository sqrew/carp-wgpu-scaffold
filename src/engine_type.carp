;; src/engine_type.carp

(defmodule Engine
  (deftype Engine [
    camera Camera
    clock Clock
    input InputManager
    grid (SpatialGrid Uint32)
    world GameWorld
    bg-color (Vector3 Double)
    accumulator Double
    coordinator Coordinator
    world-data World
    csg-dirty Bool
    grid-dirty Bool
    voxel-dirty Bool
    craters (Array CraterSpawnData)
    metaball-k Double
    show-debug-lines Bool
    view-mode Int
    shadow-quality Int
  ])

  (sig spawn-crater! (Fn [(Ref Engine.Engine) (Vector3 Double) Double (Maybe (Handle ()))] (Maybe (Handle ()))))
  (defn spawn-crater! [e pos rad existing-crater]
    (Maybe.Nothing))
)
