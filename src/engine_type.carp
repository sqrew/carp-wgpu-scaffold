;; src/engine_type.carp

(deftype Sun [
  dir (Vector3 Double)
  color (Vector3 Double)
  time Double
  cycle-active Bool
  speed Double
  orbit-angle Double
  intensity Double
  size Double
  gassiness Double
])

(defmodule Engine
  (deftype Engine [
    camera Camera
    clock Clock
    input InputManager
    grid (SpatialGrid Uint32)
    world GameWorld
    bg-color (Vector3 Double)
    suns (Array Sun)
    accumulator Double
    coordinator Coordinator
    world-data World
    csg-dirty Bool
    grid-dirty Bool
    voxel-dirty Bool
    need-chunk-scan Bool
    craters (Array CraterSpawnData)
    growing-builds (Array GrowingBuild)
    metaball-k Double
    show-debug-lines Bool
    view-mode Int
    shadow-quality Int
    pressure-field (Field FieldKernelStorage Double)
    velocity-field (Field FieldKernelStorageVector (Vector3 Double))
    temperature-field (Field FieldKernelStorage Double)
    light-field (Field FieldKernelStorage Double)
    humidity-field (Field FieldKernelStorage Double)
    charge-field (Field FieldKernelStorage Double)
    gravity-field (Field FieldKernelStorage Double)
    render-db RenderDatabase
    volumetric-sdf Bool
    chunk-loading-enabled Bool
    diagnostics Diagnostics
    active-ui-panel (Maybe (Handle ()))
    jit-cache (Map String WGPUComputePipeline)
    last-known-script String
    last-known-raymarch String
    last-known-carve String
    last-known-field-rule String
    settings Settings
  ])

  (sig spawn-crater! (Fn [(Ref Engine.Engine) (Vector3 Double) Double (Maybe (Handle ()))] (Maybe (Handle ()))))
  (defn spawn-crater! [e pos rad existing-crater]
    (Maybe.Nothing))

  (sig handle-id (Fn [(Ref (Handle ()))] Uint32))
  (defn handle-id [h]
    (Uint32.from-long (Uint64.to-long (Handle.index h))))

  (defn db [e]
    (World.field-db (Engine.world-data e)))
)
