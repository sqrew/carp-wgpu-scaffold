;; src/coordinator.carp

(load "../carp-deque/deque.carp")
(load "../carp-priority-queue/priority_queue.carp")

(use Deque)
(use PriorityQueue)
(use Result)

;; --- TimedEvent ---

(deftype TimedEvent [
  execute-at Uint64
  payload EventKind
  interval Uint64
  id Long
])

(defmodule TimedEvent
  (defn < [a b]
    (Uint64.< @(TimedEvent.execute-at a) @(TimedEvent.execute-at b)))
)

;; --- Dispatcher ---

(deftype Dispatcher [
  handlers (Array (Pair Long (Fn [(Ref EventKind)] (Result () String))))
  next-id Long
])

(defmodule Dispatcher
  (defn new []
    (Dispatcher.init [] 0l))

  (defn subscribe! [d handler]
    (let [id @(Dispatcher.next-id d)]
      (do
        (Array.push-back! (Dispatcher.handlers d) (Pair.init id @handler))
        (Dispatcher.set-next-id! d (inc id))
        id)))

  (defn unsubscribe! [d id]
    (let [hs (Dispatcher.handlers d)
          len (Array.length hs)
          new-hs []
          found false]
      (do
        (for [i 0 len]
          (let [p (Array.unsafe-nth hs i)]
            (if (= @(Pair.a p) id)
              (set! found true)
              (set! new-hs (Array.push-back new-hs @p)))))
        (when found
          (Dispatcher.set-handlers! d new-hs))
        found)))

  (defn broadcast! [d event]
    (let [hs @(Dispatcher.handlers d)
          len (Array.length &hs)
          errors []]
      (do
        (for [i 0 len]
          (let [res (~(Pair.b (Array.unsafe-nth &hs i)) event)]
            (match res
              (Result.Error msg) (set! errors (Array.push-back errors msg))
              (Result.Success _) ())))
        errors)))
)

;; --- Scheduler ---

(deftype Scheduler [
  delayed (PriorityQueue TimedEvent)
  next-id Long
])

(defmodule Scheduler
  (defn new []
    (Scheduler.init (PriorityQueue.new) 0l))

  (defn schedule! [s event delay-ms]
    (let [now (System.nanotime)
          id @(Scheduler.next-id s)
          target (Uint64.+ now (Uint64.* (Uint64.from-long (the Long delay-ms)) (Uint64.from-long 1000000l)))
          te (TimedEvent.init target event (Uint64.from-long 0l) id)]
      (do
        (PriorityQueue.push! (Scheduler.delayed s) te &TimedEvent.<)
        (Scheduler.set-next-id! s (inc id))
        id)))

  (defn schedule-periodic! [s event interval-ms]
    (let [now (System.nanotime)
          id @(Scheduler.next-id s)
          interval (Uint64.* (Uint64.from-long (the Long interval-ms)) (Uint64.from-long 1000000l))
          target (Uint64.+ now interval)
          te (TimedEvent.init target event interval id)]
      (do
        (PriorityQueue.push! (Scheduler.delayed s) te &TimedEvent.<)
        (Scheduler.set-next-id! s (inc id))
        id)))

  (defn cancel! [s id]
    (let [pq (Scheduler.delayed s)
          idx (PriorityQueue.find-index pq &(fn [te] (= @(TimedEvent.id te) id)))]
      (match idx
        (Maybe.Just i) (PriorityQueue.remove-at! pq i &TimedEvent.<)
        (Maybe.Nothing) false)))

  (defn drain-due! [s now]
    (let [pq (Scheduler.delayed s)
          due []]
      (do
        (while (not (PriorityQueue.empty? pq))
          (let [top (PriorityQueue.peek pq)]
            (match top
              (Maybe.Just te)
                (if (Uint64.<= @(TimedEvent.execute-at &te) now)
                  (let [expired (Maybe.unsafe-from (PriorityQueue.pop! pq &TimedEvent.<))]
                    (do
                      (set! due (Array.push-back due @(TimedEvent.payload &expired)))
                      (let [interval @(TimedEvent.interval &expired)]
                        (when (Uint64.> interval (Uint64.from-long 0l))
                          (let [next-target (Uint64.+ @(TimedEvent.execute-at &expired) interval)
                                renewed (TimedEvent.set-execute-at expired next-target)]
                            (PriorityQueue.push! pq renewed &TimedEvent.<))))))
                  (break))
              (Maybe.Nothing) (break))))
        due)))
)

;; --- Coordinator ---

(deftype Coordinator [
  immediate (Deque EventKind)
  scheduler Scheduler
  dispatcher Dispatcher
  running (Array Bool)
])

(defmodule Coordinator
  (defn new []
    (Coordinator.init (Deque.new) (Scheduler.new) (Dispatcher.new) [false]))

  (defn subscribe! [c handler]
    (Dispatcher.subscribe! (Coordinator.dispatcher c) handler))

  (defn unsubscribe! [c id]
    (Dispatcher.unsubscribe! (Coordinator.dispatcher c) id))

  (defn dispatch! [c event]
    (Deque.push-back! (Coordinator.immediate c) event))

  (defn dispatch-urgent! [c event]
    (Deque.push-front! (Coordinator.immediate c) event))

  (defn schedule! [c event delay-ms]
    (Scheduler.schedule! (Coordinator.scheduler c) event delay-ms))

  (defn schedule-periodic! [c event interval-ms]
    (Scheduler.schedule-periodic! (Coordinator.scheduler c) event interval-ms))

  (defn cancel! [c id]
    (Scheduler.cancel! (Coordinator.scheduler c) id))

  (defn stop! [c]
    (Array.aset! (Coordinator.running c) 0 false))

  (defn tick! [c]
    (let [due (Scheduler.drain-due! (Coordinator.scheduler c) (System.nanotime))
          due-len (Array.length &due)
          q (Coordinator.immediate c)
          d (Coordinator.dispatcher c)
          processed 0]
      (do
        (for [i 0 due-len]
          (Deque.push-back! q @(Array.unsafe-nth &due i)))
        (set! processed (Deque.length q))
        (while (not (Deque.empty? q))
          (let [ev (Maybe.unsafe-from (Deque.pop-front! q))
                errors (Dispatcher.broadcast! d &ev)]
            (do
              (when (not (Array.empty? &errors))
                (for [i 0 (Array.length &errors)]
                  (IO.println &(str* "Handler Error: " (Array.unsafe-nth &errors i)))))
              ())))
        processed)))

  (defn run! [c]
    (do
      (Array.aset! (Coordinator.running c) 0 true)
      (while @(Array.unsafe-nth (Coordinator.running c) 0)
        (let [processed (Coordinator.tick! c)]
          (when (= processed 0)
            (System.sleep-micros 1000))))))
)
