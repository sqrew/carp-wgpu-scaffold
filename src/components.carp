;; components.carp

(deftype PlayerTag [])
(defmodule PlayerTag
  (defn zero [] (PlayerTag.init))
  (implements zero PlayerTag.zero)
)

(deftype RotationState [yaw Double pitch Double])
(defmodule RotationState
  (defn zero [] (RotationState.init -1.5707 0.0))
  (implements zero RotationState.zero)
)

(deftype Parent [parent-id Uint32 local-pos (Vector3 Double) local-rot Quaternion])
(defmodule Parent
  (defn zero [] (Parent.init (Uint32.from-long 0l) (Vector3.init 0.0 0.0 0.0) (Quaternion.identity)))
  (implements zero Parent.zero)
)

(deftype NegativeSDF [])
(defmodule NegativeSDF
  (defn zero [] (NegativeSDF.init))
  (implements zero NegativeSDF.zero)
)

(defmodule RigidBody
  (defn zero [] (RigidBody.static (Vector3.init 0.0 0.0 0.0) (Quaternion.identity) 0.0 0.0))
  (implements zero RigidBody.zero)
)

(defmodule Collidable
  (defn zero [] (Collidable.init (Handle.init (Uint64.from-long 0l) (Uint32.from-long 0l)) (Volume.Box (AABB.init (Vector3.init 0.0 0.0 0.0) (Vector3.init 0.0 0.0 0.0))) (Uint32.from-long 0l) (Uint32.from-long 0l) false))
  (implements zero Collidable.zero)
)

(defmodule Vector3
  (defn zero-v3 [] (Vector3.init 0.0 0.0 0.0))
  (implements zero Vector3.zero-v3)
)

(deftype Color [v (Vector3 Double)])
(defmodule Color
  (defn zero [] (Color.init (Vector3.init 0.0 0.0 0.0)))
  (implements zero Color.zero)
)

(ECS.defworld GameWorld RigidBody Collidable Color PlayerTag RotationState Parent NegativeSDF)
